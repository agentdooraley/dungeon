class 'BuildBaseStrategy' (Strategy)

BuildBaseStrategy.Status =
{
	Defensive = "Defensive",
	Offensive = "Offensive"
}

-- Tier-1 listening post addon per race (Necrons excluded — no entry)
BuildBaseStrategy.Tier1ListeningPostAddons = {
	["guard_race"] = "addon_guard_list_post_1",
	["tau_race"] = "addon_tau_list_post_1",
	["space_marine_race"] = "space_marine_list_post_addon_1",
	["chaos_marine_race"] = "chaos_list_post_addon_1",
	["sisters_race"] = "addon_sisters_list_post_1",
	["eldar_race"] = "eldar_list_post_addon_1",
	["dark_eldar_race"] = "addon_dark_eldar_list_post_1",
	["ork_race"] = "ork_gork_totem_addon_1",
}

function BuildBaseStrategy:__init( baseinfo ) super( baseinfo )
	
	-- Workaround for Relic bug
	self.m_bHQAddon1 = false
	self.m_bHQAddon2 = false
	
	-- Maximum amount of generators to build
	self.m_iMaxGenerators = 9
	
	-- Arkhan 10.2005: Decide, which build program to use
	self.m_bSpendMoney = true
	self.m_iForceTechLockStart = nil
	self.m_iForceTechCooldownUntil = 0
	self.m_iPrepareRush = 0
	self.m_iFinishedRush = 0
	self.m_iCurrentBuildProgram = 1
	self.m_sLivingEnemyBuildKey = nil
	self.m_sClosestEnemyBuildKey = nil
	if (CpuManager.AISettings.bAlternativeStrategies) then
		self.m_iCurrentBuildProgram = self:ChooseBuildProgram()
	end
	self:RememberClosestEnemyBuildKey()
	print( "player "..cpu_manager.player_id.." has chosen strategy: "..tostring(self.m_iCurrentBuildProgram))
	
	self.debug_effectiveness = false
	
	self.player_stats = cpu_manager.stats:GetPlayerStatsFromID( cpu_manager.player_id )
	dbAssert( self.player_stats ~= nil )
	
	self:SetStatus( BuildBaseStrategy.Status.Offensive )
	self.military_stance = BuildBaseStrategy.OffensiveStance

	self.num_hq = 1
	self.tierLevel = 1
	
	self:PostEvent( Strategy.Events.OnStart )

    --begin Project QuickStart code
    --begin Project Mapsize code
    --added by Flenser 12 May 2005
    local map_size, iDistanceToEnemy = self:GetMapSize()
    local level = cpu_manager.cpu_player:GetDifficultyLevel()
    
    if level == CpuPlayer.AD_Insane then
		if g_iGMT >=120 then
			self.info.Engineers.want = self.info.Engineers.want + 1    
		end
    end

	--put a cap on tactics spendage
	Tactic.ResourceFloor.requisition = self.info.req_reserve
	
	-- Randomly choose one in the set of squad limits for easier levels
	self.m_iSquadLimit = 0
	for iLoop1 in self.info.SquadLimits do
		self.m_iSquadLimit = self.m_iSquadLimit + 1
	end
	self.m_iSquadLimit = math.random( 1, self.m_iSquadLimit )
	
	-- Check for massive battles mode
	local fArmyCapModifier = 1.0
	if (CpuManager.AISettings.bMassiveBattlesMode and g_fMassiveBattlesModifier ~= nil) then
		fArmyCapModifier = g_fMassiveBattlesModifier
	end
	
	-- Set the squad limits
	local iIndex = 1
	for iLoop1 in self.info.SquadLimits do
		if (self.m_iSquadLimit == iIndex) then
			print( "player "..cpu_manager.player_id.." has chosen squadlimits: "..iLoop1 )
			for iLoop2 in self.info.SquadLimits[iLoop1] do
				build_manager:SetSquadLimit( iLoop2, math.floor(self.info.SquadLimits[iLoop1][iLoop2] * fArmyCapModifier + 0.5))
			end
			break
		end
		iIndex = iIndex + 1
	end

	-- Set maximums, if needed
	if self.info.no_alternate_objective ~= nil then
		CapturePlan.Maximums.points = resource_manager:GetTotalNumStrategicPoints() / 2
		CapturePlan.Maximums.objectives = resource_manager:GetTotalNumStrategicObjectives() / 2
	end
	
	-- Detector list
	self.m_aDetectors = {}
	
	-- Modify unit demand if we've excess ressources
	self.m_bModifyUnitDemand = true

	-- My rating against the first enemy player
	self.rating = 0
	
	self.m_iNextUpdate = 0
	
	-- Init building lists
	self.m_aBuildings = {}
	self.m_aListeningPosts = {}
	self.m_aBuildChannels = {}
	
	-- Check if AI is allied with a human player
	local bAlliedWithHuman = false
	for oPlayer in cpu_manager.stats:GetPlayerStats() do
	
		-- Get player ID
		local iPlayerID = oPlayer:GetPlayerID()
				
		-- Check if player is an ally
		if (cpu_manager:IsFriendly(iPlayerID)) then
		
			-- Check if player is human
			if (AI_GetCpuPlayerFromID(iPlayerID) == nil) then
				bAlliedWithHuman = true
			end
		end
	end
	
	-- Set tech speed
	if (CpuManager.AISettings.iTechSpeed == -2) then
		self.info.ArmyStrengthModifier = self.info.ArmyStrengthModifier * 1.5
	elseif (CpuManager.AISettings.iTechSpeed == -1) then
		self.info.ArmyStrengthModifier = self.info.ArmyStrengthModifier * 1.25
	elseif (CpuManager.AISettings.iTechSpeed == 1) then
		self.info.ArmyStrengthModifier = self.info.ArmyStrengthModifier * 0.75
	elseif (CpuManager.AISettings.iTechSpeed == 2) then
		self.info.ArmyStrengthModifier = self.info.ArmyStrengthModifier * 0.5
	end
	self.info.ArmyStrengthModifier = self.info.ArmyStrengthModifier * math.random(75, 125) / 100
	
	-- Set tech break
	self.m_iTechBreak = 1
	if (bAlliedWithHuman) then
		
		-- Check for handicaps for AI's allied with a human player
		if (CpuManager.AISettings.iHandicap == -1) then
			self.m_iTechBreak = 2
		elseif (CpuManager.AISettings.iHandicap == -2) then
			self.m_iTechBreak = 4
		end
	else
	
		-- Check for handicaps for AI's not allied with a human player
		if (CpuManager.AISettings.iHandicap == 1) then
			self.m_iTechBreak = 2
		elseif (CpuManager.AISettings.iHandicap == 2) then
			self.m_iTechBreak = 4
		end		
	end
	
	-- Workaround squad cap
	self.m_iSquadCap = 0
	self.m_iLastSquadCapCalculation = 0
end

-- Arkhan 10.2005: Chooses a random build program for a race at the start
function BuildBaseStrategy:ChooseBuildProgram()
	return math.random(1, table.getn(self.info.BuildPrograms))
end

-- Same living-enemy fingerprint as CapturePlan homeside rebuild
function BuildBaseStrategy:GetLivingEnemyBuildKey()

	if (CapturePlan ~= nil and CapturePlan.GetLivingEnemyKey ~= nil) then
		return CapturePlan:GetLivingEnemyKey()
	end
	return ""
end

function BuildBaseStrategy:RememberClosestEnemyBuildKey()

	self.m_sLivingEnemyBuildKey = self:GetLivingEnemyBuildKey()
	local oEnemy = cpu_manager:FindClosestEnemyPlayer(false)
	if (oEnemy ~= nil and not oEnemy:IsPlayerDead()) then
		self.m_sClosestEnemyBuildKey = tostring(oEnemy:GetPlayerID())
	else
		self.m_sClosestEnemyBuildKey = ""
	end
end

-- After deaths: re-pick closest living enemy + ChooseBuildProgram (like homeside strat list)
function BuildBaseStrategy:RefreshBuildProgramIfEnemiesChanged()

	local sLiving = self:GetLivingEnemyBuildKey()
	if (sLiving ~= self.m_sLivingEnemyBuildKey) then
		-- Drop cached closest so FindClosestEnemyPlayer scans survivors only
		cpu_manager.closest_enemy_player = nil
		cpu_manager.closest_enemy_distance = nil
		if (cpu_manager.first_enemy_player ~= nil and cpu_manager.first_enemy_player:IsPlayerDead()) then
			cpu_manager.first_enemy_player = nil
		end
		self.m_sLivingEnemyBuildKey = sLiving
	end

	local oEnemy = cpu_manager:FindClosestEnemyPlayer(false)
	local sClosest = ""
	local sRace = "?"
	if (oEnemy ~= nil and not oEnemy:IsPlayerDead()) then
		sClosest = tostring(oEnemy:GetPlayerID())
		sRace = oEnemy:GetPlayerRaceName()
	end
	if (sClosest == self.m_sClosestEnemyBuildKey) then
		return false
	end

	local sOldClosest = self.m_sClosestEnemyBuildKey
	self.m_sClosestEnemyBuildKey = sClosest

	-- Mid-rush: keep rush program; opponent key already updated for sEnemy callers
	if (self.m_iPrepareRush ~= nil and self.m_iPrepareRush > 0) then
		aitrace("BuildBaseStrategy: Closest enemy changed ("..tostring(sOldClosest).." -> "..sClosest..
			" / "..sRace..") — rush active, program kept")
		return true
	end

	if (not CpuManager.AISettings.bAlternativeStrategies) then
		aitrace("BuildBaseStrategy: Closest enemy changed ("..tostring(sOldClosest).." -> "..sClosest..
			" / "..sRace..") — alt strategies off")
		return true
	end

	local iOldProg = self.m_iCurrentBuildProgram
	self.m_iCurrentBuildProgram = self:ChooseBuildProgram()
	aitrace("BuildBaseStrategy: Re-chose build program "..tostring(iOldProg).." -> "..
		tostring(self.m_iCurrentBuildProgram).." vs "..sRace.." (id "..sClosest..")")
	print("player "..cpu_manager.player_id.." re-chose strategy: "..tostring(self.m_iCurrentBuildProgram)..
		" vs "..sRace)
	return true
end

function BuildBaseStrategy:GetName()
	return "BuildBaseStrategy"
end

function BuildBaseStrategy:UpdateTierLevel()
   aitrace( "this race does not evaluate tier" )
   self.tierLevel = 1
end

function BuildBaseStrategy:GetTierLevel()
   return self.tierLevel
end

function BuildBaseStrategy:AddDetectorUnit(sUnitName)
	table.insert(self.m_aDetectors, sUnitName)
end

--increase demand on units with high effectivness against enemy class types
function BuildBaseStrategy:CalculateEffectivenessDemand( enemy_id )

	local enemy_stats = cpu_manager.stats:GetPlayerStatsFromID( enemy_id )
	dbAssert( enemy_stats ~= nil )
	
	for class = 0, UnitStatsAI.UC_Count - 1 do
		local self_eff = self.player_stats:GetTotalEffectivenessRating( class )
		local enemy_class_rating = enemy_stats:GetTotalClassRating( class )

		local difference = self_eff - enemy_class_rating
		-- if < 0 we want more of this type to counter the enemy
		-- else we have enough of this type
		self:IncEffectivenessDemand( class, difference )
	end
end

--increase demand on units that the enemy has low effectivness on or that we no longer want
function BuildBaseStrategy:CalculateClassDemand( enemy_id )

	local enemy_stats = cpu_manager.stats:GetPlayerStatsFromID( enemy_id )
	dbAssert( enemy_stats ~= nil )

	for class = 0, UnitStatsAI.UC_Count - 1 do

		local self_class_rating = self.player_stats:GetTotalClassRating( class )
		local enemy_eff = enemy_stats:GetTotalEffectivenessRating( class )

		local difference = enemy_eff - self_class_rating
		-- if < 0 then we want more this type - the enemy can't counter them well
		-- else they will be countered by the enemy, don't build more for now
		self:IncClassDemand( class, difference )
	end
end

function BuildBaseStrategy:CalculateEngineerDemand()

	local num_engineers = military_manager:GetNumEngineers()
	local limit = self.info.Engineers.want
	if (self.tierLevel == 1 and cpu_manager:AlliedBuildingInRange()) then
		limit = limit + 1
	end
	
	-- Additional builders at higher tiers
	if (self.tierLevel > 1) then
		
		-- Check army strength
		local iArmyStrength = cpu_manager:GetArmyStrength()
		if (iArmyStrength > 3000) then
			limit = limit + 3
		elseif (iArmyStrength > 2000) then
			limit = limit + 2
		else
			limit = limit + 1
		end
	end
	
	-- Минимум рабочих при достаточном реквизиции (все расы)
	local iRequisition = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition )
	if (g_iGMT <= 120 and iRequisition <= 350) then
		if (limit > 2) then
			limit = 2
		end
	elseif (iRequisition > 350) then
		if (limit < 4) then
			limit = 4
		end
	end
	
	limit = self:AdjustEngineerLimit(limit, iRequisition)
	
	if (self.info.max_engineers ~= nil and limit > self.info.max_engineers) then
		limit = self.info.max_engineers
	end
	-- Don't exceed 5 builders
	if (limit > 5) then
		limit = 5
	end
	
	-- Just build some engineers -- don't skew the wants
	if (num_engineers < limit) then
	
		-- Check if a build plan exists for an engineer
		local oBuildPlan = self:GetPlan("Build Unit Plan", cpu_manager:GetEngineerBPID())
		if (oBuildPlan ~= nil) then
			return
		end
		
		-- Check that the main base isn't under attack
		if (cpu_manager:GetCriticalSituation() > 0) and num_engineers >= 2 then
			return
		end
		
		local build_type = CpuBuildType()
		build_type.btype = CpuPrerequisites.BT_Squad
		build_type.name = cpu_manager.stats:GetSquadName( cpu_manager:GetEngineerBPID() )
		self:TryBuild( build_type )		
	end
end

function BuildBaseStrategy:AdjustEngineerLimit(limit, iRequisition)

	return limit
end

-- Arkhan 11.2006: Check if a detector unit is needed and try to build the best one available if necessary
function BuildBaseStrategy:CalculateDetectorDemand()

	-- Don't build detector units if enemy has no stealth units
	if (not cpu_manager:EnemyHasUnitInfiltrators() and not cpu_manager:EnemyHasBaseInfiltrators()) then
		return
	end
	
	-- Check for detectors and try to build the best ones if necessary
	for iLoop1 in self.m_aDetectors do
	
		-- Check if we already have this unit
		local iUnitID = cpu_manager.stats:GetSquadID(self.m_aDetectors[iLoop1])	
		local iUnitCount = cpu_manager.player_stats:GetNumSquadsByBPID(iUnitID)
		if (iUnitCount > 0) then
			return
		end
		
		-- Check if a plan exists for the current unit
		if (self:GetPlan("Build Unit Plan", iUnitID) ~= nil) then
			return
		end
	
		-- Try to build unit
		local tBuildType = CpuBuildType()
		tBuildType.btype = CpuPrerequisites.BT_Squad
		tBuildType.name = self.m_aDetectors[iLoop1]
		if (self:TryBuild(tBuildType)) then
			return
		end
	end
end

-- Arkhan 03.2006: Check stance
function BuildBaseStrategy:CheckStance()

	-- Check if we've an attack delay
	if (g_iGMT < CpuManager.AISettings.iAttackDelay * 60) then
		return "Defensive"
	end

	-- If I'm being attacked, then defend my base
	if (cpu_manager:GetCriticalSituation() > 0 or cpu_manager:GetCriticalThreat() > 500) then
		return "Defensive"
	end

	-- Check for an enemy
	local oEnemy = cpu_manager:FindCommonEnemyPlayer()
	if (oEnemy == nil) then
		return "Defensive"
	end
	
	-- If my force is at least half as strong than the other dude's, and I'm not busy defending, attack them!
	local iMyPower = cpu_manager:GetArmyStrength()
	local iEnemyPower = cpu_manager:GetArmyStrength(oEnemy)
	self.rating = iMyPower - iEnemyPower
	local iMinArmyPower = cpu_manager:GetTierLevel() * cpu_manager:MinArmyStrengthPerTier()
	if (2 * iMyPower < iEnemyPower or iMyPower < iMinArmyPower) then
		return "Defensive"
	end
	
	-- Ready to attack
	return "Offensive"
end

function BuildBaseStrategy:DefensiveStance()

	aitrace("BuildController: Compute defensive stance...")
	
	-- Check stance
	if (self:CheckStance() == "Offensive") then
	
		-- Go to offensive mode
		aitrace("BuildController: Switch to offensive mode...")
		self:SetStatus( BuildBaseStrategy.Status.Offensive )
		self.military_stance = BuildBaseStrategy.OffensiveStance
		return
	end
end

function BuildBaseStrategy:OffensiveStance()

	aitrace("BuildController: Compute offensive stance...")

	-- Check stance
	if (self:CheckStance() == "Defensive") then

		-- Go to defensive mode
		aitrace("BuildController: Switch to defensive mode...")
		self:SetStatus( BuildBaseStrategy.Status.Defensive )
		self.military_stance = BuildBaseStrategy.DefensiveStance
		return
	end
	
	-- Init attack
	self:PostEvent(Strategy.Events.OnAttack)
end

-- Arkhan 11.2006: Virtual method to build more squad/support cap
function BuildBaseStrategy:EvaluateSquadCap()
	
end

-- Arkhan 10.2005: Calculates, if more squad cap is needed
-- Larkin, 05.2009: Reverse oder, first cap, than req check
function BuildBaseStrategy:CheckSquadCap(iMinRequisition, iMinPower)

	-- Check squad cap
	local iSquadCapTotalMax		= build_manager:GetSquadCapTotalMax()
	local iSquadCapLeft			= self:GetSquadCapLeft()
	local iSquadCapCurrentMax	= self:GetSquadCap() + iSquadCapLeft
	if (iSquadCapLeft > self.info.squad_cap_threshold or iSquadCapCurrentMax >= iSquadCapTotalMax) then
		return false
	end
	
	-- Check requisition
	local iRequisition = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition ) / self.m_iTechBreak
	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power ) / self.m_iTechBreak
	if (iRequisition < iMinRequisition or iPower < iMinPower) then
		self:SaveRessources(true)
		return false
	end
	return true
end

-- Arkhan 10.2005: Calculates, if more support cap is needed
function BuildBaseStrategy:CheckSupportCap(iMinRequisition, iMinPower)

	-- Check support cap only if we have a vehicle building
	if (self:GetBuildingCountByName(self:GetBuildingName("VehicleBuilding", true)) <= 0) then
		return false
	end
	
	-- Check squad cap
	local iSupportCapTotalMax	= build_manager:GetSupportCapTotalMax()
	local iSupportCapCurrentMax	= build_manager:GetSupportCapCurrentMax()
	local iSupportCapLeft		= build_manager:GetSupportCapLeft()
	if (iSupportCapLeft > self.info.support_cap_threshold or iSupportCapCurrentMax >= iSupportCapTotalMax) then
		return false
	end

	-- Check requisition
	local iRequisition = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition ) / self.m_iTechBreak
	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power ) / self.m_iTechBreak
	if (iRequisition < iMinRequisition or iPower < iMinPower) then
		self:SaveRessources(true)
		return false
	end	
	return true
end

function BuildBaseStrategy:DevalueUnitByTier( unit_stats )
	-- This race does not devalue units!
	return 0
end

function BuildBaseStrategy:CountSquads(sUnitName, oFunctor)

	-- Check for a functor
	if (oFunctor == nil) then
	
		-- Use fast unit counting
		local iUnitID = cpu_manager.stats:GetSquadID(sUnitName)	
		return cpu_manager.player_stats:GetNumSquadsByBPID(iUnitID)
	end
	
	-- Use slow unit counting
	local iUnitCount = 0
	for oSquad in military_manager:GetSquads() do
	
		-- Check if unit is valid
		if (oSquad:IsValid()) then
		
			-- Check unit name and functor
			if (oSquad:GetSquadName() == sUnitName and oFunctor(oSquad)) then
				iUnitCount = iUnitCount + 1
			end
		end
	end
	return iUnitCount
end

-- Owned flags that still need a listening post (unlocked, safe enough to consider).
function BuildBaseStrategy:CountFlagsNeedingPosts()
	local iCount = 0
	if (CapturePlan.OrderedStratPoints == nil) then
		return 0
	end
	for iLoop1 in CapturePlan.OrderedStratPoints do
		local oStrategicPoint = CapturePlan.OrderedStratPoints[iLoop1][1]
		if (oStrategicPoint ~= nil and oStrategicPoint:Owner() == cpu_manager.player_id and
			not oStrategicPoint:HasListeningPost() and not oStrategicPoint:IsStrategicObjective() and
			not oStrategicPoint:IsLocked()) then
			iCount = iCount + 1
		end
	end
	return iCount
end

-- Unfinished HQ / epoch T2 still needs an engie — leave spare capacity for those plans.
function BuildBaseStrategy:HasCriticalUnfinishedNeedingBuilder()
	for oBuilding in cpu_manager.player_stats:GetBases() do
		if (oBuilding:IsValid() and not oBuilding:IsConstructionDone()) then
			local sName = oBuilding:GetBaseName()
			if (cpu_manager:IsHQ(oBuilding:GetBlueprintID()) or
				EngineerTactic.IsEpochTransitionBuilding(sName)) then
				local bHasBuilder = false
				local iBPID = oBuilding:GetBlueprintID()
				for oSquad in military_manager:GetSquads() do
					if (oSquad:IsValid() and oSquad:IsEngineer() and oSquad:IsBuilding() == iBPID) then
						bHasBuilder = true
						break
					end
				end
				if (not bHasBuilder) then
					return true
				end
			end
		end
	end
	return false
end

-- Parallel LP ResourcePlans from free builders + open flags (all races).
-- Idle engie + flags without posts → 2nd plan (e.g. 1 AFK while 1 builds LP / 1 builds BO).
-- Critical unfinished HQ/epoch keeps a spare engie.
function BuildBaseStrategy:GetDesiredPostWorkers()
	local iFlags = self:CountFlagsNeedingPosts()
	if (iFlags <= 0) then
		return 0
	end

	local iFree = table.getn(cpu_manager:GetAvailableBuilders())
	local iCurrent = self:PlanCount("Resource Plan")
	local iPool = iFree + iCurrent

	-- Default one post crew; any spare free engie with another open flag → second post
	local iDesired = 1
	if (iFlags >= 2 and iFree >= 1) then
		iDesired = 2
	end
	if (iFlags >= 3 and iFree >= 2 and iPool >= 4) then
		iDesired = 3
	end

	-- Late game: allow more if many engies (race max_engineers)
	if (self.tierLevel >= 3 and iPool >= 4) then
		local iLate = (self.info.max_engineers or 3) - 1
		if (iLate < 2) then
			iLate = 2
		end
		if (iLate > 3) then
			iLate = 3
		end
		iDesired = math.max(iDesired, math.min(iLate, iFlags))
	end

	iDesired = math.min(iDesired, iFlags)
	iDesired = math.min(iDesired, 3)

	-- Prefer info.post_builder as soft floor when workers exist (SM/Eldar=2)
	local iInfoPost = self.info.post_builder
	if (iInfoPost ~= nil and iInfoPost > iDesired and iPool >= iInfoPost and iFlags >= iInfoPost) then
		iDesired = math.min(iInfoPost, 3)
	end

	-- HQ/epoch unfinished without a builder: leave one free engie for that job
	if (self:HasCriticalUnfinishedNeedingBuilder()) then
		local iMaxPosts = iFree + iCurrent - 1
		if (iMaxPosts < 1) then
			iMaxPosts = 1
		end
		iDesired = math.min(iDesired, iMaxPosts)
	end

	return iDesired
end

-- Arkhan 10.2005: Changed to fit the new build program concept
function BuildBaseStrategy:Update()

	AITrace.Log("Build.Noise", "BuildBaseStrategy: Update...")

	-- Superclass
	Strategy.Update(self)
	
	-- Parallel listening-post ResourcePlans (scale with free builders / open flags)
	local required_post_workers = self:GetDesiredPostWorkers()
	if (self:PlanCount( "Resource Plan" ) < required_post_workers) then
		self:AddPlan( ResourcePlan() )	
	end
	-- Soft pack + parallel empty caps: at least 3 CapturePlans
	local iCapturePlans = self.info.flag_capture
	if (iCapturePlans == nil or iCapturePlans < 3) then
		iCapturePlans = 3
	end
	if (cpu_manager:GetArmyStrength() > 2500) then
		iCapturePlans = iCapturePlans + 1
	end
	if (self:PlanCount( "Capture Plan" ) < iCapturePlans) then
		self:AddPlan( CapturePlan( cpu_manager.start_pos ) )	
	end
	
	-- Check current tier
	self:UpdateTierLevel()
	
	-- Update HQ count
	self.num_hq = self:GetBuildingCountByName(self:GetBuildingName("HQ"))
	
	-- Build buildings, research and addons
	self:ComputeBuildProgram()

	-- Enemy vehicles spotted → push anti-tech turret upgrades (Guard/SM/Chaos/Sisters/Eldar)
	self:DoUpgradeTurretsToAntiVehicle()

	-- Tier-1 power sink: every tick, even during ForceTech
	self:DoSpendPowerOnListeningPostAddons()

	-- Tier 4 power emergency: build generators every tick
	if (self:NeedsEmergencyGeneratorsForTurrets()) then
		self:DoBuildGenerators()
	end

	-- Free / priority unit production (every tick; races override)
	self:BuildPriorityUnits()

	-- Dump excess power into vehicles (all races except Necrons)
	if (self:UsesEnergyOverflowSpend()) then
		self:SpendEnergyOverflow()
	end
	
	-- Check if we need more cap !
	if (not cpu_manager:HQThreat() and self.m_bSpendMoney) then 
		self:EvaluateSquadCap()
	end
	
	-- Check last update
	if (g_iGMT > self.m_iNextUpdate) then
	
		-- Build LP's if possible (Necessary because of DC 1.2 bug)
		-- Dark Eldar AutoConstruct: только ResourcePlan (DynamicBuild LP ворует рабов → AFK)
		-- Necron: LPs only via capturer scarab after non-crit cap (no DynamicBuild steal)
		local sPostName = self:GetBuildingName("ListeningPost")
		local sRace = cpu_manager.player_stats:GetPlayerRaceName()
		if (sPostName ~= nil and not cpu_manager:AutoConstructBuildings() and
			sRace ~= "necron_race" and
			resource_manager:GetResourceAmount():Get(ResourceAmount.RT_Requisition) > 80) then
		
			-- Check if post plan exist
			local iID = cpu_manager.stats:GetBuildingID(sPostName)
			if (not self:PlanExists("Build Building Plan", iID)) then
			
				-- Try to build post
		        local tBuildType = CpuBuildType()
		        tBuildType.btype = CpuPrerequisites.BT_Building
		        tBuildType.name = sPostName
		        if (self:TryBuild( tBuildType )) then
		            aitrace("BuildController: Dynamic build of "..tBuildType.name)
		        end
			end
		end

		-- Bigger/regular gens before race Flexible so plasma DynamicBuild doesn't steal all engineers
		self:DoBuildGenerators()
		-- Race specific builds
		self:BuildFlexible()		
		-- Build HQs on spare resources
		self:DoBuildHqs()
		-- Finish buildings
		self:FinishBuildings()		
		-- Set next update time
		self.m_iNextUpdate = g_iGMT + 10
	end
	
	-- Build units
	self:DoBuildUnits()
		
	-- Either defend or check if I should attack
	self.military_stance( self )
end

-- Races override for high-priority unit orders (e.g. free sluggas)
function BuildBaseStrategy:BuildPriorityUnits()
end

-- HQ build channels / plans not yet finished on the map
function BuildBaseStrategy:CountHQsUnderConstruction()

	local sHQName = self:GetBuildingName("HQ")
	if (sHQName == nil) then
		return 0
	end

	local iHQID = cpu_manager.stats:GetBuildingID( sHQName )
	local iCount = 0

	for oBuildChannel in build_manager:GetBuildChannelAIs() do
		if (oBuildChannel:GetBlueprintID() == iHQID and not oBuildChannel:ConstructionDone()) then
			iCount = iCount + 1
		end
	end

	iCount = iCount + self:PlanCount( "Build Building Plan", iHQID )
	return iCount
end

-- Require generators before next HQ when power is low; >= 1500 energy skips the gate
function BuildBaseStrategy:NeedsGeneratorsBeforeNextHQ()

	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )
	if (iPower >= 1500) then
		return false
	end

	local numGenerators = resource_manager:GetNumOwnedPowerGenerators()
	local hqsComplete = self:GetBuildingCountByName( self:GetBuildingName("HQ"), true )
	local requiredGenerators = hqsComplete * 6
	if (requiredGenerators > self.m_iMaxGenerators) then
		requiredGenerators = self.m_iMaxGenerators
	end

	if (numGenerators < requiredGenerators) then
		return true
	end

	-- Do not queue another HQ while one is already building and energy is low
	if (self:CountHQsUnderConstruction() > 0) then
		return true
	end

	return false
end

-- Stop building generators when power reserves are high (all races except Necrons)
function BuildBaseStrategy:CountBuildingType( sType )

	local sName = self:GetBuildingName( sType )
	if (sName == nil) then
		return 0
	end

	local iID = cpu_manager.stats:GetBuildingID( sName )
	return self:GetBuildingCountByBPID( iID, false ) + self:PlanCount( "Build Building Plan", iID )
end

function BuildBaseStrategy:GetGeneratorStructureCount()

	local iCount = self:CountBuildingType( "Generator" )
	local sBiggerGenerator = self:GetBuildingName( "BiggerGenerator" )

	if (sBiggerGenerator ~= nil) then
		local iBiggerID = cpu_manager.stats:GetBuildingID( sBiggerGenerator )
		iCount = iCount + self:GetBuildingCountByBPID( iBiggerID, false ) + self:PlanCount( "Build Building Plan", iBiggerID )
	end

	return iCount
end

-- Finished generators only (ConstructionDone): regular + bigger/slag. No plans / pads.
function BuildBaseStrategy:GetCompletedGeneratorStructureCount()

	local iCount = 0
	local sGenerator = self:GetBuildingName( "Generator" )
	if (sGenerator ~= nil) then
		local iID = cpu_manager.stats:GetBuildingID( sGenerator )
		iCount = iCount + self:GetBuildingCountByBPID( iID, true )
	end
	local sBiggerGenerator = self:GetBuildingName( "BiggerGenerator" )
	if (sBiggerGenerator ~= nil) then
		local iBiggerID = cpu_manager.stats:GetBuildingID( sBiggerGenerator )
		iCount = iCount + self:GetBuildingCountByBPID( iBiggerID, true )
	end
	return iCount
end

function BuildBaseStrategy:GetTurretStructureCount()

	return self:CountBuildingType( "Turret" )
end

function BuildBaseStrategy:GetMineStructureCount()

	return self:CountBuildingType( "Mine" )
end

-- Races may cap turret targets in ComputeBuildProgram (nil = no cap)
function BuildBaseStrategy:GetMaxAllowedTurretCount()

	return nil
end

-- Spotted enemy vehicle / air squads. Cache per tick.
BuildBaseStrategy.EnemyVehicleCacheGMT = -1
BuildBaseStrategy.EnemyVehicleCacheCount = 0
BuildBaseStrategy.EnemyAirCacheCount = 0

function BuildBaseStrategy:RefreshEnemyVehicleAirCache()

	if (BuildBaseStrategy.EnemyVehicleCacheGMT == g_iGMT) then
		return
	end
	BuildBaseStrategy.EnemyVehicleCacheGMT = g_iGMT
	local iVehicles = 0
	local iAir = 0
	if (cpu_manager.m_aEnemyUnits ~= nil) then
		for iLoop in cpu_manager.m_aEnemyUnits do
			local oSquad = cpu_manager.m_aEnemyUnits[iLoop][3]
			if (oSquad ~= nil and oSquad:IsValid()) then
				local oStats = oSquad:GetStats()
				if (oStats ~= nil) then
					local eClass = oStats:GetClass()
					if (eClass == UnitStatsAI.UC_VehicleLow or eClass == UnitStatsAI.UC_VehicleMed or
						eClass == UnitStatsAI.UC_VehicleHigh) then
						iVehicles = iVehicles + 1
					elseif (eClass == UnitStatsAI.UC_AirLow or eClass == UnitStatsAI.UC_AirMed or
						eClass == UnitStatsAI.UC_AirHigh) then
						iAir = iAir + 1
					end
				end
			end
		end
	end
	BuildBaseStrategy.EnemyVehicleCacheCount = iVehicles
	BuildBaseStrategy.EnemyAirCacheCount = iAir
end

function BuildBaseStrategy:CountEnemyVehicleSquads()

	self:RefreshEnemyVehicleAirCache()
	return BuildBaseStrategy.EnemyVehicleCacheCount
end

function BuildBaseStrategy:CountEnemyAirSquads()

	self:RefreshEnemyVehicleAirCache()
	return BuildBaseStrategy.EnemyAirCacheCount
end

function BuildBaseStrategy:HasEnemyVehicles()

	return (self:CountEnemyVehicleSquads() >= 1)
end

function BuildBaseStrategy:HasEnemyVehiclesOrAir()

	self:RefreshEnemyVehicleAirCache()
	return (BuildBaseStrategy.EnemyVehicleCacheCount >= 1 or BuildBaseStrategy.EnemyAirCacheCount >= 1)
end

-- Anti-vehicle / anti-air turret weapon upgrades (Guard / SM / Chaos / Sisters / Eldar)
function BuildBaseStrategy:IsAntiVehicleTurretAddon( sAddonName )

	if (sAddonName == nil) then
		return false
	end
	return (sAddonName == "addon_guard_turret" or
		sAddonName == "space_marine_turret_addon" or
		sAddonName == "chaos_turret_addon" or
		sAddonName == "addon_sisters_turret" or
		sAddonName == "eldar_support_platform_addon")
end

-- Upgrade turret to anti-tech only if enemy has vehicles or aircraft
function BuildBaseStrategy:CanBuildAntiVehicleTurretAddon( sAddonName )

	if (not self:IsAntiVehicleTurretAddon( sAddonName )) then
		return true
	end
	return self:HasEnemyVehiclesOrAir()
end

function BuildBaseStrategy:GetAntiVehicleTurretAddonName()

	local sRace = cpu_manager.player_stats:GetPlayerRaceName()
	if (sRace == "guard_race") then
		return "addon_guard_turret"
	elseif (sRace == "space_marine_race") then
		return "space_marine_turret_addon"
	elseif (sRace == "chaos_marine_race") then
		return "chaos_turret_addon"
	elseif (sRace == "sisters_race") then
		return "addon_sisters_turret"
	elseif (sRace == "eldar_race") then
		return "eldar_support_platform_addon"
	end
	return nil
end

function BuildBaseStrategy:CountTurretsNeedingAntiVehicleUpgrade( sAddonName )

	if (sAddonName == nil or self.m_aBuildChannels == nil) then
		return 0
	end
	local sBuilding = self:GetAddonBuilding( sAddonName )
	if (sBuilding == nil) then
		return 0
	end
	local iTurretID = cpu_manager.stats:GetBuildingID( sBuilding )
	local iAddonID = cpu_manager.stats:GetAddOnID( sAddonName )
	local iNeed = 0
	for iLoop in self.m_aBuildChannels do
		if (self.m_aBuildChannels[iLoop][2] == iTurretID) then
			local oChannel = self.m_aBuildChannels[iLoop][1]
			if (oChannel ~= nil and
				oChannel:CanAddToQueue( BuildChannelAI.PQ_AddOn, iAddonID ) == BuildChannelAI.CANBUILD_Ok) then
				iNeed = iNeed + 1
			end
		end
	end
	return iNeed
end

-- When enemy vehicles/air appear: queue anti-tech on every turret that still needs it
function BuildBaseStrategy:DoUpgradeTurretsToAntiVehicle()

	if (not self:HasEnemyVehiclesOrAir()) then
		return
	end
	local sAddon = self:GetAntiVehicleTurretAddonName()
	if (sAddon == nil) then
		return
	end
	local iAddonID = cpu_manager.stats:GetAddOnID( sAddon )
	if (self:PlanExists( "Build NotifiedAddOn Plan", iAddonID ) or
		self:PlanExists( "Build AddOn Plan", iAddonID )) then
		return
	end
	if (self:CountTurretsNeedingAntiVehicleUpgrade( sAddon ) < 1) then
		return
	end
	local aTurretPositions = {}
	self:AddPlan( BuildNotifiedAddOnPlan( iAddonID, 0, aTurretPositions ) )
	aitrace("BuildController: Anti-vehicle turret upgrade — enemy vehicles/air spotted")
end

-- More than 5 mines only with 30 generators, 5 HQs and 30 turrets
function BuildBaseStrategy:CanBuildBeyondMineCap()

	local sHQ = self:GetBuildingName( "HQ" )
	if (sHQ == nil) then
		return false
	end

	if (self:GetBuildingCountByName( sHQ, true ) < 5) then
		return false
	end
	if (self:GetGeneratorStructureCount() < 30) then
		return false
	end
	if (self:GetTurretStructureCount() < 30) then
		return false
	end

	return true
end

function BuildBaseStrategy:ShouldBuildMoreMines()

	if (self:CanBuildBeyondMineCap()) then
		return true
	end

	return (self:GetMineStructureCount() < 5)
end

-- Tier 4: energy < 300 and turrets outnumber generators
function BuildBaseStrategy:NeedsEmergencyGeneratorsForTurrets()

	if (self.tierLevel < 4) then
		return false
	end

	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )
	if (iPower >= 300) then
		return false
	end

	local iTurrets = self:GetTurretStructureCount()
	if (iTurrets <= 0) then
		return false
	end

	return (iTurrets > self:GetGeneratorStructureCount())
end

-- Owned safe homeside income SPs without LP (not relic / not T&H): do not grow generator count
-- (all races except Necrons). Uncaptured points ignored; threatened unbuilt flags ignored.
-- Example: 3/5 captured and fortified → gens OK; 5 captured but 2 still need LP → freeze gens.
function BuildBaseStrategy:ShouldPrioritizeHomeSidePostsOverGenerators()

	if (cpu_manager.player_stats:GetPlayerRaceName() == "necron_race") then
		return false
	end
	local iRequisition = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition )
	if (iRequisition >= 400) then
		return false
	end

	for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
		if (CapturePlan:IsRegularHomeSidePoint(oStrategicPoint) and
			oStrategicPoint:Owner() == cpu_manager.player_id and
			not oStrategicPoint:HasListeningPost()) then
			local iEnemy = cpu_manager:GetArmyStrengthAtPos(oStrategicPoint:GetPosition(), 45, true)
			if (iEnemy <= 80) then
				return true
			end
		end
	end
	return false
end

function BuildBaseStrategy:ShouldBuildMoreGenerators()

	if (self:NeedsEmergencyGeneratorsForTurrets()) then
		return true
	end

	if (cpu_manager.player_stats:GetPlayerRaceName() == "necron_race") then
		return true
	end

	-- Freeze at current gen count while safe captured homeside still need LPs
	if (self:ShouldPrioritizeHomeSidePostsOverGenerators()) then
		return false
	end

	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )
	-- T1: stop gens when energy high
	if (self.tierLevel == 1 and iPower > 300) then
		return false
	end
	-- T2: energy > 500 → no more generators (power research gated separately)
	if (self.tierLevel == 2 and iPower > 500) then
		return false
	end
	-- T3: >5 gens and energy > 600 → no more generators
	if (self.tierLevel == 3 and self:GetGeneratorStructureCount() > 5 and iPower > 600) then
		return false
	end
	-- T4+: no energy/gen-count cap (emergency turrets still override above)

	return true
end

-- Power-income research (not weapon "power" upgrades). Necrons exempt.
function BuildBaseStrategy:IsPowerIncomeResearch( sResearchName )

	if (sResearchName == nil) then
		return false
	end
	-- Dark Eldar scythe weapon research — not energy income
	if (string.find( sResearchName, "scythe" ) ~= nil) then
		return false
	end
	if (string.find( sResearchName, "power_research" ) ~= nil) then
		return true
	end
	if (string.find( sResearchName, "upgrade_power" ) ~= nil) then
		return true
	end
	if (string.find( sResearchName, "improved_power_source" ) ~= nil) then
		return true
	end
	return false
end

-- Defer energy upgrades (non-Necron): need ≥4 finished gens; also tier energy caps
function BuildBaseStrategy:ShouldDeferPowerIncomeResearch()

	if (cpu_manager.player_stats:GetPlayerRaceName() == "necron_race") then
		return false
	end

	-- Regular + bigger/slag, ConstructionDone only
	if (self:GetCompletedGeneratorStructureCount() < 4) then
		return true
	end

	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )
	if (self.tierLevel == 2 and iPower > 500) then
		return true
	end
	if (self.tierLevel == 3 and self:GetGeneratorStructureCount() > 5 and iPower > 600) then
		return true
	end
	return false
end

-- Central gate for HQ / generator limits (DynamicBuild, strategyinfo, DoBuild*)
function BuildBaseStrategy:IsBuildingBuildBlocked( iBuildingID )

	if (iBuildingID == nil or iBuildingID == 0) then
		return false
	end

	if (self:NeedsEmergencyGeneratorsForTurrets()) then
		if (cpu_manager:IsTurret( iBuildingID ) or cpu_manager:IsMine( iBuildingID )) then
			return true
		end
	end

	if (cpu_manager:IsHQ( iBuildingID ) and self:NeedsGeneratorsBeforeNextHQ()) then
		return true
	end

	if ((cpu_manager:IsGenerator( iBuildingID ) or cpu_manager:IsBiggerGenerator( iBuildingID )) and
		not self:ShouldBuildMoreGenerators()) then
		return true
	end

	if (cpu_manager:IsMine( iBuildingID ) and not self:ShouldBuildMoreMines()) then
		return true
	end

	-- Pre-T4 vehicle bay cap (unless 3000/3000 overflow)
	local sVeh = self:GetBuildingName("VehicleBuilding")
	if (sVeh ~= nil and iBuildingID == cpu_manager.stats:GetBuildingID(sVeh) and
		self:UsesEnergyOverflowSpend() and not self:CanBuildMoreVehicleBuildings()) then
		return true
	end

	return false
end

-- 3000 req + 3000 power: ignore vehicle-building / tech gates
function BuildBaseStrategy:IsResourceOverflow()
	local iReq = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition )
	local iPow = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )
	return (iReq >= 3000 and iPow >= 3000)
end

function BuildBaseStrategy:GetEnergyAmount()
	return resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )
end

-- Necrons override false
function BuildBaseStrategy:UsesEnergyOverflowSpend()
	return true
end

-- Max vehicle production buildings before T4 (2 default; Tau T2=1; Eldar T4 formula)
function BuildBaseStrategy:GetMaxVehicleBuildings()
	if (self:IsResourceOverflow()) then
		return 99
	end
	if (self:GetTierLevel() >= 4) then
		return 99
	end
	return 2
end

function BuildBaseStrategy:CanBuildMoreVehicleBuildings()
	if (self:IsResourceOverflow()) then
		return true
	end
	local sVeh = self:GetBuildingName("VehicleBuilding")
	if (sVeh == nil) then
		return true
	end
	local iHave = self:GetBuildingCountByName(sVeh, false)
	return (iHave < self:GetMaxVehicleBuildings())
end

function BuildBaseStrategy:PushVehicleBuildingUpTo( iDesired )
	local sName = self:GetBuildingName("VehicleBuilding")
	if (sName == nil or iDesired == nil or iDesired < 1) then
		return
	end
	local iMax = self:GetMaxVehicleBuildings()
	if (iDesired > iMax) then
		iDesired = iMax
	end
	local iHave = self:GetBuildingCountByName(sName, false)
	if (iHave >= iDesired) then
		return
	end
	self:DynamicBuild(sName, iDesired, 1, 0, 0, 0, 0)
end

-- Spam energy-heavy unit across free production channels
function BuildBaseStrategy:DumpEnergyIntoUnit( sUnitName, iDesiredMax )
	if (sUnitName == nil) then
		return false
	end
	if (iDesiredMax == nil) then
		iDesiredMax = 99
	end
	return (self:TryBuildParallelSquads(sUnitName, iDesiredMax, nil) > 0)
end

-- Race override: spend float power on vehicles
function BuildBaseStrategy:SpendEnergyOverflow()
end

function BuildBaseStrategy:IsBuildingNameBuildBlocked( sBuildingName )

	if (sBuildingName == nil) then
		return false
	end

	return self:IsBuildingBuildBlocked( cpu_manager.stats:GetBuildingID( sBuildingName ) )
end

-- Generator / LP-addon rules outrank ForceTech and m_bSpendMoney locks
function BuildBaseStrategy:HasPowerManagementPriority()

	if (cpu_manager.player_stats:GetPlayerRaceName() == "necron_race") then
		return false
	end

	if (self:NeedsEmergencyGeneratorsForTurrets()) then
		return true
	end

	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )
	if (self.tierLevel == 1 and iPower >= 300) then
		return true
	end

	if (self:ShouldBuildMoreGenerators()) then
		return true
	end

	return false
end

function BuildBaseStrategy:IsPowerSinkAddon( sAddonName )

	if (sAddonName == nil) then
		return false
	end

	local sTier1Addon = self:GetTier1ListeningPostAddon()
	return (sTier1Addon ~= nil and sAddonName == sTier1Addon)
end

function BuildBaseStrategy:IsPowerSinkBuilding( sBuildingName )

	if (sBuildingName == nil) then
		return false
	end

	local iID = cpu_manager.stats:GetBuildingID(sBuildingName)
	return (cpu_manager:IsGenerator(iID) or cpu_manager:IsBiggerGenerator(iID))
end

function BuildBaseStrategy:CanBypassSpendLockForPowerSink( sName, bIsAddon )

	if (bIsAddon) then
		if (self.tierLevel == 1 and self:IsPowerSinkAddon(sName)) then
			local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )
			return (iPower >= 300)
		end
		return false
	end

	return (self:IsPowerSinkBuilding(sName) and
		(cpu_manager:IsBiggerGenerator(cpu_manager.stats:GetBuildingID(sName)) or self:ShouldBuildMoreGenerators()))
end

function BuildBaseStrategy:GetTier1ListeningPostAddon()

	local sRace = cpu_manager.player_stats:GetPlayerRaceName()
	return BuildBaseStrategy.Tier1ListeningPostAddons[sRace]
end

-- When tier-1 power >= 300, upgrade listening posts instead of hoarding energy
function BuildBaseStrategy:DoSpendPowerOnListeningPostAddons()

	if (cpu_manager.player_stats:GetPlayerRaceName() == "necron_race") then
		return
	end

	if (self.tierLevel ~= 1) then
		return
	end

	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )
	if (iPower < 300) then
		return
	end

	local sAddon = self:GetTier1ListeningPostAddon()
	if (sAddon == nil) then
		return
	end

	local sListeningPost = self:GetBuildingName("ListeningPost")
	if (sListeningPost == nil or self:GetAddonBuilding(sAddon) ~= sListeningPost) then
		return
	end

	local iListeningPostID = cpu_manager.stats:GetBuildingID(sListeningPost)
	if (self:GetBuildingCountByBPID(iListeningPostID, true) < 1) then
		return
	end

	self:DynamicAddon(sAddon, 100, 1, 0, 0, 0, 0, nil, nil, false)
end

function BuildBaseStrategy:TryBuild( build_type )

	if (build_type.btype == CpuPrerequisites.BT_Building) then
		local iBuildingID = cpu_manager.stats:GetBuildingID( build_type.name )
		if (self:IsBuildingBuildBlocked( iBuildingID )) then
			if (cpu_manager:IsHQ( iBuildingID )) then
				aitrace("BuildController: HQ blocked - need generators first (power < 1500)")
			else
				aitrace("BuildController: Generator blocked - enough power for tier "..tostring(self.tierLevel))
			end
			return false
		end
	elseif (build_type.btype == CpuPrerequisites.BT_Research) then
		if (self:IsPowerIncomeResearch( build_type.name ) and self:ShouldDeferPowerIncomeResearch()) then
			aitrace("BuildController: Power research deferred - gens/energy gate (tier "..tostring(self.tierLevel)..")")
			return false
		end
	elseif (build_type.btype == CpuPrerequisites.BT_AddOn) then
		if (not self:CanBuildAntiVehicleTurretAddon( build_type.name )) then
			aitrace("BuildController: Anti-vehicle turret deferred - no enemy vehicles")
			return false
		end
	end

	return Strategy.TryBuild( self, build_type )
end

-- How many more squads of this type may still be ordered (engine limit + optional victory cap)
function BuildBaseStrategy:GetRemainingSquadOrders( sUnitName, iDesiredMax )

	local iUnitID = cpu_manager.stats:GetSquadID( sUnitName )
	if (not build_manager:CanBuildSquad( iUnitID )) then
		return 0
	end

	local iOwned = self:CountSquads( sUnitName )
	local iPending = self:PlanCount( "Build Unit Plan", iUnitID )
	local iRemaining = 999 - iOwned - iPending

	if (iDesiredMax ~= nil) then
		local iByDesired = iDesiredMax - iOwned - iPending
		if (iByDesired < iRemaining) then
			iRemaining = iByDesired
		end
	end

	if (iRemaining < 0) then
		iRemaining = 0
	end
	return iRemaining
end

-- Squad cap left for new orders (orks override: cap is spent when the order is placed)
function BuildBaseStrategy:GetEffectiveSquadCapForOrders( iUnitID, iSquadCapReq )
	return math.max( build_manager:GetSquadCapLeft(), 0 )
end

-- Count production buildings that can accept a new squad order right now
function BuildBaseStrategy:CountAvailableUnitBuildChannels( iUnitID, iSquadCapReq, iSupportCapReq )

	local iCount = 0
	local iSquadCapLeft = math.max( build_manager:GetSquadCapLeft(), 0 )
	local iSupportCapLeft = math.max( build_manager:GetSupportCapLeft(), 0 )

	for oBuildChannel in build_manager:GetUnlockedBuildChannelAIs() do

		if (oBuildChannel:IsBuilding() == 0 and not oBuildChannel:IsLocked()) then

			local iItemIndex = oBuildChannel:GetItemIndexFromID( BuildChannelAI.PQ_Squad, iUnitID )
			if (iItemIndex ~= BuildChannelAI.INVALID_INDEX) then

				if (oBuildChannel:CanAddToQueue( BuildChannelAI.PQ_Squad, iUnitID ) == BuildChannelAI.CANBUILD_Ok) then

					if ((iSquadCapReq == 0 or iSquadCapLeft - iSquadCapReq >= 0) and
						(iSupportCapReq == 0 or iSupportCapLeft - iSupportCapReq >= 0)) then
						iCount = iCount + 1
					end
				end
			end
		end
	end
	return iCount
end

function BuildBaseStrategy:AddUnitBuildPlan( iUnitID, iSquadCapReq, iSupportCapReq )

	if (self:CountAvailableUnitBuildChannels( iUnitID, iSquadCapReq, iSupportCapReq ) <= 0) then
		return false
	end

	self:AddPlan( BuildUnitPlan( iUnitID ) )
	return true
end

-- Place up to iMaxParallel orders across free production buildings
function BuildBaseStrategy:TryBuildParallelSquads( sUnitName, iDesiredMax, iMaxParallel )

	if (cpu_manager:RestrictMilitary()) then
		return 0
	end
	if (not cpu_manager.components[CpuPlayer.CT_BuildUnits]) then
		return 0
	end

	local iUnitID = cpu_manager.stats:GetSquadID( sUnitName )
	local oUnitStats = cpu_manager.stats:GetUnitStatsFromBPID( iUnitID )
	if (oUnitStats == nil) then
		return 0
	end

	local iRemaining = self:GetRemainingSquadOrders( sUnitName, iDesiredMax )
	if (iRemaining <= 0) then
		return 0
	end

	local iSquadCapReq = oUnitStats:GetSquadCapReq()
	local iSupportCapReq = oUnitStats:GetSupportCapReq()
	local iCapLeft = self:GetEffectiveSquadCapForOrders( iUnitID, iSquadCapReq )
	local iOrdersByCap = iRemaining

	if (iSquadCapReq > 0) then
		local iByCap = math.floor( iCapLeft / iSquadCapReq )
		if (iByCap < iOrdersByCap) then
			iOrdersByCap = iByCap
		end
	end

	local iChannels = self:CountAvailableUnitBuildChannels( iUnitID, iSquadCapReq, iSupportCapReq )
	local iOrders = iOrdersByCap

	if (iChannels < iOrders) then
		iOrders = iChannels
	end
	if (iMaxParallel ~= nil and iMaxParallel > 0 and iMaxParallel < iOrders) then
		iOrders = iMaxParallel
	end
	if (iOrders <= 0) then
		return 0
	end

	local iBuilt = 0
	for iLoop1 = 1, iOrders do
		if (self:AddUnitBuildPlan( iUnitID, iSquadCapReq, iSupportCapReq )) then
			iBuilt = iBuilt + 1
		else
			break
		end
	end
	return iBuilt
end

-- Victory / elite squads: respects iDesiredMax and engine SquadLimits via CanBuildSquad
function BuildBaseStrategy:TryBuildVictorySquad( sUnitName, iDesiredMax, iMaxParallel )

	return self:TryBuildParallelSquads( sUnitName, iDesiredMax, iMaxParallel ) > 0
end

-- Build HQs
function BuildBaseStrategy:DoBuildHqs()

	aitrace("BuildController: Check Hqs")

	local hqs = self.num_hq

	if (self:NeedsGeneratorsBeforeNextHQ()) then
		return
	end
	
	-- Check requisition
	local iRequisition = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition )
	if g_iGMT < 120 and  iRequisition<1000  then
		return
	end
	
	local numGenerators = resource_manager:GetNumOwnedPowerGenerators()
	if g_iGMT < 120 and  iRequisition<700 and numGenerators > 0 then 
		return
	end
	if (iRequisition < 700 and self.info.req_reserve > 0) then
		return
	end
	
	-- Check power
	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )
--	if (iPower < 200 and self.info.req_reserve <= 0) then
	--	return
	--end	
	
	-- Get maximum amount of hqs
	local max_hqs = 5
	


	-- Build if we are below min power per tier
	if (( iPower < 150*self.num_hq) and (iRequisition < 450 + 150*self.num_hq)) then
		return
	end
	
	-- Check build plans for HQs
	local iHQID = cpu_manager.stats:GetBuildingID(self:GetBuildingName("HQ"))
	
	
	-- Check if any HQs are in production
	for oBuildChannel in build_manager:GetBuildChannelAIs() do

		-- Check building ID
		if (oBuildChannel:GetBlueprintID() == iHQID and not oBuildChannel:ConstructionDone()) then
			return
		end
	end
		
	if (hqs < max_hqs) then

		-- Build basic HQ
		local build_type = CpuBuildType()
		build_type.btype = CpuPrerequisites.BT_Building
		build_type.name = self:GetBuildingName("HQ")
		if (self:TryBuild( build_type )) then
			aitrace("BuildController: Dynamic build of a HQ")
		end
	end
end

-- Arkhan 10.2005: Abstract method for race specific builds
function BuildBaseStrategy:BuildFlexible()
	-- Should be empty
end

function BuildBaseStrategy:FinishBuildings() 

	aitrace("BuildController: Finish buildings...")

	-- Epoch T2 (soul shrine / tau research / etc.) before gens/turrets
	for oBuilding in cpu_manager.player_stats:GetBases() do
		if (oBuilding:IsValid() and not oBuilding:IsConstructionDone()) then
			local sName = oBuilding:GetBaseName()
			if (EngineerTactic.IsEpochTransitionBuilding(sName)) then
				local iEpochID = oBuilding:GetBlueprintID()
				if (not self:PlanExists("Build Building Plan", iEpochID)) then
					local vPos = oBuilding:GetPosition()
					aitrace("BuildController: Resume unfinished epoch building "..sName)
					self:AddPlan(BuildBuildingPlan(iEpochID, vPos, nil, true, true, nil))
					return
				end
			end
		end
	end

	-- Prioritize unfinished bigger generators (high value; easy to abandon for other builds)
	local sBiggerName = self:GetBuildingName("BiggerGenerator")
	if (sBiggerName ~= nil) then
		local iBiggerID = cpu_manager.stats:GetBuildingID(sBiggerName)
		if (iBiggerID ~= nil and iBiggerID ~= 0 and not self:PlanExists("Build Building Plan", iBiggerID)) then
			local oBigger = build_manager:FindUnfinishedBuilding(iBiggerID)
			local oLiveBigger = EngineerTactic.ResolveLiveFinishTarget(oBigger)
			if (oLiveBigger ~= nil) then
				local vPos = oLiveBigger:GetPosition()
				aitrace("BuildController: Resume unfinished bigger generator")
				self:AddPlan(BuildBuildingPlan(iBiggerID, vPos, nil, true, true, nil))
				return
			end
		end
	end

	-- Try to finish a building that wasn't finished (probably because the AI was reset)
	local iBuildingID = build_manager:FindAnyUnfinishedBuildings()
	if (iBuildingID ~= 0) then
	
		-- First see if I'm already trying to finish this
		if (self:PlanExists("Build Building Plan", iBuildingID)) then
			return
		end

		-- Dark Eldar: LP дожимает ResourcePlan (не второй BuildBuildingPlan)
		if (cpu_manager:AutoConstructBuildings() and cpu_manager:IsListeningPost(iBuildingID)) then
			return
		end
	
		-- Check for auto-construct buildings
		if (cpu_manager:AutoConstructBuildings()) then
	
			-- Get building
			local oBuilding = build_manager:FindUnfinishedBuilding(iBuildingID)
			local oBuildingAI = EngineerTactic.ResolveLiveFinishTarget(oBuilding)
			if (oBuildingAI == nil) then
				return
			end
			
			-- Check health
			if (oBuildingAI:GetHealthPercentage() > 0.2) then
				return
			end
		end
		
		-- Build it!
		self:AddPlan(BuildBuildingPlan(iBuildingID, cpu_manager.start_pos))
	end
end

-- Bigger generator (thermo/slag): independent of regular gens; locks engineer via plan
function BuildBaseStrategy:TryBuildBiggerGenerator()

	local sBiggerName = self:GetBuildingName("BiggerGenerator")
	if (sBiggerName == nil) then
		return false
	end

	local iBiggerGeneratorID = cpu_manager.stats:GetBuildingID(sBiggerName)
	if (iBiggerGeneratorID == nil or iBiggerGeneratorID == 0) then
		return false
	end

	if (self:PlanExists("Build Building Plan", iBiggerGeneratorID)) then
		return true
	end

	if (build_manager:FindUnfinishedBuilding(iBiggerGeneratorID) ~= nil) then
		return true
	end

	-- Solo-builder races (Eldar etc.): never start thermo while a regular gen pad is unfinished —
	-- GetUnlockedSquads can grab the bonesinger the tick after Abort/Retry unlocks him.
	if (self:GetMaxParallelGeneratorPlans() <= 1) then
		local sGenName = self:GetBuildingName("Generator")
		if (sGenName ~= nil) then
			local iGenID = cpu_manager.stats:GetBuildingID(sGenName)
			if (iGenID ~= nil and iGenID ~= 0 and
				build_manager:FindUnfinishedBuilding(iGenID) ~= nil) then
				return false
			end
		end
	end

	-- Soft req gate: don't spam plans when broke (thermo ~1.5 gen cost)
	local iRequisition = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition )
	if (iRequisition < 200 and g_iGMT < 90) then
		return false
	end

	aitrace("BuildController: Trying to build bigger generator")
	resource_manager:UpdateFreeSlagHeaps(iBiggerGeneratorID)

	local base_pos = cpu_manager.start_pos
	local slag_table = {}

	for slag_heap in resource_manager:GetSlagHeaps() do
		local slag_pos = slag_heap:GetPosition()
		if (not cpu_manager.terrain_analyzer:HasThreat(slag_pos, 20)) then
			local functor = function(squad_ai)
				local squad_pos = squad_ai:GetPosition()
				return (squad_ai:IsEngineer() and squad_ai:CanBuild(iBiggerGeneratorID) == SquadAI.CANBUILD_Ok and
					not cpu_manager:IsEngineerActivelyBuilding(squad_ai) and
					not cpu_manager:HasThreatOnPath(squad_pos, slag_pos, 20))
			end
			local engineer = cpu_manager:GetClosestUnlockedSquad(slag_pos, 500, functor)
			if (engineer ~= nil) then
				local dist = cpu_manager:GetShortestPathingDistance(base_pos, slag_pos, true)
				local can_build = engineer:CanBuildAt(iBiggerGeneratorID, slag_pos)
				table.insert(slag_table, { slag_pos, engineer, dist, can_build })
			end
		end
	end

	local num_items = table.getn(slag_table)
	if (num_items < 1) then
		return false
	end

	if (num_items > 1) then
		local sortfunc = function(item1, item2)
			return item1[3] < item2[3]
		end
		table.sort(slag_table, sortfunc)
	end

	local vSlagPos = slag_table[1][1]
	local oEngineer = slag_table[1][2]
	local bCanBuild = slag_table[1][4]

	-- Always AddPlan so the engineer is locked (unlocked DoMove was stolen by other builds)
	aitrace("BuildManager: Dynamic build of bigger generator at "..tostring(vSlagPos.x)..", "..tostring(vSlagPos.z))
	if (bCanBuild) then
		self:AddPlan(BuildBuildingPlan(iBiggerGeneratorID, vSlagPos, nil, true, true, oEngineer))
	else
		self:AddPlan(BuildBuildingPlan(iBiggerGeneratorID, vSlagPos, true, true, true, oEngineer))
		if (not cpu_manager:JumpBuilder(oEngineer, vSlagPos)) then
			cpu_manager:DoMove(oEngineer, vSlagPos, false, "Go to bigger generator")
		end
	end
	return true
end

-- Necron: max 2 plasma plans (3 caused duplicate templates + worker fights). Others: 1.
function BuildBaseStrategy:GetMaxParallelGeneratorPlans()

	if (cpu_manager.player_stats ~= nil and
		cpu_manager.player_stats:GetPlayerRaceName() == "necron_race") then
		-- Soft capturers / unfinished LP: one gen at a time (direct call — no .Method ~= nil)
		if (cpu_manager:HasUnfinishedNecronListeningPost()) then
			return 1
		end
		return 2
	end
	return 1
end

-- Regular plasma/warp generators: parallel with bigger gen (separate plans / engineers)
function BuildBaseStrategy:TryBuildRegularGenerators(bEmergencyGen, numGenerators, max_gen)

	local iGeneratorID = cpu_manager.stats:GetBuildingID(self:GetBuildingName("Generator"))
	if (iGeneratorID == nil or iGeneratorID == 0) then
		return false
	end

	local iMaxParallel = self:GetMaxParallelGeneratorPlans()
	local iPlans = self:PlanCount("Build Building Plan", iGeneratorID)
	if (iPlans >= iMaxParallel) then
		return true
	end

	-- Count unfinished pads (Necron parallel used to ignore this → duplicate templates)
	local iUnfinished = 0
	for oBuilding in cpu_manager.player_stats:GetBases() do
		if (oBuilding:IsValid() and not oBuilding:IsConstructionDone() and
			oBuilding:GetBlueprintID() == iGeneratorID) then
			iUnfinished = iUnfinished + 1
		end
	end
	if (iUnfinished >= iMaxParallel) then
		return true
	end
	-- Enough plans already covering unfinished pads — don't add another template
	if (iUnfinished > 0 and iPlans >= iUnfinished and iMaxParallel > 1) then
		return true
	end

	-- Non-Necron: one at a time (unfinished / channel blocks new)
	if (iMaxParallel <= 1) then
		if (build_manager:FindUnfinishedBuilding(iGeneratorID) ~= nil) then
			return true
		end
		for oBuildChannel in build_manager:GetBuildChannelAIs() do
			if (oBuildChannel:GetBlueprintID() == iGeneratorID and not oBuildChannel:ConstructionDone()) then
				return true
			end
		end
	end

	if (numGenerators >= max_gen) then
		return false
	end

	local build_type = CpuBuildType()
	build_type.btype = CpuPrerequisites.BT_Building
	build_type.name = self:GetBuildingName("Generator")
	if (self:TryBuild(build_type)) then
		aitrace("BuildController: Dynamic build of a generator (plans "..tostring(iPlans + 1).."/"..tostring(iMaxParallel)..")")
		return true
	end
	return false
end

-- Arkhan 10.2005: Modified to allow bigger generators in tier2
-- 17.07.2026: bigger + regular parallel; bigger not blocked by plasma plans / power-cap neglect
function BuildBaseStrategy:DoBuildGenerators()

	aitrace("BuildController: Check generators...")

	local bEmergencyGen = self:NeedsEmergencyGeneratorsForTurrets()
	local numGenerators = self:GetGeneratorStructureCount()
	
	-- Check requisition (regular gens; bigger has its own soft gate in TryBuildBiggerGenerator)
	local iRequisition = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition )
	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )
	local bAllowRegular = true
	if (not bEmergencyGen) then
		if g_iGMT < 120 and iRequisition < 1000 then
			bAllowRegular = false
		end
		if g_iGMT < 120 and iRequisition < 700 and numGenerators > 0 then
			bAllowRegular = false
		end
		if (iRequisition < 300 and self.info.req_reserve > 0) then
			bAllowRegular = false
		end
	end
	-- Necron gens cost power not req — don't strand AFK scarabs with piles of energy
	if (cpu_manager.player_stats:GetPlayerRaceName() == "necron_race" and iPower >= 250) then
		bAllowRegular = true
	end
	
	-- Get maximum amount of generators
	local max_gen = self.num_hq * 6
	if (max_gen > self.m_iMaxGenerators) then
		max_gen = self.m_iMaxGenerators
	end

	if (bEmergencyGen) then
		local iTurretTarget = self:GetTurretStructureCount()
		aitrace("BuildController: Emergency generators for turrets (target "..tostring(iTurretTarget)..", have "..tostring(numGenerators)..")")
		if (iTurretTarget > max_gen) then
			max_gen = iTurretTarget
		end
		if (numGenerators >= iTurretTarget) then
			-- Still try bigger: thermo is efficient power
			self:TryBuildBiggerGenerator()
			return
		end
	end

	-- Bigger gen first and independent: ~1.5 cost for ~4 income; don't wait on plasma plans
	self:TryBuildBiggerGenerator()

	-- Regular gens in parallel (different engineer / plan) when we still want power sinks
	if (bAllowRegular and (bEmergencyGen or self:ShouldBuildMoreGenerators())) then
		self:TryBuildRegularGenerators(bEmergencyGen, numGenerators, max_gen)
	end
end

function BuildBaseStrategy:CalculateSquadDemand( unit_id, unit_stats )

	--check if this squad type is locked out
	if not build_manager:CanBuildSquad( unit_id ) then
		return VALUE_LOCK_BUILD
	end

	local prereq = CpuPrerequisites2( cpu_manager.cpu_player, unit_stats:GetSquadName(), CpuPrerequisites.BT_Squad )

	--check if we can even build it, ever
	if prereq:CannotFulfillPrereqs() then
		return VALUE_NEVER_BUILD
	end
   
	local demand = 0
	local deval = 0
	-- Modify for certain squads we like/dislike
	local squad_mod = self:ModifySquadDemand(unit_id)
   
	-- Get class demand
	local fClassDemand = self:GetClassDemand(unit_stats:GetClass())
	if (fClassDemand < 0.0) then
		fClassDemand = -(1.0 / fClassDemand)
	end
	local class_demand = unit_stats:GetClassRating() * (fClassDemand + 1.0)
  
	-- Get standard effectiveness demand
	local effect_demand = 0
	for class = 0, UnitStatsAI.UC_Count - 1 do
		local fEffectivenessDemand = self:GetEffectivenessDemand(class)
		if (fEffectivenessDemand < 0.0) then
			fEffectivenessDemand = -(1.0 / fEffectivenessDemand)
		end
		effect_demand = effect_demand + unit_stats:GetEffectivenessRating(class) * fEffectivenessDemand
	end
	effect_demand = effect_demand / UnitStatsAI.UC_Count
   	  	  
   	--depress rating according to tier
   	--we depress according squad_mod
	if squad_mod == 0 then
		demand = 0
	else --we depress accoring to standard race specific values
		deval = self:DevalueUnitByTier( unit_stats )
		demand = class_demand + effect_demand + deval
	end
	
	--just for debug purpose 
	--dlg("d",string.format("%-25.25s",unit_stats:GetSquadName()).." ND: "..string.format("%04.0f",demand).." C: "..string.format("%04.0f",class_demand).." E: "..string.format("%04.0f",effect_demand).." D: "..string.format("%04.0f",deval)) 
   
	--if I can't build it right now because I don't have the money
	--figure out how long it'll take, and factor that in
	local power_needed = unit_stats:GetCost( ResourceAmount.RT_Power ) - 
		  resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )
	local req_needed = unit_stats:GetCost( ResourceAmount.RT_Requisition ) - 
		  resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition )
	local req_weight = 0
	local power_weight = 0
	local ticks_per_second = 8
	
	if power_needed > 0 then
		  
	   --rate is measured in rate per minute. we want it per second
	   local power_rate = resource_manager:GetResourceRate( ResourceAmount.RT_Power ) / 60
	   
	   --if no power coming in, don't try to build stuff with power prereqs!
	   if power_rate == 0 then
		  return VALUE_RESOURCE_RATE
	   else
		  
		  power_weight = power_needed / power_rate		 
	   end	  
	end
	
	if req_needed > 0 then
	   
	   --rate is measured in rate per minute. we want it per second
	   local req_rate = resource_manager:GetResourceRate( ResourceAmount.RT_Requisition ) / 60
	   
	   if req_rate == 0 then
		  return VALUE_RESOURCE_RATE
	   else
		  req_weight = req_needed / req_rate
	   end
	end
	
	--how many seconds before I can build this thing
	local resource_time = 0
	if power_weight > req_weight then
	   resource_time = power_weight
	else
	   resource_time = req_weight
	end
	
	--check time cap
	if resource_time > 180 then
	   return VALUE_BUILD_TIME
	end
   
	-- Arkhan 11.2005: Check ressources
	local iRequisition = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition )
	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )

	-- Arkhan 11.2005: Check squad and support cap
	local iSquadCap				= self:GetSquadCap()
	local iSquadCapTotalMax		= build_manager:GetSquadCapTotalMax()
	local fSquadPercentage		= iSquadCap / iSquadCapTotalMax
	local iSupportCap			= build_manager:GetSupportCapCurrentMax() - build_manager:GetSupportCapLeft()
	local iSupportCapTotalMax	= build_manager:GetSupportCapTotalMax()
	local fSupportPercentage	= iSupportCap / iSupportCapTotalMax
   
	-- Modify unit demand
	if (self.m_bModifyUnitDemand) then
   
		-- Arkhan 11.2005: Force the build of vehicles if power is available and requisition rare
		if (iPower > 2 * iRequisition and 2 * fSupportPercentage < 3 * fSquadPercentage) then
			if (unit_stats:GetSupportCapReq() > 0) then
				demand = demand * 2
			end
		end
		
		-- Arkhan 01.2006: Force the build of squads if requisition is available and power rare
		if (iRequisition > 2 * iPower and 2 * fSquadPercentage < 3 * fSupportPercentage) then
			if (unit_stats:GetSquadCapReq() > 0) then
				demand = demand * 2
			end
		end
	end
	
	-- Arkhan 12.2005: Decrease squad demand for every already existing unit of this type a bit, to increase unit diversity
	demand = math.max(demand * (100 - 5 * self:CountSquads(unit_stats:GetSquadName())) / 100, demand * 3 / 5)
   
	return demand   
end

-- Arkhan 03.2006: Abstract method to modify squad demand
function BuildBaseStrategy:ModifySquadDemand(iUnitID)
	return 50
end

function BuildBaseStrategy:BuildUnits()
		
	-- Try to build units for now (for defense while teching up)
	-- HQ critical / 1v1 army <0.8 enemy → Spawn NOW even if factory busy
	local id, demand = self:GetHighestDemandedSquad(cpu_manager:NeedsUrgentMilitaryProduction())
	dbAssert( demand ~= nil )

	if (id ~= nil and demand > 0) then
	
		local build_type = CpuBuildType()
		build_type.btype = CpuPrerequisites.BT_Squad
		build_type.name = cpu_manager.stats:GetSquadName( id )

		aitrace( "Spawn NOW: "..build_type.name )
		self:TryBuild( build_type )
	end
end

function BuildBaseStrategy:DoBuildUnits()
	
	aitrace("BuildController: Building units...")
	
	-- We need one engineer minimum
	self:CalculateEngineerDemand()
		
	-- Don't build units if a building, research or addon is more important
	if (not self.m_bSpendMoney or not Tactic.Options.can_reinforce) then
		aitrace("BuildController: No ressources for units available")
		return
	end
	
	-- Check if we need a detector unit and try to build the best one available if necessary
	self:CalculateDetectorDemand()
	
	--check if using designer strategy. If so, don't build my own units
	if cpu_manager:IsUsingDesignerPreference() then
		aitrace("using designer preferences")
		return
	end

	--calculate wants for units
	local enemy = cpu_manager:FindClosestEnemyPlayer()
	if enemy ~= nil then
		local player_id = enemy:GetPlayerID()
		self:CalculateEffectivenessDemand( player_id )
		self:CalculateClassDemand( player_id )
	end
		
	for unit_stats in cpu_manager.stats:GetUnitStats( cpu_manager.cpu_player:GetPlayerRace() ) do
	   
	   local unit_id = unit_stats:GetID()
	   local demand = self:CalculateSquadDemand( unit_id, unit_stats )
	   	   
	   self:SetSquadDemand( unit_id, demand )	   
	end
	
	self:BuildUnits()			
end

--Corsix Added
function BuildBaseStrategy:AddOnNotify( addon_id, notify_code , build_channel)
	aitrace("this race does not have an addon notify!")
end
--End

function BuildBaseStrategy:HQEmergency()
	return (self.num_hq <= 0 and military_manager:GetNumEngineers() >= 1)
end

-- Arkhan 10.2005: Compute build programs
function BuildBaseStrategy:ComputeBuildProgram()

	aitrace("BuildController: Compute build program...")

	-- Dead neighbors: re-pick closest living enemy + build program (like homeside)
	self:RefreshBuildProgramIfEnemiesChanged()

	-- Check ressources
	local iRequisition = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition ) / self.m_iTechBreak
	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power ) / self.m_iTechBreak

	-- Check squad and support cap
	local iSquadCapLeft		= self:GetSquadCapLeft()
	local iSquadCap			= self:GetSquadCap()
	local iSupportCapLeft	= build_manager:GetSupportCapLeft()
	local iSupportCap		= build_manager:GetSupportCapCurrentMax() - iSupportCapLeft
	
	-- Get current tier
	local iTier = self:GetTierLevel()
	aitrace("BuildController: Current tier = "..tostring(iTier))
	
	-- Get current army strength
	local iArmyStrength = cpu_manager:GetArmyStrength()
	aitrace("BuildController: Current army strength = "..tostring(iArmyStrength))
	
	-- Check if we have a builder
	local iBuilders = military_manager:GetNumEngineers()
	
	-- Check for massive battles mode
	local fArmyCapModifier = 1.0
	if (CpuManager.AISettings.bMassiveBattlesMode and g_fMassiveBattlesModifier ~= nil) then
		fArmyCapModifier = g_fMassiveBattlesModifier
	end
			
	-- Reset squad limits (for the moment)
	local iIndex = 1
	for iLoop1 in self.info.SquadLimits do
		if (self.m_iSquadLimit == iIndex) then
			for iLoop2 in self.info.SquadLimits[iLoop1] do
				build_manager:SetSquadLimit(iLoop2, math.floor(self.info.SquadLimits[iLoop1][iLoop2] * fArmyCapModifier + 0.5))
			end
			break
		end
		iIndex = iIndex + 1
	end
	
	-- HQ emergency check
	if (self:HQEmergency()) then
		self.m_bSpendMoney = false
		Tactic.Options.can_reinforce = false
	else
		self.m_bSpendMoney = true
		Tactic.Options.can_reinforce = self:CheckReinforce()
	end
	
	-- T2 + army>1250 + T3 money: press T3 immediately (addon/research/building), above everything
	self:TryImmediateT2ToT3Transition()

	-- Check for force teching (economy gate + 30s attempt window / cooldown)
	local bForceTech = false
	if (self:ShouldApplyForceTechLock()) then
	
		-- HQ critical / homeside army top-up: keep spending on units
		if (not cpu_manager:NeedsUrgentMilitaryProduction()) then
		
			-- Force teching
			aitrace("BuildController: Force teching!!!")
			bForceTech = true
	   		Tactic.Options.can_reinforce = false
	   		self.m_bSpendMoney = false
		end
	end
	
	-- Check if we have to abort a rush program
	if (self.m_iPrepareRush > 0 and cpu_manager:NeedsUrgentMilitaryProduction()) then

    	-- Abort rush
    	aitrace("ABORT RUSH")
		self.m_iPrepareRush = 0
		self.m_iFinishedRush = 4
		
	    -- Switch to standard build program
	    self.m_iCurrentBuildProgram = 1
	end
		
	-- Create building list and validate start point
	self.m_aBuildings = {}
	self.m_aListeningPosts = {}
	local iHQID = cpu_manager.stats:GetBuildingID(self:GetBuildingName("HQ"))
	local vHQPos = nil
	local bUpdateStartPoint = true
	local iClosestHQDistance = sqr(1000)
	for oBuilding in military_manager:GetBases() do
	
		-- Check for valid building
		if (oBuilding:IsValid()) then
		
			-- Get blueprint ID
			local iBlueprintID = oBuilding:GetBlueprintID()
		
			-- Add to building or post list
			if (oBuilding:IsListeningPost()) then
				table.insert(self.m_aListeningPosts, { oBuilding, iBlueprintID, oBuilding:IsConstructionDone() })
			else
	  			table.insert(self.m_aBuildings, { oBuilding, iBlueprintID, oBuilding:IsConstructionDone() })
	  		end
	  		
	  		-- Get position
			local vPos = oBuilding:GetPosition()
		
			-- Check for buildings in range of current start point
			local iDistance = distance_sqr(vPos, cpu_manager.start_pos)
			if (iDistance < sqr(35)) then
				bUpdateStartPoint = false
			end
		
			-- Check for HQ building
			if (iBlueprintID == iHQID and iDistance < iClosestHQDistance) then
				vHQPos = vPos
				iClosestHQDistance = iDistance
			end
		end
	end
	
	-- Create list of build channels
	self.m_aBuildChannels = {}
	for oBuildChannel in build_manager:GetBuildChannelAIs() do
	
		-- Only add complete build channels
		if (oBuildChannel:ConstructionDone()) then
			table.insert(self.m_aBuildChannels, { oBuildChannel, oBuildChannel:GetBlueprintID() })
		end
	end
	
	-- Update start point if necessary
	if (bUpdateStartPoint and vHQPos ~= nil) then
	
		-- Validate position
		aitrace("CpuManager: Reset start point")
		cpu_manager.start_pos = vHQPos
	end
	
	-- Make sure we've enough req in tier 1 to build posts
	if (iTier == 1) then
		iRequisition = iRequisition - 100
	end
	
	-- Soft-save for bigger generator without freezing the whole build program
	local iBiggerGeneratorID = cpu_manager.stats:GetBuildingID(self:GetBuildingName("BiggerGenerator"))
	local oBiggerGeneratorPlan = self:GetPlan("Build Building Plan", iBiggerGeneratorID)
	if (oBiggerGeneratorPlan ~= nil and not oBiggerGeneratorPlan.started_building and
		not self:HasResourcesForBiggerGenerator(iRequisition, iPower)) then
		-- Restrict units/reinforce briefly; still allow other buildings (was: return → stalled everything)
		if (oBiggerGeneratorPlan.m_iPlanStart ~= nil and g_iGMT < oBiggerGeneratorPlan.m_iPlanStart + 90) then
			self:SaveRessources(true)
		end
	end

	-- Compute build program
	local aTurretPosition = {}
	local bSaveRessources = true
	local bBuildUnits = true
	for iLoop1 = 1, table.getn(self.info.BuildPrograms[self.m_iCurrentBuildProgram]) do

		-- Extract object data
		local iMinTier			= self.info.BuildPrograms[self.m_iCurrentBuildProgram][iLoop1][1]
		local iMinRequisition	= self.info.BuildPrograms[self.m_iCurrentBuildProgram][iLoop1][2]
		local iMinPower			= self.info.BuildPrograms[self.m_iCurrentBuildProgram][iLoop1][3]
		local iMinArmyStrength	= self.info.BuildPrograms[self.m_iCurrentBuildProgram][iLoop1][4]
		local iCount			= self.info.BuildPrograms[self.m_iCurrentBuildProgram][iLoop1][5]
		local sType				= self.info.BuildPrograms[self.m_iCurrentBuildProgram][iLoop1][6]
		local sName				= self.info.BuildPrograms[self.m_iCurrentBuildProgram][iLoop1][7]
		-- dark40k 10.2008 -- 8th parameter added true if to be used only for this tier (was already the case for sType="Unit")
		local bSingleTier		= self.info.BuildPrograms[self.m_iCurrentBuildProgram][iLoop1][8]
		local iID				= 0
		
		-- Modify the army strength
		if (self.info.ArmyStrengthModifier ~= nil) then
			iMinArmyStrength = iMinArmyStrength * self.info.ArmyStrengthModifier
		end
		
		-- If min requisition is 0, then set it to -100 to avoid problems
		if (iMinRequisition == 0) then
			iMinRequisition = -100
		end

		-- If min power is 0, then set it to -100 to avoid problems
		if (iMinPower == 0) then
			iMinPower = -100
		end
				
		-- Check how many instances exist
		local iCurrentInstances = 0

		-- dark40k 10.2008 : no creation if wrong tier and singletier set
		-- added first test to check Tier level
		if (iTier~=iMinTier) and bSingleTier==true then
			iCount = 0
		elseif (sType == "Building") then

			-- Check for turret
			if (sName == self:GetBuildingName("Turret")) then
				
				-- Check special modes
				if (not CpuManager.AISettings.bTurrets) then
					iCount = 0
				elseif (CpuManager.AISettings.bFortressMode) then
					iCount = math.min(iCount * 2, math.max(iCount, 6))
				end

				local iMaxTurrets = self:GetMaxAllowedTurretCount()
				if (iMaxTurrets ~= nil) then
					iCount = math.min(iCount, iMaxTurrets)
				end
			end
			
			-- Check for mine
			if (sName == self:GetBuildingName("Mine")) then
				
				-- Check special modes
				if (not CpuManager.AISettings.bMines) then
					iCount = 0
				elseif (CpuManager.AISettings.bFortressMode) then
					iCount = math.min(iCount * 2, math.max(iCount, 6))
				end
			end
		
			-- Build building
			if (iCount > 0) then
			
				-- Get building ID
				iID = cpu_manager.stats:GetBuildingID(sName)
				
				-- Check building list for current building
				iCurrentInstances = self:GetBuildingCountByBPID(iID, false)
				
				-- Check build plans for current building
				local oBuildPlan = self:GetPlan("Build Building Plan", iID)
				if (oBuildPlan ~= nil) then
				
					-- Check if building was not started, yet
					if (not oBuildPlan.started_building and (iRequisition < iMinRequisition + 100 or iPower < iMinPower + 100)) then
						self:SaveRessources(bSaveRessources)
						return
					end
					
					-- Parallel same-type plans: Necron plasma up to 3; others max 2
					local iMaxSame = 2
					if (cpu_manager.player_stats:GetPlayerRaceName() == "necron_race" and
						cpu_manager:IsGenerator(iID)) then
						iMaxSame = self:GetMaxParallelGeneratorPlans()
					end
					if (self:PlanCount("Build Building Plan", iID) >= iMaxSame) then
						iCurrentInstances = iCount
					end
				end
			end
			
		elseif (sType == "Research") then
		
			-- Get research ID
			iID = cpu_manager.stats:GetResearchID(sName)
			
			-- Check if research exists
			if (cpu_manager.cpu_player:IsResearchComplete(sName)) then
				iCurrentInstances = iCurrentInstances + 1
			end
			
			-- Check if research plan exists
			local oBuildPlan = self:GetPlan("Build Research Plan", iID)
			if (oBuildPlan ~= nil) then
			
				-- Check if research was not started, yet
				if (not oBuildPlan.started_building and (iRequisition < iMinRequisition + 100 or iPower < iMinPower + 100)) then
					self:SaveRessources(bSaveRessources)
					return
				end
				iCurrentInstances = iCount
			end
			
		elseif (sType == "Addon") then
		
			-- Get addon ID
			iID = cpu_manager.stats:GetAddOnID(sName)
			
			-- Check existing addons
			local sAddonBuilding = self:GetAddonBuilding(sName)
			local iBuildingID = cpu_manager.stats:GetBuildingID(sAddonBuilding)
			local iBuildingCount = 0
			for iLoop2 in self.m_aBuildChannels do
			
				-- Check for addon building
				if (self.m_aBuildChannels[iLoop2][2] == iBuildingID) then
					iBuildingCount = iBuildingCount + 1
					if (self.m_aBuildChannels[iLoop2][1]:CanAddToQueue(BuildChannelAI.PQ_AddOn, iID) ~= BuildChannelAI.CANBUILD_Ok) then
						iCurrentInstances = iCurrentInstances + 1
					end
				end
			end
						
			-- Check HQ tier addon 1
			if (self:IsTierAddon(sName, 2) and not self.m_bHQAddon1) then
				iCurrentInstances = 0
				
			-- Check HQ tier addon 2
			elseif (self:IsTierAddon(sName, 3) and not self.m_bHQAddon2) then
				iCurrentInstances = 0
			end
			
	  		-- Calculate demand (one minimum)
			iCount = math.max(math.floor(iCount * iBuildingCount / 100), 1)
			
			-- Check if addon plan exists
			local oBuildPlan = self:GetPlan("Build AddOn Plan", iID)
			if (oBuildPlan ~= nil) then
			
				-- Check if addon was not started, yet
				if (not oBuildPlan.started_building and (iRequisition < iMinRequisition + 100 or iPower < iMinPower + 100)) then
					self:SaveRessources(bSaveRessources)
					return
				end
				iCurrentInstances = iCount
			end

		elseif (sType == "TurretAddon") then

			-- Anti-tech turret upgrade only when enemy has vehicles
			if (not self:CanBuildAntiVehicleTurretAddon( sName )) then
				iCount = 0
			end
		
			-- Get addon ID
			iID = cpu_manager.stats:GetAddOnID(sName)
			
			-- Check existing addons
			local sAddonBuilding = self:GetAddonBuilding(sName)
			local iTurretID = cpu_manager.stats:GetBuildingID(sAddonBuilding)
			local iTurretCount = 0
			aTurretPositions = {}
			for iLoop2 in self.m_aBuildChannels do
			
				-- Check for addon building
				if (self.m_aBuildChannels[iLoop2][2] == iTurretID) then
					iTurretCount = iTurretCount + 1
					if (self.m_aBuildChannels[iLoop2][1]:CanAddToQueue(BuildChannelAI.PQ_AddOn, iID) ~= BuildChannelAI.CANBUILD_Ok) then
						iCurrentInstances = iCurrentInstances + 1
						aTurretPositions[iCurrentInstances] = self.m_aBuildChannels[iLoop2][1]:GetEntity():GetPosition()
					end
				end
			end
			
			-- Check for fortress mode
			if (CpuManager.AISettings.bFortressMode and sAddonBuilding == self:GetBuildingName("Turret")) then
				iCount = math.max(iCount, 50)
			end
			
	  		-- Calculate demand (one minimum)
			if (iCount > 0) then
				iCount = math.max(math.floor(iCount * iTurretCount / 100), 1)
			end
			
			-- Check if addon plan exists
			local oBuildPlan = self:GetPlan("Build NotifiedAddOn Plan", iID)
			if (oBuildPlan ~= nil) then
			
				-- Check if turret addon was not started, yet
				if (not oBuildPlan.started_building and (iRequisition < iMinRequisition + 100 or iPower < iMinPower + 100)) then
					self:SaveRessources(bSaveRessources)
					return
				end
				iCurrentInstances = iCount
			end
			
	  	elseif (sType == "Unit") then
	  	
	  		-- Check tier level, squad and support cap
	  		local iUnitSquadCap, iUnitSupportCap = self:GetUnitStats(sName)
	  		if (iTier == iMinTier and iSquadCapLeft >= iUnitSquadCap and iSupportCapLeft >= iUnitSupportCap and not bForceTech and bBuildUnits) then
	  		
				-- Get unit ID
				iID = cpu_manager.stats:GetSquadID(sName)
		  		
				-- Check how many units we have of the current type
				iCurrentInstances = self:CountSquads(sName)
				
				-- Check unit count
				if (iCurrentInstances < iCount) then
				
					-- Was: m_bSpendMoney=false for HarassingTime (5 min) → fake "No ressources"
					-- with 800+ req, and blocked slaves/DoBuildUnits. Flexible Force-build
					-- already handles the priority unit; do not starve the rest of the economy.
					
					-- Was: bBuildUnits=false for 2 min → only FIRST under-count Flexible unit
					-- (e.g. mandrakes) could build; Archon/later lines never ran. Removed.
				end
				
				-- Check if a plan exists for the current unit
				local oBuildPlan = self:GetPlan("Build Unit Plan", iID)
				if (oBuildPlan ~= nil) then
					
					-- Check if unit was not started, yet
					if (not oBuildPlan.started_building and (iRequisition < iMinRequisition + 100 or iPower < iMinPower + 100)) then
						self:SaveRessources(bSaveRessources)
						return
					end
					iCurrentInstances = iCount
				end
				
				-- If max army strength is reached, then just don't build unit
				if (iMinArmyStrength > 0 and iMinArmyStrength < iArmyStrength) then
					iCount = 0
				end
				iMinArmyStrength = 0
		  	else
		  		iCount = 0
	  		end
	  		
	  	elseif (sType == "Rush") then
	  	
	  		-- Check if rush was already finished
	  		local bRestrictReinforcing = (iCount > 0)
	  		iCount = 0
	  		if (self.m_iFinishedRush < iMinTier) then
	  		
	  			-- Check tier level
	  			if (iMinTier >= iTier) then
	  			
	  				-- Check rush state
		  			if (sName == "Prepare") then
		  			
		  				-- Prepare rush
		  				if (self.m_iPrepareRush < iMinTier) then	  				
		  					aitrace("BuildController: Prepare tier"..tostring(iMinTier).." rush")
		  					self.m_iPrepareRush = iMinTier
		  				end
		  				
				  		-- Restrict unit building
			  			self.m_bSpendMoney = false
			  			
			  			-- Restrict reinforcing if count is greater than zero
			  			if (bRestrictReinforcing) then
			  				Tactic.Options.can_reinforce = false
			  			end
		  			else
		  			
						-- Wait until we've reached the required army strength
						if (iArmyStrength < iMinArmyStrength) then
							Tactic.Options.can_reinforce = true
							return
						end
			
						-- Unleash rush
						aitrace("BuildController: Unleash tier"..tostring(iMinTier).." rush")
				   		self.m_iFinishedRush = self.m_iPrepareRush
				   		self.m_iPrepareRush = 0
		  			end
		  			
		  		-- Check if rush is still active
		  		elseif (self.m_iPrepareRush == iMinTier) then
		  		
		  			-- Deactivate rush
		  			aitrace("BuildController: Deactivate tier"..tostring(iMinTier).." rush")
		  			self.m_iFinishedRush = iMinTier
		  			self.m_iPrepareRush = 0
		  		end
	  		end
	  		
	  	elseif (sType == "Restrict") then

			-- Restrict squad limit
			aitrace("BuildController: Restrict squad limit for "..sName.." to "..tostring(iCount))
			build_manager:SetSquadLimit(sName, math.floor(iCount * fArmyCapModifier + 0.5))
  			iCount = 0
		end
		
		-- Check if we need a Relic
		if (iCurrentInstances < iCount and self:RelicRequired(sName)) then
			
			-- Check AI settings and relics
			if (not CpuManager.AISettings.bRelicUnits or not self:HasRelic()) then
				iCount = 0
			end
		end
		
		-- Check if object should be built
		if (iCurrentInstances < iCount) then
		
			-- Check tier level
			if (iTier < iMinTier) then
				return
			end
			
			-- Check army power
			if (iArmyStrength < iMinArmyStrength and not bForceTech) then
				return
			end
			
			-- If requisition or power is rare, don't spend any ressources for units
			if (iRequisition < iMinRequisition or iPower < iMinPower) then
			
				-- Restrict reinforcing and unit building if we have at least one builder
				if (iBuilders > 0) then
					self:SaveRessources(bSaveRessources)
				end
				return
			end
			
			-- Build object
			local bUpdateRessources = false
			if (sType == "Building") then
			
				-- Build building
				local tBuildType = CpuBuildType()
				tBuildType.name = sName
				tBuildType.btype = CpuPrerequisites.BT_Building
				if (self:TryBuild( tBuildType )) then
					aitrace("BuildController: Building "..sName)
					return
				else
					aitrace("BuildController: Building failed => "..sName)
				end
				
			elseif (sType == "Research") then
			
				-- Start research
				local tBuildType = CpuBuildType()
				tBuildType.name = sName
				tBuildType.btype = CpuPrerequisites.BT_Research
				if (self:TryBuild( tBuildType )) then
					aitrace("BuildController: Researching "..sName)
				end
				bUpdateRessources = true
				
			elseif (sType == "Addon") then
			
				-- Build addon
				local tBuildType = CpuBuildType()
				tBuildType.name = sName
				tBuildType.btype = CpuPrerequisites.BT_AddOn
				if (self:TryBuild( tBuildType )) then

					-- Check HQ addons
					if (self:IsTierAddon(sName, 2)) then
						self.m_bHQAddon1 = true
					elseif (self:IsTierAddon(sName, 3)) then
						self.m_bHQAddon2 = true
					end
					aitrace("BuildController: Building addon "..sName)
				end
				bUpdateRessources = true

			elseif (sType == "TurretAddon") then
			
				-- Upgrade turret
				aitrace("BuildController: Building turret addon "..sName)
				self.AddPlan( self, BuildNotifiedAddOnPlan( iID , 0, aTurretPositions) )
				bUpdateRessources = true
				
			elseif (sType == "Unit") then
					
				-- Build unit
				local tBuildType = CpuBuildType()
				tBuildType.btype = CpuPrerequisites.BT_Squad
				tBuildType.name = sName
				if (self:TryBuild( tBuildType )) then
					aitrace("BuildController: Force-building "..sName)
					bBuildUnits = false
					bUpdateRessources = true
				end
			end
			
			-- Update ressources
			if (bUpdateRessources) then
				bSaveRessources = false
				iRequisition = iRequisition - iMinRequisition
				iPower = iPower - iMinPower
			end
		end
	end
end

-- Arkhan 11.2006: Check if we have enough resources for a bigger generator
function BuildBaseStrategy:HasResourcesForBiggerGenerator(iRequisition, iPower)

	-- Check requisition
	if (iRequisition < 300) then
		return false
	end
	return true
end

-- Arkhan 11.2006: Check if we own a relic
function BuildBaseStrategy:HasRelic()

	-- Check all strategic points
	for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
			
		-- Check strategic point
		if (oStrategicPoint:Owner() == cpu_manager.player_id and oStrategicPoint:IsRelic()) then
			return true
		end
	end
	return false
end

-- Arkhan 11.2006: Virtual method for checking out relic units
function BuildBaseStrategy:RelicRequired(sName)
	return false
end

-- Arkhan 11.2006: Save ressources
function BuildBaseStrategy:SaveRessources(bSave)
	
	-- Check if it's necessary to save ressources
	if (not bSave) then
		return
	end
	
	-- Check resources
	if (not self:HasResourceOverflow()) then
		
		-- Restrict reinforcing and unit building
		aitrace("BuildController: Restrict reinforcing and unit building!")
		Tactic.Options.can_reinforce = false
		self.m_bSpendMoney = false
	end
end

-- Arkhan 06.2007: Check if we have a resource overflow
function BuildBaseStrategy:HasResourceOverflow()

	-- Don't reinforce if we've lots of power, rare requisition, and few vehicles
	local iRequisition	= resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition ) / self.m_iTechBreak
	local iPower		= resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power ) / self.m_iTechBreak
	local iTier			= self:GetTierLevel()
	if ((iTier == 1 and iRequisition > 600 and iPower > 250) or (iTier > 1 and iRequisition > 800 and iPower > 500)) then
		return true
	end
	return false
end

-- Arkhan 11.2006: Check if we can reinforce
function BuildBaseStrategy:CheckReinforce()

	-- Don't reinforce in the first 3 minutes
	if (g_iGMT < 60 * 3) then
		return false
	end

	-- Check resources
	local iRequisition		= resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition ) / self.m_iTechBreak
	local iPower			= resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power ) / self.m_iTechBreak
	
	-- Keep some resources for strategic points and other things
	if (iRequisition < Tactic.ResourceFloor.requisition or iPower < Tactic.ResourceFloor.power) then
		return false
	end
	
	-- Don't reinforce if we've lots of power, rare requisition, and few vehicles
	local iSupportCapLeft = build_manager:GetSupportCapLeft()
	if (iSupportCapLeft >= 2 and iPower > 800 and iRequisition < 400) then
		return false
	end
	return true
end

-- MultiBuilding open gate (all map sizes, all races):
-- hard setting + (GMT > 120 OR rich bank)
-- Necron bank: power only; others: req and power
function BuildBaseStrategy:CanOpenMultiBuildings()
	if (not CpuManager.AISettings.bMultiBuildings) then
		return false
	end
	if (g_iGMT > 120) then
		return true
	end
	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )
	if (cpu_manager.player_stats:GetPlayerRaceName() == "necron_race") then
		return (iPower > 3000)
	end
	local iRequisition = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition )
	return (iRequisition > 3000 and iPower > 3000)
end

-- Extra ForceTech gate on top of race ForceTech(): bank OR army floors OR T3+
-- T2: army > 1250 AND (pow > 700 OR req > 700 OR can afford T3 transition)
function BuildBaseStrategy:PassesForceTechEconomyGate()
	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )
	local iTierLevel = self:GetTierLevel()
	local iArmyStrength = cpu_manager:GetArmyStrength()
	local iRequisition = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition )

	if (cpu_manager.player_stats:GetPlayerRaceName() == "necron_race") then
		if (iPower >= 3000) then
			return true
		end
	else
		if (iRequisition >= 3000 and iPower >= 3000) then
			return true
		end
	end

	if (iTierLevel == 1 and iArmyStrength >= 750) then
		return true
	end
	if (iTierLevel == 2 and iArmyStrength > 1250) then
		if (iPower > 700 or iRequisition > 700) then
			return true
		end
		if (self:CanAffordStandardT3Transition()) then
			return true
		end
	end
	if (iTierLevel >= 3) then
		return true
	end
	return false
end

-- Universal T2 ForceTech: army > 1250 and (energy/req overflow OR money for T3)
function BuildBaseStrategy:HasUniversalT2ForceTech()
	if (self:GetTierLevel() ~= 2) then
		return false
	end
	local iArmyStrength = cpu_manager:GetArmyStrength()
	if (iArmyStrength <= 1250) then
		return false
	end
	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )
	local iRequisition = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition )
	if (iPower > 700 or iRequisition > 700) then
		return true
	end
	return self:CanAffordStandardT3Transition()
end

-- Race T3 transition costs: most 340/340; Necron pow 400; Tau 450/340
function BuildBaseStrategy:CanAffordStandardT3Transition()
	local iRequisition = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Requisition )
	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power )
	local sRace = cpu_manager.player_stats:GetPlayerRaceName()
	if (sRace == "necron_race") then
		return (iPower >= 400)
	end
	if (sRace == "tau_race") then
		return (iRequisition >= 450 and iPower >= 340)
	end
	return (iRequisition >= 340 and iPower >= 340)
end

-- T2 + army > 1250 + T3 money + prereqs: press T3 immediately (above spend lock / BO)
function BuildBaseStrategy:ShouldPressImmediateT2ToT3()
	if (self:GetTierLevel() ~= 2) then
		return false
	end
	if (cpu_manager:GetArmyStrength() <= 1250) then
		return false
	end
	if (not self:CanAffordStandardT3Transition()) then
		return false
	end
	if (not self:HasForceTechBuildingPrereqs()) then
		return false
	end
	if (self:IsForceTechTransitionInProgress()) then
		return false
	end
	return true
end

function BuildBaseStrategy:QueueImmediateTransitionAddon( sAddonName )
	if (sAddonName == nil) then
		return false
	end
	local iID = cpu_manager.stats:GetAddOnID(sAddonName)
	if (iID == nil or iID == 0) then
		return false
	end
	if (self:PlanExists("Build AddOn Plan", iID) or self:PlanExists("Build NotifiedAddOn Plan", iID)) then
		return false
	end
	for oBase in cpu_manager.player_stats:GetBases() do
		if (oBase:IsValid() and cpu_manager:IsHQ(oBase:GetBlueprintID()) and oBase:HasAddOn(iID)) then
			return false
		end
	end
	local tBuildType = CpuBuildType()
	tBuildType.name = sAddonName
	tBuildType.btype = CpuPrerequisites.BT_AddOn
	if (self:TryBuild(tBuildType)) then
		if (self:IsTierAddon(sAddonName, 2)) then
			self.m_bHQAddon1 = true
		elseif (self:IsTierAddon(sAddonName, 3)) then
			self.m_bHQAddon2 = true
		end
		aitrace("BuildController: Immediate T3 transition addon "..sAddonName)
		return true
	end
	return false
end

function BuildBaseStrategy:QueueImmediateTransitionResearch( sResearchName )
	if (sResearchName == nil) then
		return false
	end
	if (cpu_manager.cpu_player:IsResearchComplete(sResearchName)) then
		return false
	end
	local iID = cpu_manager.stats:GetResearchID(sResearchName)
	if (iID == nil or iID == 0) then
		return false
	end
	if (self:PlanExists("Build Research Plan", iID)) then
		return false
	end
	local tBuildType = CpuBuildType()
	tBuildType.name = sResearchName
	tBuildType.btype = CpuPrerequisites.BT_Research
	if (self:TryBuild(tBuildType)) then
		aitrace("BuildController: Immediate T3 transition research "..sResearchName)
		return true
	end
	return false
end

function BuildBaseStrategy:QueueImmediateTransitionBuilding( sBuildingName )
	if (sBuildingName == nil) then
		return false
	end
	if (self:GetBuildingCountByName(sBuildingName, false) >= 1) then
		return false
	end
	local iID = cpu_manager.stats:GetBuildingID(sBuildingName)
	if (iID == nil or iID == 0) then
		return false
	end
	if (self:PlanExists("Build Building Plan", iID)) then
		return false
	end
	local tBuildType = CpuBuildType()
	tBuildType.name = sBuildingName
	tBuildType.btype = CpuPrerequisites.BT_Building
	if (self:TryBuild(tBuildType)) then
		aitrace("BuildController: Immediate T3 transition building "..sBuildingName)
		return true
	end
	return false
end

function BuildBaseStrategy:TryImmediateT2ToT3Transition()
	if (not self:ShouldPressImmediateT2ToT3()) then
		return false
	end
	local sRace = cpu_manager.player_stats:GetPlayerRaceName()
	local tRace = BuildBaseStrategy.ForceTechAbort[sRace]
	if (tRace == nil or tRace[2] == nil) then
		return false
	end
	local tAbort = tRace[2]
	if (tAbort.addons ~= nil) then
		for iLoop1 = 1, table.getn(tAbort.addons) do
			if (self:QueueImmediateTransitionAddon(tAbort.addons[iLoop1])) then
				return true
			end
		end
	end
	if (tAbort.researches ~= nil) then
		for iLoop1 = 1, table.getn(tAbort.researches) do
			if (self:QueueImmediateTransitionResearch(tAbort.researches[iLoop1])) then
				return true
			end
		end
	end
	if (tAbort.buildings ~= nil) then
		for iLoop1 = 1, table.getn(tAbort.buildings) do
			if (self:QueueImmediateTransitionBuilding(tAbort.buildings[iLoop1])) then
				return true
			end
		end
	end
	return false
end

