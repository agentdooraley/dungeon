function BuildBaseStrategy:HasAnyCompletedBuilding( aNames )
	if (aNames == nil) then
		return false
	end
	for iLoop1 = 1, table.getn(aNames) do
		if (self:GetBuildingCountByName(aNames[iLoop1], true) >= 1) then
			return true
		end
	end
	return false
end

function BuildBaseStrategy:HasAllCompletedBuildings( aNames )
	if (aNames == nil) then
		return true
	end
	for iLoop1 = 1, table.getn(aNames) do
		if (self:GetBuildingCountByName(aNames[iLoop1], true) < 1) then
			return false
		end
	end
	return true
end

-- (A or B) and C  via all_groups = { {A,B}, {C} }  — each group is OR, groups are AND
function BuildBaseStrategy:MatchesForceTechPrereqSpec( tSpec )
	if (tSpec == nil) then
		return false
	end
	if (tSpec.always) then
		return true
	end
	if (tSpec.any ~= nil and not self:HasAnyCompletedBuilding(tSpec.any)) then
		return false
	end
	if (tSpec.all ~= nil and not self:HasAllCompletedBuildings(tSpec.all)) then
		return false
	end
	if (tSpec.min ~= nil) then
		for iLoop1 = 1, table.getn(tSpec.min) do
			local sName = tSpec.min[iLoop1][1]
			local iNeed = tSpec.min[iLoop1][2]
			if (self:GetBuildingCountByName(sName, true) < iNeed) then
				return false
			end
		end
	end
	if (tSpec.all_groups ~= nil) then
		for iLoop1 = 1, table.getn(tSpec.all_groups) do
			local aGroup = tSpec.all_groups[iLoop1]
			if (not self:HasAnyCompletedBuilding(aGroup)) then
				return false
			end
		end
	end
	-- Spec had only fields we already validated (or empty after always)
	if (tSpec.any == nil and tSpec.all == nil and tSpec.min == nil and tSpec.all_groups == nil and not tSpec.always) then
		return false
	end
	return true
end

function BuildBaseStrategy:HasForceTechBuildingPrereqs()
	local sRace = cpu_manager.player_stats:GetPlayerRaceName()
	local iTier = self:GetTierLevel()
	local tRace = BuildBaseStrategy.ForceTechBuildingPrereqs[sRace]
	if (tRace == nil) then
		return false
	end
	return self:MatchesForceTechPrereqSpec(tRace[iTier])
end

function BuildBaseStrategy:HasForceTechBuildingPlan( aNames )
	if (aNames == nil) then
		return false
	end
	for iLoop1 = 1, table.getn(aNames) do
		local iID = cpu_manager.stats:GetBuildingID(aNames[iLoop1])
		if (iID ~= nil and iID ~= 0 and self:PlanExists("Build Building Plan", iID)) then
			return true
		end
		-- Incomplete pad already placed counts as started
		if (self:GetBuildingCountByName(aNames[iLoop1], false) > self:GetBuildingCountByName(aNames[iLoop1], true)) then
			return true
		end
	end
	return false
end

function BuildBaseStrategy:HasForceTechResearchPlan( aNames )
	if (aNames == nil) then
		return false
	end
	for iLoop1 = 1, table.getn(aNames) do
		local iID = cpu_manager.stats:GetResearchID(aNames[iLoop1])
		if (iID ~= nil and iID ~= 0 and self:PlanExists("Build Research Plan", iID)) then
			return true
		end
	end
	return false
end

function BuildBaseStrategy:HasForceTechAddonPlan( aNames )
	if (aNames == nil) then
		return false
	end
	for iLoop1 = 1, table.getn(aNames) do
		local sName = aNames[iLoop1]
		local iID = cpu_manager.stats:GetAddOnID(sName)
		if (iID ~= nil and iID ~= 0) then
			if (self:PlanExists("Build AddOn Plan", iID) or self:PlanExists("Build NotifiedAddOn Plan", iID)) then
				return true
			end
		end
		if (self:IsTierAddon(sName, 2) and self.m_bHQAddon1) then
			return true
		end
		if (self:IsTierAddon(sName, 3) and self.m_bHQAddon2) then
			return true
		end
	end
	return false
end

function BuildBaseStrategy:IsForceTechTransitionInProgress()
	local sRace = cpu_manager.player_stats:GetPlayerRaceName()
	local iTier = self:GetTierLevel()
	local tRace = BuildBaseStrategy.ForceTechAbort[sRace]
	if (tRace == nil) then
		return false
	end
	local tAbort = tRace[iTier]
	if (tAbort == nil) then
		return false
	end
	if (self:HasForceTechBuildingPlan(tAbort.buildings)) then
		return true
	end
	if (self:HasForceTechResearchPlan(tAbort.researches)) then
		return true
	end
	if (self:HasForceTechAddonPlan(tAbort.addons)) then
		return true
	end
	return false
end

-- Race ForceTech OR universal T2 + building prereqs + economy + 30s/30s; abort if transition started
function BuildBaseStrategy:ShouldApplyForceTechLock()
	if (g_iGMT < (self.m_iForceTechCooldownUntil or 0)) then
		self.m_iForceTechLockStart = nil
		return false
	end
	-- Tier button already pressed / research/building/addon queued → normal spend
	if (self:IsForceTechTransitionInProgress()) then
		self.m_iForceTechLockStart = nil
		return false
	end
	if (not self:HasForceTechBuildingPrereqs()) then
		self.m_iForceTechLockStart = nil
		return false
	end
	if (not self:ForceTech() and not self:HasUniversalT2ForceTech()) then
		self.m_iForceTechLockStart = nil
		return false
	end
	if (not self:PassesForceTechEconomyGate()) then
		self.m_iForceTechLockStart = nil
		return false
	end
	if (self.m_iForceTechLockStart == nil) then
		self.m_iForceTechLockStart = g_iGMT
	end
	if ((g_iGMT - self.m_iForceTechLockStart) >= 30) then
		self.m_iForceTechCooldownUntil = g_iGMT + 30
		self.m_iForceTechLockStart = nil
		aitrace("BuildController: ForceTech window expired, cooldown 30s")
		return false
	end
	return true
end

