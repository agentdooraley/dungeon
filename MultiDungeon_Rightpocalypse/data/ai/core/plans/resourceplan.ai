class 'ResourcePlan' (Plan)

function ResourcePlan:__init() super( CpuPlayer.CT_Resourcing )

	--the flag I'm trying to capture
	self.capturing_flag = nil
	self.builder = nil
	
	self.m_iNextUpdate = 0
	
	self.garrison_id = nil

	--find a garrison building
	local num_buildings = build_manager:GetNumBuildableBuildings()
	for building_index = 0, num_buildings - 1 do
		local bid = build_manager:GetBuildableBuildingAt( building_index )
		if( build_manager:IsGarrisonBuilding(bid) ) then
			self.garrison_id = bid
			break
		end
	end
	
	dbAssert( self.garrison_id ~= nil )
	
	Plan.SetState( self, "Find Flag", ResourcePlan.FindFlag )
	Plan.SetName( self, "Resource Plan" )
	
	Plan.SetNeeds( self, "Obtain Flag and Builder", ResourcePlan.ObtainFlagAndBuilder )
	
	self.is_building = false
end

function ResourcePlan:IsEqual( plan_name, plan_id )
	return self:GetName() == plan_name
end

function ResourcePlan:FindStrategicPoint()

	-- Find best strategic point to capture
	local bAutoConstruct = cpu_manager:AutoConstructBuildings()
	for iLoop1 in CapturePlan.OrderedStratPoints do
	
		-- Get strategic point
		local oStrategicPoint = CapturePlan.OrderedStratPoints[iLoop1][1]
		
		-- Get position
		local vPosition = oStrategicPoint:GetPosition()
		
		-- We're the owner, but no post
		if (oStrategicPoint:Owner() == cpu_manager.player_id and not oStrategicPoint:HasListeningPost() and
			not oStrategicPoint:IsStrategicObjective() and not oStrategicPoint:IsLocked() and
			not (cpu_manager:CloseEnemyUnits(vPosition, 35) and cpu_manager.terrain_analyzer:HasThreat(vPosition, 35))) then
			
			-- Dark Eldar AutoConstruct: не резать флаг из‑за threat на пути (рабы AFK у HQ)
			if (bAutoConstruct or not cpu_manager:HasThreatOnPath(cpu_manager.start_pos, vPosition, 30)) then
				return oStrategicPoint
			end		
		end
	end
	return nil
end

function ResourcePlan:IsNecronCapturerPostBuilder( oSquad )

	if (oSquad == nil or not oSquad:IsValid()) then
		return false
	end
	-- Non-Necron: unchanged
	if (not cpu_manager:IsNecronBuilderScarab(oSquad)) then
		return true
	end
	-- Necron: only free idle scarabs — never steal capturer / POST LOCK / plan worker
	if (oSquad:IsCapturing() or oSquad:IsLocked()) then
		return false
	end
	local oTac = oSquad:GetTactic()
	if (oTac ~= nil) then
		if (oTac.IsNecronPostLocked ~= nil and oTac:IsNecronPostLocked()) then
			return false
		end
		if (oTac.m_vPendingNecronPostPos ~= nil) then
			return false
		end
		if (oTac.IsOnCaptureDuty ~= nil and oTac:IsOnCaptureDuty()) then
			return false
		end
	end
	return true
end

function ResourcePlan:ObtainFlagAndBuilder()

	-- Check last update
	if (g_iGMT < self.m_iNextUpdate and g_iGMT > DefendChokePointPlan.HarassingTime * 10) then
		return
	end
	self.m_iNextUpdate = g_iGMT + 1/2

	aitrace("ResourcePlan: ObtainFlagAndBuilder...")

	-- Necron LP costs ~25 power — skip if broke (capturer-after-cap still handles own flag)
	local bNecron = (cpu_manager.player_stats ~= nil and
		cpu_manager.player_stats:GetPlayerRaceName() == "necron_race")
	if (bNecron) then
		local iPower = resource_manager:GetResourceAmount():Get(ResourceAmount.RT_Power)
		if (iPower == nil or iPower < 25) then
			return
		end
	end
	
	-- Check for available builders
	local aBuilders = cpu_manager:GetAvailableBuilders()
	if (table.getn(aBuilders) <= 0) then
		aitrace( "ResourcePlan: No builders available" )
		return
	end

	-- Get one of our strategic points without a post
	local strat_pt = self:FindStrategicPoint()
	if (strat_pt == nil) then
		aitrace( "ResourcePlan: Can't find strategic point to build a post on" )
		return
	end
	
	local found_engineer = false
	local can_build_no_money = false
	local can_build_error = false
	local can_build_prereq = false
	local can_build_not_buildable = false
	local bAutoConstruct = cpu_manager:AutoConstructBuildings()
	
	--save the location of flag
	local build_pos = strat_pt:GetEntity():GetPosition()

	local iBuilderIndex = 0
	for iLoop1 in aBuilders do
		
		-- Get builder
		local oSquad = aBuilders[iLoop1]

		-- Necron: pure builder scarabs never take ResourcePlan LP jobs
		if (not self:IsNecronCapturerPostBuilder(oSquad)) then
		else
		
		local can_build = oSquad:CanBuild( self.garrison_id )
		
		if (can_build == SquadAI.CANBUILD_NoResources) then
			can_build_no_money = true
		elseif (can_build == CANBUILD_NotBuildable) then
			can_build_not_buildable = true
		elseif (can_build == SquadAI.CANBUILD_Prerequisites) then
			can_build_prereq = true
		elseif (can_build == SquadAI.CANBUILD_Error) then
			can_build_error = true
		elseif (can_build == SquadAI.CANBUILD_Ok) then 
		
			local squad_pos = oSquad:GetPosition()
			-- DE AutoConstruct: path-threat блокировал назначение → рабы AFK, LP не ставятся
			local bPathOk = bAutoConstruct or not cpu_manager:HasThreatOnPath(squad_pos, build_pos, 30)

			-- Capturer with pending post for another flag: leave them alone
			local oTactic = oSquad:GetTactic()
			local bPendingOther = false
			if (oTactic ~= nil and oTactic.m_vPendingNecronPostPos ~= nil) then
				if (distance_sqr(oTactic.m_vPendingNecronPostPos, build_pos) > sqr(25)) then
					bPendingOther = true
				end
			end
		
			if (not bPendingOther and oSquad:CanBuildAt( self.garrison_id, build_pos ) and bPathOk) then
		
				if (self.builder == nil) then
				
					-- Set builder
					found_engineer = true
					self.builder = oSquad
					iBuilderIndex = iLoop1
				else
					local curr_pos = self.builder:GetPosition()
					if (distance_sqr(curr_pos, build_pos) > distance_sqr(squad_pos, build_pos)) then
					
						-- Set builder
						found_engineer = true
						self.builder = oSquad
						iBuilderIndex = iLoop1
					end
				end
			end	
		end
		end -- necron capturer filter
	end

	if self.builder ~= nil then
	
		-- Found builder
		table.remove(aBuilders, iBuilderIndex)
		Plan.LockResource( self, strat_pt )
		self.capturing_flag = strat_pt		
		Plan.LockResource( self, self.builder )
		-- Сбросить залипший busy/assist у DE-раба после DynamicBuild LP
		local oTactic = self.builder:GetTactic()
		if (oTactic ~= nil and oTactic.ClearWorkFlags ~= nil) then
			oTactic:ClearWorkFlags()
		end
		Plan.SetNeeds( self, "No needs", Plan.NeedsFulfilled )
		self.capturing_flag:TagFlagForEngineer( true )
		return
	end
	
	aipushtrace("ResourcePlan")
	
	local some_error_found = false
	
	if not found_engineer then
		some_error_found = true
		aitrace( "no engineers to build a post" )
	end
	
	if can_build_no_money then
		some_error_found = true
		aitrace( "ResourcePlan: No money to build a post" )
	end
	
	if can_build_no_money then
		some_error_found = true
		aitrace( "ResourcePlan: No money to build a post" )
	end
	
	if can_build_error then
		some_error_found = true
		aitrace( "ResourcePlan: Can build error" )
	end

	if can_build_not_buildable then
		some_error_found = true
		aitrace( "ResourcePlan: Not buildable" )
	end		
	
	if can_build_prereq then
		some_error_found = true
		aitrace( "ResourcePlan: Prerequisites" )
	end
	
	if not some_error_found then
		aitrace( "ResourcePlan: Can't build post: unknown error!" )
	end
	
	aipoptrace("ResourcePlan")
	
end

function ResourcePlan:BuildPost()

	if (self.builder == nil or self.capturing_flag == nil) then
		return
	end

	-- Enemy recaptured the flag!
	if (not self.capturing_flag:FinishedCapturing()) then
		aitrace("ResourcePlan: Enemy recaptured flag...", true)
		self.capturing_flag:TagFlagForEngineer( false )
		self:FreeResources()
		if (g_iGMT > DefendChokePointPlan.HarassingTime * 10) then
			self:SetComplete( true )
		else
			Plan.SetState( self, "Build another listening post", ResourcePlan.FindFlag )
			Plan.SetNeeds( self, "Obtain Flag and Builder", ResourcePlan.ObtainFlagAndBuilder )
		end
		return
	end
	
	local build_pos = self.capturing_flag:GetPosition()
	
	-- Check if building can be built
	if (not self.builder:CanBuildAt(self.garrison_id, build_pos)) then
		local vAlt = cpu_manager:FindValidBuildPositionNear(self.garrison_id, build_pos, self.builder, 35)
		if (vAlt ~= nil) then
			build_pos = vAlt
		end
	end
	if (not self.builder:CanBuildAt(self.garrison_id, build_pos)) then
		aitrace("ResourcePlan: Can't build post for unknown reasons...", true)
		self.capturing_flag:TagFlagForEngineer( false )
		self:FreeResources()
		if (g_iGMT > DefendChokePointPlan.HarassingTime * 10) then
			self:SetComplete( true )
		else
			Plan.SetState( self, "Build another listening post", ResourcePlan.FindFlag )
			Plan.SetNeeds( self, "Obtain Flag and Builder", ResourcePlan.ObtainFlagAndBuilder )
		end
		return
	end
	
	-- Try to build post
	self.builder:DoBuildBuilding( self.garrison_id, build_pos )
	
	Plan.SetState( self, "Building Garrison at "..vec2str(build_pos), ResourcePlan.BuildingListeningPost )

	self:OnEvent( Plan.Events.OnPlanStart )
end

-- Only the unfinished LP at THIS flag (never another ResourcePlan's post).
function ResourcePlan:FindUnfinishedPostAtFlag()
	if (self.capturing_flag == nil or self.garrison_id == nil) then
		return nil
	end
	local vFlagPos = self.capturing_flag:GetPosition()
	local iNearSqr = sqr(25)
	local oBest = nil
	local iBestDist = iNearSqr
	for oBuilding in cpu_manager.player_stats:GetBases() do
		if (oBuilding:IsValid() and not oBuilding:IsConstructionDone() and
			oBuilding:GetBlueprintID() == self.garrison_id) then
			local iDist = distance_sqr(oBuilding:GetPosition(), vFlagPos)
			if (iDist < iBestDist) then
				iBestDist = iDist
				oBest = oBuilding
			end
		end
	end
	if (oBest ~= nil) then
		return oBest:GetEntity()
	end
	local oBuilding = build_manager:FindUnfinishedBuilding(self.garrison_id)
	if (oBuilding ~= nil and distance_sqr(oBuilding:GetPosition(), vFlagPos) < iNearSqr) then
		return oBuilding
	end
	return nil
end

-- Orks/Necrons: max 1 worker — skip if another engie already on this post.
function ResourcePlan:HasOtherWorkerOnPost( oBuilding )
	if (oBuilding == nil or self.builder == nil) then
		return false
	end
	if (EngineerTactic.GetMaxWorkers("build") > 1) then
		return false
	end
	local vBuildPos = oBuilding:GetPosition()
	local iMyId = self.builder:GetID()
	for oSquad in military_manager:GetSquads() do
		if (oSquad:IsValid() and oSquad:IsEngineer() and oSquad:GetID() ~= iMyId) then
			if (oSquad:IsBuilding() == self.garrison_id and
				distance_sqr(oSquad:GetPosition(), vBuildPos) < sqr(30)) then
				return true
			end
			if (oSquad:IsBuildProgressing() and
				distance_sqr(oSquad:GetPosition(), vBuildPos) < sqr(20)) then
				return true
			end
		end
	end
	return false
end

function ResourcePlan:BuildingListeningPost()

	aitrace("ResourcePlan: BuildingListeningPost...")
	if (self.builder == nil or self.capturing_flag == nil) then
		return
	end
	
	-- Check if builder is building
	if (self.builder:IsBuilding() == 0) then
		
		if (not self.is_building) then
			Plan.SetState( self, "Trying to build listening post", ResourcePlan.BuildPost )
			return
		end
	else
	
		--tag that we started building
		self.is_building = true
	end
	
	local vFlagPos = self.capturing_flag:GetPosition()
	-- Must be THIS flag's post — FindUnfinishedBuilding() alone returns any LP and double-stacks engies
	local oBuilding = self:FindUnfinishedPostAtFlag()
	if (oBuilding ~= nil and distance_sqr(self.builder:GetPosition(), vFlagPos) > sqr(40) and
		cpu_manager:JumpBuilder(self.builder, vFlagPos)) then
		return
	end
	
	-- Check if builder is building
	if (self.builder:IsBuilding() == 0) then
	
		-- Check for building at our flag only
		if (oBuilding ~= nil) then

			if (self:HasOtherWorkerOnPost(oBuilding)) then
				-- Another gretchin/scarab already finishing — do not pile on
				return
			end
		
			-- Check for auto-construct buildings
			if (cpu_manager:AutoConstructBuildings()) then
			
				-- Get building AI
				local oBuildingAI = military_manager:GetBaseFromID(oBuilding:GetID())
				-- Only tap brand-new shells; HP>=0.15 already kicked off / auto-building
				if (oBuildingAI ~= nil and oBuildingAI:GetHealthPercentage() <= 0.2) then
					self.builder:DoFinishBuilding(oBuilding)
					return
				end
			else
				self.builder:DoFinishBuilding(oBuilding)
				return
			end
		end
		
		-- Job finished (no unfinished post left at this flag)
		aitrace("ResourcePlan: Job finished!!!")
		self.capturing_flag:TagFlagForEngineer( false )
		self:FreeResources()
		if (g_iGMT > DefendChokePointPlan.HarassingTime * 10) then
			self:SetComplete( true )
		else
			Plan.SetState( self, "Build another listening post", ResourcePlan.FindFlag )
			Plan.SetNeeds( self, "Obtain Flag and Builder", ResourcePlan.ObtainFlagAndBuilder )
		end
	end
end

function ResourcePlan:FindFlag()

	if( self.capturing_flag == nil ) then
		return
	end
	
	self:OnEvent( Plan.Events.OnPlanStart )
	
	Plan.SetState( self, "Starting to build post", ResourcePlan.BuildPost )
end

function ResourcePlan:FreeResources()

	-- Check builder
	if (self.builder ~= nil) then
		self:UnlockResource(self.builder)
		self.builder = nil
	end

	-- Check capturing flag
	if (self.capturing_flag ~= nil) then
		self:UnlockResource(self.capturing_flag)
		self.capturing_flag = nil	
	end
end

function ResourcePlan:Update()

	if (self:IsComplete()) then
		return
	end
	
	AITrace.Log("Resource.Noise", "ResourcePlan: Update...")
	
	-- Check if builder is valid
	if (self.builder ~= nil and not self.builder:IsValid()) then
		self:FreeResources()
		if (g_iGMT > DefendChokePointPlan.HarassingTime * 10) then
			self:SetComplete( true )
		else
			Plan.SetState( self, "Find Flag", ResourcePlan.FindFlag )
			Plan.SetNeeds( self, "Obtain Flag and Builder", ResourcePlan.ObtainFlagAndBuilder )
		end
		return
	end
	
	-- LP under fire: stay building. Abort only critical HP / melee overrun (dance is EngineerTactic).
	if (self.builder ~= nil) then
		local fHP = self.builder:GetHealthPercentage()
		local oTactic = self.builder:GetTactic()
		local bCritical = (fHP ~= nil and fHP < 0.2)
		local bOverrunMelee = false
		if (oTactic ~= nil and oTactic.ShouldAbandonWork ~= nil and oTactic:ShouldAbandonWork()) then
			bOverrunMelee = true
		end
		if (bCritical or bOverrunMelee) then
			if (oTactic ~= nil) then
				if (oTactic.ClearWorkFlags ~= nil) then
					oTactic:ClearWorkFlags()
				end
				if (oTactic.TryWorkerRefuge ~= nil) then
					oTactic:UpdateStance()
					oTactic:TryWorkerRefuge()
				end
			end
			self:FreeResources()
			if (g_iGMT > DefendChokePointPlan.HarassingTime * 10) then
				self:SetComplete( true )
			else
				Plan.SetState( self, "Find Flag", ResourcePlan.FindFlag )
				Plan.SetNeeds( self, "Obtain Flag and Builder", ResourcePlan.ObtainFlagAndBuilder )
			end
			return
		end
	end
	
	-- Contested flag: keep building under ranged fire; drop only if not on job + crushing + melee
	if (self.capturing_flag ~= nil and self.builder ~= nil) then
		local vFlagPos = self.capturing_flag:GetPosition()
		if (cpu_manager:CloseEnemyUnits(vFlagPos, 35) and cpu_manager.terrain_analyzer:HasThreat(vFlagPos, 35)) then
			local iEnemyStrength, iAlliedStrength = cpu_manager:GetArmyStrengthAtPos(vFlagPos, 35)
			local bBuilding = (self.builder:IsBuilding() ~= 0 or self.builder:IsBuildProgressing())
			local oMelee = cpu_manager.cpu_player:FindFirstEnemy(self.builder:GetPosition(), 22, 1)
			local bMelee = (oMelee ~= nil and not oMelee:IsRanged())
			if (not bBuilding and iEnemyStrength > iAlliedStrength * 1.5 and bMelee) then
				local oTactic = self.builder:GetTactic()
				if (oTactic ~= nil and oTactic.TryWorkerRefuge ~= nil) then
					oTactic:UpdateStance()
					oTactic:TryWorkerRefuge()
				end
				self:FreeResources()
				if (g_iGMT > DefendChokePointPlan.HarassingTime * 10) then
					self:SetComplete( true )
				else
					Plan.SetState( self, "Find Flag", ResourcePlan.FindFlag )
					Plan.SetNeeds( self, "Obtain Flag and Builder", ResourcePlan.ObtainFlagAndBuilder )
				end
				return
			end
		end
	end
	
	Plan.Update(self)
end
