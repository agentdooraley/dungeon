class 'CapturePlan' (Plan)

CapturePlan.Maximums = 
{
	points = INT_MAX,
	objectives = INT_MAX
}

CapturePlan.OrderedStratPoints = {}
CapturePlan.StratPoints = {}
CapturePlan.LastStratUpdate = 0
-- Fingerprint of living enemies — rebuild OrderedStratPoints when someone dies
CapturePlan.LivingEnemyKey = nil
CapturePlan.GuardRange = 45
CapturePlan.MaxGuards = 3
CapturePlan.EscortGuards = 2
-- After abort: do not re-assign the same point for a while (stops retreat↔recapture jitter)
CapturePlan.AbortCooldowns = {}
CapturePlan.AbortCooldownTime = 12
CapturePlan.AbortSearchDelay = 8
CapturePlan.CaptureOrderThrottle = 2.5
-- Enemy / non-homeside: rarer DoDefault (no hurt-flicker thrash)
CapturePlan.EnemyPointCaptureOrderThrottle = 2
CapturePlan.FightBackClearDelay = 1.5
-- After DoDefault starts capture: ignore soft aborts briefly (engine lag / lingering hurt)
CapturePlan.CaptureCommitGrace = 6
CapturePlan.MinProgressToCommit = 0.05
-- Finish-vs-threat: progress tiers (see ShouldFinishCaptureDespiteThreat) — all game
CapturePlan.MinProgressToFinishVsThreat = 0.85
CapturePlan.FinishCaptureHighProgress = 0.95
-- Non-homeside contested: army ratios at flag (no WasRecentlyHurt)
-- ≥1.2× → stay and clear; ≥2× (or empty) → may DoDefault capture
CapturePlan.EnemyPointArmyRange = 30
CapturePlan.EnemyPointClearRatio = 1.2
CapturePlan.EnemyPointCaptureRatio = 2.0
-- T1 soft/harass approach: local bubble abort (before HQ addon / not overflow)
CapturePlan.T1SoloThreatRange = 30
CapturePlan.T1SoloThreatRatio = 1.2
-- King of the Hill / Take&Hold victory countdown (g_iGMT ≈ seconds)
CapturePlan.TakeAndHoldVictoryDuration = 300
CapturePlan.TakeAndHoldLockRemainTime = 60
-- Last 2 minutes: must stay on victory SP (no peel / AvoidDeath)
CapturePlan.TakeAndHoldUrgentRemainTime = 120
-- Homeside-secure phase (must be declared with other class statics)
CapturePlan.HomeSideSecureCacheGMT = -1
CapturePlan.HomeSideSecureCache = false
-- Soft preferred for empty points only if not much farther than army (~1.5x)
CapturePlan.SoftPreferDistSqrFactor = 2.25
-- Don't re-DoMove while already walking to flag (repath spam = backtrack / "escort" wander)
CapturePlan.ApproachDriftFactor = 1.35
CapturePlan.ApproachDriftPadSqr = 625
-- Flag empty/threat/contested — one strength scan per flag per GMT
CapturePlan.FlagScanCache = {}
-- CapturingFlag / CaptureFlag: heavy outmatch / force / clear-then cadence
CapturePlan.CapThreatCheckInterval = 1.25
-- Empty SP soft list TTL (GMT)
CapturePlan.EmptySPCacheTTL = 2
-- Escort refresh when no guards and not guarding
CapturePlan.GuardIdleInterval = 1.25

function CapturePlan:DbgSquad(oSquad)

	if (oSquad == nil or not oSquad:IsValid()) then
		return "nil"
	end
	return "id="..tostring(oSquad:GetID()).." "..tostring(oSquad:GetSquadName()).." @"..vec2str(oSquad:GetPosition())
end

function CapturePlan:DbgFlag(oFlag)

	if (oFlag == nil) then
		return "nil"
	end
	local sKind = "SP"
	if (oFlag:IsRelic()) then
		sKind = "relic"
	elseif (oFlag:IsStrategicObjective()) then
		sKind = "crit"
	end
	local sHome = "off"
	if (self:IsRegularHomeSidePoint(oFlag)) then
		sHome = "homeSP"
	elseif (self:IsHomeSideRelic(oFlag)) then
		sHome = "homeRelic"
	end
	return sKind.."/"..sHome.." own="..tostring(oFlag:Owner()).." @"..vec2str(oFlag:GetPosition())
end

-- Re-DoMove every throttle tick restarts pathing → backtrack / "escort wander".
-- Refresh only when idle/stopped, or drifted farther from the flag.
function CapturePlan:ShouldReissueApproachMove(oSquad, vFlagPos)

	if (oSquad == nil or not oSquad:IsValid() or vFlagPos == nil) then
		return true
	end
	local iDist = distance_sqr(oSquad:GetPosition(), vFlagPos)
	local bMoving = (oSquad:IsInStateMove() or oSquad:IsInStateAttackMove())
	if (not bMoving and not oSquad:IsCapturing()) then
		self.m_iLastApproachDistSqr = iDist
		return true
	end
	if (self.m_iLastApproachDistSqr ~= nil and
		iDist > self.m_iLastApproachDistSqr * CapturePlan.ApproachDriftFactor + CapturePlan.ApproachDriftPadSqr) then
		AITrace.Log("Capture.Order", "APPROACH refresh — drifted "..tostring(self.m_iLastApproachDistSqr).." -> "..tostring(iDist))
		self.m_iLastApproachDistSqr = iDist
		return true
	end
	if (self.m_iLastApproachDistSqr == nil or iDist < self.m_iLastApproachDistSqr) then
		self.m_iLastApproachDistSqr = iDist
	end
	return false
end

function CapturePlan:HasAlliedPlayers()

	for oPlayer in cpu_manager.stats:GetPlayerStats() do
		if (oPlayer:GetPlayerID() ~= cpu_manager.player_id and not oPlayer:IsPlayerDead() and
			not cpu_manager.player_stats:IsEnemy(oPlayer)) then
			return true
		end
	end
	return false
end

function CapturePlan:GetDistanceToClosestEnemy(vPos)

	local iBestDist = nil
	for oPlayer in cpu_manager.stats:GetPlayerStats() do
		if (oPlayer:GetPlayerID() ~= cpu_manager.player_id and not oPlayer:IsPlayerDead() and
			cpu_manager.player_stats:IsEnemy(oPlayer)) then
			local iDist = cpu_manager:GetShortestPathingDistance(oPlayer:GetStartingPosition(), vPos, false)
			if (iBestDist == nil or iDist < iBestDist) then
				iBestDist = iDist
			end
		end
	end
	return iBestDist
end

function CapturePlan:IsSameStrategicPoint(oA, oB)

	if (oA == nil or oB == nil) then
		return false
	end
	return distance_sqr(oA:GetPosition(), oB:GetPosition()) < sqr(5)
end

function CapturePlan:IsHomeSideRelic(oStrategicPoint)

	if (not oStrategicPoint:IsRelic()) then
		return false
	end
	local vPos = oStrategicPoint:GetPosition()
	local iDistMy = cpu_manager:GetShortestPathingDistance(cpu_manager.start_pos, vPos, false)
	local iDistEnemy = self:GetDistanceToClosestEnemy(vPos)
	if (iDistEnemy == nil) then
		return true
	end
	return iDistMy < iDistEnemy
end

function CapturePlan:IsRelicOwnedByAlly(oStrategicPoint)

	local iOwner = oStrategicPoint:Owner()
	return (cpu_manager:IsFriendly(iOwner) and iOwner ~= cpu_manager.player_id)
end

function CapturePlan:WeOwnHomeSideRelic()

	for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
		if (oStrategicPoint:Owner() == cpu_manager.player_id and self:IsHomeSideRelic(oStrategicPoint)) then
			return true
		end
	end
	return false
end

-- True while homeside relic exists and is not friendly-owned (take before victory crits)
function CapturePlan:NeedsHomeSideRelicBeforeCrit()

	for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
		if (self:IsHomeSideRelic(oStrategicPoint) and
			not cpu_manager:IsFriendly(oStrategicPoint:Owner())) then
			return true
		end
	end
	return false
end

-- Sort key: regular homeside → homeside relic → mid SP → other relic → victory crit
-- Urgent T&H (<2 min): victory crit first (decap before anything else)
function CapturePlan:GetCapturePriorityRank(oStrategicPoint)

	if (oStrategicPoint == nil) then
		return 99
	end
	local bCrit = (oStrategicPoint:IsStrategicObjective() and not oStrategicPoint:IsRelic())
	if (bCrit and self:IsTakeAndHoldUrgent()) then
		return -1
	end
	if (self:IsRegularHomeSidePoint(oStrategicPoint)) then
		return 0
	end
	if (self:IsHomeSideRelic(oStrategicPoint)) then
		return 1
	end
	if (bCrit) then
		return 4
	end
	if (oStrategicPoint:IsRelic()) then
		return 3
	end
	return 2
end

function CapturePlan:GetHomeSideRelicsSorted()

	local aRelics = {}
	for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
		if (self:IsHomeSideRelic(oStrategicPoint)) then
			local iDistMy = cpu_manager:GetShortestPathingDistance(cpu_manager.start_pos, oStrategicPoint:GetPosition(), false)
			table.insert(aRelics, { oStrategicPoint, iDistMy })
		end
	end
	if (table.getn(aRelics) > 1) then
		table.sort(aRelics, function(oItem1, oItem2)
			return oItem1[2] < oItem2[2]
		end)
	end
	return aRelics
end

function CapturePlan:GetTargetHomeSideRelic()

	if (not self:HasAlliedPlayers()) then
		return nil
	end
	if (self:WeOwnHomeSideRelic()) then
		return nil
	end

	local aRelics = self:GetHomeSideRelicsSorted()
	if (table.getn(aRelics) < 1) then
		return nil
	end

	if (not self:IsRelicOwnedByAlly(aRelics[1][1])) then
		return aRelics[1][1]
	end
	if (table.getn(aRelics) >= 2) then
		return aRelics[2][1]
	end
	return nil
end

function CapturePlan:ShouldSkipRelicForAllies(oStrategicPoint)

	return false
--[[	if (not self:HasAlliedPlayers() or not oStrategicPoint:IsRelic()) then
		return false
	end
	if (not self:IsHomeSideRelic(oStrategicPoint)) then
		return true
	end
	if (self:WeOwnHomeSideRelic() and oStrategicPoint:Owner() ~= cpu_manager.player_id) then
		return true
	end

	local oTarget = self:GetTargetHomeSideRelic()
	if (oTarget == nil) then
		return true
	end
	return not self:IsSameStrategicPoint(oStrategicPoint, oTarget)]]
end

function CapturePlan:IsHomeSidePoint(oStrategicPoint)

	if (oStrategicPoint == nil) then
		return false
	end
	local vPos = oStrategicPoint:GetPosition()
	local iDistMy = cpu_manager:GetShortestPathingDistance(cpu_manager.start_pos, vPos, false)
	local iDistEnemy = self:GetDistanceToClosestEnemy(vPos)
	if (iDistEnemy == nil) then
		return true
	end
	return iDistMy < iDistEnemy
end

-- Income SP on our side (not relic, not Take&Hold victory / crit)
function CapturePlan:IsRegularHomeSidePoint(oStrategicPoint)

	if (oStrategicPoint == nil or oStrategicPoint:IsRelic() or oStrategicPoint:IsStrategicObjective()) then
		return false
	end
	return self:IsHomeSidePoint(oStrategicPoint)
end

-- Secure-phase set: ALL regular homeside income SP + homeside relics (not T&H crits)
function CapturePlan:IsHomeSideSecureTarget(oStrategicPoint)

	if (oStrategicPoint == nil) then
		return false
	end
	if (self:IsRegularHomeSidePoint(oStrategicPoint)) then
		return true
	end
	return self:IsHomeSideRelic(oStrategicPoint)
end

-- True while any homeside income SP or homeside relic is not friendly-owned.
-- Includes ALL regular homeside + homeside relics; excludes T&H victory crits.
function CapturePlan:NeedsHomeSideSecurePhase()

	if (CapturePlan.HomeSideSecureCacheGMT == g_iGMT) then
		return CapturePlan.HomeSideSecureCache
	end
	CapturePlan.HomeSideSecureCacheGMT = g_iGMT
	local bNeeds = false
	for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
		if (self:IsHomeSideSecureTarget(oStrategicPoint) and
			not cpu_manager:IsFriendly(oStrategicPoint:Owner())) then
			bNeeds = true
			break
		end
	end
	CapturePlan.HomeSideSecureCache = bNeeds
	return bNeeds
end

function CapturePlan:AllOtherRegularHomeSidesOwned(oExcept)

	for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
		if (self:IsHomeSideSecureTarget(oStrategicPoint) and
			not self:IsSameStrategicPoint(oStrategicPoint, oExcept) and
			not cpu_manager:IsFriendly(oStrategicPoint:Owner())) then
			return false
		end
	end
	return true
end

-- Per-flag GMT cache for empty / threat / contested (shared strength @45)
function CapturePlan:GetFlagScanEntry(oFlag)

	if (oFlag == nil) then
		return nil
	end
	local iFid = oFlag:GetID()
	if (iFid == nil) then
		return nil
	end
	local sKey = tostring(cpu_manager.player_id).."_"..tostring(iFid)
	local aEntry = CapturePlan.FlagScanCache[sKey]
	if (aEntry ~= nil and aEntry.gmt == g_iGMT) then
		return aEntry
	end
	aEntry = { gmt = g_iGMT }
	CapturePlan.FlagScanCache[sKey] = aEntry
	return aEntry
end

function CapturePlan:GetCachedFlagEnemyAt45(oFlag)

	local aEntry = CapturePlan:GetFlagScanEntry(oFlag)
	if (aEntry ~= nil and aEntry.enemyAt45 ~= nil) then
		return aEntry.enemyAt45
	end
	local iRange = CapturePlan.GuardRange
	if (iRange == nil) then
		iRange = 45
	end
	local vPos = oFlag:GetPosition()
	local iEnemy = 0
	if (vPos ~= nil) then
		iEnemy = cpu_manager:GetArmyStrengthAtPos(vPos, iRange, true)
		if (iEnemy == nil) then
			iEnemy = 0
		end
	end
	if (aEntry ~= nil) then
		aEntry.enemyAt45 = iEnemy
	end
	return iEnemy
end

-- Contested = LP / massed troops (not bare enemy ownership — empty decap must re-cap)
function CapturePlan:IsContestedHomeSidePoint(oStrategicPoint)

	if (oStrategicPoint == nil) then
		return false
	end
	local aEntry = CapturePlan:GetFlagScanEntry(oStrategicPoint)
	if (aEntry ~= nil and aEntry.contested ~= nil) then
		return aEntry.contested
	end
	local bContested = false
	if (self:HasBlockingEnemyPost(oStrategicPoint)) then
		bContested = true
	else
		bContested = (CapturePlan:GetCachedFlagEnemyAt45(oStrategicPoint) > 150)
	end
	if (aEntry ~= nil) then
		aEntry.contested = bContested
	end
	return bContested
end

function CapturePlan:HasFreeHomeSideSecureTarget()

	for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
		if (self:IsHomeSideSecureTarget(oStrategicPoint) and
			not cpu_manager:IsFriendly(oStrategicPoint:Owner()) and
			not self:IsContestedHomeSidePoint(oStrategicPoint)) then
			return true
		end
	end
	return false
end

function CapturePlan:IsVictoryCritPoint(oStrategicPoint)

	if (oStrategicPoint == nil) then
		return false
	end
	return (oStrategicPoint:IsStrategicObjective() and not oStrategicPoint:IsRelic())
end

-- Enemy army at our homeside point > entire friendly army → no sense fighting it
function CapturePlan:IsHomeSideOverwhelmedByEnemyArmy(oStrategicPoint)

	if (oStrategicPoint == nil or not self:IsHomeSideSecureTarget(oStrategicPoint)) then
		return false
	end
	if (cpu_manager:IsFriendly(oStrategicPoint:Owner())) then
		return false
	end
	local iMyArmy = cpu_manager:GetArmyStrength()
	if (iMyArmy == nil) then
		iMyArmy = 0
	end
	local iEnemy = cpu_manager:GetArmyStrengthAtPos(oStrategicPoint:GetPosition(), 50, true)
	if (iEnemy == nil) then
		iEnemy = 0
	end
	return (iEnemy > iMyArmy)
end

function CapturePlan:ShouldRedirectFromOverwhelmedHomeSide()

	if (not self:NeedsHomeSideSecurePhase()) then
		return false
	end
	for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
		if (self:IsHomeSideOverwhelmedByEnemyArmy(oStrategicPoint)) then
			return true
		end
	end
	return false
end

-- Enemy-side non-crit homeside (closer to enemy start than ours)
function CapturePlan:IsEnemyNonCritHomeSidePoint(oStrategicPoint)

	if (oStrategicPoint == nil) then
		return false
	end
	if (self:IsVictoryCritPoint(oStrategicPoint)) then
		return false
	end
	if (self:IsHomeSideSecureTarget(oStrategicPoint)) then
		return false
	end
	if (cpu_manager:IsFriendly(oStrategicPoint:Owner())) then
		return false
	end
	local vPos = oStrategicPoint:GetPosition()
	local iDistMy = cpu_manager:GetShortestPathingDistance(cpu_manager.start_pos, vPos, false)
	local oEnemy = cpu_manager:FindClosestEnemyPlayer()
	if (oEnemy == nil) then
		return false
	end
	local iDistEnemy = cpu_manager:GetShortestPathingDistance(oEnemy:GetStartingPosition(), vPos, false)
	if (iDistMy == nil or iDistEnemy == nil) then
		return false
	end
	return (iDistEnemy < iDistMy)
end

-- Nearest to OUR start_pos among enemy non-crit homeside where OUR WHOLE army would beat local enemy
function CapturePlan:FindEnemyNonCritHomeSidePoint(vFrom, iMaxDist)

	local vAnchor = cpu_manager.start_pos
	if (vAnchor == nil) then
		vAnchor = vFrom
	end
	if (vAnchor == nil) then
		return nil
	end
	if (iMaxDist == nil) then
		iMaxDist = 400
	end

	local iMyArmy = cpu_manager:GetArmyStrength()
	if (iMyArmy == nil) then
		iMyArmy = 0
	end

	local oBest = nil
	local iBestDist = nil
	local oBestAny = nil
	local iBestAnyDist = nil
	local iBestAnyEnemy = nil

	for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
		if (self:IsEnemyNonCritHomeSidePoint(oStrategicPoint)) then
			local vPos = oStrategicPoint:GetPosition()
			-- Distance from our start_pos (swap homeside → closest usable fight)
			local iDist = cpu_manager:GetShortestPathingDistance(vAnchor, vPos, true)
			if (iDist ~= nil and iDist > 0 and iDist < iMaxDist) then
				local iEnemy = cpu_manager:GetArmyStrengthAtPos(vPos, 50, true)
				if (iEnemy == nil) then
					iEnemy = 0
				end
				-- If we march the whole army there, would we be stronger?
				if (iMyArmy > iEnemy) then
					if (oBest == nil or iDist < iBestDist) then
						oBest = oStrategicPoint
						iBestDist = iDist
					end
				else
					-- Fallback: least defended, then closest (still leave HQ AFK)
					if (oBestAny == nil or iEnemy < iBestAnyEnemy or
						(iEnemy == iBestAnyEnemy and iDist < iBestAnyDist)) then
						oBestAny = oStrategicPoint
						iBestAnyDist = iDist
						iBestAnyEnemy = iEnemy
					end
				end
			end
		end
	end

	if (oBest ~= nil) then
		return Vector3f(oBest:GetPosition())
	end
	if (oBestAny ~= nil) then
		return Vector3f(oBestAny:GetPosition())
	end
	return nil
end

-- Choke/harass: only redirect when our homeside is hopeless vs whole army
function CapturePlan:FindAdvantagePushPoint(vFrom, iMaxDist)

	if (not self:ShouldRedirectFromOverwhelmedHomeSide()) then
		return nil
	end
	return self:FindEnemyNonCritHomeSidePoint(vFrom, iMaxDist)
end


-- During secure phase: free homeside/relic OK; contested after free done (or if none free left)
function CapturePlan:CanCaptureDuringHomeSideSecure(oStrategicPoint)

	if (not self:IsHomeSideSecureTarget(oStrategicPoint)) then
		return false
	end
	if (cpu_manager:IsFriendly(oStrategicPoint:Owner())) then
		return false
	end
	-- Whole-army outgunned at this homeside: leave it, push enemy homeside instead
	if (self:IsHomeSideOverwhelmedByEnemyArmy(oStrategicPoint)) then
		return false
	end
	if (not self:IsContestedHomeSidePoint(oStrategicPoint)) then
		return true
	end
	if (self:AllOtherRegularHomeSidesOwned(oStrategicPoint)) then
		return true
	end
	-- Multi-decap all contested: still allow (sort prefers quieter first)
	return not self:HasFreeHomeSideSecureTarget()
end

function CapturePlan:HasArmyMassForHomeSidePush(vPos)

	local iEnemy, iAllied = cpu_manager:GetArmyStrengthAtPos(vPos, 50, true)
	if (iEnemy <= 0) then
		return true
	end
	return (iAllied >= iEnemy * 1.15) or (iAllied >= math.min(500, cpu_manager:GetArmyStrength() * 0.6))
end

-- Take&Hold: enemy owns > half victory SPs long enough → emergency / urgent window
function CapturePlan:IsTakeAndHoldEmergency()

	return self:IsTakeAndHoldUrgent()
end

-- Seconds left on enemy T&H victory countdown (nil if not ticking).
-- Uses CriticalTimer even if SCAR mode flag lagging — otherwise MustStay never arms.
function CapturePlan:GetTakeAndHoldTimeRemaining()

	if (cpu_manager.m_iCriticalTimer == nil or cpu_manager.m_iCriticalTimer <= 0) then
		return nil
	end
	local iLeft = CapturePlan.TakeAndHoldVictoryDuration - (g_iGMT - cpu_manager.m_iCriticalTimer)
	if (iLeft == nil or iLeft <= 0) then
		return nil
	end
	return iLeft
end

function CapturePlan:IsTakeAndHoldCountdownActive()

	return (self:GetTakeAndHoldTimeRemaining() ~= nil)
end

-- ≤2 minutes left on victory countdown
function CapturePlan:IsTakeAndHoldUrgent()

	local iLeft = self:GetTakeAndHoldTimeRemaining()
	local iUrgent = CapturePlan.TakeAndHoldUrgentRemainTime
	if (iUrgent == nil) then
		iUrgent = 120
	end
	return (iLeft ~= nil and iLeft <= iUrgent)
end

-- Alias used by abort / MustStay (last 2 min)
function CapturePlan:IsTakeAndHoldFinalMinute()

	return self:IsTakeAndHoldUrgent()
end

-- Urgent T&H: stay on victory SP — no CapturePlan abort / peel off the flag
-- oFlag optional: class-call safe (SoftTryCapture etc. pass the point)
function CapturePlan:MustStayOnVictoryPoint(oFlag)

	if (not self:IsTakeAndHoldVictoryCapture(oFlag)) then
		return false
	end
	return self:IsTakeAndHoldUrgent()
end

-- Enemy/neutral victory SP still exists (need to contest / decap)
function CapturePlan:HasUnownedVictoryPoint()

	for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
		if (self:IsVictoryStrategicPoint(oStrategicPoint) and
			not cpu_manager:IsFriendly(oStrategicPoint:Owner())) then
			return true
		end
	end
	return false
end

-- <2 min T&H: drop non-VP caps so capturers retarget victory
function CapturePlan:ShouldYieldForUrgentVictory()

	if (not self:IsTakeAndHoldUrgent()) then
		return false
	end
	if (not self:HasUnownedVictoryPoint()) then
		return false
	end
	if (self:IsTakeAndHoldVictoryCapture()) then
		return false
	end
	return (self.capturing_flag ~= nil)
end

-- True if flag is a T&H victory SP (not relic)
function CapturePlan:IsVictoryStrategicPoint(oFlag)

	if (oFlag == nil) then
		return false
	end
	return (oFlag:IsStrategicObjective() and not oFlag:IsRelic())
end

-- Squad / LP near the flag (strength only — HasThreat/FindFirst are noisy + duplicate)
function CapturePlan:HasPointThreat(oFlag)

	if (oFlag == nil) then
		return false
	end
	local aEntry = CapturePlan:GetFlagScanEntry(oFlag)
	if (aEntry ~= nil and aEntry.threat ~= nil) then
		return aEntry.threat
	end
	local bThreat = false
	if (self:HasBlockingEnemyPost(oFlag)) then
		bThreat = true
	else
		bThreat = (CapturePlan:GetCachedFlagEnemyAt45(oFlag) > 0)
	end
	if (aEntry ~= nil) then
		aEntry.threat = bThreat
	end
	return bThreat
end

-- Soft pack: real enemy troops / LP only (ignore noisy threat map).
-- Safe as class call (HasSafeEmptyCaptureTarget) — no instance fields.
function CapturePlan:IsEmptyOfEnemyArmy(oFlag)

	if (oFlag == nil) then
		return false
	end
	local aEntry = CapturePlan:GetFlagScanEntry(oFlag)
	if (aEntry ~= nil and aEntry.empty ~= nil) then
		return aEntry.empty
	end
	local bEmpty = false
	if (not CapturePlan.HasBlockingEnemyPost(CapturePlan, oFlag)) then
		bEmpty = (CapturePlan:GetCachedFlagEnemyAt45(oFlag) <= 0)
	end
	if (aEntry ~= nil) then
		aEntry.empty = bEmpty
	end
	return bEmpty
end

-- Enemy army strength at flag (for contest gates)
function CapturePlan:GetEnemyArmyAtPoint(oFlag)

	if (oFlag == nil) then
		return 0
	end
	local vPos = oFlag:GetPosition()
	if (vPos == nil) then
		return 0
	end
	local iRange = CapturePlan.GuardRange
	if (iRange == nil) then
		iRange = 45
	end
	local iEnemy = cpu_manager:GetArmyStrengthAtPos(vPos, iRange, true)
	if (iEnemy == nil) then
		return 0
	end
	return iEnemy
end

-- Army strengths at flag (default: enemy-point contest range 30)
function CapturePlan:GetPointArmyStrengths(oFlag, iRange)

	if (oFlag == nil) then
		return 0, 0
	end
	local vPos = oFlag:GetPosition()
	if (vPos == nil) then
		return 0, 0
	end
	if (iRange == nil) then
		iRange = CapturePlan.EnemyPointArmyRange
	end
	if (iRange == nil) then
		iRange = 30
	end
	local iEnemy, iAllied = cpu_manager:GetArmyStrengthAtPos(vPos, iRange, true)
	if (iEnemy == nil) then
		iEnemy = 0
	end
	if (iAllied == nil) then
		iAllied = 0
	end
	return iEnemy, iAllied
end

-- Crit / mid / enemy homeside — not our secure homeside expand
function CapturePlan:IsEnemySideCapturePoint(oFlag)

	if (oFlag == nil) then
		return false
	end
	return (not self:IsHomeSidePoint(oFlag))
end

-- Non-homeside: may start / keep DoDefault only if empty or allied ≥ 2× enemy @30
function CapturePlan:CanCaptureEnemySidePoint(oFlag)

	if (oFlag == nil) then
		return false
	end
	if (self:HasBlockingEnemyPost(oFlag)) then
		return false
	end
	local iEnemy, iAllied = self:GetEnemySideForceAtPoint(oFlag, self.capturing_squad)
	if (iEnemy <= 0) then
		return true
	end
	local fNeed = CapturePlan.EnemyPointCaptureRatio
	if (fNeed == nil) then
		fNeed = 2.0
	end
	return (iAllied >= iEnemy * fNeed)
end

-- Allied force at flag @30, plus capturer strength when still approaching
function CapturePlan:GetEnemySideForceAtPoint(oFlag, oSquad)

	local iEnemy, iAllied = self:GetPointArmyStrengths(oFlag, CapturePlan.EnemyPointArmyRange)
	if (oFlag == nil) then
		return iEnemy, iAllied
	end
	local vPos = oFlag:GetPosition()
	local iRange = CapturePlan.EnemyPointArmyRange
	if (iRange == nil) then
		iRange = 30
	end
	if (oSquad ~= nil and oSquad:IsValid() and vPos ~= nil) then
		local iSquadStr = 0
		local oTactic = oSquad:GetTactic()
		if (oTactic ~= nil) then
			iSquadStr = oTactic:GetUnitStrength()
		end
		if (distance_sqr(oSquad:GetPosition(), vPos) > sqr(iRange)) then
			iAllied = iAllied + iSquadStr
		elseif (iAllied < iSquadStr) then
			iAllied = iSquadStr
		end
	end
	return iEnemy, iAllied
end

-- Non-homeside: stay and clear (fight) when allied ≥ 1.2× — but do not capture yet
function CapturePlan:ShouldClearNotCaptureEnemyPoint(oFlag)

	if (oFlag == nil or not self:IsEnemySideCapturePoint(oFlag)) then
		return false
	end
	if (self:CanCaptureEnemySidePoint(oFlag)) then
		return false
	end
	local iEnemy, iAllied = self:GetEnemySideForceAtPoint(oFlag, self.capturing_squad)
	if (iEnemy <= 0 and not self:HasBlockingEnemyPost(oFlag)) then
		return false
	end
	local fClear = CapturePlan.EnemyPointClearRatio
	if (fClear == nil) then
		fClear = 1.2
	end
	-- Enough mass to clear, or still gathering (contest ≥1×) — hold capture
	return (iAllied >= iEnemy * fClear) or (iAllied >= iEnemy)
end

-- Mid-cap crit / enemy-side: dying under local fire while outmatched → peel.
-- IsEmptyOfEnemyArmy(flag) can stay true while ranged shreds the capturer outside GuardRange.
-- Does not apply to urgent T&H MustStay / ≥0.85 finish / free Slugga.
-- True while still stripping enemy ownership (decap). Neutral/ours = take phase.
-- Decap is ~2–3× faster than take — under fire: finish strip, do not stay to own.
function CapturePlan:IsEnemyOwnedCaptureFlag(oFlag)

	if (oFlag == nil) then
		return false
	end
	local iOwner = oFlag:Owner()
	if (iOwner == nil or iOwner == 0) then
		return false
	end
	return (not cpu_manager:IsFriendly(iOwner))
end

-- Bare enemy flag only: finish DECAP under fire. LP / base on flag = abort (no suicide on construction)
function CapturePlan:CanFinishFastDecapUnderFire(oFlag)

	if (not self:IsEnemyOwnedCaptureFlag(oFlag)) then
		return false
	end
	if (self:HasBlockingEnemyPost(oFlag)) then
		return false
	end
	return true
end

function CapturePlan:ShouldAbortDyingCritCapture(oSquad, oFlag, fProgress)

	if (oSquad == nil or not oSquad:IsValid() or oFlag == nil) then
		return false
	end
	if (self:MustStayOnVictoryPoint(oFlag) or
		(self:IsTakeAndHoldEmergency() and self:IsTakeAndHoldVictoryCapture(oFlag))) then
		return false
	end
	local oTac = oSquad:GetTactic()
	if (oTac ~= nil and oTac.IgnoresCaptureThreat ~= nil and oTac:IgnoresCaptureThreat()) then
		return false
	end
	-- Enemy-owned / mid / victory — not homeside income
	local bVictory = self:IsVictoryStrategicPoint(oFlag)
	local bEnemySide = self:IsEnemySideCapturePoint(oFlag)
	if (not bVictory and not bEnemySide) then
		return false
	end
	local fHP = oSquad:GetHealthPercentage()
	local bUnderFire = (oSquad:IsUnderAttack() or oSquad:WasRecentlyHurt())
	-- Broken / collapsing always peel — DECAP finish never overrides morale break
	if (oSquad:IsBroken()) then
		return true
	end
	if (bUnderFire and fHP ~= nil and fHP < 0.5) then
		return true
	end
	-- Healthy enough + high progress: finish take/decap through soft threat
	if (fProgress ~= nil and self:ShouldFinishCaptureDespiteThreat(fProgress, oSquad)) then
		return false
	end
	-- Under fire: keep only bare-flag enemy DECAP while still healthy
	if (bUnderFire) then
		if (fHP ~= nil and fHP < 0.65) then
			return true
		end
		return (not self:CanFinishFastDecapUnderFire(oFlag))
	end
	-- In combat without hurt flags: outgunned locally — same bare-decap exception
	if (not oSquad:IsInCombat()) then
		return false
	end
	local iRange = CapturePlan.T1SoloThreatRange
	if (iRange == nil) then
		iRange = 30
	end
	local iEnemy, iAllied = cpu_manager:GetArmyStrengthAtPos(oSquad:GetPosition(), iRange, true)
	if (iEnemy == nil or iEnemy <= 0) then
		return false
	end
	if (iAllied == nil) then
		iAllied = 0
	end
	if (iEnemy <= iAllied) then
		return false
	end
	if (fHP ~= nil and fHP < 0.65) then
		return true
	end
	return (not self:CanFinishFastDecapUnderFire(oFlag))
end

-- Contested point: capturer (+ allies on point) must match enemy — no lone warrior suicide
function CapturePlan:CanCapturerContestPoint(oSquad, oFlag, iSquadStr)

	if (oFlag == nil) then
		return false
	end
	local iEnemy = self:GetEnemyArmyAtPoint(oFlag)
	if (iEnemy <= 0 and not self:HasBlockingEnemyPost(oFlag)) then
		return true
	end
	if (iSquadStr == nil) then
		iSquadStr = 0
		if (oSquad ~= nil and oSquad:IsValid()) then
			local oTactic = oSquad:GetTactic()
			if (oTactic ~= nil) then
				iSquadStr = oTactic:GetUnitStrength()
			end
		end
	end
	local vPos = oFlag:GetPosition()
	local iRange = CapturePlan.GuardRange
	if (iRange == nil) then
		iRange = 45
	end
	local _, iAllied = cpu_manager:GetArmyStrengthAtPos(vPos, iRange, true)
	if (iAllied == nil) then
		iAllied = 0
	end
	-- Allied at point already counts the capturer if present; when picking remotely use squad str
	local iForce = iAllied
	if (oSquad == nil or not oSquad:IsValid() or
		distance_sqr(oSquad:GetPosition(), vPos) > sqr(iRange)) then
		iForce = iAllied + iSquadStr
	elseif (iForce < iSquadStr) then
		iForce = iSquadStr
	end
	return (iForce >= iEnemy)
end

-- Strongest capturer that can actually contest the point (skips Forced-weakest suicide)
function CapturePlan:PickContestCapturer(aList, oFlag, vStratPos)

	if (aList == nil or oFlag == nil) then
		return nil, nil
	end
	local oBest = nil
	local iBestStr = -1
	local iBestIdx = nil
	local iBestDist = nil
	for iLoop1 in aList do
		local oSquad = aList[iLoop1][1]
		if (oSquad ~= nil and oSquad:IsValid() and cpu_manager:IsFullCapturerSquad(oSquad)) then
			local oTactic = oSquad:GetTactic()
			-- Soft packs never solo contested
			if (oTactic == nil or not oTactic:IsDedicatedCapturer()) then
				local iStr = aList[iLoop1][2]
				if (iStr == nil) then
					if (oTactic ~= nil) then
						iStr = oTactic:GetUnitStrength()
					else
						iStr = 0
					end
				end
				if (self:CanCapturerContestPoint(oSquad, oFlag, iStr)) then
					local vPos = aList[iLoop1][3]
					local iDist = 0
					if (vPos ~= nil and vStratPos ~= nil) then
						iDist = distance_sqr(vPos, vStratPos)
					end
					if (oBest == nil or iStr > iBestStr or (iStr == iBestStr and iDist < iBestDist)) then
						oBest = oSquad
						iBestStr = iStr
						iBestIdx = iLoop1
						iBestDist = iDist
					end
				end
			end
		end
	end
	return oBest, iBestIdx
end

-- Empty (no enemy army) strategic points — SoftTry / HasSafeEmpty share this list.
-- Path gate: full HasThreatOnPath only 1v1 + early/T1; else cheap mid-probe.
CapturePlan.EmptySPCaches = {}
CapturePlan.EmptyMidProbeRange = 40
CapturePlan.EmptyMidProbeThreat = 150
CapturePlan.EmptyMidProbeMinDist = 70
CapturePlan.PathCheckExpensiveMaxRoles = 2
CapturePlan.PathCheckRoleCaches = {}
CapturePlan.PathCheckCorridorRange = 35
-- Full corridor path only while 1v1 and early (GMT) or still T1
CapturePlan.EmptyPathExpensiveUntilGMT = 360
-- StratPoints filter rebuild cadence (Obtain still runs; list reused between)
CapturePlan.StratPointsRebuildTTL = 2

-- 1v1 + (early or T1): expensive corridor; FFA / late → mid only
function CapturePlan:ShouldUseExpensiveEmptyPathCheck()

	local iPlayers = g_iNumPlayers
	if (iPlayers == nil or iPlayers > 2) then
		return false
	end
	local iUntil = CapturePlan.EmptyPathExpensiveUntilGMT
	if (iUntil == nil) then
		iUntil = 360
	end
	if (g_iGMT < iUntil) then
		return true
	end
	if (cpu_manager ~= nil and cpu_manager.GetTierLevel ~= nil and
		cpu_manager:GetTierLevel() <= 1) then
		return true
	end
	return false
end

-- Currently on soft/cap/harass duty (not "can capture" pool)
function CapturePlan:SquadInActivePathCheckRole(oSquad)

	if (oSquad == nil or not oSquad:IsValid()) then
		return false
	end
	local oTac = oSquad:GetTactic()
	if (oTac == nil) then
		return false
	end
	if (oSquad:IsCapturing() or oTac:IsCapturePlanMove() or oTac:IsSoftSelfCap() or
		oTac:IsSoftCapturerOnCaptureDuty()) then
		return true
	end
	if (oTac.vHarassingTargetAttack ~= nil) then
		return true
	end
	return false
end

function CapturePlan:CountActivePathCheckRoles()

	local iPid = cpu_manager.player_id
	local aCache = CapturePlan.PathCheckRoleCaches[iPid]
	if (aCache ~= nil and aCache.gmt == g_iGMT) then
		return aCache.count
	end

	local iCount = 0
	for oSquad in military_manager:GetSquads() do
		if (CapturePlan:SquadInActivePathCheckRole(oSquad)) then
			iCount = iCount + 1
		end
	end

	CapturePlan.PathCheckRoleCaches[iPid] = { gmt = g_iGMT, count = iCount }
	return iCount
end

function CapturePlan:IsEmptyFlagMidBlocked(vFlagPos)

	local vMid = Vector3f(cpu_manager.start_pos)
	vMid.x = (cpu_manager.start_pos.x + vFlagPos.x) * 0.5
	vMid.z = (cpu_manager.start_pos.z + vFlagPos.z) * 0.5
	local iRange = CapturePlan.EmptyMidProbeRange
	if (iRange == nil) then
		iRange = 40
	end
	local iMidEnemy = cpu_manager:GetArmyStrengthAtPos(vMid, iRange, true)
	if (iMidEnemy == nil) then
		iMidEnemy = 0
	end
	local iThreat = CapturePlan.EmptyMidProbeThreat
	if (iThreat == nil) then
		iThreat = 150
	end
	return (iMidEnemy >= iThreat)
end

function CapturePlan:IsEmptyFlagPathBlocked(vFlagPos)

	if (vFlagPos == nil or cpu_manager.start_pos == nil) then
		return false
	end
	-- Homeside / near base: no choke probe
	if (cpu_manager:IsHomeSidePosition(vFlagPos)) then
		return false
	end
	local iMinDist = CapturePlan.EmptyMidProbeMinDist
	if (iMinDist == nil) then
		iMinDist = 70
	end
	if (distance_sqr(cpu_manager.start_pos, vFlagPos) <= sqr(iMinDist)) then
		return false
	end

	-- Full corridor: 1v1 + early/T1 and few active roles; else mid-probe
	if (CapturePlan:ShouldUseExpensiveEmptyPathCheck()) then
		local iMaxExpensive = CapturePlan.PathCheckExpensiveMaxRoles
		if (iMaxExpensive == nil) then
			iMaxExpensive = 2
		end
		if (CapturePlan:CountActivePathCheckRoles() <= iMaxExpensive) then
			local iPathRange = CapturePlan.PathCheckCorridorRange
			if (iPathRange == nil) then
				iPathRange = 35
			end
			return cpu_manager:HasThreatOnPath(cpu_manager.start_pos, vFlagPos, iPathRange)
		end
	end
	return CapturePlan:IsEmptyFlagMidBlocked(vFlagPos)
end

function CapturePlan:GetEmptySPCache()

	local iPid = cpu_manager.player_id
	local aCache = CapturePlan.EmptySPCaches[iPid]
	local iTTL = CapturePlan.EmptySPCacheTTL
	if (iTTL == nil) then
		iTTL = 2
	end
	if (aCache ~= nil and aCache.gmt ~= nil and (g_iGMT - aCache.gmt) < iTTL) then
		return aCache
	end

	local aList = {}
	local iN = 0
	for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
		if (oStrategicPoint ~= nil and not oStrategicPoint:IsLocked() and
			not cpu_manager:IsFriendly(oStrategicPoint:Owner()) and
			CapturePlan:IsEmptyOfEnemyArmy(oStrategicPoint) and
			not CapturePlan:IsOnAbortCooldown(oStrategicPoint:GetPosition())) then
			local vFlagPos = oStrategicPoint:GetPosition()
			if (not CapturePlan:IsEmptyFlagPathBlocked(vFlagPos)) then
				iN = iN + 1
				aList[iN] = oStrategicPoint
			end
		end
	end

	aCache = { gmt = g_iGMT, list = aList, any = (iN > 0) }
	CapturePlan.EmptySPCaches[iPid] = aCache
	return aCache
end

-- Soft pack: list of empty unlocked non-friendly points (shared per think)
function CapturePlan:GetEmptyStrategicPoints()
	return self:GetEmptySPCache().list
end

function CapturePlan:HasSafeEmptyCaptureTarget()
	return self:GetEmptySPCache().any
end

-- Soft pack only: nearest dedicated for empty points (no army at flag)
function CapturePlan:PickDedicatedCapturerForPoint(aList, vStratPos)

	if (aList == nil or vStratPos == nil) then
		return nil, nil
	end
	local oBestClear = nil
	local iBestClearDist = nil
	local iBestClearIdx = nil
	local oBestAny = nil
	local iBestAnyDist = nil
	local iBestAnyIdx = nil
	for iLoop1 in aList do
		local oSquad = aList[iLoop1][1]
		local vPos = aList[iLoop1][3]
		if (oSquad ~= nil and oSquad:IsValid() and vPos ~= nil and
			cpu_manager:IsFullCapturerSquad(oSquad) and
			not cpu_manager:IsNecronScarabPendingPost(oSquad)) then
			local oTactic = oSquad:GetTactic()
			if (oTactic ~= nil and oTactic:IsDedicatedCapturer()) then
				local iDist = distance_sqr(vPos, vStratPos)
				if (oBestAny == nil or iDist < iBestAnyDist) then
					oBestAny = oSquad
					iBestAnyDist = iDist
					iBestAnyIdx = iLoop1
				end
				if (not cpu_manager:HasThreatOnPath(vPos, vStratPos, 30)) then
					if (oBestClear == nil or iDist < iBestClearDist) then
						oBestClear = oSquad
						iBestClearDist = iDist
						iBestClearIdx = iLoop1
					end
				end
			end
		end
	end
	if (oBestClear ~= nil) then
		return oBestClear, iBestClearIdx
	end
	return oBestAny, iBestAnyIdx
end

-- aList entries: { squad, strength, pos }; returns squad, index
function CapturePlan:PickStrongestCapturer(aList)

	if (aList == nil) then
		return nil, nil
	end
	local oBest = nil
	local iBestStr = -1
	local iBestIdx = nil
	for iLoop1 in aList do
		local oSquad = aList[iLoop1][1]
		if (oSquad ~= nil and oSquad:IsValid() and cpu_manager:IsFullCapturerSquad(oSquad)) then
			local iStr = aList[iLoop1][2]
			if (iStr == nil) then
				local oTactic = oSquad:GetTactic()
				if (oTactic ~= nil) then
					iStr = oTactic:GetUnitStrength()
				else
					iStr = 0
				end
			end
			if (iStr > iBestStr) then
				oBest = oSquad
				iBestStr = iStr
				iBestIdx = iLoop1
			end
		end
	end
	return oBest, iBestIdx
end

-- Prefer clear path; fallback to closest.
-- bAllowDedicated: soft OK on clean/free points (never solo into contested).
-- Soft wins only if not much farther than army — idle warriors near homeside must cap.
function CapturePlan:PickCapturerForPoint(aList, vStratPos, bRequireClearPath, bAllowDedicated)

	if (aList == nil or vStratPos == nil) then
		return nil, nil
	end
	if (bAllowDedicated == nil) then
		bAllowDedicated = true
	end
	local fSoftPrefer = CapturePlan.SoftPreferDistSqrFactor
	if (fSoftPrefer == nil or fSoftPrefer < 1) then
		fSoftPrefer = 2.25
	end
	local oSoftClear, iSoftClearDist, iSoftClearIdx = nil, nil, nil
	local oArmyClear, iArmyClearDist, iArmyClearIdx = nil, nil, nil
	local oSoftAny, iSoftAnyDist, iSoftAnyIdx = nil, nil, nil
	local oArmyAny, iArmyAnyDist, iArmyAnyIdx = nil, nil, nil
	for iLoop1 in aList do
		local oSquad = aList[iLoop1][1]
		local vPos = aList[iLoop1][3]
		if (oSquad ~= nil and oSquad:IsValid() and vPos ~= nil and
			cpu_manager:IsFullCapturerSquad(oSquad)) then
			local oTactic = oSquad:GetTactic()
			local bDedicated = (oTactic ~= nil and oTactic:IsDedicatedCapturer())
			if (bDedicated and not bAllowDedicated) then
			else
				local iDist = distance_sqr(vPos, vStratPos)
				if (bDedicated) then
					if (oSoftAny == nil or iDist < iSoftAnyDist) then
						oSoftAny = oSquad
						iSoftAnyDist = iDist
						iSoftAnyIdx = iLoop1
					end
				else
					if (oArmyAny == nil or iDist < iArmyAnyDist) then
						oArmyAny = oSquad
						iArmyAnyDist = iDist
						iArmyAnyIdx = iLoop1
					end
				end
				if (not cpu_manager:HasThreatOnPath(vPos, vStratPos, 30)) then
					if (bDedicated) then
						if (oSoftClear == nil or iDist < iSoftClearDist) then
							oSoftClear = oSquad
							iSoftClearDist = iDist
							iSoftClearIdx = iLoop1
						end
					else
						if (oArmyClear == nil or iDist < iArmyClearDist) then
							oArmyClear = oSquad
							iArmyClearDist = iDist
							iArmyClearIdx = iLoop1
						end
					end
				end
			end
		end
	end
	local function ChooseSoftOrArmy(oSoft, iSoftD, iSoftIdx, oArmy, iArmyD, iArmyIdx)
		if (oSoft == nil) then
			return oArmy, iArmyIdx
		end
		if (oArmy == nil) then
			return oSoft, iSoftIdx
		end
		if (iSoftD <= iArmyD * fSoftPrefer) then
			return oSoft, iSoftIdx
		end
		return oArmy, iArmyIdx
	end
	if (oSoftClear ~= nil or oArmyClear ~= nil) then
		return ChooseSoftOrArmy(oSoftClear, iSoftClearDist, iSoftClearIdx,
			oArmyClear, iArmyClearDist, iArmyClearIdx)
	end
	if (bRequireClearPath) then
		return nil, nil
	end
	return ChooseSoftOrArmy(oSoftAny, iSoftAnyDist, iSoftAnyIdx,
		oArmyAny, iArmyAnyDist, iArmyAnyIdx)
end

-- Stuck CanOnlyDecap on neutral must not block real capturers (IsBeingCaptured stays true)
function CapturePlan:IsCaptureBlockingAssignment(oStrategicPoint)

	if (oStrategicPoint == nil or not oStrategicPoint:IsBeingCaptured()) then
		return false
	end
	local iOwner = oStrategicPoint:Owner()
	if (iOwner == 0 or cpu_manager:IsFriendly(iOwner)) then
		return false
	end
	return true
end

function CapturePlan:ShouldGuardCapture(oStrategicPoint)

	if (oStrategicPoint == nil or oStrategicPoint:IsRelic()) then
		return false
	end
	-- Emergency T&H victory: cover the decapper (allied >= enemy)
	if (self:IsTakeAndHoldEmergency() and oStrategicPoint:IsStrategicObjective() and
		not oStrategicPoint:IsRelic()) then
		return true
	end
	-- Secure phase: escort contested only when NO free homeside left.
	-- Otherwise idle/new capturers get yanked off parallel free caps (40s yo-yo).
	if (CapturePlan:NeedsHomeSideSecurePhase() and self:IsHomeSideSecureTarget(oStrategicPoint) and
		self:IsContestedHomeSidePoint(oStrategicPoint)) then
		return not self:HasFreeHomeSideSecureTarget()
	end
	-- Early game: every squad caps, no escorts sitting on the capturer
	if (g_iGMT < DefendChokePointPlan.HarassingTime * 60) then
		return false
	end
	-- Clear-then-capture: any threatened point needs cover before/while clearing
	if (self:HasPointThreat(oStrategicPoint)) then
		return true
	end
	-- Regular income SP only — not homeside crits (escorts sat on crit while base raided)
	return self:IsRegularHomeSidePoint(oStrategicPoint)
end

-- Homeside / HQ threat that defense should answer (raid posts, base, SP)
function CapturePlan:FindHomeDefenseThreatPos()

	if (cpu_manager:GetCriticalThreat() > 0 or cpu_manager:HQThreat()) then
		return cpu_manager.start_pos
	end
	local aThreats = cpu_manager.m_aThreatPositions
	if (aThreats == nil) then
		return nil
	end
	local vBest = nil
	local iBest = 0
	local iCount = table.getn(aThreats)
	for iLoop1 = 1, iCount do
		local vPos = aThreats[iLoop1]
		if (vPos ~= nil and cpu_manager:IsHomeSidePosition(vPos)) then
			local iEnemy = cpu_manager:GetArmyStrengthAtPos(vPos, 45, true)
			-- Same floor as ResponsePlan.MinThreatStrength (80)
			if (iEnemy ~= nil and iEnemy >= 80 and iEnemy > iBest) then
				iBest = iEnemy
				vBest = vPos
			end
		end
	end
	return vBest
end

-- DefendStrategy: Respond to raid! (mid or homeside) — active ResponsePlan.
-- FindHomeDefenseThreatPos misses mid raids → SoftTry/CapturePlan kept empty-crit suicide.
function CapturePlan:IsActiveRaidResponse()

	if (cpu_manager == nil or cpu_manager.StrategyExists == nil) then
		return false
	end
	local oDefend = cpu_manager:StrategyExists("DefendStrategy")
	if (oDefend == nil or oDefend.m_oResponsePlan == nil) then
		return false
	end
	if (oDefend.m_oResponsePlan.IsComplete ~= nil and oDefend.m_oResponsePlan:IsComplete()) then
		return false
	end
	return true
end

-- SoftTry / assign: any defense pressure that should block mid/crit expand
function CapturePlan:ShouldBlockMidCritExpand()

	if (cpu_manager:GetCriticalThreat() > 0 or cpu_manager:HQThreat()) then
		return true
	end
	if (self:IsActiveRaidResponse()) then
		return true
	end
	return (self:FindHomeDefenseThreatPos() ~= nil)
end

-- True: drop mid/crit/offside capture so Response/Defend can take unlocked squads.
-- Homeside secure targets keep capping — escorts unlock via UpdateCaptureGuards.
function CapturePlan:ShouldYieldForHomeDefense()

	-- Final minute / emergency T&H victory decap outranks a local raid
	if (self:MustStayOnVictoryPoint() or
		(self:IsTakeAndHoldEmergency() and self:IsTakeAndHoldVictoryCapture())) then
		return false
	end
	-- Necron scarab: no guns — abort→AFK at flag / missed LP; warriors handle raid
	if (self.capturing_squad ~= nil and
		cpu_manager:IsNecronBuilderScarab(self.capturing_squad)) then
		return false
	end
	-- Comment intent: crit / off-point only — finishing homeside beats yanking for a raid
	if (self.capturing_flag ~= nil and self:IsHomeSideSecureTarget(self.capturing_flag)) then
		return false
	end
	-- Bare enemy mid-decap only while healthy — broken / low HP yield to defense
	if (self.capturing_flag ~= nil and self.capturing_squad ~= nil and
		self.capturing_squad:IsValid() and self.capturing_squad:IsCapturing() and
		not self.capturing_squad:IsBroken() and
		self:CanFinishFastDecapUnderFire(self.capturing_flag)) then
		local fHP = self.capturing_squad:GetHealthPercentage()
		if (fHP == nil or fHP >= 0.65) then
			return false
		end
	end
	-- Mid Respond to raid: drop mid/crit (homeside already kept above)
	if (self:IsActiveRaidResponse()) then
		return true
	end
	local vThreat = self:FindHomeDefenseThreatPos()
	if (vThreat == nil) then
		return false
	end
	-- Threat is on our capture flag — stay and fight / finish there
	if (self.capturing_flag ~= nil) then
		if (distance_sqr(self.capturing_flag:GetPosition(), vThreat) <= sqr(60)) then
			return false
		end
	end
	return true
end

-- Decap re-secure: abort mid/offside caps so squads return to homeside
function CapturePlan:ShouldYieldForHomeSideSecure()

	if (not CapturePlan:NeedsHomeSideSecurePhase()) then
		return false
	end
	if (self:MustStayOnVictoryPoint() or
		(self:IsTakeAndHoldEmergency() and self:IsTakeAndHoldVictoryCapture())) then
		return false
	end
	if (self.capturing_flag == nil) then
		return false
	end
	-- Redirect mode: leave overwhelmed homeside; keep enemy non-crit homeside
	if (self:ShouldRedirectFromOverwhelmedHomeSide()) then
		if (self:IsHomeSideOverwhelmedByEnemyArmy(self.capturing_flag)) then
			return true
		end
		if (self:IsEnemyNonCritHomeSidePoint(self.capturing_flag)) then
			return false
		end
	end
	return not self:IsHomeSideSecureTarget(self.capturing_flag)
end

function CapturePlan:IsTakeAndHoldVictoryCapture(oFlag)

	-- Take and Hold victory points = IsStrategicObjective (not relic, not regular SP)
	-- oFlag optional — when omitted, use instance capturing_flag (never read as class static)
	if (oFlag == nil) then
		if (self == CapturePlan) then
			return false
		end
		oFlag = self.capturing_flag
	end
	if (oFlag == nil) then
		return false
	end
	return (oFlag:IsStrategicObjective() and not oFlag:IsRelic())
end

function CapturePlan:CanSquadCaptureGuard(oSquad, oTactic)

	if (oSquad == nil or oTactic == nil) then
		return false
	end
	if (self:IsTakeAndHoldVictoryCapture() and oSquad:IsEngineer()) then
		return false
	end
	return oTactic:CanCaptureGuard()
end

-- Добавьте эту функцию в начало файла
local function CountTableItems(t)
    local count = 0
    for _ in pairs(t) do
        count = count + 1
    end
    return count
end

-- Добавить в глобальные обработчики событий
function OnStrategicPointOwnerChanged()
    CapturePlan.LastStratUpdate = 0  -- Принудительное обновление
end

-- Living enemies as sorted id string (homeside / capture distances ignore dead)
function CapturePlan:GetLivingEnemyKey()

	local aIds = {}
	for oPlayer in cpu_manager.stats:GetPlayerStats() do
		if (oPlayer:GetPlayerID() ~= cpu_manager.player_id and not oPlayer:IsPlayerDead() and
			cpu_manager.player_stats:IsEnemy(oPlayer)) then
			table.insert(aIds, oPlayer:GetPlayerID())
		end
	end
	if (table.getn(aIds) > 1) then
		table.sort(aIds, function(a, b) return a < b end)
	end
	local sKey = ""
	for iLoop1 = 1, table.getn(aIds) do
		if (iLoop1 > 1) then
			sKey = sKey.."_"
		end
		sKey = sKey..tostring(aIds[iLoop1])
	end
	return sKey
end

-- After player deaths: rebuild OrderedStratPoints vs remaining living starts
function CapturePlan:RefreshCapturingListIfNeeded()

	local sKey = self:GetLivingEnemyKey()
	if (sKey == CapturePlan.LivingEnemyKey and table.getn(CapturePlan.OrderedStratPoints) > 0) then
		return false
	end
	AITrace.Log("Capture.Noise", "CapturePlan: Rebuild strat list — living enemies changed ("..tostring(CapturePlan.LivingEnemyKey).." -> "..tostring(sKey)..")")
	CapturePlan.LivingEnemyKey = sKey
	InitCapturingList()
	CapturePlan.LastStratUpdate = 0
	return true
end

-- Arkhan 01.2007: Init ordered strategic point array
function InitCapturingList()

    -- Если план захвата завершен - переинициализируем его
--   if CapturePlan:IsComplete() then
--       CapturePlan:SetComplete(false)
--       CapturePlan.LastStratUpdate = 0  -- Форсируем обновление точек
--   end
	CapturePlan.OrderedStratPoints = {}

	-- Find closest enemy and distance from base to base
	local oEnemy, iBaseToBaseDistance = cpu_manager:FindClosestEnemyPlayer()
	if (oEnemy == nil) then
		CapturePlan.LivingEnemyKey = CapturePlan:GetLivingEnemyKey()
		return
	end		
	local vEnemyPos = oEnemy:GetStartingPosition()
	
	-- Get start positions (living enemies only — homeside shifts when neighbors die)
	local aEnemyStartPositions = {}
	for oPlayer in cpu_manager.stats:GetPlayerStats() do

		-- Check player
		if (oPlayer:GetPlayerID() ~= cpu_manager.player_id and not oPlayer:IsPlayerDead()) then
		
			if (cpu_manager.player_stats:IsEnemy(oPlayer)) then
				table.insert(aEnemyStartPositions, oPlayer:GetStartingPosition())
			end
		end
	end

	-- Find best strategic point to capture
	for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
		
		-- Get position of strategic point
		local vStratPos = oStrategicPoint:GetPosition()
		
		-- Get shortest pathing distance to my base
		local iPathingDistanceToMyBase = cpu_manager:GetShortestPathingDistance(cpu_manager.start_pos, vStratPos, false)
		
		-- Get shortest pathing distance to closes enemy base
		local iPathingDistanceToEnemyBase = 1000
		for iLoop1 in aEnemyStartPositions do

			-- Get pathing distance to enemy base
			local iDistance = cpu_manager:GetShortestPathingDistance(aEnemyStartPositions[iLoop1], vStratPos, false)
			if (iDistance < iPathingDistanceToEnemyBase) then
				iPathingDistanceToEnemyBase = iDistance
			end
		end
		
		-- Don't take criticals too close at the enemy base
		if (not oStrategicPoint:IsStrategicObjective() or iPathingDistanceToMyBase < 2 * iPathingDistanceToEnemyBase) then

			-- Create modified pathing distance
			local iModifiedPathingDistance = iPathingDistanceToMyBase
			if (iPathingDistanceToEnemyBase < iPathingDistanceToMyBase) then
		
				-- Posts closer to the enemy base than to my base get a malus
				local iModifier = math.max((iPathingDistanceToMyBase - iPathingDistanceToEnemyBase) / 2, 20)
				iModifiedPathingDistance = iPathingDistanceToMyBase + iModifier
			
			elseif (iPathingDistanceToEnemyBase < iBaseToBaseDistance) then
		
				-- Posts in enemy direction get a range bonus
				local iModifier = math.max((iBaseToBaseDistance - iPathingDistanceToEnemyBase) / 2, 20)
				iModifiedPathingDistance = iPathingDistanceToMyBase - iModifier
			end
			
			-- Non-homeside relics get a malus; homeside relic preferred over crits
			if (oStrategicPoint:IsRelic()) then
				if (CapturePlan:IsHomeSideRelic(oStrategicPoint)) then
					iModifiedPathingDistance = iModifiedPathingDistance - 10
				else
					iModifiedPathingDistance = iModifiedPathingDistance + 15
				end
			elseif (oStrategicPoint:IsStrategicObjective()) then
				-- Victory crit after homeside relic
				iModifiedPathingDistance = iModifiedPathingDistance + 25
			end
			
			-- Store strategic point
			table.insert(CapturePlan.OrderedStratPoints, { oStrategicPoint, iModifiedPathingDistance, iPathingDistanceToMyBase,
														   iPathingDistanceToEnemyBase })
		end
	end
	
	CapturePlan.LivingEnemyKey = CapturePlan:GetLivingEnemyKey()

	-- Sort: homeside → homeside relic → mid → other relic → victory crit; then distance
	if (table.getn(CapturePlan.OrderedStratPoints) > 1) then
	
		local SortFunction = function( oItem1, oItem2 )
			local iRank1 = CapturePlan:GetCapturePriorityRank(oItem1[1])
			local iRank2 = CapturePlan:GetCapturePriorityRank(oItem2[1])
			if (iRank1 ~= iRank2) then
				return iRank1 < iRank2
			end
			return oItem1[3] < oItem2[3]
		end
		table.sort(CapturePlan.OrderedStratPoints, SortFunction)
	end
end


function CapturePlan:__init( base_location ) super( CpuPlayer.CT_Resourcing )

	dbAssert( base_location ~= nil )
	self.StartActually = true 
	--save a copy of the base to resource close to
	self.base_location = Vector3f( base_location )
	
	--the flag I'm trying to capture
	self.capturing_flag = nil
	self.capturing_squad = nil
	self.capturing_squad_hurt = 0
	self.guard_squads = {}
	
	Plan.SetName( self, "Capture Plan" )
	Plan.SetState( self, "Capture Flag", CapturePlan.CaptureFlag )
	Plan.SetNeeds( self, "Obtain ressources", CapturePlan.ObtainRessources )
	
	self.m_iThreatRange = 45
	
	self.m_iNextUpdate = 0
	self.m_iNextGuardUpdate = 0
	self.m_iNextCapThreatCheck = 0
	self.m_iLastCaptureOrder = 0
	self.m_iLastApproachDistSqr = nil
	self.m_iFightBackClearTime = nil
	self.m_iCaptureCommitUntil = 0
	self.m_iLastTopUpAttempt = 0
end

function CapturePlan:CanEarlyTopUp()
	local iRequisition = resource_manager:GetResourceAmount():Get(ResourceAmount.RT_Requisition)
	return (iRequisition > 200 and g_iGMT < DefendChokePointPlan.HarassingTime * 60)
end

-- T1 only, before HQ addon, not 3000/3000 overflow
function CapturePlan:IsT1SoloExpandThreatGateActive()

	if (cpu_manager:GetTierLevel() ~= 1) then
		return false
	end
	local oBBS = cpu_manager.build_base_strategy
	if (oBBS ~= nil) then
		if (oBBS.IsResourceOverflow ~= nil and oBBS:IsResourceOverflow()) then
			return false
		end
		if (oBBS.m_bHQAddon1) then
			return false
		end
	end
	return true
end

-- Soft / plan capturer / harasser walking alone (not mid-capture ≥0.85)
function CapturePlan:IsT1SoloExpandRole(oSquad)

	if (oSquad == nil or not oSquad:IsValid()) then
		return false
	end
	local oTac = oSquad:GetTactic()
	if (oTac == nil) then
		return false
	end
	if (oTac:IsDedicatedCapturer() or oTac:IsSoftCapturerOnCaptureDuty() or
		oTac:IsCapturePlanMove() or oTac:IsSoftSelfCap() or oTac:IsActivelyHarassing()) then
		return true
	end
	return false
end

-- Raw 30m bubble: enemy > 1.2 * allied
function CapturePlan:HasT1SoloLocalThreatBubble(oSquad)

	if (oSquad == nil or not oSquad:IsValid()) then
		return false
	end
	local iRange = CapturePlan.T1SoloThreatRange
	if (iRange == nil) then
		iRange = 30
	end
	local fRatio = CapturePlan.T1SoloThreatRatio
	if (fRatio == nil) then
		fRatio = 1.2
	end
	local vPos = oSquad:GetPosition()
	local iEnemy, iAllied = cpu_manager:GetArmyStrengthAtPos(vPos, iRange, true)
	if (iEnemy == nil or iEnemy <= 0) then
		return false
	end
	if (iAllied == nil) then
		iAllied = 0
	end
	return (iEnemy > iAllied * fRatio)
end

-- Enemy strength in solo-expand bubble (class-call safe)
function CapturePlan:GetSoloExpandLocalEnemyStrength(oSquad)

	if (oSquad == nil or not oSquad:IsValid()) then
		return 0
	end
	local iRange = CapturePlan.T1SoloThreatRange
	if (iRange == nil) then
		iRange = 30
	end
	local iEnemy = cpu_manager:GetArmyStrengthAtPos(oSquad:GetPosition(), iRange, true)
	if (iEnemy == nil) then
		return 0
	end
	return iEnemy
end

-- Local 30m: enemy > 1.2 * allied → abort approach / refuse new soft job (T1 gate)
function CapturePlan:HasT1SoloLocalThreat(oSquad, fProgress)

	if (not self:IsT1SoloExpandThreatGateActive()) then
		return false
	end
	if (fProgress ~= nil and fProgress >= CapturePlan.MinProgressToFinishVsThreat) then
		return false
	end
	-- Committed on the flag: keep old finish / soft-commit rules
	if (oSquad:IsCapturing()) then
		return false
	end
	if (not self:IsT1SoloExpandRole(oSquad)) then
		return false
	end
	-- With the blob: not a solo suicide walk
	local oTac = oSquad:GetTactic()
	if (oTac ~= nil and oTac.IsFightingAlongsideArmy ~= nil and oTac:IsFightingAlongsideArmy()) then
		return false
	end
	return self:HasT1SoloLocalThreatBubble(oSquad)
end

-- All game: solo soft/plan/harass under live fire with local enemies on approach.
-- Does not abort mid-cap or ≥0.85 finish; empty-flag distant chip still OK (no local enemy).
function CapturePlan:ShouldAbortSoloExpandUnderFire(oSquad, fProgress)

	if (oSquad == nil or not oSquad:IsValid()) then
		return false
	end
	if (fProgress ~= nil and fProgress >= CapturePlan.MinProgressToFinishVsThreat) then
		return false
	end
	if (oSquad:IsCapturing()) then
		return false
	end
	if (not self:IsT1SoloExpandRole(oSquad)) then
		return false
	end
	local oTac = oSquad:GetTactic()
	if (oTac ~= nil and oTac.IsFightingAlongsideArmy ~= nil and oTac:IsFightingAlongsideArmy()) then
		return false
	end
	if (not oSquad:IsUnderAttack() and not oSquad:WasRecentlyHurt()) then
		return false
	end
	return (self:GetSoloExpandLocalEnemyStrength(oSquad) > 0)
end

-- Closer to enemy start than ours (or not homeside) = deep / "in the ass"
function CapturePlan:IsDeepOnEnemySide(vPos)

	if (vPos == nil or cpu_manager == nil or cpu_manager.start_pos == nil) then
		return false
	end
	if (cpu_manager.IsHomeSidePosition ~= nil and cpu_manager:IsHomeSidePosition(vPos)) then
		return false
	end
	local oEnemy = cpu_manager:FindClosestEnemyPlayer(false)
	if (oEnemy == nil) then
		return true
	end
	local vEnemy = oEnemy:GetStartingPosition()
	if (vEnemy == nil) then
		return true
	end
	local iDistMy = cpu_manager:GetShortestPathingDistance(cpu_manager.start_pos, vPos, false)
	local iDistEnemy = cpu_manager:GetShortestPathingDistance(vEnemy, vPos, false)
	if (iDistMy == nil or iDistEnemy == nil) then
		return true
	end
	return (iDistMy >= iDistEnemy)
end

-- T1: under fire while deep on enemy side toward empty crit / enemy-side point → bail
function CapturePlan:ShouldAbortT1DeepExpandUnderFire(oSquad, oFlag, fProgress)

	if (not self:IsT1SoloExpandThreatGateActive()) then
		return false
	end
	if (oSquad == nil or not oSquad:IsValid()) then
		return false
	end
	if (fProgress ~= nil and fProgress >= CapturePlan.MinProgressToFinishVsThreat) then
		return false
	end
	if (oSquad:IsCapturing()) then
		return false
	end
	if (not oSquad:IsUnderAttack() and not oSquad:WasRecentlyHurt()) then
		return false
	end
	if (not self:IsT1SoloExpandRole(oSquad)) then
		return false
	end
	local oTac = oSquad:GetTactic()
	if (oTac ~= nil and oTac.IsFightingAlongsideArmy ~= nil and oTac:IsFightingAlongsideArmy()) then
		return false
	end
	-- Only for victory / enemy-side jobs (homeside under fire is OK to keep)
	if (oFlag ~= nil) then
		local bVictory = self:IsVictoryStrategicPoint(oFlag)
		local bEnemySide = self:IsEnemySideCapturePoint(oFlag)
		if (not bVictory and not bEnemySide) then
			return false
		end
	end
	return self:IsDeepOnEnemySide(oSquad:GetPosition())
end

-- Finish through threat / melee / outmatch if progress high enough (all game).
-- ≥0.85: stay on flag (broken included via BrokenCaptureAllowed).
function CapturePlan:ShouldFinishCaptureDespiteThreat(fProgress, oSquad)

	if (fProgress == nil or fProgress < CapturePlan.MinProgressToFinishVsThreat) then
		return false
	end
	if (oSquad == nil or not oSquad:IsValid()) then
		return false
	end
	-- Above 0.95: finish regardless of size/HP / broken
	if (fProgress > CapturePlan.FinishCaptureHighProgress) then
		return true
	end
	local fHealth = oSquad:GetHealthPercentage()
	-- Sisters Missionary / Tau Stealth: designed as 1-model expanders
	if (cpu_manager:IsSoloMapCapturer(oSquad)) then
		if (fProgress >= CapturePlan.FinishCaptureHighProgress) then
			return (fHealth >= 0.50)
		end
		return (fHealth >= 0.65)
	end
	-- ≥0.85: finish vs melee / outmatch / broken
	return true
end

-- Empty victory crit: take only if flag empty, path/local army not stronger than capturer,
-- not under live fire, not broken. Urgent T&H: always. Class-call safe (oSquad optional).
function CapturePlan:CanSafelyTakeEmptyVictory(oSquad, oFlag)

	if (oFlag == nil or not self:IsVictoryStrategicPoint(oFlag)) then
		return true
	end
	-- Last 2 min: die for the win
	if (self:IsTakeAndHoldUrgent()) then
		return true
	end
	-- Homeside / relic first
	if (self:NeedsHomeSideSecurePhase()) then
		return false
	end
	if (self:NeedsHomeSideRelicBeforeCrit()) then
		return false
	end
	if (not self:IsEmptyOfEnemyArmy(oFlag)) then
		return false
	end
	local vFlag = oFlag:GetPosition()
	if (oSquad == nil or not oSquad:IsValid()) then
		return (not self:IsEmptyFlagPathBlocked(vFlag))
	end
	-- Broken never starts empty crit (T&H urgent already allowed above)
	if (oSquad:IsBroken()) then
		return false
	end
	-- Live fire with local enemy: peel, don't walk onto crit
	if ((oSquad:IsUnderAttack() or oSquad:WasRecentlyHurt()) and
		self:GetSoloExpandLocalEnemyStrength(oSquad) > 0) then
		return false
	end
	-- T1: under fire deep on enemy side → don't keep pushing empty crit
	if (self:ShouldAbortT1DeepExpandUnderFire(oSquad, oFlag, 0)) then
		return false
	end
	local vFrom = oSquad:GetPosition()
	local iPathRange = CapturePlan.T1SoloThreatRange
	if (iPathRange == nil) then
		iPathRange = 30
	end
	if (cpu_manager:HasThreatOnPath(vFrom, vFlag, iPathRange)) then
		return false
	end
	local iCapStr = cpu_manager:GetUnitStrength(oSquad)
	if (iCapStr == nil) then
		iCapStr = 0
	end
	-- Army at flag stronger than capturer (belt — empty check usually 0)
	local iAtFlag = cpu_manager:GetArmyStrengthAtPos(vFlag, iPathRange, true)
	if (iAtFlag ~= nil and iAtFlag > 0 and iAtFlag > iCapStr) then
		return false
	end
	-- Local army stronger than capturer (would walk through them)
	local iNear = cpu_manager:GetArmyStrengthAtPos(vFrom, iPathRange, true)
	if (iNear ~= nil and iNear > 0 and iNear > iCapStr) then
		return false
	end
	return true
end

-- Single gate: when broken may keep / start a capture job.
-- Exceptions: overwhelm, T&H victory (countdown), ≥0.85 finish, empty homeside income.
-- Class-call safe (oFlag required for T&H / homeside checks).
function CapturePlan:BrokenCaptureAllowed(oSquad, oFlag, fProgress)

	if (oSquad == nil or not oSquad:IsValid()) then
		return false
	end
	if (not oSquad:IsBroken()) then
		return true
	end
	if (oFlag == nil) then
		return false
	end
	-- Overwhelm: push through
	if (cpu_manager ~= nil and cpu_manager.m_bOverwhelmActive) then
		return true
	end
	-- T&H: victory SP while countdown running (incl. urgent MustStay)
	if (self:IsVictoryStrategicPoint(oFlag) and self:IsTakeAndHoldCountdownActive()) then
		return true
	end
	if (self:MustStayOnVictoryPoint(oFlag)) then
		return true
	end
	-- Mid / crit / enemy-side: never stay broken (was: ≥0.85 kept them dying on flag)
	if (self:IsVictoryStrategicPoint(oFlag) or self:IsEnemySideCapturePoint(oFlag)) then
		return false
	end
	-- ≥0.85 finish push — homeside only
	if (fProgress ~= nil and self:ShouldFinishCaptureDespiteThreat(fProgress, oSquad)) then
		return true
	end
	-- Empty homeside income: broken may re-cap (not crit / enemy-side)
	if (self:IsRegularHomeSidePoint(oFlag) and self:IsEmptyOfEnemyArmy(oFlag)) then
		return true
	end
	return false
end

-- True → abort / refuse assign while broken (inverse of BrokenCaptureAllowed)
function CapturePlan:ShouldRefuseBrokenCapture(oSquad, oFlag, fProgress)

	if (oSquad == nil or not oSquad:IsValid() or oFlag == nil) then
		return false
	end
	if (not oSquad:IsBroken()) then
		return false
	end
	return (not self:BrokenCaptureAllowed(oSquad, oFlag, fProgress))
end

-- Alias (call sites / SoftTryCapture)
function CapturePlan:ShouldRefuseBrokenEnemyOrCritStart(oSquad, oFlag, fProgress)
	return self:ShouldRefuseBrokenCapture(oSquad, oFlag, fProgress)
end

function CapturePlan:CapturerNeedsTopUp()
	if (self.capturing_squad == nil or not self.capturing_squad:IsValid()) then
		return false
	end
	if (self.capturing_flag == nil) then
		return false
	end
	-- Homeside points are safe enough — only top up for enemy-side / contested push
	if (self:IsHomeSidePoint(self.capturing_flag)) then
		return false
	end
	if (not self:CanEarlyTopUp()) then
		return false
	end
	if (self.capturing_squad:GetNumTroopers() >= self.capturing_squad:GetMaxTroopers()) then
		return false
	end
	return true
end

-- Reinforce after move order; never spam (DoReinforce cancels path → jitter)
CapturePlan.TopUpThrottle = 8
function CapturePlan:TryTopUpCapturer(bForce)
	if (not self:CapturerNeedsTopUp()) then
		return false
	end
	if (self.capturing_squad:IsReinforcing()) then
		return true
	end
	if (not bForce and g_iGMT < self.m_iLastTopUpAttempt + CapturePlan.TopUpThrottle) then
		return false
	end
	local oTactic = self.capturing_squad:GetTactic()
	local bDid = false
	if (oTactic ~= nil) then
		bDid = oTactic:TryDoReinforce()
	elseif (not Tactic.IsOrkPlayer()) then
		bDid = Tactic.DoReinforcePreferTroopers(self.capturing_squad)
	end
	if (bDid) then
		AITrace.Log("Capture.Noise", "CapturePlan: Top-up capturer en route to enemy point")
		self.m_iLastTopUpAttempt = g_iGMT
		return true
	end
	return false
end

function CapturePlan:IsEqual( plan_name, plan_id )
	return self:GetName() == plan_name
end

function CapturePlan:PruneAbortCooldowns()

	local iCount = table.getn(CapturePlan.AbortCooldowns)
	for iLoop = iCount, 1, -1 do
		if (g_iGMT >= CapturePlan.AbortCooldowns[iLoop][2]) then
			table.remove(CapturePlan.AbortCooldowns, iLoop)
		end
	end
end

function CapturePlan:MarkAbortCooldown(vPos, iSeconds)

	if (vPos == nil) then
		return
	end
	self:PruneAbortCooldowns()
	local iUntil = g_iGMT + (iSeconds or CapturePlan.AbortCooldownTime)
	table.insert(CapturePlan.AbortCooldowns, { Vector3f(vPos), iUntil })
end

function CapturePlan:IsOnAbortCooldown(vPos)

	if (vPos == nil) then
		return false
	end
	self:PruneAbortCooldowns()
	local iRangeSqr = sqr(12)
	for iLoop in CapturePlan.AbortCooldowns do
		if (distance_sqr(vPos, CapturePlan.AbortCooldowns[iLoop][1]) < iRangeSqr) then
			return true
		end
	end
	return false
end

-- Enemy LP / base at flag: solo CapturePlan must not yo-yo into turret fire
function CapturePlan:HasBlockingEnemyPost(oFlag)

	if (oFlag == nil) then
		return false
	end
	local iOwner = oFlag:Owner()
	local bOwnedByEnemy = (not cpu_manager:IsFriendly(iOwner) and iOwner ~= 0)
	if (not bOwnedByEnemy) then
		return false
	end
	if (oFlag:HasListeningPost()) then
		return true
	end
	if (cpu_manager.cpu_player:FindFirstBaseEnemy(oFlag:GetPosition(), 1, 1) ~= nil) then
		return true
	end
	return false
end

-- Capturer already peeling (AvoidDeath) — CapturePlan must release, not re-DoDefault
function CapturePlan:IsCapturerEmergencyPeeling(oSquad)

	if (oSquad == nil or not oSquad:IsValid()) then
		return false
	end
	local oTactic = oSquad:GetTactic()
	-- Free Ork Slugga after recruitment: never abort for peel / broken / retreat
	if (oTactic ~= nil and oTactic.IgnoresCaptureThreat ~= nil and oTactic:IgnoresCaptureThreat()) then
		return false
	end
	-- Last minute T&H victory: stay on the point even if broken / AvoidDeath
	if (self:MustStayOnVictoryPoint()) then
		return false
	end
	-- Broken allowed (overwhelm / T&H / ≥0.85 / empty homeside): keep job
	if (self.capturing_flag ~= nil) then
		local fProgress = 0
		if (self.capturing_flag.GetCaptureProgress ~= nil) then
			fProgress = self.capturing_flag:GetCaptureProgress()
		end
		if (self:BrokenCaptureAllowed(oSquad, self.capturing_flag, fProgress)) then
			return false
		end
	end
	-- Broken: release immediately (DoDefault ↔ flee = throttle)
	if (oSquad:IsBroken()) then
		return true
	end
	if (oTactic == nil) then
		return false
	end
	return (oTactic:IsInEmergencySubState() or oTactic:ShouldRetreatToBase())
end

function CapturePlan:ShouldAbortForMoraleOrThreat(oSquad, oFlag, fProgress)

	if (oSquad == nil or not oSquad:IsValid() or oFlag == nil) then
		return true
	end
	if (fProgress == nil) then
		fProgress = 0
	end

	local oTactic = oSquad:GetTactic()
	-- Free Ork Slugga after recruitment: never abort for threat / broken
	if (oTactic ~= nil and oTactic.IgnoresCaptureThreat ~= nil and oTactic:IgnoresCaptureThreat()) then
		return false
	end

	-- T&H countdown: never abort approach/capture on victory SP (no flag jitter)
	if (oFlag:IsStrategicObjective() and not oFlag:IsRelic() and self:IsTakeAndHoldFinalMinute()) then
		return false
	end

	-- Broken allowed (overwhelm / T&H / ≥0.85 / empty homeside): keep going
	if (oSquad:IsBroken() and self:BrokenCaptureAllowed(oSquad, oFlag, fProgress)) then
		return false
	end

	-- Broken refused: abort
	if (self:ShouldRefuseBrokenCapture(oSquad, oFlag, fProgress)) then
		return true
	end

	-- ≥0.85 finish: do not abort for soft threat
	if (self:ShouldFinishCaptureDespiteThreat(fProgress, oSquad)) then
		return false
	end

	-- Tau Stealth 1-model: under fire → abort even on empty (dies in ~2 shots; invisible OK until spotted)
	if (cpu_manager:IsFragileOneModelStealth(oSquad) and
		(oSquad:IsUnderAttack() or oSquad:WasRecentlyHurt())) then
		return true
	end

	-- Solo expand path: BEFORE empty early-return (empty used to skip ambushes en route)
	-- T1 ratio bubble + all-game under-fire with local enemies @30
	if (self:HasT1SoloLocalThreat(oSquad, fProgress)) then
		return true
	end
	if (self:ShouldAbortSoloExpandUnderFire(oSquad, fProgress)) then
		return true
	end
	-- T1: under fire deep toward empty crit / enemy-side → peel home
	if (self:ShouldAbortT1DeepExpandUnderFire(oSquad, oFlag, fProgress)) then
		return true
	end

	-- Empty flag (no enemy army): keep walking/capping — chip fire elsewhere ≠ abandon free crit
	if (self:IsEmptyOfEnemyArmy(oFlag)) then
		return false
	end

	-- Already capturing: soft threat OK. Only care about the approach.
	if (oSquad:IsCapturing()) then
		return false
	end

	local vFlagPos = oFlag:GetPosition()
	local vPos = oSquad:GetPosition()
	local bNearFlag = (distance_sqr(vPos, vFlagPos) <= sqr(35))
	local bHome = self:IsHomeSidePoint(oFlag)
	local bCrit = (oFlag:IsStrategicObjective() and not oFlag:IsRelic())
	local bEnemySide = (bCrit or not bHome)

	-- Non-homeside / crit: army ratio @30 only — never WasRecentlyHurt (hurt flicker = yo-yo)
	if (bEnemySide) then
		local iEnemy, iAllied = self:GetEnemySideForceAtPoint(oFlag, oSquad)
		if (iEnemy <= 0) then
			return false
		end
		-- Hopeless only once we are at the fight (far: gather guards / walk in)
		if (bNearFlag and iAllied < iEnemy) then
			return true
		end
		-- ≥1× or still approaching: stay to clear (capture gated by CanCaptureEnemySidePoint)
		return false
	end

	-- Homeside approach: close enough that DoDefault will start capture soon
	if (bNearFlag and not oSquad:WasRecentlyHurt() and not oSquad:IsBroken()) then
		return false
	end

	local bBroken = oSquad:IsBroken()
	local bUnderFire = oSquad:WasRecentlyHurt() or oSquad:IsUnderAttack()
	-- Threat next to the squad (and at flag only when already close). Distant defenders
	-- on the target point must NOT cancel the walk from our edge — that caused yo-yo.
	local iEnemy, iAllied = cpu_manager:GetArmyStrengthAtPos(vPos, self.m_iThreatRange, true)
	if (bNearFlag) then
		local iEnemyAtFlag = cpu_manager:GetArmyStrengthAtPos(vFlagPos, self.m_iThreatRange, true)
		if (iEnemyAtFlag > iEnemy) then
			iEnemy = iEnemyAtFlag
		end
	end

	if (not bBroken and not bUnderFire) then
		if (iEnemy > 80 and (iAllied < iEnemy or 3 * iAllied < 2 * iEnemy)) then
			if (iAllied < 50) then
				return true
			end
		end
		return false
	end

	-- Homeside + cover: under fire on approach is OK (broken already aborted above)
	if (bHome and not bCrit and iAllied >= 50 and iAllied >= iEnemy) then
		return false
	end

	if (bBroken) then
		return true
	end

	if (bUnderFire and iEnemy > 0) then
		return true
	end

	return false
end

function CapturePlan:SetCapturerPlanMove( oSquad )

	if (oSquad == nil or not oSquad:IsValid()) then
		return false
	end
	local oTactic = oSquad:GetTactic()
	if (oTactic == nil) then
		return false
	end
	-- Necron: never yank scarab off own unfinished LP
	if (cpu_manager:IsNecronScarabPendingPost(oSquad)) then
		AITrace.Log("Capture.Assign", "CapturePlan: refuse capturer assign — scarab POST LOCK")
		return false
	end
	-- Necron: never yank off gen/turret/any construction into capturers
	if (cpu_manager:IsNecronScarabOnBuildDuty(oSquad)) then
		AITrace.Log("Capture.Assign", "CapturePlan: refuse capturer assign — scarab on build duty")
		return false
	end
	-- Necron: mark map capturer; do NOT DoStop (that cancelled builds)
	if (cpu_manager:IsNecronBuilderScarab(oSquad)) then
		EngineerTactic.UnregisterWorkerSquad(oSquad)
		-- No ClearWorkFlags ~= nil probe (Relic crash on method bind)
		oTactic:ClearWorkFlags()
		oTactic.m_bNecronMapCapturer = true
	end
	-- Capturer duty wins — drop stale escort flag (CanCaptureGuard used to prefer it)
	oTactic:SetCaptureGuardMove(false, false)
	oTactic:SetCapturePlanMove(true)
	return true
end

function CapturePlan:ClearCapturerPlanMove( oSquad )

	if (oSquad ~= nil) then
		local oTactic = oSquad:GetTactic()
		if (oTactic ~= nil) then
			oTactic:SetCapturePlanMove(false)
			-- Necron: demote to builder unless still POST LOCKed on own LP
			if (cpu_manager:IsNecronBuilderScarab(oSquad) and
				not cpu_manager:IsNecronScarabPendingPost(oSquad)) then
				oTactic.m_bNecronMapCapturer = false
			end
		end
	end
end

function CapturePlan:SetCaptureGuardMove( oSquad, bValue, bAttack )

	if (oSquad ~= nil and oSquad:IsValid()) then
		local oTactic = oSquad:GetTactic()
		if (oTactic ~= nil) then
			oTactic:SetCaptureGuardMove(bValue, bAttack)
		end
	end
end

function CapturePlan:GetAvailableCaptureGuardSquads()

	local aGuards = {}
	if (self.capturing_squad == nil or not self.capturing_squad:IsValid()) then
		return aGuards
	end

	-- While free homeside still needs parallel caps, do not recruit capturer-capable idle
	local bProtectParallelCaps = (CapturePlan:NeedsHomeSideSecurePhase() and
		self:HasFreeHomeSideSecureTarget())

	local vRef = self.capturing_squad:GetPosition()
	for oSquad in military_manager:GetUnlockedSquads() do
		if (oSquad:IsValid() and oSquad:GetID() ~= self.capturing_squad:GetID()) then
			local oTactic = oSquad:GetTactic()
			if (oTactic ~= nil and self:CanSquadCaptureGuard(oSquad, oTactic)) then
				-- Already escorting this / any capture: keep
				local bKeepEscort = oTactic:IsCaptureGuardMove()
				-- Fresh capturer-capable idle: reserve for CapturePlan while free homeside open
				if (bProtectParallelCaps and not bKeepEscort and oSquad:CanCapture() and
					not oSquad:IsInCombat()) then
				elseif (bKeepEscort or oSquad:IsIdle() or
					(oSquad:IsInCombat() and distance_sqr(oSquad:GetPosition(), vRef) < sqr(CapturePlan.GuardRange))) then
					table.insert(aGuards, { oSquad, oTactic:GetUnitStrength(), oSquad:GetPosition() })
				end
			end
		end
	end

	if (table.getn(aGuards) > 1) then
		table.sort(aGuards, function(oItem1, oItem2)
			return distance_sqr(oItem1[3], vRef) < distance_sqr(oItem2[3], vRef)
		end)
	end
	return aGuards
end

function CapturePlan:ReleaseCaptureGuard( oSquad )

	if (oSquad == nil) then
		return
	end
	AITrace.Log("Capture.Escort", "ESCORT release "..self:DbgSquad(oSquad))
	self:SetCaptureGuardMove(oSquad, false, false)
	if (oSquad:IsLocked()) then
		self:UnlockResource(oSquad)
	end
	local iCount = table.getn(self.guard_squads)
	for iLoop1 = iCount, 1, -1 do
		if (self.guard_squads[iLoop1] == oSquad:GetID()) then
			table.remove(self.guard_squads, iLoop1)
		end
	end
end

function CapturePlan:ReleaseAllCaptureGuards()

	local iCount = table.getn(self.guard_squads)
	for iLoop1 = iCount, 1, -1 do
		local oSquad = military_manager:GetSquadFromID(self.guard_squads[iLoop1])
		if (oSquad ~= nil and oSquad:IsValid()) then
			self:ReleaseCaptureGuard(oSquad)
		else
			table.remove(self.guard_squads, iLoop1)
		end
	end
end

function CapturePlan:ReleaseCaptureGuardsExcept( aKeepIds )

	local aKeep = {}
	for iLoop1 in aKeepIds do
		aKeep[aKeepIds[iLoop1]] = true
	end

	local iCount = table.getn(self.guard_squads)
	for iLoop1 = iCount, 1, -1 do
		if (aKeep[self.guard_squads[iLoop1]] == nil) then
			local oSquad = military_manager:GetSquadFromID(self.guard_squads[iLoop1])
			if (oSquad ~= nil and oSquad:IsValid()) then
				self:ReleaseCaptureGuard(oSquad)
			else
				table.remove(self.guard_squads, iLoop1)
			end
		end
	end
end

function CapturePlan:AssignCaptureGuard( oSquad, vPos, bAttack )

	if (oSquad == nil or not oSquad:IsValid() or vPos == nil) then
		return
	end

	if (self:IsTakeAndHoldVictoryCapture() and oSquad:IsEngineer()) then
		return
	end

	if (not oSquad:IsLocked()) then
		Plan.LockResource(self, oSquad)
	end

	local bFound = false
	for iLoop1 in self.guard_squads do
		if (self.guard_squads[iLoop1] == oSquad:GetID()) then
			bFound = true
			break
		end
	end
	if (not bFound) then
		table.insert(self.guard_squads, oSquad:GetID())
		AITrace.Log("Capture.Escort", "ESCORT assign "..self:DbgSquad(oSquad).." -> "..vec2str(vPos)..
			" attack="..tostring(bAttack).." for "..self:DbgFlag(self.capturing_flag))
	end

	local oTactic = oSquad:GetTactic()
	self:SetCaptureGuardMove(oSquad, true, bAttack)
	if (bAttack) then
		if (oTactic:GetState() ~= Tactic.States.Attack or distance_sqr(oTactic:GetTarget(), vPos) > sqr(5)) then
			oTactic:SetState(Tactic.States.Attack)
			oTactic:SetTarget(vPos, Tactic.Variant.Vector)
		end
	else
		if (oTactic:GetState() ~= Tactic.States.Hold or distance_sqr(oTactic:GetTarget(), vPos) > sqr(5)) then
			oTactic:SetState(Tactic.States.Hold)
			oTactic:SetTarget(vPos, Tactic.Variant.Vector)
		end
	end
end

function CapturePlan:UpdateCaptureGuards()

	if (g_iGMT < self.m_iNextGuardUpdate) then
		return
	end

	local bHasGuards = (self.guard_squads ~= nil and table.getn(self.guard_squads) > 0)
	local bShouldGuard = (self.capturing_squad ~= nil and self.capturing_squad:IsValid() and
		self.capturing_flag ~= nil and self:ShouldGuardCapture(self.capturing_flag))
	if (not bHasGuards and not bShouldGuard) then
		local iIdle = CapturePlan.GuardIdleInterval
		if (iIdle == nil) then
			iIdle = 1.25
		end
		self.m_iNextGuardUpdate = g_iGMT + iIdle
		self:ReleaseAllCaptureGuards()
		return
	end
	self.m_iNextGuardUpdate = g_iGMT + 1/2

	if (self.capturing_squad == nil or not self.capturing_squad:IsValid() or
		self.capturing_flag == nil or not bShouldGuard) then
		if (bHasGuards) then
			AITrace.Log("Capture.Escort", "ESCORT clear — no guard needed for "..self:DbgFlag(self.capturing_flag))
		end
		self:ReleaseAllCaptureGuards()
		return
	end

	-- Free recruitment Slugga: never pull the main army to escort them
	local oCapGuardTactic = self.capturing_squad:GetTactic()
	if (oCapGuardTactic ~= nil and oCapGuardTactic.IgnoresCaptureThreat ~= nil and
		oCapGuardTactic:IgnoresCaptureThreat()) then
		self:ReleaseAllCaptureGuards()
		return
	end

	-- Base / homeside raid elsewhere: unlock escorts for Response/Defend
	if (self:ShouldYieldForHomeDefense()) then
		self:ReleaseAllCaptureGuards()
		return
	end
	if (self:ShouldYieldForHomeSideSecure()) then
		self:ReleaseAllCaptureGuards()
		return
	end

	if (cpu_manager:IsAllyCaptureAtPoint(self.capturing_flag, CapturePlan.GuardRange)) then
		self:ReleaseAllCaptureGuards()
		return
	end

	if (self:IsTakeAndHoldVictoryCapture()) then
		local iCount = table.getn(self.guard_squads)
		for iLoop1 = iCount, 1, -1 do
			local oSquad = military_manager:GetSquadFromID(self.guard_squads[iLoop1])
			if (oSquad ~= nil and oSquad:IsValid() and oSquad:IsEngineer()) then
				self:ReleaseCaptureGuard(oSquad)
			end
		end
	end

	local vCapturerPos = self.capturing_squad:GetPosition()
	local vFlagPos = self.capturing_flag:GetPosition()
	local iGuardRange = CapturePlan.GuardRange
	local iEnemyStrength = cpu_manager:GetArmyStrengthAtPos(vCapturerPos, iGuardRange, true)
	if (iEnemyStrength <= 0) then
		iEnemyStrength = cpu_manager:GetArmyStrengthAtPos(vFlagPos, iGuardRange, true)
	end

	local oEnemy = cpu_manager.cpu_player:FindFirstInfantryEnemy(vCapturerPos, iGuardRange, 1)
	if (oEnemy == nil) then
		oEnemy = cpu_manager.cpu_player:FindFirstEnemy(vCapturerPos, iGuardRange, 1)
	end
	if (oEnemy == nil) then
		oEnemy = cpu_manager.cpu_player:FindFirstInfantryEnemy(vFlagPos, iGuardRange, 1)
	end
	if (oEnemy == nil) then
		oEnemy = cpu_manager.cpu_player:FindFirstEnemy(vFlagPos, iGuardRange, 1)
	end

	local vThreatPos = nil
	if (oEnemy ~= nil) then
		vThreatPos = Vector3f(oEnemy:GetPosition())
	end

	local bThreat = (iEnemyStrength > 50 or oEnemy ~= nil or
		cpu_manager.terrain_analyzer:HasThreat(vFlagPos, iGuardRange))

	local aGuards = self:GetAvailableCaptureGuardSquads()
	local aNewGuardIds = {}
	local iGuardCount = 0
	local bSecurePush = (CapturePlan:NeedsHomeSideSecurePhase() and
		self:IsContestedHomeSidePoint(self.capturing_flag))
	local bEmergencyVictory = (self:IsTakeAndHoldEmergency() and self:IsTakeAndHoldVictoryCapture())
	local bEnemySide = self:IsEnemySideCapturePoint(self.capturing_flag)
	local bClearThenCap = false
	if (not bEmergencyVictory) then
		if (bEnemySide) then
			bClearThenCap = (not self:CanCaptureEnemySidePoint(self.capturing_flag) and
				not self:HasBlockingEnemyPost(self.capturing_flag))
		else
			bClearThenCap = (not self:IsEmptyOfEnemyArmy(self.capturing_flag) and
				self:HasPointThreat(self.capturing_flag))
		end
	end
	local iMaxGuards = CapturePlan.MaxGuards
	if (bSecurePush or bEmergencyVictory or bClearThenCap) then
		iMaxGuards = 6
	end
	local fGatherRatio = 1.2
	if (bEnemySide and CapturePlan.EnemyPointClearRatio ~= nil) then
		fGatherRatio = CapturePlan.EnemyPointClearRatio
	end
	-- Enemy-side clear: measure mass at contest range 30
	if (bEnemySide and bClearThenCap) then
		local iE = self:GetPointArmyStrengths(self.capturing_flag, CapturePlan.EnemyPointArmyRange)
		if (iE ~= nil and iE > iEnemyStrength) then
			iEnemyStrength = iE
		end
	end

	if (bThreat or bEmergencyVictory or bClearThenCap) then
		if (vThreatPos == nil) then
			vThreatPos = vFlagPos
		end
		local iGathered = self.capturing_squad:GetTactic():GetUnitStrength()
		if (bEnemySide) then
			local _, iAlliedAtPoint = self:GetPointArmyStrengths(self.capturing_flag, CapturePlan.EnemyPointArmyRange)
			if (iAlliedAtPoint ~= nil and iAlliedAtPoint > iGathered) then
				iGathered = iAlliedAtPoint
			end
		end
		for iLoop1 = 1, table.getn(aGuards) do
			if (iGuardCount >= iMaxGuards) then
				break
			end
			local oGuard = aGuards[iLoop1][1]
			local iStrength = aGuards[iLoop1][2]
			-- Keep gathering until allied >= clear ratio (enemy-side 1.2×) / emergency / secure
			if (bSecurePush or bEmergencyVictory or bClearThenCap or
				iGuardCount == 0 or iGathered < iEnemyStrength * fGatherRatio) then
				local bAttack = (iGathered + iStrength >= iEnemyStrength) or
					(iGathered + iStrength >= iEnemyStrength * 1.15) or
					(iGuardCount >= 1) or bSecurePush or bEmergencyVictory
				self:AssignCaptureGuard(oGuard, vThreatPos, bAttack)
				table.insert(aNewGuardIds, oGuard:GetID())
				iGuardCount = iGuardCount + 1
				iGathered = iGathered + iStrength
			else
				break
			end
		end
	elseif (g_iGMT < DefendChokePointPlan.HarassingTime * 60) then
		local iEscort = math.min(CapturePlan.EscortGuards, table.getn(aGuards))
		local vEscortPos = vCapturerPos
		if (distance_sqr(vCapturerPos, vFlagPos) > sqr(40)) then
			vEscortPos = vFlagPos
		end
		for iLoop1 = 1, iEscort do
			local oGuard = aGuards[iLoop1][1]
			self:AssignCaptureGuard(oGuard, vEscortPos, false)
			table.insert(aNewGuardIds, oGuard:GetID())
		end
	end

	self:ReleaseCaptureGuardsExcept(aNewGuardIds)
end

function CapturePlan:UnlockCapturingSquad( oSquad )

	self:ClearCapturerPlanMove(oSquad)
	if (oSquad ~= nil) then
		self:UnlockResource(oSquad)
	end
end

function CapturePlan:ObtainRessources()

	-- Always respect abort / search cooldown (was ignored before 3 min → instant re-assign jitter)
	if (g_iGMT < self.m_iNextUpdate) then
		return
	end
	-- Idle search cadence 2s (Needs still drives Obtain; no force rebuild in Update)
	self.m_iNextUpdate = g_iGMT + 2

	-- Check if we have a strategic point to capture
	--if (not self:FindFreeStrategicPoint() and g_iGMT > 2 * 60) then
	if not self:FindFreeStrategicPoint() then
	
		-- Старая логика (плохая):
		-- self:FreeRessources(true)
		-- return
		
		-- Новая логика: не завершаем план, а ждем появления точек
		AITrace.Log("Capture.Noise", "CapturePlan: Waiting for free strategic points...")
		return
    end
end

function CapturePlan:FreeRessources(bEndPlan, bDangerAbort)

	-- Skip empty free (BO spawns extra CapturePlans that spam this every tick)
	if (self.capturing_flag == nil and self.capturing_squad == nil and
		(self.guard_squads == nil or table.getn(self.guard_squads) == 0)) then
		return
	end

	-- Success: our/ally finished capture — always free
	local bCaptureDone = false
	if (self.capturing_flag ~= nil) then
		local iOwner = self.capturing_flag:Owner()
		if (cpu_manager:IsFriendly(iOwner) and
			(iOwner ~= cpu_manager.player_id or self.capturing_flag:FinishedCapturing())) then
			bCaptureDone = true
		end
	end

	-- Urgent T&H victory: never abort off the flag (danger or soft yield)
	if (not bCaptureDone and self:MustStayOnVictoryPoint()) then
		AITrace.Log("Capture.Abort", "CapturePlan: Ignore free — urgent T&H victory (<2 min)!")
		return
	end

	local sWhy = "unknown"
	if (bCaptureDone) then
		sWhy = "DONE"
	elseif (bDangerAbort) then
		sWhy = "DANGER"
	else
		sWhy = "YIELD"
	end
	AITrace.Log("Capture.Assign", "FREE "..sWhy.." squad="..self:DbgSquad(self.capturing_squad)..
		" flag="..self:DbgFlag(self.capturing_flag)..
		" guards="..tostring(table.getn(self.guard_squads or {})))

	AITrace.Log("Capture.Noise", "CapturePlan: Free ressources...")
	self:ReleaseAllCaptureGuards()

	-- Necron capturer scarab: after non-crit income SP → immediate LP (not victory/relic)
	local oNecronPostFlag = nil
	local oNecronPostSquad = nil
	if (bCaptureDone and self.capturing_flag ~= nil and self.capturing_squad ~= nil and
		self.capturing_squad:IsValid() and cpu_manager:IsNecronBuilderScarab(self.capturing_squad)) then
		local oFlag = self.capturing_flag
		local bVictoryCrit = (oFlag:IsStrategicObjective() and not oFlag:IsRelic())
		if (not bVictoryCrit and not oFlag:IsRelic()) then
			oNecronPostFlag = oFlag
			oNecronPostSquad = self.capturing_squad
		end
	end

	-- Free flag
	if (self.capturing_flag ~= nil) then
		-- Blacklist only on danger abort (not after successful capture)
		if (bDangerAbort) then
			self:MarkAbortCooldown(self.capturing_flag:GetPosition(), CapturePlan.AbortCooldownTime)
		end
		self:UnlockResource(self.capturing_flag)
		self.capturing_flag = nil
		Plan.SetState(self, "Capture New Flag", CapturePlan.CaptureFlag)
	end
	
	-- Free capturer — do NOT force Retreat-to-base (fought Capture/harass DoMove → bounce)
	if (self.capturing_squad ~= nil) then
		if (self.capturing_squad:IsValid() and bDangerAbort) then
			-- Only peel home when truly broken / critical; otherwise unlock and leave path alone
			local oTactic = self.capturing_squad:GetTactic()
			if (oTactic ~= nil and oTactic:ShouldRetreatAllTheWayHome()) then
				local vBasePos = cpu_manager:FindClosestFriendlyBaseOrStrategicPoint(self.capturing_squad:GetPosition(), cpu_manager.start_pos, true, false)
				if (vBasePos ~= nil) then
					oTactic:SetState(Tactic.States.Retreat, "FreeResources")
					oTactic:SetTarget(vBasePos, Tactic.Variant.Vector)
				end
			end
		end
		self:UnlockCapturingSquad(self.capturing_squad)
		self.capturing_squad = nil
	end

	if (oNecronPostFlag ~= nil and oNecronPostSquad ~= nil and oNecronPostSquad:IsValid()) then
		-- No oTactic.SetPendingNecronPost ~= nil probe — Relic crash on bind
		local oTactic = oNecronPostSquad:GetTactic()
		if (oTactic ~= nil) then
			oTactic:SetPendingNecronPost(oNecronPostFlag)
		end
	end

	self.capturing_squad_hurt = 0
	self.m_iLastCaptureOrder = 0
	self.m_iLastApproachDistSqr = nil
	self.m_iFightBackClearTime = nil
	self.m_iCaptureCommitUntil = 0
	self.m_iLastTopUpAttempt = 0
	if (bDangerAbort) then
		-- Let the squad actually retreat before re-locking capture duty
		self.m_iNextUpdate = g_iGMT + CapturePlan.AbortSearchDelay
	end
	
	-- Check time
	-- В функции FreeRessources заменяем:
	-- Убираем условие завершения плана
	-- if (g_iGMT > 2 * 60 and bEndPlan) then
	--     self:SetComplete(true)
	-- else
	--     Plan.SetNeeds( self, "Obtain ressources", CapturePlan.ObtainRessources )
	-- end

	-- Всегда возвращаем план в состояние поиска ресурсов
	Plan.SetNeeds( self, "Obtain ressources", CapturePlan.ObtainRessources )
end

function CapturePlan:FindFreeStrategicPoint()
	
	-- Check if we've already a flag to capture
	if (self.capturing_flag ~= nil and self.capturing_squad ~= nil) then
		return true
	else
		self:FreeRessources(false)
	end
	
	AITrace.Log("Capture.Noise", "CapturePlan: Find free strategic point...")

	-- Dead neighbors: reclassify homeside distances for capture priority
	self:RefreshCapturingListIfNeeded()

	local bEmergency = self:IsTakeAndHoldEmergency()
	
	-- Get available capturers
	local aCapturers = cpu_manager:GetAvailableCapturers()
        local aCapturersHigh = cpu_manager:GetAvailableCapturersHigh()
	if (table.getn(aCapturers) < 1) and (table.getn(aCapturersHigh) < 1)  then
		return false
	end
  --[[      if (table.getn(BuildOrderStrategy.mid_capture_flag) ~= 0) and (g_iGMT < 60 and Strategy:GetMapSize()=="large") or (g_iGMT < 50 and Strategy:GetMapSize()=="small") or (g_iGMT < 50 and Strategy:GetMapSize()=="medium")then
         for iLoop1 in BuildOrderStrategy.mid_capture_flag do
          local oMidFlag = BuildOrderStrategy.mid_capture_flag[iLoop1]
          self.capturing_flag = oMidFlag
		for iLoop2 in aCapturers do
				self.capturing_squad = aCapturers[iLoop2][1]
				table.remove(aCapturers, iLoop2)
				break
			
		end
         -- table.remove(BuildOrderStrategy.mid_capture_flag, iLoop1)
            BuildOrderStrategy.mid_capture_flag = {}
          break
         end
        end]]
        
       if ((table.getn(BuildOrderStrategy.mid_capture_flag) == 0) or g_iGMT > 0) and self.capturing_flag == nil and self.capturing_squad == nil then

	local bSecureHome = CapturePlan:NeedsHomeSideSecurePhase()
	local bUrgentTH = self:IsTakeAndHoldUrgent()

	-- Rebuild StratPoints every StratPointsRebuildTTL (reuse list between)
	local iRebuildTTL = CapturePlan.StratPointsRebuildTTL
	if (iRebuildTTL == nil) then
		iRebuildTTL = 2
	end
	if (g_iGMT >= CapturePlan.LastStratUpdate + iRebuildTTL) then
	
		-- Find best strategic point to capture
		CapturePlan.StratPoints = {}
		for iLoop1 in CapturePlan.OrderedStratPoints do
		
			-- Get strategic point
			local oStrategicPoint = CapturePlan.OrderedStratPoints[iLoop1][1]
			local bVictoryCrit = (oStrategicPoint:IsStrategicObjective() and not oStrategicPoint:IsRelic())
			local bUrgentVictory = (bUrgentTH and bVictoryCrit and
				not cpu_manager:IsFriendly(oStrategicPoint:Owner()))
			
			-- Check strategic point
			if (not oStrategicPoint:HasListeningPost() and not self:IsCaptureBlockingAssignment(oStrategicPoint) and
				not cpu_manager:IsFriendly(oStrategicPoint:Owner())) or 
                oStrategicPoint:Owner() == 0 or  -- Нейтральная
                (not cpu_manager:IsFriendly(oStrategicPoint:Owner()) and not oStrategicPoint:HasListeningPost()) or
				(bSecureHome and self:CanCaptureDuringHomeSideSecure(oStrategicPoint)) or
				bUrgentVictory then
				
				-- Filter distant / critical points during early harass
				local bTakeStrat = true
				local iPathingDistanceToMyBase	= CapturePlan.OrderedStratPoints[iLoop1][3]
				local iPathingDistanceToEnemy	= CapturePlan.OrderedStratPoints[iLoop1][4]
				if (bUrgentVictory) then
					-- T&H <2 min: always allow victory decap (secure / relic / raid ignore)
					bTakeStrat = true
				elseif (bSecureHome) then
					-- Homeside secure as before; if hopeless vs whole army → enemy non-crit homeside
					if (self:CanCaptureDuringHomeSideSecure(oStrategicPoint)) then
						bTakeStrat = true
					elseif (self:ShouldRedirectFromOverwhelmedHomeSide() and
						self:IsEnemyNonCritHomeSidePoint(oStrategicPoint)) then
						bTakeStrat = true
					else
						bTakeStrat = false
					end
				elseif (g_iGMT < DefendChokePointPlan.HarassingTime * 40) then
					-- After homeside secure: free empty mid/relic OK even if closer to enemy start (FFA)
					if (bVictoryCrit) then
						bTakeStrat = false
					elseif (iPathingDistanceToMyBase > iPathingDistanceToEnemy * 2 and
						self:HasPointThreat(oStrategicPoint)) then
						bTakeStrat = false
					end
				elseif (bVictoryCrit) then
					-- Empty safe crit OK; contested only on T&H countdown
					if (self:IsEmptyOfEnemyArmy(oStrategicPoint)) then
						if (not self:CanSafelyTakeEmptyVictory(nil, oStrategicPoint)) then
							bTakeStrat = false
						end
					elseif (not self:IsTakeAndHoldCountdownActive()) then
						bTakeStrat = false
					end
				end
				-- Homeside relic before victory crit (even after regular SP secure)
				if (bTakeStrat and not bUrgentVictory) then
					if (bVictoryCrit and self:NeedsHomeSideRelicBeforeCrit()) then
						bTakeStrat = false
					end
				end
				-- Homeside/base under fire: skip contested/crit expansion; free empty OK after secure
				-- Defend my base / mid Respond-to-raid: no mid/crit expand either
				-- Secure targets (incl. homeside relic) stay eligible during secure phase
				if (bTakeStrat and not bUrgentVictory and self:ShouldBlockMidCritExpand()) then
					local bBaseOrRaid = (cpu_manager:GetCriticalThreat() > 0 or cpu_manager:HQThreat() or
						self:IsActiveRaidResponse())
					local bFreeExpand = (not bSecureHome and not self:HasPointThreat(oStrategicPoint) and
						not bBaseOrRaid)
					local bSecureTarget = (bSecureHome and self:IsHomeSideSecureTarget(oStrategicPoint))
					if (bVictoryCrit) then
						bTakeStrat = false
					elseif (bBaseOrRaid and not self:IsRegularHomeSidePoint(oStrategicPoint) and
						not self:IsHomeSideSecureTarget(oStrategicPoint)) then
						bTakeStrat = false
					elseif (not bSecureTarget and not bFreeExpand and (oStrategicPoint:IsRelic() or
						not self:IsRegularHomeSidePoint(oStrategicPoint))) then
						bTakeStrat = false
					end
				end
				if (bTakeStrat and self:ShouldSkipRelicForAllies(oStrategicPoint)) then
					bTakeStrat = false
				end
									
				-- Add strat to current capturing list (precompute empty/contested for sort)
				if (bTakeStrat) then
					table.insert(CapturePlan.StratPoints, {
						oStrategicPoint,
						CapturePlan.OrderedStratPoints[iLoop1][3],
						CapturePlan.OrderedStratPoints[iLoop1][4],
						CapturePlan:IsEmptyOfEnemyArmy(oStrategicPoint),
						CapturePlan:IsContestedHomeSidePoint(oStrategicPoint)
					})
				end
			end
		end
		if (table.getn(CapturePlan.StratPoints) > 1) then
			local SortStratPoints = function(oItem1, oItem2)
				local iRank1 = CapturePlan:GetCapturePriorityRank(oItem1[1])
				local iRank2 = CapturePlan:GetCapturePriorityRank(oItem2[1])
				if (iRank1 ~= iRank2) then
					return iRank1 < iRank2
				end
				-- Empty (no enemy army) before contested — closer contested must not beat freer far crit
				local bEmpty1 = oItem1[4]
				local bEmpty2 = oItem2[4]
				if (bEmpty1 ~= bEmpty2) then
					return bEmpty1
				end
				-- Secure phase: quiet free points before contested (LP / mass)
				if (bSecureHome) then
					local bCont1 = oItem1[5]
					local bCont2 = oItem2[5]
					if (bCont1 ~= bCont2) then
						return not bCont1
					end
				end
				return oItem1[2] < oItem2[2]
			end
			table.sort(CapturePlan.StratPoints, SortStratPoints)
		end
		CapturePlan.LastStratUpdate = g_iGMT
	end

	-- Prefer unfinished homeside. After secure: free empty anywhere; contested enemy-side late / strong.
	-- Urgent T&H: never homeside-restrict — victory may be enemy-side
	local bRestrictToHome = bSecureHome
	if (bUrgentTH) then
		bRestrictToHome = false
	end
	-- Hopeless homeside vs whole army: allow enemy non-crit homeside push
	if (bSecureHome and self:ShouldRedirectFromOverwhelmedHomeSide()) then
		bRestrictToHome = false
	end
	local iMyArmy = cpu_manager:GetArmyStrength()
	local bAllowContestedEnemySide = (not bSecureHome and (g_iGMT > 360 or iMyArmy > 2500))
	if (not bRestrictToHome and not bAllowContestedEnemySide and not bUrgentTH) then
		for iLoop1 in CapturePlan.StratPoints do
			local tEntry = CapturePlan.StratPoints[iLoop1]
			if (tEntry[2] < tEntry[3] and not tEntry[1]:HasListeningPost()) then
				bRestrictToHome = true
				break
			end
		end
	end

	-- If every homeside candidate is locked/unavailable, do not block enemy-side forever
	-- (extra CapturePlans + free capturer sat idle → Response/Choke bounce)
	-- Keep homeside-only while secure phase is active
	if (bRestrictToHome and not bSecureHome) then
		local bHomeUnlocked = false
		for iLoop1 in CapturePlan.StratPoints do
			local tEntry = CapturePlan.StratPoints[iLoop1]
			if (tEntry[2] < tEntry[3] and not tEntry[1]:IsLocked() and not self:IsOnAbortCooldown(tEntry[1]:GetPosition())) then
				bHomeUnlocked = true
				break
			end
		end
		if (not bHomeUnlocked) then
			bRestrictToHome = false
		end
	end

	-- Get closest strat point without threat
	local iStratCount = table.getn(CapturePlan.StratPoints)
	for iLoop1 = 1, iStratCount do
	
		-- Check only unlocked strategic points
		local tEntry = CapturePlan.StratPoints[iLoop1]
		local oStrategicPoint = tEntry[1]
		local iDistMyBase = tEntry[2]
		local iDistEnemyBase = tEntry[3]
		local vStratPos = oStrategicPoint:GetPosition()
		local bEnemySide = (iDistMyBase >= iDistEnemyBase)
		local bPointThreat = self:HasPointThreat(oStrategicPoint)
		-- After secure: free empty mid/relic OK even on "enemy side" by start distance (FFA)
		local bSkipForSide = (bRestrictToHome and bEnemySide and
			not (not bSecureHome and not bPointThreat))
		if (bSkipForSide) then
		elseif (self:ShouldSkipRelicForAllies(oStrategicPoint)) then
		elseif (self:IsOnAbortCooldown(vStratPos)) then
		elseif (not oStrategicPoint:IsLocked()) then

			local bVictory = (oStrategicPoint:IsStrategicObjective() and not oStrategicPoint:IsRelic())
			local bEmergencyVictory = (bEmergency and bVictory)
			-- Secure push = last remaining homeside AND contested (LP/mass).
			-- Empty free points must stay soft-eligible (Necron pool = soft only).
			local bEmptyArmy = self:IsEmptyOfEnemyArmy(oStrategicPoint)
			local bSecurePush = (bSecureHome and self:IsHomeSideSecureTarget(oStrategicPoint) and
				self:IsContestedHomeSidePoint(oStrategicPoint) and
				self:AllOtherRegularHomeSidesOwned(oStrategicPoint))
			local iPathDistBase = cpu_manager:GetShortestPathingDistance(cpu_manager.start_pos, vStratPos)

			-- Emergency T&H: strongest capturer on victory SP
			if (bEmergencyVictory) then
				local oPick, iIdx = self:PickStrongestCapturer(aCapturersHigh)
				if (oPick ~= nil) then
					self.capturing_squad = oPick
					table.remove(aCapturersHigh, iIdx)
				else
					oPick, iIdx = self:PickStrongestCapturer(aCapturers)
					if (oPick ~= nil) then
						self.capturing_squad = oPick
						table.remove(aCapturers, iIdx)
					end
				end
				if (self.capturing_squad ~= nil) then
					self.capturing_flag = oStrategicPoint
					break
				end
			-- Homeside relic: never delay. Other relics: wait early game.
			elseif (oStrategicPoint:IsRelic() and g_iGMT < 70 and
				not self:IsHomeSideRelic(oStrategicPoint)) then
			-- Victory crit only after homeside relic (and early SP count gate)
			-- Urgent T&H: never delay victory for relic / early SP count
			elseif (bVictory and not bUrgentTH and self:NeedsHomeSideRelicBeforeCrit()) then
			elseif (bVictory and not bUrgentTH and not bSecureHome and
				g_iGMT <= 150 and resource_manager:GetNumOwnedStrategicPoints() <= 4) then
			-- Soft on empty: ignore early path-dist gate (was base AFK)
			elseif (iPathDistBase >= 160 and g_iGMT <= 45 and not bEmptyArmy) then
			else
				-- Soft pack: only safe (no army). Contested → army that can actually win.
				-- Soft-first only if soft not much farther than nearest army (all races).
				local oPick, iIdx = nil, nil
				if (bEmptyArmy and not bSecurePush) then
					oPick, iIdx = self:PickDedicatedCapturerForPoint(aCapturers, vStratPos)
					if (oPick ~= nil) then
						local oArmyNear, _ = self:PickCapturerForPoint(aCapturers, vStratPos, false, false)
						if (oArmyNear ~= nil and oArmyNear:GetID() ~= oPick:GetID()) then
							local fSoftPrefer = CapturePlan.SoftPreferDistSqrFactor
							if (fSoftPrefer == nil or fSoftPrefer < 1) then
								fSoftPrefer = 2.25
							end
							local iSoftD = distance_sqr(oPick:GetPosition(), vStratPos)
							local iArmyD = distance_sqr(oArmyNear:GetPosition(), vStratPos)
							if (iSoftD > iArmyD * fSoftPrefer) then
								oPick = nil
								iIdx = nil
							end
						end
					end
					if (oPick ~= nil) then
						self.capturing_squad = oPick
						table.remove(aCapturers, iIdx)
					end
				end
				if (self.capturing_squad == nil and bEmptyArmy) then
					local bAllowSoft = (not bSecurePush)
					oPick, iIdx = self:PickCapturerForPoint(aCapturers, vStratPos, false, bAllowSoft)
					if (oPick == nil) then
						oPick, iIdx = self:PickCapturerForPoint(aCapturersHigh, vStratPos, false, bAllowSoft)
						if (oPick ~= nil) then
							self.capturing_squad = oPick
							table.remove(aCapturersHigh, iIdx)
						end
					else
						self.capturing_squad = oPick
						table.remove(aCapturers, iIdx)
					end
				elseif (self.capturing_squad == nil and not bEmptyArmy) then
					-- Contested victory without T&H: skip (empty crits preferred via sort)
					if (bVictory and not self:IsTakeAndHoldCountdownActive()) then
					else
						oPick, iIdx = self:PickContestCapturer(aCapturersHigh, oStrategicPoint, vStratPos)
						if (oPick ~= nil) then
							self.capturing_squad = oPick
							table.remove(aCapturersHigh, iIdx)
						else
							oPick, iIdx = self:PickContestCapturer(aCapturers, oStrategicPoint, vStratPos)
							if (oPick ~= nil) then
								self.capturing_squad = oPick
								table.remove(aCapturers, iIdx)
							end
						end
					end
				end
				if (self.capturing_squad ~= nil) then
					-- Broken: never assign onto crit / enemy-side start
					if (self:ShouldRefuseBrokenEnemyOrCritStart(self.capturing_squad, oStrategicPoint, 0)) then
						self.capturing_squad = nil
					elseif (bVictory and self:IsEmptyOfEnemyArmy(oStrategicPoint) and
						not self:CanSafelyTakeEmptyVictory(self.capturing_squad, oStrategicPoint)) then
						self.capturing_squad = nil
					else
						self.capturing_flag = oStrategicPoint
						break
					end
				end
			end
		end
	end
       end

	-- Soft/army AFK fallback: StratPoints filters skipped a free empty → still send someone
	-- MUST respect secure phase — without it empty mid/crit beat contested homeside
	if (self.capturing_flag == nil and self.capturing_squad == nil) then
		local oSoft, iSoftIdx = self:PickDedicatedCapturerForPoint(aCapturers, cpu_manager.start_pos)
		local oCap = oSoft
		local iCapIdx = iSoftIdx
		local bFromSoft = (oSoft ~= nil)
		if (oCap == nil) then
			oCap, iCapIdx = self:PickCapturerForPoint(aCapturers, cpu_manager.start_pos, false, false)
			bFromSoft = false
		end
		if (oCap ~= nil) then
			local oBest = nil
			local iBestRank = nil
			local iBestDist = nil
			local vCapPos = oCap:GetPosition()
			local bBlockMidCrit = self:ShouldBlockMidCritExpand()
			for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
				if (oStrategicPoint ~= nil and not oStrategicPoint:IsLocked() and
					not cpu_manager:IsFriendly(oStrategicPoint:Owner()) and
					not self:IsOnAbortCooldown(oStrategicPoint:GetPosition())) then
					local bCrit = (oStrategicPoint:IsStrategicObjective() and not oStrategicPoint:IsRelic())
					local bEmpty = self:IsEmptyOfEnemyArmy(oStrategicPoint)
					-- Secure first: contested homeside OK via CanCapture; never mid/crit
					if (bSecureHome and not self:CanCaptureDuringHomeSideSecure(oStrategicPoint)) then
					elseif (bCrit and not self:CanSafelyTakeEmptyVictory(oCap, oStrategicPoint) and
						not (bUrgentTH and bCrit)) then
					elseif (not bSecureHome and not bEmpty and not (bUrgentTH and bCrit)) then
					elseif (bCrit and not bUrgentTH and self:NeedsHomeSideRelicBeforeCrit()) then
					elseif (self:ShouldRefuseBrokenEnemyOrCritStart(oCap, oStrategicPoint, 0)) then
					-- Defend my base / mid Respond-to-raid: AFK fallback must not send to mid/crit
					elseif (bBlockMidCrit and not bUrgentTH and
						not self:IsRegularHomeSidePoint(oStrategicPoint) and
						not self:IsHomeSideSecureTarget(oStrategicPoint)) then
					else
						local iRank = self:GetCapturePriorityRank(oStrategicPoint)
						local iDist = distance_sqr(vCapPos, oStrategicPoint:GetPosition())
						if (oBest == nil or iRank < iBestRank or (iRank == iBestRank and iDist < iBestDist)) then
							oBest = oStrategicPoint
							iBestRank = iRank
							iBestDist = iDist
						end
					end
				end
			end
			if (oBest ~= nil) then
				-- If soft far and army much closer to best empty — switch to army
				if (bFromSoft) then
					local oArmyNear, iArmyIdx = self:PickCapturerForPoint(aCapturers, oBest:GetPosition(), false, false)
					if (oArmyNear ~= nil and oArmyNear:GetID() ~= oCap:GetID()) then
						local fSoftPrefer = CapturePlan.SoftPreferDistSqrFactor
						if (fSoftPrefer == nil or fSoftPrefer < 1) then
							fSoftPrefer = 2.25
						end
						local iSoftD = distance_sqr(vCapPos, oBest:GetPosition())
						local iArmyD = distance_sqr(oArmyNear:GetPosition(), oBest:GetPosition())
						if (iSoftD > iArmyD * fSoftPrefer) then
							oCap = oArmyNear
							iCapIdx = iArmyIdx
							bFromSoft = false
						end
					end
				end
				self.capturing_squad = oCap
				if (iCapIdx ~= nil) then
					table.remove(aCapturers, iCapIdx)
				end
				self.capturing_flag = oBest
			end
		end
	end

	-- Check if we found a flag to capture
	if (self.capturing_flag ~= nil and self.capturing_squad ~= nil) then
		local vFlagPos = self.capturing_flag:GetPosition()
		local iTries = 0
		while (self.capturing_squad ~= nil and iTries < 6) do
			iTries = iTries + 1
			-- Necron POST LOCK: skip this scarab, try next capturer for same flag
			if (self:SetCapturerPlanMove(self.capturing_squad)) then
				Plan.LockResource(self, self.capturing_flag)
				Plan.LockResource(self, self.capturing_squad)
				AITrace.Log("Capture.Assign", "ASSIGN "..self:DbgSquad(self.capturing_squad).." -> "..
					self:DbgFlag(self.capturing_flag)..
					" secure="..tostring(CapturePlan:NeedsHomeSideSecurePhase())..
					" empty="..tostring(self:IsEmptyOfEnemyArmy(self.capturing_flag))..
					" contested="..tostring(self:IsContestedHomeSidePoint(self.capturing_flag)))
				self:CaptureFlag()
				return true
			end
			AITrace.Log("Capture.Assign", "ASSIGN refuse SetCapturerPlanMove "..self:DbgSquad(self.capturing_squad))
			local iSkipId = self.capturing_squad:GetID()
			self.capturing_squad = nil
			-- Drop refused from lists
			for iLoop1 = table.getn(aCapturers), 1, -1 do
				if (aCapturers[iLoop1][1]:GetID() == iSkipId) then
					table.remove(aCapturers, iLoop1)
				end
			end
			for iLoop1 = table.getn(aCapturersHigh), 1, -1 do
				if (aCapturersHigh[iLoop1][1]:GetID() == iSkipId) then
					table.remove(aCapturersHigh, iLoop1)
				end
			end
			local oPick, iIdx = self:PickDedicatedCapturerForPoint(aCapturers, vFlagPos)
			if (oPick == nil) then
				oPick, iIdx = self:PickCapturerForPoint(aCapturers, vFlagPos, false, true)
			end
			if (oPick == nil) then
				oPick, iIdx = self:PickCapturerForPoint(aCapturersHigh, vFlagPos, false, true)
				if (oPick ~= nil) then
					table.remove(aCapturersHigh, iIdx)
				end
			elseif (iIdx ~= nil) then
				table.remove(aCapturers, iIdx)
			end
			self.capturing_squad = oPick
		end
		self.capturing_flag = nil
		self.capturing_squad = nil
		return false
	end
	self.capturing_flag = nil
	self.capturing_squad = nil
	return false
end

function CapturePlan:FightBack()

	AITrace.Log("Capture.Noise", "CapturePlan: Fight back...")

	-- Check if we've a flag and a capturer
	if (self.capturing_flag == nil or self.capturing_squad == nil) then
		Plan.SetState(self, "Capture New Flag", CapturePlan.CaptureFlag)
		return
	end

	-- If no more danger, wait briefly before resuming capture (stops hurt flicker jitter)
	if (not self.capturing_squad:WasRecentlyHurt()) then
		if (self.m_iFightBackClearTime == nil) then
			self.m_iFightBackClearTime = g_iGMT
		end
		if (g_iGMT >= self.m_iFightBackClearTime + CapturePlan.FightBackClearDelay) then
			self.m_iFightBackClearTime = nil
			Plan.SetState(self, "Capture Flag Again", CapturePlan.CaptureFlag)
		end
		return
	end
	self.m_iFightBackClearTime = nil

	-- Check owner
	local owner = self.capturing_flag:Owner()
	if (cpu_manager:IsFriendly(owner) and owner ~= cpu_manager.player_id) then
		AITrace.Log("Capture.Noise", "CapturePlan: Flag already captured by an ally!")
		self:UnlockResource(self.capturing_flag)
		self.capturing_flag = nil
		Plan.SetState(self, "Capture New Flag", CapturePlan.CaptureFlag)
		return
	end
	
    -- Figure out military threat
    local vPos = self.capturing_squad:GetPosition()
    local iEnemyStrength = cpu_manager:GetArmyStrengthAtPos(vPos, self.m_iThreatRange, true)
	
	-- If current threat is too strong, then retreat
	local iSquadPower = self.capturing_squad:GetTactic():GetUnitStrength()
	if ((iSquadPower < iEnemyStrength and iEnemyStrength > 100) or 3 * iSquadPower < 2 * iEnemyStrength) then
	   	AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Too dangerous!")
	   	AITrace.Log("Capture.Abort", "CapturePlan: SquadStrength = "..tostring(iSquadPower).." Threat = "..tostring(iEnemyStrength))
		self:FreeRessources(true, true)
		return
	end
	
    -- Check for stealth troops
	if (self:CheckStealthThreat(vPos)) then
   		AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Can't attack stealth troops!")
		self:FreeRessources(true, true)
		return
    end
		
	-- Set Hold state
	local oTactic = self.capturing_squad:GetTactic()
	oTactic:SetState(Tactic.States.Hold)
	oTactic:SetTarget(self.capturing_flag:GetEntity():GetPosition(), Tactic.Variant.Vector)
	
	-- Early top-up while fighting for SP (same gate as pre-departure)
	if (self.capturing_squad:IsInCombat()) then
		self:TryTopUpCapturer()
	end
end

function CapturePlan:CheckStealthThreat(vPos)

	-- No problem for hunters
	if (self.capturing_squad:IsDetector() and self.capturing_squad:GetTactic():IsAttacker()) then
		return false
	end

	-- Check for stealth troops
	if (cpu_manager.cpu_player:FindFirstInfiltratedEnemy(vPos, self.m_iThreatRange, 1) == nil) then
		return false
	end
	return true
end

function CapturePlan:CapturingFlag()

	AITrace.Log("Capture.Noise", "CapturePlan: Capturing flag...")
	
	-- Check if we've a flag and a living capturer
	if (self.capturing_flag == nil or self.capturing_squad == nil) then
		return
	end
	
	-- Check if an ally is capturing or our capturing is finished
	local iOwner = self.capturing_flag:Owner()
	local bOwnedByMe = (cpu_manager:IsFriendly(iOwner) and iOwner == cpu_manager.player_id)
	local bOwnedByAlly = (cpu_manager:IsFriendly(iOwner) and iOwner ~= cpu_manager.player_id)
	if (bOwnedByAlly or (bOwnedByMe and self.capturing_flag:FinishedCapturing())) then
		AITrace.Log("Capture.Noise", "CapturePlan: Flag captured by an ally!")
		self:FreeRessources(true)
		return
	end

	local vFlagPos = self.capturing_flag:GetPosition()
	local fProgress = 0
	if (self.capturing_flag.GetCaptureProgress ~= nil) then
		fProgress = self.capturing_flag:GetCaptureProgress()
	end

	local bIsCapturing = self.capturing_squad:IsCapturing()
	local bCommitted = (bIsCapturing or fProgress >= CapturePlan.MinProgressToCommit or
		g_iGMT < self.m_iCaptureCommitUntil)
	local bMustStayVictory = self:MustStayOnVictoryPoint()
	local bEmergencyVictory = (self:IsTakeAndHoldEmergency() and self:IsTakeAndHoldVictoryCapture())
	local bSecurePush = (CapturePlan:NeedsHomeSideSecurePhase() and
		self:IsHomeSideSecureTarget(self.capturing_flag) and
		self:IsContestedHomeSidePoint(self.capturing_flag) and
		self:AllOtherRegularHomeSidesOwned(self.capturing_flag))
	local bAttacker = true
	local oCapTactic = self.capturing_squad:GetTactic()
	if (oCapTactic ~= nil) then
		bAttacker = oCapTactic:IsAttacker()
	end
	local bOwnedByEnemy = (not cpu_manager:IsFriendly(iOwner) and iOwner ~= 0)

	-- Broken / AvoidDeath first — before T&H / clear-then-capture early returns re-DoDefault
	-- Urgent T&H victory: never abort for peel (die on the flag, even 1 model)
	if (self:IsCapturerEmergencyPeeling(self.capturing_squad) and
		not bMustStayVictory and not bEmergencyVictory) then
		AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Capturer retreating under fire!")
		self:FreeRessources(true, true)
		return
	end

	-- Broken: do not start / clear crit or enemy-side (≥0.85 finish still allowed)
	if (self:ShouldRefuseBrokenEnemyOrCritStart(self.capturing_squad, self.capturing_flag, fProgress)) then
		AITrace.Log("Capture.Abort", "CapturePlan: Abort! Broken — capture not allowed!")
		self:FreeRessources(true, true)
		return
	end

	-- Contested: outmatched → leave (crit / enemy homeside). T&H MustStay excepted.
	-- Do not suicide once committed on a dangerous flag outside T&H.
	-- Free recruitment Slugga: ignore threat — keep capping unbuilt points alone.
	-- High progress (≥0.85): finish the point despite local outmatch / melee.
	-- Enemy-side: only abort if allied < enemy @30 (clear phase gathers to 1.2× / caps at 2×).
	local bIgnoreCapThreat = (oCapTactic ~= nil and oCapTactic.IgnoresCaptureThreat ~= nil and
		oCapTactic:IgnoresCaptureThreat())
	local bFinishDespite = self:ShouldFinishCaptureDespiteThreat(fProgress, self.capturing_squad)
	-- Heavy force/outmatch/clear-then: every CapThreatCheckInterval unless T&H / ≥0.85
	local bHeavyCapThreat = (bMustStayVictory or bEmergencyVictory or bFinishDespite)
	if (not bHeavyCapThreat) then
		if (self.m_iNextCapThreatCheck == nil or g_iGMT >= self.m_iNextCapThreatCheck) then
			bHeavyCapThreat = true
			local iInterval = CapturePlan.CapThreatCheckInterval
			if (iInterval == nil) then
				iInterval = 1.25
			end
			self.m_iNextCapThreatCheck = g_iGMT + iInterval
		end
	end
	local bEnemySideEarly = self:IsEnemySideCapturePoint(self.capturing_flag)
	if (bHeavyCapThreat and not bIgnoreCapThreat and not bFinishDespite and not self:MustStayOnVictoryPoint() and
		not self:IsEmptyOfEnemyArmy(self.capturing_flag)) then
		local bOutmatched = false
		if (bEnemySideEarly) then
			local iE, iA = self:GetEnemySideForceAtPoint(self.capturing_flag, self.capturing_squad)
			local bNearFight = (distance_sqr(self.capturing_squad:GetPosition(), vFlagPos) <= sqr(35))
			bOutmatched = (iE > 0 and iA < iE and not bCommitted and bNearFight)
		else
			bOutmatched = (not self:CanCapturerContestPoint(self.capturing_squad, self.capturing_flag, nil))
		end
		if (bOutmatched) then
			AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Contested point outmatched!")
			self:FreeRessources(true, true)
			return
		end
	end

	-- Empty-flag crit death: local fire outguns capturer (flag empty-check missed ranged)
	if (not bIgnoreCapThreat and
		self:ShouldAbortDyingCritCapture(self.capturing_squad, self.capturing_flag, fProgress)) then
		AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Dying on crit under fire!")
		self:FreeRessources(true, true)
		return
	end

	-- Crit / off-point capture while homeside/base raided: free for defense
	-- Free Slugga: disposable — do not yank them into home defense (don't steer main army)
	-- Priority yield: no danger blacklist (was: homeside SP cooldown → fallback to mid/crit)
	if (not bIgnoreCapThreat and self:ShouldYieldForHomeDefense()) then
		AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Home defense priority!")
		self:FreeRessources(true, false)
		return
	end
	-- Homeside lost/decapped: drop mid/offside and re-secure
	if (not bIgnoreCapThreat and self:ShouldYieldForHomeSideSecure()) then
		AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Re-secure homeside!")
		self:FreeRessources(true, false)
		return
	end
	-- T&H <2 min: drop non-VP so we retarget victory decap
	if (self:ShouldYieldForUrgentVictory()) then
		AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Urgent T&H victory retarget!")
		self:FreeRessources(true, false)
		return
	end

	-- Tau Stealth 1-model under fire: drop flag immediately (even committed / empty / soft)
	if (cpu_manager:IsFragileOneModelStealth(self.capturing_squad) and
		(self.capturing_squad:IsUnderAttack() or self.capturing_squad:WasRecentlyHurt())) then
		AITrace.Log("Capture.Abort", "CapturePlan: Fragile stealth peel — under fire!")
		self:FreeRessources(true, true)
		return
	end

	-- Emergency / final-minute T&H victory: force decap; never leave the flag
	if (bEmergencyVictory or bMustStayVictory) then
		self:UpdateCaptureGuards()
		if (not bIsCapturing and (self.capturing_squad:IsInStateMove() or self.capturing_squad:IsInCombat())) then
			self:TryTopUpCapturer(false)
		end
		if (bIsCapturing) then
			return
		end
		if (g_iGMT >= self.m_iLastCaptureOrder + CapturePlan.CaptureOrderThrottle) then
			self.capturing_squad:DoDefault(self.capturing_flag:GetEntity())
			self.m_iLastCaptureOrder = g_iGMT
			self.m_iCaptureCommitUntil = g_iGMT + CapturePlan.CaptureCommitGrace
		end
		return
	end

	-- Soft: army appeared on approach → leave (cooldown), then other safe point or help army
	-- Necron scarab: finish the point → POST LOCK LP (never peel mid-cap)
	local oCapTactic = self.capturing_squad:GetTactic()
	local bSoftPack = (oCapTactic ~= nil and oCapTactic:IsDedicatedCapturer())
	local bNecronScarab = cpu_manager:IsNecronBuilderScarab(self.capturing_squad)
	if (bSoftPack and not bNecronScarab and not bSecurePush and not bCommitted and
		not self:IsEmptyOfEnemyArmy(self.capturing_flag)) then
		AITrace.Log("Capture.Abort", "CapturePlan: Soft capturer peel — point no longer safe!")
		self:FreeRessources(true, true)
		return
	end

	-- Non-homeside: clear @ ≥1.2×, capture only @ ≥2× / empty (no WasRecentlyHurt)
	local bFinishPush = (bFinishDespite and not self:HasBlockingEnemyPost(self.capturing_flag))
	local bEnemySide = self:IsEnemySideCapturePoint(self.capturing_flag)
	local bHoldClearEnemy = (bHeavyCapThreat and bEnemySide and not bIgnoreCapThreat and not bSoftPack and
		not bSecurePush and not bFinishPush and not bMustStayVictory and not bEmergencyVictory and
		not bCommitted and not self:HasBlockingEnemyPost(self.capturing_flag) and
		not self:CanCaptureEnemySidePoint(self.capturing_flag))
	if (bHoldClearEnemy) then
		local iEnemy, iAllied = self:GetEnemySideForceAtPoint(self.capturing_flag, self.capturing_squad)
		local bNearFight = (distance_sqr(self.capturing_squad:GetPosition(), vFlagPos) <= sqr(35))
		-- Hopeless only at the flag (far: walk + gather guards to 1.2×)
		if (bNearFight and iEnemy > 0 and iAllied < iEnemy and not bCommitted) then
			AITrace.Log("Capture.Abort", "CapturePlan: Abort approach! Enemy-side outmatched @30!")
			self:FreeRessources(true, true)
			return
		end
		if (self.m_iDbgWaitLog == nil or g_iGMT >= self.m_iDbgWaitLog + 2) then
			AITrace.Log("Capture.Wait", "WAIT clear-enemy "..self:DbgSquad(self.capturing_squad)..
				" flag="..self:DbgFlag(self.capturing_flag)..
				" allied="..tostring(iAllied).." enemy="..tostring(iEnemy)..
				" committed="..tostring(bCommitted))
			self.m_iDbgWaitLog = g_iGMT
		end
		self:UpdateCaptureGuards()
		-- Approach / hold to clear — never DoDefault until 2×
		local iOrderThrottle = CapturePlan.EnemyPointCaptureOrderThrottle
		if (iOrderThrottle == nil) then
			iOrderThrottle = 2
		end
		if (g_iGMT >= self.m_iLastCaptureOrder + iOrderThrottle) then
			local vSquadPos = self.capturing_squad:GetPosition()
			local oTactic = self.capturing_squad:GetTactic()
			if (oTactic ~= nil) then
				if (oTactic:GetState() ~= Tactic.States.Hold) then
					oTactic:SetState(Tactic.States.Hold)
				end
				if (oTactic:GetTarget() == nil or distance_sqr(oTactic:GetTarget(), vFlagPos) > sqr(1)) then
					oTactic:SetTarget(vFlagPos, Tactic.Variant.Vector)
				end
			end
			if (distance_sqr(vFlagPos, vSquadPos) >= sqr(35)) then
				if (self:ShouldReissueApproachMove(self.capturing_squad, vFlagPos)) then
					cpu_manager:DoMove(self.capturing_squad, vFlagPos, false, "Capture clear approach")
				end
			end
			self.m_iLastCaptureOrder = g_iGMT
		end
		return
	end

	-- Homeside clear-then (legacy): real army on secure/home push only
	if (bHeavyCapThreat and not bIgnoreCapThreat and not bSoftPack and not bEnemySide and not bSecurePush and not bFinishPush and
		not self:IsEmptyOfEnemyArmy(self.capturing_flag) and self:HasPointThreat(self.capturing_flag)) then
		if (bCommitted and not self:HasBlockingEnemyPost(self.capturing_flag)) then
		else
			if (self.m_iDbgWaitLog == nil or g_iGMT >= self.m_iDbgWaitLog + 2) then
				AITrace.Log("Capture.Wait", "WAIT clear-then "..self:DbgSquad(self.capturing_squad)..
					" flag="..self:DbgFlag(self.capturing_flag)..
					" committed="..tostring(bCommitted)..
					" guards="..tostring(table.getn(self.guard_squads or {})))
				self.m_iDbgWaitLog = g_iGMT
			end
			self:UpdateCaptureGuards()
			return
		end
	end

	-- Approach abort — empty flags already cleared in ShouldAbortForMoraleOrThreat
	if (not bCommitted and self:ShouldAbortForMoraleOrThreat(self.capturing_squad, self.capturing_flag, fProgress)) then
		AITrace.Log("Capture.Abort", "CapturePlan: Abort approach! Broken/under fire toward unsafe point!")
		self:FreeRessources(true, true)
		return
	end
	
	local bBlockingPost = self:HasBlockingEnemyPost(self.capturing_flag)
	if (bBlockingPost) then
		if (bSecurePush) then
			if (not self:HasArmyMassForHomeSidePush(vFlagPos)) then
				if (not bCommitted and (self.capturing_squad:WasRecentlyHurt() or self.capturing_squad:IsUnderAttack())) then
					if (self.capturing_squad:IsInStateAttackMove() or self.capturing_squad:IsInStateMove()) then
						self.capturing_squad:DoStop()
					end
				end
				if (self.m_iDbgWaitLog == nil or g_iGMT >= self.m_iDbgWaitLog + 2) then
					AITrace.Log("Capture.Wait", "WAIT secure-push mass "..self:DbgSquad(self.capturing_squad)..
						" flag="..self:DbgFlag(self.capturing_flag))
					self.m_iDbgWaitLog = g_iGMT
				end
				self:UpdateCaptureGuards()
				return
			end
		else
			local bHurtNearPost = (self.capturing_squad:WasRecentlyHurt() or self.capturing_squad:IsUnderAttack())
			local bArmed = (self.capturing_flag:HasListeningPost() and self.capturing_flag:HasWeapons())
			if (not bAttacker or bArmed or bHurtNearPost or not bCommitted) then
				AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Enemy listening post / base at flag!")
				self:FreeRessources(true, true)
				return
			end
		end
	end
	if (bOwnedByEnemy and not bCommitted) then
	
		-- Check for infiltrated enemies
		if (self:CheckStealthThreat(self.capturing_flag:GetPosition())) then
			AITrace.Log("Capture.Abort", "CapturePlan: Flag is being captured by an infiltrated enemy and we can't detect them!")
			self:FreeRessources(true, true)
			return
		end
	
		-- Check if we can't attack or the enemy has built a fortified post
		if (not bAttacker) then
		
			-- Check if enemy is capturing
			local bIsBeingCapturedByEnemy = (self.capturing_flag:IsBeingCaptured() and not bIsCapturing)
			if (bIsBeingCapturedByEnemy) then
				AITrace.Log("Capture.Abort", "CapturePlan: Flag is being captured by an enemy and we can't attack!")
				self:FreeRessources(true, true)
				return
			end
		end
	end

	-- Enemy-side top-up only while approaching (DoReinforce cancels capture if already capping)
	if (bHeavyCapThreat and not bIsCapturing and
		(self.capturing_squad:IsInStateMove() or self.capturing_squad:IsInCombat())) then
		self:TryTopUpCapturer(false)
	end

	-- Already on the flag: finish it. Soft hurt / FightBack was start→abort churn.
	if (bCommitted) then
		-- Hard abort only if massively outgunned while hurt — not when ≥0.85 finish push
		if (bHeavyCapThreat and not bFinishDespite and self.capturing_squad:WasRecentlyHurt()) then
			local vPos = self.capturing_squad:GetPosition()
			local iEnemyStrength, iAlliedStrength = cpu_manager:GetArmyStrengthAtPos(vPos, self.m_iThreatRange, true)
			if (iEnemyStrength > 100 and (iAlliedStrength * 2 < iEnemyStrength)) then
				AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Overwhelmed while on flag!")
				self:FreeRessources(true, true)
				return
			end
		end
		if (bIsCapturing) then
			return
		end
		-- Progress stuck / engine dropped capture: re-issue DoDefault sparingly
		local iReissue = CapturePlan.CaptureOrderThrottle
		if (bEnemySide) then
			iReissue = CapturePlan.EnemyPointCaptureOrderThrottle or 2
		end
		if (g_iGMT >= self.m_iLastCaptureOrder + iReissue) then
			self.capturing_squad:DoDefault(self.capturing_flag:GetEntity())
			self.m_iLastCaptureOrder = g_iGMT
			self.m_iCaptureCommitUntil = g_iGMT + CapturePlan.CaptureCommitGrace
		end
		return
	end
		
	-- Homeside approach only: FightBack on hurt (enemy-side uses clear/capture ratios above)
	if (not bEnemySide and self.capturing_squad:WasRecentlyHurt() and not bIgnoreCapThreat) then
	
		local vPos = self.capturing_squad:GetPosition()
		local bNearFlag = (distance_sqr(vPos, vFlagPos) <= sqr(35))

		-- After harassing time only fight back if the capturing squad is close to the capture point
		if (g_iGMT > DefendChokePointPlan.HarassingTime * 60 and not bNearFlag) then
			AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Too dangerous!")
			self:FreeRessources(true, true)
			return
		end
		
		-- Update hurt counter
		self.capturing_squad_hurt = self.capturing_squad_hurt + 1
		     
		-- Figure out military threat
		local iEnemyStrength, iAlliedStrength = cpu_manager:GetArmyStrengthAtPos(vPos, self.m_iThreatRange, true)
		local bOutgunned = (iAlliedStrength < iEnemyStrength) or (3 * iAlliedStrength < 2 * iEnemyStrength)
		-- Ghost chip damage with no army: abort only if FAR from flag (near flag → keep going)
		local bGhostHurtFar = (iEnemyStrength == 0 and self.capturing_squad_hurt > 3 and not bNearFlag)
		-- Non-attacker: abort on real threat, or if hurt while still approaching
		local bNonAttackerThreat = (not bAttacker and (iEnemyStrength > 0 or not bNearFlag))
		
		if (bOutgunned or bGhostHurtFar or bNonAttackerThreat) then
			AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Too dangerous!")
			AITrace.Log("Capture.Abort", "CapturePlan: Power = "..tostring(iAlliedStrength).." Threat = "..tostring(iEnemyStrength))
			self:FreeRessources(true, true)
			return
		end
		
		-- Check for stealth troops
		if (self:CheckStealthThreat(vPos)) then
			AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Can't attack stealth troops!")
			self:FreeRessources(true, true)
			return
		end
		
		-- Fight only if there is a real enemy army (empty FightBack↔Capture churn = jitter)
		if (iEnemyStrength > 0 and not bNearFlag) then
			Plan.SetState(self, "Fighting back!", CapturePlan.FightBack)
			local oTactic = self.capturing_squad:GetTactic()
			oTactic:SetState(Tactic.States.Hold)
			oTactic:SetTarget(self.capturing_flag:GetEntity():GetPosition(), Tactic.Variant.Vector)
			return
		end
		-- Near flag, hurt, no decisive threat: proceed to capture
	end

	-- Throttle re-orders: DoDefault/DoMove every tick = start/stop/walk loops
	local iCapThrottle = CapturePlan.CaptureOrderThrottle
	if (bEnemySide) then
		iCapThrottle = CapturePlan.EnemyPointCaptureOrderThrottle or 2
	end
	if (g_iGMT < self.m_iLastCaptureOrder + iCapThrottle) then
		return
	end
	
	-- Get info
	local vSquadPos = self.capturing_squad:GetPosition()
	local oTactic = self.capturing_squad:GetTactic()

	-- Broken near flag: never issue DoDefault unless BrokenCaptureAllowed
	if (self:ShouldRefuseBrokenCapture(self.capturing_squad, self.capturing_flag, fProgress)) then
		AITrace.Log("Capture.Abort", "CapturePlan: Abort! Broken — refuse near-flag DoDefault!")
		self:FreeRessources(true, true)
		return
	end

	-- Check if we should capture the flag directly or just walk there in attack mode
    if (g_iGMT < 60) then
    
    	-- At gamestart squads should start immediatly (Larkin edit: 13.01.2008)
		AITrace.Log("Capture.Order", "ORDER DoDefault early "..self:DbgSquad(self.capturing_squad).." -> "..self:DbgFlag(self.capturing_flag))
        self.capturing_squad:DoDefault(self.capturing_flag:GetEntity())
		self.m_iLastCaptureOrder = g_iGMT
		self.m_iCaptureCommitUntil = g_iGMT + CapturePlan.CaptureCommitGrace
        
    else
    
        if (oTactic:GetState() ~= Tactic.States.Hold) then
            oTactic:SetState(Tactic.States.Hold)
        end
        if (oTactic:GetTarget() == nil or distance_sqr(oTactic:GetTarget(), vFlagPos) > sqr(1)) then
            oTactic:SetTarget(vFlagPos, Tactic.Variant.Vector)
			AITrace.Log("Capture.Order", "RETARGET Hold "..self:DbgSquad(self.capturing_squad).." -> "..vec2str(vFlagPos))
        end
        if (distance_sqr(vFlagPos, vSquadPos) < sqr(35)) then
			AITrace.Log("Capture.Order", "ORDER DoDefault near "..self:DbgSquad(self.capturing_squad).." -> "..self:DbgFlag(self.capturing_flag))
            self.capturing_squad:DoDefault(self.capturing_flag:GetEntity())
			self.m_iLastCaptureOrder = g_iGMT
			self.m_iCaptureCommitUntil = g_iGMT + CapturePlan.CaptureCommitGrace
			self.m_iLastApproachDistSqr = nil
        else
			if (self:ShouldReissueApproachMove(self.capturing_squad, vFlagPos)) then
				AITrace.Log("Capture.Order", "ORDER approach "..self:DbgSquad(self.capturing_squad).." -> "..vec2str(vFlagPos))
				cpu_manager:DoMove(self.capturing_squad, vFlagPos, false, "Capture approach")
			else
				AITrace.Log("Capture.Order", "ORDER approach skip "..self:DbgSquad(self.capturing_squad).." -> "..vec2str(vFlagPos))
			end
			self.m_iLastCaptureOrder = g_iGMT
        end
    end
end

function CapturePlan:CaptureFlag()

	-- Check if we've a flag and a capturer
	if (self.capturing_flag == nil or self.capturing_squad == nil) then
		Plan.SetNeeds( self, "Obtain ressources", CapturePlan.ObtainRessources )
		return
	end

	if (self:IsCapturerEmergencyPeeling(self.capturing_squad) and
		not self:MustStayOnVictoryPoint() and
		not (self:IsTakeAndHoldEmergency() and self:IsTakeAndHoldVictoryCapture())) then
		AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Capturer retreating under fire!")
		self:FreeRessources(true, true)
		return
	end
	local fCapProgressEarly = 0
	if (self.capturing_flag.GetCaptureProgress ~= nil) then
		fCapProgressEarly = self.capturing_flag:GetCaptureProgress()
	end
	if (self:ShouldRefuseBrokenEnemyOrCritStart(self.capturing_squad, self.capturing_flag, fCapProgressEarly)) then
		AITrace.Log("Capture.Abort", "CapturePlan: Abort! Broken — capture not allowed!")
		self:FreeRessources(true, true)
		return
	end
	local bMustStayVictoryEarly = self:MustStayOnVictoryPoint()
	local bFinishEarly = self:ShouldFinishCaptureDespiteThreat(fCapProgressEarly, self.capturing_squad)
	local bEmergencyVictoryEarly = (self:IsTakeAndHoldEmergency() and self:IsTakeAndHoldVictoryCapture())
	local bHeavyCapThreat = (bMustStayVictoryEarly or bEmergencyVictoryEarly or bFinishEarly)
	if (not bHeavyCapThreat) then
		if (self.m_iNextCapThreatCheck == nil or g_iGMT >= self.m_iNextCapThreatCheck) then
			bHeavyCapThreat = true
			local iInterval = CapturePlan.CapThreatCheckInterval
			if (iInterval == nil) then
				iInterval = 1.25
			end
			self.m_iNextCapThreatCheck = g_iGMT + iInterval
		end
	end
	if (bHeavyCapThreat and not bMustStayVictoryEarly and not bFinishEarly and
		not self:IsEmptyOfEnemyArmy(self.capturing_flag)) then
		local bOutmatched = false
		if (self:IsEnemySideCapturePoint(self.capturing_flag)) then
			local iE, iA = self:GetEnemySideForceAtPoint(self.capturing_flag, self.capturing_squad)
			local bNearFight = (distance_sqr(self.capturing_squad:GetPosition(),
				self.capturing_flag:GetPosition()) <= sqr(35))
			bOutmatched = (iE > 0 and iA < iE and bNearFight)
		else
			bOutmatched = (not self:CanCapturerContestPoint(self.capturing_squad, self.capturing_flag, nil))
		end
		if (bOutmatched) then
			AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Contested point outmatched!")
			self:FreeRessources(true, true)
			return
		end
	end
	if (self:ShouldAbortDyingCritCapture(self.capturing_squad, self.capturing_flag, fCapProgressEarly)) then
		AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Dying on crit under fire!")
		self:FreeRessources(true, true)
		return
	end
	-- Priority yield: no danger blacklist (homeside cooldown → mid/crit fallback)
	if (self:ShouldYieldForHomeDefense()) then
		AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Home defense priority!")
		self:FreeRessources(true, false)
		return
	end
	if (self:ShouldYieldForHomeSideSecure()) then
		AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Re-secure homeside!")
		self:FreeRessources(true, false)
		return
	end
	if (self:ShouldYieldForUrgentVictory()) then
		AITrace.Log("Capture.Abort", "CapturePlan: Abort capturing! Urgent T&H victory retarget!")
		self:FreeRessources(true, false)
		return
	end
	
	-- Get info
	local vFlagPos = self.capturing_flag:GetPosition()
	local vSquadPos = self.capturing_squad:GetPosition()
	local oTactic = self.capturing_squad:GetTactic()
	
	oTactic:SetState(Tactic.States.Hold)
	oTactic:SetTarget(vFlagPos, Tactic.Variant.Vector)

	local bEmergencyVictory = bEmergencyVictoryEarly
	local bSecurePush = (CapturePlan:NeedsHomeSideSecurePhase() and
		self:IsHomeSideSecureTarget(self.capturing_flag) and
		self:IsContestedHomeSidePoint(self.capturing_flag) and
		self:AllOtherRegularHomeSidesOwned(self.capturing_flag))
	local fCapProgress = fCapProgressEarly
	local bFinishPush = (bFinishEarly and not self:HasBlockingEnemyPost(self.capturing_flag))
	-- Enemy-side: clear @1.2×, capture only @2× / empty. Homeside: legacy HasPointThreat hold.
	local bEnemySide = self:IsEnemySideCapturePoint(self.capturing_flag)
	local bHoldForClear = false
	if (bHeavyCapThreat and not bEmergencyVictory and not bSecurePush and not bFinishPush) then
		if (bEnemySide) then
			bHoldForClear = (not self:HasBlockingEnemyPost(self.capturing_flag) and
				not self:CanCaptureEnemySidePoint(self.capturing_flag))
		else
			bHoldForClear = (not self:IsEmptyOfEnemyArmy(self.capturing_flag) and
				self:HasPointThreat(self.capturing_flag))
		end
	end

	if (not bHoldForClear) then
		if (distance_sqr(vFlagPos, vSquadPos) < sqr(35)) then
			self.capturing_squad:DoDefault(self.capturing_flag:GetEntity())
			self.m_iCaptureCommitUntil = g_iGMT + CapturePlan.CaptureCommitGrace
			self.m_iLastApproachDistSqr = nil
			if (bHeavyCapThreat) then
				self:TryTopUpCapturer(true)
			end
		elseif (self:ShouldReissueApproachMove(self.capturing_squad, vFlagPos)) then
			AITrace.Log("Capture.Order", "ORDER approach start "..self:DbgSquad(self.capturing_squad).." -> "..vec2str(vFlagPos))
			cpu_manager:DoMove(self.capturing_squad, vFlagPos, false, "Capture approach")
		end
	else
		self:UpdateCaptureGuards()
		-- Enemy-side clear: walk to the fight, never DoDefault until 2×
		if (bEnemySide and self:ShouldReissueApproachMove(self.capturing_squad, vFlagPos)) then
			cpu_manager:DoMove(self.capturing_squad, vFlagPos, false, "Capture clear approach")
		end
	end
	self.m_iLastCaptureOrder = g_iGMT
	
	-- Set plan states
	self:OnEvent(Plan.Events.OnPlanStart)
	Plan.SetState(self, "Capturing flag", CapturePlan.CapturingFlag)
	Plan.SetNeeds( self, "No needs", Plan.NeedsFulfilled )
end

function CapturePlan:Update()

	if (self:IsComplete()) then
		return
	end

	AITrace.Log("Capture.Noise", "CapturePlan: Update...")

	self:UpdateCaptureGuards()

  --  if g_iGMT > 240 then
    --   CapturePlan.StartActually = false
    --end
    -- Проверка доступных захватчиков каждые 10 секунд
    if math.mod(g_iGMT, 10) == 0 then
        local capturers = cpu_manager:GetAvailableCapturers()
        local high_capturers = cpu_manager:GetAvailableCapturersHigh()
        local start_capturers = cpu_manager:GetAvailableCapturersStart()
        
		AITrace.Log("Capture.Noise", "Capturers available: "..
				table.getn(capturers).." regular, "..
				table.getn(high_capturers).." high, "..
				table.getn(start_capturers).." start")
        
		-- Используйте ее в условии
		if CountTableItems(capturers) == 0 and 
		   CountTableItems(high_capturers) == 0 and 
		   CountTableItems(start_capturers) == 0 then
			
			AITrace.Log("Capture.Noise", "No capturers available! Requesting new squad...")
			--self:RequestCapturerSquad()
		end
    end

	
	-- Check if we lost our capturer
	if (self.capturing_squad ~= nil and not self.capturing_squad:IsValid()) then
		self:UnlockCapturingSquad(self.capturing_squad)
		self.capturing_squad = nil
		self.capturing_squad_hurt = 0
		Plan.SetState(self, "Capture Flag", CapturePlan.CaptureFlag)

	elseif (self.capturing_squad ~= nil and DefendStrategy.bDefending and cpu_manager:GetArmyStrength() < 2000) then
		
		-- Check if our capturer is needed for defense 
		if (self.capturing_squad:GetTactic():GetUnitStrength() > 300 and g_iGMT < DefendChokePointPlan.HarassingTime  and
			self.capturing_squad:IsCapturing() and
			self.capturing_flag ~= nil and 
			self.capturing_flag:Owner() == cpu_manager.player_id and
			self.capturing_flag:GetCaptureProgress() < 0.3) then
				
			cpu_manager:DoMove(self.capturing_squad, self.capturing_squad:GetPosition(), true, "Interrupt capturing!")
			self:UnlockCapturingSquad(self.capturing_squad)
			self.capturing_squad = nil
			self.capturing_squad_hurt = 0
			Plan.SetState(self, "Capture Flag", CapturePlan.CaptureFlag)
		end

       elseif (self.capturing_squad ~= nil and self.capturing_squad:IsValid()) then
		
		if (self.capturing_flag ~= nil and
			self.capturing_flag:Owner() == cpu_manager.player_id and
			self.capturing_flag:FinishedCapturing()) then
			self:FreeRessources(true)
		end
	end
	
	Plan.Update(self)
end
aitrace("CapturePlan PATCH applied successfully!")