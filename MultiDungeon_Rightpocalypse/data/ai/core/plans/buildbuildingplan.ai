import ("Plans/BuildPlan.ai")

class 'BuildBuildingPlan' (BuildPlan)

BuildBuildingPlan.UNREACHABLE_RETRY_SEC = 12
BuildBuildingPlan.IDLE_LOCKED_ABORT_SEC = 25
BuildBuildingPlan.CANBUILD_CHECK_RANGE = 28
-- AFK-on-height: track map position, not IsIdle
BuildBuildingPlan.STATIONARY_STUCK_SEC = 10
BuildBuildingPlan.STATIONARY_MOVE_SQR = 4
BuildBuildingPlan.STATIONARY_APPROACH_DIST = 10
BuildBuildingPlan.STATIONARY_WORK_GRACE_SEC = 30

function BuildBuildingPlan:__init( building_id, build_pos, wait_on_builder, bKeepBuildPos, bPlacementResolved, oAssignedEngineer) super( CpuPlayer.CT_BuildBuildings )

	self.bestPosition = nil
	self.m_bKeepBuildPos = (bKeepBuildPos == true)
	self.m_oAssignedEngineer = nil
	self.m_iAssignedEngineerID = nil
	self:SetAssignedEngineer(oAssignedEngineer)
	self.m_iPlacementFailCount = 0
	self.m_iStuckSince = nil
	self.m_iUnreachableSince = nil
	self.m_iStationarySince = nil
	self.m_vStationaryPos = nil
	self.m_iStationaryPhase = 0
	self.m_bStationaryHadWork = false
	-- Necron/Ork: bind plan to one pad (FindUnfinishedBuilding is global → pile-on)
	self.m_iClaimedBuildingId = nil

	-- Nil if you want to automatically quit out on failure
	self.wait_on_builder = wait_on_builder
	
	self.front = front
	-- Scarabs do need extra attention
	self.shift_move = 0
	self.shifted = false

	-- The building i'm trying to build
	BuildPlan.SetItemID( self, building_id )
	BuildPlan.SetItemName( self, cpu_manager.stats:GetBuildingName( building_id ) )

	dbAssert( self.item_name ~= nil )
	
	Plan.SetNeeds( self, "Asking for builder", BuildBuildingPlan.ObtainBuilder )
	Plan.SetState( self, "Wanting to build: "..self.item_name, BuildBuildingPlan.BuildBuilding )
	Plan.SetName( self, "Build Building Plan" )
	
	-- Init build position
	if (build_pos ~= nil) then
		if (not self.m_bKeepBuildPos and bPlacementResolved ~= true and
			cpu_manager:UsesEngineerSafePlacement(building_id)) then
			build_pos = cpu_manager:FindEngineerSafeBuildPosition(building_id, build_pos)
		end
		if (self.m_oAssignedEngineer == nil) then
			self:SetAssignedEngineer(cpu_manager:GetClosestEngineerForBuild(building_id, build_pos, true, false))
		end
		self.build_pos = Vector2f()
		self.build_pos.x = build_pos.x
		self.build_pos.y = build_pos.z
		self.copy_build_pos = Vector3f( build_pos )
	end
	
	-- Check for unfinished building without builder
	local oBuilding = build_manager:FindUnfinishedBuilding( self.item_id )	
	if (oBuilding) then
	
		-- Check if building has a builder
		local has_builder = false
		for squad_ai in military_manager:GetSquads() do
			
			-- Check builder
			if (squad_ai:IsValid() and squad_ai:IsEngineer() and squad_ai:IsBuilding() == self.item_id) then
				has_builder = true
				break
			end
		end
		
		-- If building has no builder then finish it
		if (not has_builder) then		
			aitrace("BuildBuildingPlan: Finish building...")
			self:MarkConstructionStarted()
			self.copy_build_pos = Vector3f(oBuilding:GetPosition())
			self.bestPosition = Vector3f(oBuilding:GetPosition())
			self.build_pos = Vector2f()
			self.build_pos.x = self.bestPosition.x
			self.build_pos.z = self.bestPosition.z
			Plan.SetNeeds( self, "Fixing building...", BuildBuildingPlan.ObtainNewBuilder )
			Plan.SetState( self, "Try to fix building: "..self.item_name, BuildBuildingPlan.FixState )
		end
	end
	
	-- Force HQ rebuilds
	self.m_bEmergencyHQ = false
	if (cpu_manager:IsHQ(building_id)) then
		self.m_bEmergencyHQ = true
	end
	
	self.assistant_builder = nil
end

function BuildBuildingPlan:IsEpochPlan()
	return (self.item_name ~= nil and EngineerTactic.IsEpochTransitionBuilding(self.item_name))
end

-- BuildOrder waits on OnPlanStart — must fire when construction is marked started early
-- (Retry/unfinished/abort), otherwise BO never completes and BuildBase (addons) never runs.
function BuildBuildingPlan:MarkConstructionStarted()
	if (self.started_building) then
		return
	end
	self.started_building = true
	self:OnEvent( Plan.Events.OnPlanStart )
end

-- Used by BuildPlan.BuildingState — unfinished footprint means plan is NOT done.
function BuildBuildingPlan:IsConstructionStillPending()
	return (build_manager:FindUnfinishedBuilding(self.item_id) ~= nil)
end

function BuildBuildingPlan:MarkBuilderEpochCommitment()
	if (not self:IsEpochPlan() or self.builder == nil or not self.builder:IsValid()) then
		return
	end
	local oBuilding = self.building
	if (oBuilding == nil) then
		oBuilding = build_manager:FindUnfinishedBuilding(self.item_id)
	end
	if (oBuilding == nil) then
		return
	end
	-- FindUnfinishedBuilding returns an entity (GetID); BaseAI has GetEntity():GetID()
	local iTargetId = nil
	if (type(oBuilding.GetEntity) == "function") then
		local oEnt = oBuilding:GetEntity()
		if (oEnt ~= nil) then
			iTargetId = oEnt:GetID()
		end
	end
	if (iTargetId == nil and type(oBuilding.GetID) == "function") then
		iTargetId = oBuilding:GetID()
	end
	if (iTargetId == nil) then
		return
	end
	local oTactic = self.builder:GetTactic()
	if (oTactic ~= nil) then
		oTactic.m_iEpochBuildTargetId = iTargetId
		oTactic.m_bBusy = true
	end
end

function BuildBuildingPlan:NeedsAssistantBuilder()
	-- Necron/Ork: never 2nd worker on a pad (incl. epoch)
	if (EngineerTactic.ShouldDisableGeneralAssist()) then
		return false
	end
	if (not self:IsEpochPlan()) then
		return false
	end
	return cpu_manager.player_stats:GetNumBasesByBPID(self.item_id, true) < 1
end

-- This plan's unfinished pad only (Necron/Ork parallel gens must not share FindUnfinishedBuilding)
function BuildBuildingPlan:FindOwnUnfinishedBuilding()

	local function ToEnt( oBuilding )
		local oLive, oEnt = EngineerTactic.ResolveLiveFinishTarget(oBuilding)
		if (oLive == nil) then
			return nil
		end
		if (oEnt ~= nil) then
			return oEnt
		end
		return oLive
	end

	local iNearSqr = sqr(30)
	if (self.m_iClaimedBuildingId ~= nil) then
		for oBuilding in cpu_manager.player_stats:GetBases() do
			if (oBuilding:IsValid() and oBuilding:GetID() == self.m_iClaimedBuildingId) then
				if (not oBuilding:IsConstructionDone() and
					oBuilding:GetBlueprintID() == self.item_id) then
					return ToEnt(oBuilding)
				end
				self.m_iClaimedBuildingId = nil
				break
			end
		end
	end

	if (self.bestPosition ~= nil) then
		local oBest = nil
		local iBestDist = iNearSqr
		for oBuilding in cpu_manager.player_stats:GetBases() do
			if (oBuilding:IsValid() and not oBuilding:IsConstructionDone() and
				oBuilding:GetBlueprintID() == self.item_id) then
				local iDist = distance_sqr(oBuilding:GetPosition(), self.bestPosition)
				if (iDist < iBestDist) then
					iBestDist = iDist
					oBest = oBuilding
				end
			end
		end
		if (oBest ~= nil) then
			return ToEnt(oBest)
		end
		local oAny = build_manager:FindUnfinishedBuilding(self.item_id)
		local oLiveAny = EngineerTactic.ResolveLiveFinishTarget(oAny)
		if (oLiveAny ~= nil and distance_sqr(oLiveAny:GetPosition(), self.bestPosition) < iNearSqr) then
			return ToEnt(oLiveAny)
		end
		-- Necron/Ork: never steal a distant unfinished pad for another plan
		if (EngineerTactic.ShouldDisableGeneralAssist()) then
			return nil
		end
	end

	if (EngineerTactic.ShouldDisableGeneralAssist()) then
		return nil
	end
	return ToEnt(build_manager:FindUnfinishedBuilding(self.item_id))
end

-- DoFinish only on live pads (destroyed thermo/plasma/LP → no pure-virtual crash)
function BuildBuildingPlan:SafeDoFinish( oSquad, oPad )

	if (not EngineerTactic.SafeDoFinishBuilding(oSquad, oPad)) then
		local oLive = EngineerTactic.ResolveLiveFinishTarget(self.building)
		if (oLive == nil) then
			self.building = nil
			self.m_iClaimedBuildingId = nil
		end
		return false
	end
	return true
end

function BuildBuildingPlan:ClaimOwnBuilding( oBuilding )

	if (oBuilding == nil) then
		return
	end
	-- Always store BaseAI id so FindOwnUnfinishedBuilding lookup works
	-- (ToEnt returns entity whose GetID ≠ Base:GetID)
	local iWantId = EngineerTactic.GetPadTargetId(oBuilding)
	if (iWantId ~= nil) then
		for oBase in cpu_manager.player_stats:GetBases() do
			if (oBase:IsValid()) then
				if (oBase:GetID() == iWantId) then
					self.m_iClaimedBuildingId = oBase:GetID()
					return
				end
				if (type(oBase.GetEntity) == "function") then
					local oEnt = oBase:GetEntity()
					if (oEnt ~= nil and type(oEnt.GetID) == "function" and oEnt:GetID() == iWantId) then
						self.m_iClaimedBuildingId = oBase:GetID()
						return
					end
				end
			end
		end
		self.m_iClaimedBuildingId = iWantId
	end
end

function BuildBuildingPlan:ObtainAssistantBuilder( oBuilding )
	if (not self:NeedsAssistantBuilder()) then
		return false
	end
	if (self.assistant_builder ~= nil and self.assistant_builder:IsValid()) then
		if (oBuilding ~= nil) then
			self:SafeDoFinish(self.assistant_builder, oBuilding)
		end
		return true
	end
	if (self.assistant_builder ~= nil) then
		Plan.UnlockResource(self, self.assistant_builder)
		self.assistant_builder = nil
	end
	
	local iPrimaryId = nil
	if (self.builder ~= nil) then
		iPrimaryId = self.builder:GetID()
	end
	
	local vTargetPos = self.bestPosition
	if (oBuilding ~= nil) then
		vTargetPos = oBuilding:GetPosition()
	end
	
	local oAssist = cpu_manager:GetClosestEngineerForBuild(self.item_id, vTargetPos, true, false, vTargetPos, iPrimaryId)
	if (oAssist == nil) then
		oAssist = cpu_manager:GetClosestEngineerForBuild(self.item_id, vTargetPos, true, true, vTargetPos, iPrimaryId)
	end
	if (oAssist ~= nil and not oAssist:IsLocked()) then
		self.assistant_builder = oAssist
		Plan.LockResource(self, oAssist)
		if (oBuilding ~= nil) then
			self:SafeDoFinish(oAssist, oBuilding)
		end
		return true
	end
	return false
end

function BuildBuildingPlan:MaintainAssistantBuilder()
	if (not self.started_building or not self:NeedsAssistantBuilder()) then
		return
	end
	
	local oBuilding = self.building
	if (oBuilding == nil) then
		oBuilding = build_manager:FindUnfinishedBuilding(self.item_id)
		self.building = oBuilding
	end
	oBuilding = EngineerTactic.ResolveLiveFinishTarget(oBuilding)
	if (oBuilding == nil) then
		self.building = nil
		self.m_iClaimedBuildingId = nil
		return
	end
	self.building = oBuilding
	
	if (self.assistant_builder == nil or not self.assistant_builder:IsValid()) then
		if (self.assistant_builder ~= nil) then
			Plan.UnlockResource(self, self.assistant_builder)
			self.assistant_builder = nil
		end
		self:ObtainAssistantBuilder(oBuilding)
	elseif (self.assistant_builder:IsIdle() and not self.assistant_builder:IsBuildProgressing()) then
		self:SafeDoFinish(self.assistant_builder, oBuilding)
	end
end

function BuildBuildingPlan:FindEngineerCloseToSP()

	aitrace("BuildBuildingPlan: FindEngineerCloseToSP...")

	-- Get available engineers close to start point
	local aEngineers = {}
	for oSquad in military_manager:GetUnlockedSquads() do
	
		-- Get a valid engineer
		if (oSquad:IsValid() and oSquad:IsEngineer() and oSquad:CanBuild(self.item_id) == SquadAI.CANBUILD_Ok and
			not cpu_manager:IsEngineerReservedForEpoch(oSquad, self.item_id)) then
		
			-- Get distance to start point
			local vSquadPos = oSquad:GetPosition()
			local iDistance = distance_sqr(cpu_manager.start_pos, vSquadPos)
			
			-- Add to builder list
			table.insert(aEngineers, { oSquad, vSquadPos, iDistance })
		end	
	end
	
	-- Sort list
	table.sort(aEngineers, function(oItem1, oItem2) return oItem1[3] < oItem2[3] end)
	
	-- Get a save build position
	for iLoop1 in aEngineers do
	
		-- Get a build pos close to engineer and start point
		local vSquadPos = aEngineers[iLoop1][2]
		local vBasePos = cpu_manager:FindClosestFriendlyBaseOrStrategicPoint(vSquadPos, cpu_manager.start_pos, true, true)
		if (vBasePos ~= nil) then

			-- Set build pos
			self.build_pos = Vector2f()
			self.build_pos.x = vBasePos.x
			self.build_pos.y = vBasePos.z
			return aEngineers[iLoop1][1]
		end
	end
	
	-- Force HQ building
	if (self.m_bEmergencyHQ and table.getn(aEngineers) > 0) then
		return aEngineers[1][1]
	end
	return nil
end

function BuildBuildingPlan:PickClosestBuilder(bRequireClearPath)

	local vPos = self.bestPosition
	if (vPos == nil and self.copy_build_pos ~= nil) then
		vPos = self.copy_build_pos
	end
	if (vPos == nil) then
		vPos = cpu_manager.start_pos
	end
	
	return cpu_manager:GetClosestEngineerForBuild(self.item_id, vPos, true, bRequireClearPath, vPos)
end

function BuildBuildingPlan:IsBuilderCloseToSite(oEngineer, vSitePos)
	if (oEngineer == nil or not oEngineer:IsValid() or vSitePos == nil) then
		return false
	end
	return distance_sqr(oEngineer:GetPosition(), vSitePos) <= sqr(BuildBuildingPlan.CANBUILD_CHECK_RANGE)
end

function BuildBuildingPlan:CanBuilderUseSite(oEngineer, vSitePos)
	if (oEngineer == nil or not oEngineer:IsValid() or vSitePos == nil) then
		return false
	end
	if (oEngineer:CanBuild(self.item_id) ~= SquadAI.CANBUILD_Ok) then
		return false
	end
	return oEngineer:CanBuildAt(self.item_id, vSitePos)
end

-- Только когда рабочий уже у шаблонной точки, но CanBuildAt всё равно false
function BuildBuildingPlan:IsSiteUnreachableForBuilder(oEngineer)
	if (oEngineer == nil or self.bestPosition == nil) then
		return false
	end
	if (not self:IsBuilderCloseToSite(oEngineer, self.bestPosition)) then
		return false
	end
	return not self:CanBuilderUseSite(oEngineer, self.bestPosition)
end

function BuildBuildingPlan:ResetStationaryWatch()

	self.m_iStationarySince = nil
	self.m_vStationaryPos = nil
	self.m_iStationaryPhase = 0
	self.m_bStationaryHadWork = false
end

function BuildBuildingPlan:IsBuilderConstructingOrRepairing( oBuilder )

	if (oBuilder == nil or not oBuilder:IsValid()) then
		return false
	end
	if (oBuilder:IsBuilding() ~= 0 or oBuilder:IsBuildProgressing()) then
		return true
	end
	if (type(oBuilder.IsRepairing) == "function" and oBuilder:IsRepairing()) then
		return true
	end
	local oTac = oBuilder:GetTactic()
	if (oTac ~= nil and type(oTac.IsHqRepairWorker) == "function" and oTac:IsHqRepairWorker()) then
		return true
	end
	return false
end

function BuildBuildingPlan:GetStationaryApproachPos()

	local vSite = self.bestPosition
	if (vSite == nil) then
		vSite = self.copy_build_pos
	end
	if (vSite == nil or self.builder == nil or not self.builder:IsValid()) then
		return nil
	end
	local vBuilder = self.builder:GetPosition()
	local fDx = vBuilder.x - vSite.x
	local fDz = vBuilder.z - vSite.z
	local fLen = math.sqrt(fDx * fDx + fDz * fDz)
	local fDist = BuildBuildingPlan.STATIONARY_APPROACH_DIST
	local vNear = Vector3f(vSite)
	if (fLen > 1) then
		vNear.x = vSite.x + (fDx / fLen) * fDist
		vNear.z = vSite.z + (fDz / fLen) * fDist
	else
		vNear.x = vSite.x + fDist
		vNear.z = vSite.z
	end
	return vNear
end

-- Task but not building: if map position unchanged ~10s → DoMove near site; again → release; after move → DoBuild
function BuildBuildingPlan:MaintainStationaryBuilderUnstick()

	if (self.builder == nil or not self.builder:IsValid()) then
		self:ResetStationaryWatch()
		return
	end
	if (not self.builder:IsLocked()) then
		self:ResetStationaryWatch()
		return
	end

	local vPos = self.builder:GetPosition()

	-- Actively building/repairing: pause watch; later stuck wait gets +30s grace
	if (self:IsBuilderConstructingOrRepairing(self.builder)) then
		self.m_bStationaryHadWork = true
		self.m_vStationaryPos = Vector3f(vPos)
		self.m_iStationarySince = g_iGMT
		return
	end

	local iMoveSqr = BuildBuildingPlan.STATIONARY_MOVE_SQR
	local iStuckSec = BuildBuildingPlan.STATIONARY_STUCK_SEC
	if (self.m_bStationaryHadWork) then
		iStuckSec = iStuckSec + BuildBuildingPlan.STATIONARY_WORK_GRACE_SEC
	end

	-- After approach: if close to site, reissue build (player: walk near → click template)
	if (self.m_iStationaryPhase == 1 and self.bestPosition ~= nil and
		self:IsBuilderCloseToSite(self.builder, self.bestPosition) and
		self:CanBuilderUseSite(self.builder, self.bestPosition)) then
		self.builder:DoBuildBuilding(self.item_id, self.bestPosition)
		Plan.SetState(self, "Building a "..self.item_name, BuildBuildingPlan.BuildingState)
		self:ResetStationaryWatch()
		return
	end

	if (self.m_vStationaryPos == nil) then
		self.m_vStationaryPos = Vector3f(vPos)
		self.m_iStationarySince = g_iGMT
		if (self.m_iStationaryPhase == nil) then
			self.m_iStationaryPhase = 0
		end
		return
	end

	if (distance_sqr(vPos, self.m_vStationaryPos) > iMoveSqr) then
		self.m_vStationaryPos = Vector3f(vPos)
		self.m_iStationarySince = g_iGMT
		return
	end

	if (self.m_iStationarySince == nil) then
		self.m_iStationarySince = g_iGMT
		return
	end
	if (g_iGMT < self.m_iStationarySince + iStuckSec) then
		return
	end

	if (self.m_iStationaryPhase == nil or self.m_iStationaryPhase == 0) then
		local vNear = self:GetStationaryApproachPos()
		if (vNear ~= nil) then
			cpu_manager:DoMove(self.builder, vNear, false, "Stationary approach "..tostring(self.item_name))
			aitrace("BuildBuildingPlan: Stationary → move near site "..tostring(self.item_name))
		end
		self.m_iStationaryPhase = 1
		self.m_vStationaryPos = Vector3f(vPos)
		self.m_iStationarySince = g_iGMT
		return
	end

	-- Second stuck wait after approach → free builder
	aitrace("BuildBuildingPlan: Stationary twice → release "..tostring(self.item_name))
	self:ResetStationaryWatch()
	if (self.started_building or self:IsConstructionStillPending()) then
		self:AbortAndReleaseBuilder("stationary stuck")
	else
		Plan.UnlockResource(self, self.builder)
		self.builder = nil
		Plan.SetNeeds(self, "Asking for builder", BuildBuildingPlan.ObtainBuilder)
		Plan.SetState(self, "Wanting to build: "..self.item_name, BuildBuildingPlan.BuildBuilding)
	end
end

-- Шаблонная точка недоступна рабочему → сместить позицию (или отпустить план)
function BuildBuildingPlan:EnsureReachableBuildSite(oEngineer)
	if (self.bestPosition == nil) then
		if (not self:InitBestBuildingPosition()) then
			return false
		end
	end
	if (oEngineer == nil) then
		oEngineer = self.builder
	end
	if (oEngineer == nil) then
		return false
	end

	-- Front / Around HQ / BaseBack: не трогаем точку, пока рабочий не дошёл
	if (self.m_bKeepBuildPos) then
		if (not self:IsSiteUnreachableForBuilder(oEngineer)) then
			return true
		end
	else
		if (self:CanBuilderUseSite(oEngineer, self.bestPosition)) then
			return true
		end
	end

	aitrace("BuildBuildingPlan: Unreachable site for "..self.item_name..", fallback...", true)
	if (self:ApplyFallbackBuildPosition(oEngineer:GetPosition())) then
		if (self:IsValidAssignedEngineer() and self:CanBuilderUseSite(self.m_oAssignedEngineer, self.bestPosition)) then
			return true
		end
		if (self:CanBuilderUseSite(oEngineer, self.bestPosition)) then
			return true
		end
	end
	return false
end

-- Keep ID: dead engineer userdata can lose IsValid (nil method crash)
function BuildBuildingPlan:SetAssignedEngineer(oEng)

	self.m_oAssignedEngineer = nil
	self.m_iAssignedEngineerID = nil
	if (oEng == nil) then
		return
	end
	if (type(oEng.GetID) ~= "function") then
		return
	end
	local iID = oEng:GetID()
	if (iID == nil) then
		return
	end
	local oFresh = military_manager:GetSquadFromID(iID)
	if (oFresh == nil or type(oFresh.IsValid) ~= "function" or not oFresh:IsValid()) then
		return
	end
	self.m_oAssignedEngineer = oFresh
	self.m_iAssignedEngineerID = iID
end

function BuildBuildingPlan:IsValidAssignedEngineer()

	local oEng = nil
	if (self.m_iAssignedEngineerID ~= nil) then
		oEng = military_manager:GetSquadFromID(self.m_iAssignedEngineerID)
	elseif (self.m_oAssignedEngineer ~= nil and type(self.m_oAssignedEngineer.GetID) == "function") then
		local iID = self.m_oAssignedEngineer:GetID()
		if (iID ~= nil) then
			self.m_iAssignedEngineerID = iID
			oEng = military_manager:GetSquadFromID(iID)
		end
	end

	if (oEng == nil or type(oEng.IsValid) ~= "function" or not oEng:IsValid()) then
		self.m_oAssignedEngineer = nil
		self.m_iAssignedEngineerID = nil
		return false
	end
	self.m_oAssignedEngineer = oEng

	if (type(oEng.IsLocked) == "function" and oEng:IsLocked()) then
		return false
	end
	if (self.item_id == nil or type(oEng.CanBuild) ~= "function") then
		return false
	end
	return oEng:CanBuild(self.item_id) == SquadAI.CANBUILD_Ok
end

function BuildBuildingPlan:ObtainBuilder()
	
	-- Check if we have a build pos
	local engineer = nil
	if (self.build_pos == nil) then
	
		-- Find engineer that is closest to a listening post
		engineer = self:FindEngineerCloseToSP()
		if (engineer == nil) then
			aitrace("BuildBuildingPlan: No builders for: "..self.item_name)
			return
		end
	end
	
	-- Check for best building position
	if (self.bestPosition == nil and not self:InitBestBuildingPosition()) then
		return
	end

	-- The build pos was already set, but no engineer was found yet. find one close to the best position
	if (engineer == nil) then
	
		if (self:IsValidAssignedEngineer()) then
			engineer = self.m_oAssignedEngineer
		end
		
		if (engineer == nil) then
			engineer = self:PickClosestBuilder(false)
		end
		
		if (engineer == nil and self.m_bKeepBuildPos and self.copy_build_pos ~= nil) then
			local vRetryPos = cpu_manager:FindSafeSiteNearFront(self.item_id, self.copy_build_pos, 25)
			if (vRetryPos ~= nil and distance_sqr(vRetryPos, self.copy_build_pos) > sqr(2)) then
				self.copy_build_pos = Vector3f(vRetryPos)
				self.build_pos.x = vRetryPos.x
				self.build_pos.y = vRetryPos.z
				self.bestPosition = nil
				if (not self:InitBestBuildingPosition()) then
					aitrace("BuildBuildingPlan: No builders for: "..self.item_name)
					return
				end
				engineer = self:PickClosestBuilder(false)
			end
		elseif (engineer == nil and not self.m_bKeepBuildPos) then
			local vRetryPos = cpu_manager:FindEngineerSafeBuildPosition(self.item_id, self.bestPosition)
			if (vRetryPos ~= nil and (self.copy_build_pos == nil or
				distance_sqr(vRetryPos, self.copy_build_pos) > sqr(2))) then
				self.copy_build_pos = Vector3f(vRetryPos)
				self.build_pos.x = vRetryPos.x
				self.build_pos.y = vRetryPos.z
				self.bestPosition = nil
				self:SetAssignedEngineer(cpu_manager:GetClosestEngineerForBuild(self.item_id, vRetryPos, true, false))
				if (not self:InitBestBuildingPosition()) then
					aitrace("BuildBuildingPlan: No builders for: "..self.item_name)
					return
				end
				engineer = self:PickClosestBuilder(false)
			end
		end
		if (engineer == nil) then
			engineer = self:PickClosestBuilder(true)
		end
		if (engineer == nil) then
			aitrace("BuildBuildingPlan: No builders for: "..self.item_name)
			return
		end
	end

	if (not self.m_bKeepBuildPos and not self:EnsureReachableBuildSite(engineer)) then
		aitrace("BuildBuildingPlan: No reachable site for: "..self.item_name)
		return
	end
	if (self:IsValidAssignedEngineer()) then
		engineer = self.m_oAssignedEngineer
	end

	-- Lock and save it!
	if (engineer:IsLocked()) then
		aitrace("BuildBuildingPlan: Builder already locked for: "..self.item_name)
		return
	end
	BuildPlan.SetBuilder(self, engineer)
	
	if (self:NeedsAssistantBuilder()) then
		self:ObtainAssistantBuilder(nil)
	end

	-- No needs
	Plan.SetNeeds( self, "No needs", Plan.NeedsFulfilled )
end

function BuildBuildingPlan:InitBestBuildingPosition()
	
	-- Get closest enemy position
	local oEnemy = cpu_manager:FindClosestEnemyPlayer()
	local vEnemyPos = Vector3f(0,0,0)
	if (oEnemy ~= nil) then
		vEnemyPos = Vector3f(oEnemy:GetStartingPosition())
	end
	
	-- Check if we have a build position
	if (self.build_pos == nil) then
		
		-- Try to get a new build position
		self.build_pos = Vector2f()
		self.build_pos.x = cpu_manager.start_pos.x
		self.build_pos.y = cpu_manager.start_pos.z
		if (math.random(1, 2) == 1) then

			-- Get strategic point positions
			local aBuildPositions = {}
			for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
			
				-- Check owner
				if (oStrategicPoint:Owner() == cpu_manager.player_id) then
					table.insert(aBuildPositions, oStrategicPoint:GetPosition())
				end
			end
			local iBuildPosCount = table.getn(aBuildPositions)
			if (iBuildPosCount > 0) then
				
				-- Choose a random strat position
				local vBuildPos = aBuildPositions[math.random(1, iBuildPosCount)]
				self.build_pos.x = vBuildPos.x
				self.build_pos.y = vBuildPos.z
			end
		end
	end

	-- Init variables
	local bias = nil
	local try_bias = false
	local base_pos = Vector3f(cpu_manager.start_pos)

	-- Строгая позиция шаблона: снап только рядом с copy_build_pos
	if (self.m_bKeepBuildPos and self.copy_build_pos ~= nil and not cpu_manager:IsBiggerGenerator(self.item_id)) then
		local bias_pos = Vector2f()
		bias_pos.x = self.copy_build_pos.x
		bias_pos.y = self.copy_build_pos.z
		local bias = Vector3f(self.copy_build_pos)
		self.bestPosition = Vector3f()
		if (not cpu_manager.terrain_analyzer:FindClosestFreePosition(self.item_id, bias_pos, bias, self.bestPosition)) then
			self.bestPosition = Vector3f(self.copy_build_pos)
		end
		if (cpu_manager:IsTurret(self.item_id) or cpu_manager:IsMine(self.item_id)) then
			local vAnchor = cpu_manager:GetBaseFrontAnchor()
			if (not cpu_manager:IsEnemyFacingPosition(self.bestPosition, vAnchor)) then
				local vFixed = cpu_manager:ProjectToEnemyFront(self.bestPosition, vAnchor, 12)
				local vFixed2d = Vector2f()
				vFixed2d.x = vFixed.x
				vFixed2d.y = vFixed.z
				local vBias = Vector3f(vEnemyPos)
				if (cpu_manager.terrain_analyzer:FindClosestFreePosition(self.item_id, vFixed2d, vBias, self.bestPosition) and
					cpu_manager:IsEnemyFacingPosition(self.bestPosition, vAnchor)) then
					-- ok
				else
					self.bestPosition = vFixed
				end
			end
		end
		return true
	end

	-- Check for turret
	if (cpu_manager:IsTurret(self.item_id)) then
		
		-- Turret at base, bias to next LP	
		if (self.build_pos.x == base_pos.x and self.build_pos.y == base_pos.z) then
		
			local oStrategicPoint = resource_manager:FindFirstStrategicPoint(base_pos, 50)
			if (oStrategicPoint ~= nil) then
				bias = oStrategicPoint:GetPosition()
			end
			try_bias = true
		elseif (self.copy_build_pos ~= nil) then
			bias = Vector3f(vEnemyPos)
		end
			
		-- Turret at LP or no LP found, bias to own base
		if (bias == nil) then
			bias = Vector3f(base_pos)
		end
	else
		if (self.m_bKeepBuildPos) then
			if (self.copy_build_pos ~= nil) then
				bias = Vector3f(self.copy_build_pos)
			else
				bias = Vector3f(vEnemyPos)
			end
		elseif (self.copy_build_pos ~= nil) then
			bias = Vector3f(self.copy_build_pos)
		else
			bias = Vector3f(base_pos)
		end
	end
	
	-- Local copy to tweak with bias
	local bias_pos = Vector2f(self.build_pos)
	
	-- Build turrets at base facing enemy or webways
	if (try_bias == true) then
		bias_pos.x = bias_pos.x + cpu_manager:GetBias(self.build_pos.x, bias.x)
		bias_pos.y = bias_pos.y + cpu_manager:GetBias(self.build_pos.y, bias.z)
		bias = base_pos
	end
		
	-- Try to build toward or away from enemy, depending on what type of building it is
	self.bestPosition = Vector3f()
	if (cpu_manager:IsBiggerGenerator(self.item_id)) then
		
		-- Bigger generators use fixed position
		self.bestPosition = Vector3f(self.copy_build_pos)
						
	elseif (not cpu_manager.terrain_analyzer:FindClosestFreePosition(self.item_id, bias_pos, bias, self.bestPosition)) then

		-- Unable to build turrets/webways with bias, retry with default settings
		if (try_bias) then

			bias = vEnemyPos
			if (not cpu_manager.terrain_analyzer:FindClosestFreePosition(self.item_id, self.build_pos, bias, self.bestPosition)) then
				aitrace("BuildBuildingPlan: Cannot place building: "..self.item_name)
				return false
			end
		else
			
			-- Arkhan 12.2005: Retry with deviation to fix build bug
			--Retry with deviation to fix build bug
            local bufer = math.random(1, 8)
            if bufer == 1 then
				bias_pos.x = self.build_pos.x + math.random(-10, -10)
				bias_pos.y = self.build_pos.y + math.random(0, 0)
            elseif bufer == 2 then
				bias_pos.x = self.build_pos.x + math.random(0, 0)
				bias_pos.y = self.build_pos.y + math.random(-10, -10)
            elseif bufer == 3 then
				bias_pos.x = self.build_pos.x + math.random(10, 10)
				bias_pos.y = self.build_pos.y + math.random(0, 0)
            elseif bufer == 4 then
				bias_pos.x = self.build_pos.x + math.random(0, 0)
				bias_pos.y = self.build_pos.y + math.random(10, 10)
            elseif bufer == 5 then
				bias_pos.x = self.build_pos.x + math.random(10, 10)
				bias_pos.y = self.build_pos.y + math.random(10, 10)
            elseif bufer == 6 then
				bias_pos.x = self.build_pos.x + math.random(-10, -10)
				bias_pos.y = self.build_pos.y + math.random(-10, -10)
			elseif bufer == 7 then
				bias_pos.x = self.build_pos.x + math.random(-10, -10)
				bias_pos.y = self.build_pos.y + math.random(10, 10)
            elseif bufer == 8 then
				bias_pos.x = self.build_pos.x + math.random(10, 10)
				bias_pos.y = self.build_pos.y + math.random(-10, -10)
            end

			local bSuccess = cpu_manager.terrain_analyzer:FindClosestFreePosition(self.item_id, bias_pos, bias, self.bestPosition)
			if (not bSuccess) then
				aitrace("BuildBuildingPlan: Cannot place building: "..self.item_name)
				return false
			end
		end
	end
	if (self.bestPosition == nil) then
		aitrace("BuildBuildingPlan: Can't find a free position to build "..self.item_name)
		return false
	end
	
	if (self.m_bKeepBuildPos and (cpu_manager:IsTurret(self.item_id) or cpu_manager:IsMine(self.item_id))) then
		local vAnchor = cpu_manager:GetBaseFrontAnchor()
		if (not cpu_manager:IsEnemyFacingPosition(self.bestPosition, vAnchor)) then
			local vFixed = cpu_manager:ProjectToEnemyFront(self.bestPosition, vAnchor, 12)
			local vFixed2d = Vector2f()
			vFixed2d.x = vFixed.x
			vFixed2d.y = vFixed.z
			local vBias = Vector3f(vEnemyPos)
			if (cpu_manager.terrain_analyzer:FindClosestFreePosition(self.item_id, vFixed2d, vBias, self.bestPosition) and
				cpu_manager:IsEnemyFacingPosition(self.bestPosition, vAnchor)) then
				-- ok
			else
				self.bestPosition = vFixed
			end
		end
	end
	return true
end

function BuildBuildingPlan:SetSaveBuildPosition(oEngineer)

	-- Check build position
	if (self.build_pos == nil or self.copy_build_pos == nil) then
		return false
	end

	-- Check threat at build position
	local vBuildPos = self.copy_build_pos
	if (not cpu_manager.terrain_analyzer:HasThreat(vBuildPos, 35)) then
		return true
	end
	
	-- Set close position to engineer
	local vEngineerPosition = cpu_manager.start_pos
	if (oEngineer ~= nil) then
		vEngineerPosition = oEngineer:GetPosition()
	end
	
	-- Get a save position as new build position
	local vBasePos = cpu_manager:FindClosestFriendlyBaseOrStrategicPoint(vEngineerPosition, vBuildPos, true, true)
	if (vBasePos == nil) then
		vBasePos = cpu_manager:FindClosestFriendlyBaseOrStrategicPoint(vEngineerPosition, vBuildPos, true, false)
	end
	if (vBasePos ~= nil) then
		vBuildPos = Vector3f(vBasePos)
	end
	
	-- Set new build position
	self.build_pos.x = vBuildPos.x
	self.build_pos.y = vBuildPos.z
	
	-- Update best build position
	self.bestPosition = nil
	return self:InitBestBuildingPosition()
end

function BuildBuildingPlan:ApplyFallbackBuildPosition(vRefPos)
	-- Never abandon an unfinished pad for a brand-new template site (Eldar warp gen steal)
	local oUnfinished = self:FindOwnUnfinishedBuilding()
	if (oUnfinished == nil and (self.started_building or self.m_iClaimedBuildingId ~= nil)) then
		oUnfinished = build_manager:FindUnfinishedBuilding(self.item_id)
	end
	if (oUnfinished ~= nil) then
		local vPad = oUnfinished:GetPosition()
		self:ClaimOwnBuilding(oUnfinished)
		self.copy_build_pos = Vector3f(vPad)
		if (self.build_pos == nil) then
			self.build_pos = Vector2f()
		end
		self.build_pos.x = vPad.x
		self.build_pos.y = vPad.z
		self.bestPosition = Vector3f(vPad)
		self.m_bKeepBuildPos = true
		self.m_iPlacementFailCount = 0
		self:MarkConstructionStarted()
		if (self.builder ~= nil and self.builder:IsValid()) then
			self:SafeDoFinish(self.builder, oUnfinished)
			self:MarkBuilderEpochCommitment()
		end
		return true
	end

	if (vRefPos == nil and self.builder ~= nil) then
		vRefPos = self.builder:GetPosition()
	end
	if (vRefPos == nil) then
		vRefPos = cpu_manager.start_pos
	end
	local vPos, oEng = cpu_manager:ResolveBuildFallbackGuaranteed(self.item_id, vRefPos)
	if (vPos == nil) then
		self.m_iPlacementFailCount = self.m_iPlacementFailCount + 1
		if (self.m_iPlacementFailCount >= 8) then
			self:AbortAndReleaseBuilder("fallback exhausted")
		end
		return false
	end
	self.copy_build_pos = Vector3f(vPos)
	self.build_pos.x = vPos.x
	self.build_pos.y = vPos.z
	self.bestPosition = nil
	self.m_bKeepBuildPos = false
	if (oEng ~= nil) then
		self:SetAssignedEngineer(oEng)
	end
	if (not self:InitBestBuildingPosition()) then
		self.m_iPlacementFailCount = self.m_iPlacementFailCount + 1
		if (self.m_iPlacementFailCount >= 8) then
			self:AbortAndReleaseBuilder("InitBestBuildingPosition failed")
		end
		return false
	end
	self.m_iPlacementFailCount = 0
	return true
end

-- Enemy blob at unfinished pad — release only on real overrun (not ranged chip / base fight)
function BuildBuildingPlan:IsBuildSiteOverrun(vPos)

	if (vPos == nil) then
		return false
	end
	local iEnemy, iAllied = cpu_manager:GetArmyStrengthAtPos(vPos, 40, true)
	if (iEnemy == nil or iEnemy < 200) then
		return false
	end
	if (iAllied == nil) then
		iAllied = 0
	end
	if (iEnemy >= 350 and iEnemy > iAllied * 1.2) then
		return true
	end
	-- Contested: need melee on the builder (if any)
	if (self.builder ~= nil and self.builder:IsValid()) then
		local oMelee = cpu_manager.cpu_player:FindFirstEnemy(self.builder:GetPosition(), 28, 1)
		if (oMelee ~= nil and not oMelee:IsRanged() and iEnemy > iAllied) then
			return true
		end
	end
	return false
end

function BuildBuildingPlan:ReleaseBuilderFromOverrun(sReason)

	aitrace("BuildBuildingPlan: Site overrun — release builder ("..tostring(sReason)..")")
	if (self.assistant_builder ~= nil) then
		Plan.UnlockResource(self, self.assistant_builder)
		self.assistant_builder = nil
	end
	if (self.builder ~= nil) then
		if (self.builder:IsValid()) then
			local oTactic = self.builder:GetTactic()
			if (oTactic ~= nil) then
				if (oTactic.ClearWorkFlags ~= nil) then
					oTactic:ClearWorkFlags()
				end
				if (oTactic.TryWorkerRefuge ~= nil) then
					oTactic:UpdateStance()
					oTactic:TryWorkerRefuge()
				else
					self.builder:DoMove(cpu_manager.start_pos)
				end
			end
		end
		Plan.UnlockResource(self, self.builder)
		self.builder = nil
	end
	-- Leave unfinished; leave BuildingState so next tick does not assert on nil builder
	self:MarkConstructionStarted()
	Plan.SetNeeds(self, "Fixing building...", BuildBuildingPlan.ObtainNewBuilder)
	Plan.SetState(self, "Try to fix building: "..tostring(self.item_name), BuildBuildingPlan.FixState)
end

function BuildBuildingPlan:ShouldKeepUnfinishedOnAbort()
	if (self:IsEpochPlan()) then
		return true
	end
	-- Generators: abort must not drop the pad so thermo/DynamicBuild can steal the only engie
	if (cpu_manager:IsGenerator(self.item_id) or cpu_manager:IsBiggerGenerator(self.item_id)) then
		return true
	end
	return false
end

function BuildBuildingPlan:AbortAndReleaseBuilder(sReason)
	-- Epoch / generators must stay until finished — release engie only to re-seek, not drop the job.
	if (self:ShouldKeepUnfinishedOnAbort() and self:IsConstructionStillPending()) then
		if (sReason ~= nil) then
			aitrace("BuildBuildingPlan: Keep unfinished "..self.item_name.." ("..sReason..")", true)
		end
		if (self.assistant_builder ~= nil) then
			Plan.UnlockResource(self, self.assistant_builder)
			self.assistant_builder = nil
		end
		if (self.builder ~= nil) then
			Plan.UnlockResource(self, self.builder)
			self.builder = nil
		end
		self:MarkConstructionStarted()
		Plan.SetNeeds(self, "Fixing building...", BuildBuildingPlan.ObtainNewBuilder)
		Plan.SetState(self, "Try to fix building: "..self.item_name, BuildBuildingPlan.FixState)
		return
	end
	if (sReason ~= nil) then
		aitrace("BuildBuildingPlan: Abort "..self.item_name.." ("..sReason..")", true)
	end
	if (self.assistant_builder ~= nil) then
		Plan.UnlockResource(self, self.assistant_builder)
		self.assistant_builder = nil
	end
	if (self.builder ~= nil) then
		Plan.UnlockResource(self, self.builder)
		self.builder = nil
	end
	self:SetComplete(true)
end

function BuildBuildingPlan:BuildBuilding()

	-- Check for builder
	if (self.builder == nil) then
		
		-- Shall we wait for a builder?
		if (self.wait_on_builder == nil) then	
			aitrace( "BuildBuildingPlan: No builder found. Abort "..self.item_name )
			Plan.SetComplete( self, true )
		else
			aitrace( "BuildBuildingPlan: Search builder for "..self.item_name )	
		end
		return
	end
	
	-- Relocate only for buildings that use safe placement (not LP/turret/mine)
	if (cpu_manager:UsesEngineerSafePlacement(self.item_id) and
		cpu_manager.terrain_analyzer:HasThreat(self.bestPosition, 35)) then
	
		-- Try to find a save build position
		if (not self:SetSaveBuildPosition(self.builder)) then
			if (not self:ApplyFallbackBuildPosition(self.builder:GetPosition())) then
				aitrace("BuildBuildingPlan: Cannot build under threat : "..self.item_name)
				return
			end
		end
	end

	if (not self.m_bKeepBuildPos and not self:EnsureReachableBuildSite(self.builder)) then
		if (self.m_iPlacementFailCount >= 8) then
			self:AbortAndReleaseBuilder("unreachable after fallback")
		end
		return
	end

	-- No assertion for bigger generators !!!
	if (cpu_manager:IsBiggerGenerator(self.item_id)) then
		if (not self.builder:CanBuildAt(self.item_id, self.bestPosition) or self.builder:CanBuild(self.item_id) ~= SquadAI.CANBUILD_Ok) then
			return
		end
	end
	
	-- Check if building can be built
	if (not self.builder:CanBuildAt(self.item_id, self.bestPosition)) then
		aitrace("BuildBuildingPlan: Can't build building for unknown reasons. Try to get another build position..", true)
		if (self.m_bKeepBuildPos and not self:IsBuilderCloseToSite(self.builder, self.bestPosition)) then
			cpu_manager:DoMove(self.builder, self.bestPosition, false, "Template approach "..self.item_name)
			return
		end
		if (self:ApplyFallbackBuildPosition(self.builder:GetPosition())) then
			if (self.builder:CanBuildAt(self.item_id, self.bestPosition)) then
				self.builder:DoBuildBuilding(self.item_id, self.bestPosition)
				Plan.SetState( self, "Building a "..self.item_name, BuildBuildingPlan.BuildingState )
			else
				self.m_iPlacementFailCount = self.m_iPlacementFailCount + 1
				if (self.m_iPlacementFailCount >= 8) then
					self:AbortAndReleaseBuilder("no valid site after fallback")
				end
			end
			return
		end
		self.build_pos = nil
		self:InitBestBuildingPosition()
		return
	end
	
	-- Try to build
	self.builder:DoBuildBuilding(self.item_id, self.bestPosition)

	-- Change state
	Plan.SetState( self, "Building a "..self.item_name, BuildBuildingPlan.BuildingState )
	return
end

function BuildBuildingPlan:BuildingState()

	aitrace("BuildBuildingPlan: Building State...")

	-- Released / died mid-tick — never call BuildPlan.BuildingState without builder
	if (self.builder == nil or not self.builder:IsValid()) then
		if (self.started_building) then
			-- DE auto-construct: pad finishes alone — do NOT ObtainNewBuilder (that re-stuck the slave)
			if (cpu_manager:AutoConstructBuildings() and not self:IsEpochPlan()) then
				Plan.SetComplete(self, true)
				return
			end
			-- Unfinished pad still exists → re-obtain (skip foreign left builder nil; not overrun)
			local oPad = self:FindOwnUnfinishedBuilding()
			if (oPad ~= nil) then
				self.building = oPad
				Plan.SetNeeds(self, "Fixing building...", BuildBuildingPlan.ObtainNewBuilder)
				return
			end
			Plan.SetComplete(self, true)
		end
		return
	end

	-- Overrun + worker wants to abandon (melee/critical) — not chip fire
	local oThreatBuilding = build_manager:FindUnfinishedBuilding(self.item_id)
	if (oThreatBuilding ~= nil and self:IsBuildSiteOverrun(oThreatBuilding:GetPosition())) then
		local oTactic = self.builder:GetTactic()
		if (oTactic ~= nil and oTactic.ShouldAbandonWork ~= nil and oTactic:ShouldAbandonWork()) then
			self:ReleaseBuilderFromOverrun("BuildingState")
			return
		end
	end
		
	-- Compute basic building state method
	BuildPlan.BuildingState(self)

	-- Check if building was started
	if (not self.started_building) then
		return
	end

	-- Epoch only: don't treat brief leave as done while footprint unfinished
	if (self:IsComplete() and self:IsConstructionStillPending()) then
		if (self:IsEpochPlan() and not cpu_manager:AutoConstructBuildings()) then
			self:SetComplete(false)
		end
	end

	if (self.started_building) then
		local oB = self:FindOwnUnfinishedBuilding()
		if (oB ~= nil) then
			self.building = oB
			self:ClaimOwnBuilding(oB)
			-- Necron/Ork: claim only if claim free / already ours
			if (EngineerTactic.ShouldDisableGeneralAssist() and self.builder ~= nil and
				self.builder:IsValid()) then
				local oTactic = self.builder:GetTactic()
				local iPadId = EngineerTactic.GetPadTargetId(oB)
				local vPad = oB:GetPosition()
				if (oTactic ~= nil and iPadId ~= nil and
					not oTactic:CanJoinBuildTarget(iPadId, vPad, "build")) then
					-- Own builder already placing/finishing this BP — re-register, never skip
					if (self.builder:IsBuilding() == self.item_id or self.builder:IsBuildProgressing()) then
						EngineerTactic.RegisterWorker(iPadId, self.builder)
						oTactic.m_vDestination = Vector3f(vPad)
						oTactic.m_bBusy = true
					else
						-- True foreign claim: unlock THIS plan's extra worker — do NOT SetComplete
						aitrace("BuildBuildingPlan: skip foreign pad claim — "..self.item_name)
						Plan.UnlockResource(self, self.builder)
						self.builder = nil
						return
					end
				else
					if (iPadId ~= nil) then
						EngineerTactic.RegisterWorker(iPadId, self.builder)
					end
					if (oTactic ~= nil) then
						oTactic.m_vDestination = Vector3f(vPad)
						oTactic.m_bBusy = true
					end
				end
			end
			self:ObtainAssistantBuilder(oB)
			self:MarkBuilderEpochCommitment()
		end
	end
	
	-- Search THIS plan's unfinished building only
	local oBuilding = self:FindOwnUnfinishedBuilding()
	if (oBuilding ~= nil and self.bestPosition ~= nil and distance_sqr(oBuilding:GetPosition(), self.bestPosition) < 100) then
	
		-- Try to jump if possible
		if (self.builder ~= nil and distance_sqr(self.builder:GetPosition(), self.bestPosition) > sqr(40) and
			cpu_manager:JumpBuilder(self.builder, self.bestPosition)) then
			return
		end
	end

	if (self.builder == nil) then
		return
	end
	
	-- Check if builder is building (OLD Relic AutoConstruct path — do not short-circuit before this)
	if (self.builder:IsBuilding() ~= self.item_id) then
		
		-- Check for building
		if (oBuilding ~= nil) then
		
			-- Live BaseAI only (destroyed pad mid-Critical → no GetID/DoFinish crash)
			local oBuildingAI = EngineerTactic.ResolveLiveFinishTarget(oBuilding)
			if (oBuildingAI ~= nil) then

				-- AutoConstruct: tap while HP<=0.2; above that pad builds alone → unlock
				if (not cpu_manager:AutoConstructBuildings() or oBuildingAI:GetHealthPercentage() <= 0.2) then
					-- Necron/Ork: do not pile onto a pad another worker already owns
					if (EngineerTactic.ShouldDisableGeneralAssist()) then
						local oTactic = self.builder:GetTactic()
						local iPadId = EngineerTactic.GetPadTargetId(oBuildingAI)
						if (oTactic ~= nil and iPadId ~= nil and
							not oTactic:CanJoinBuildTarget(iPadId, oBuildingAI:GetPosition(), "build")) then
							aitrace("BuildBuildingPlan: Release extra worker (Necron/Ork max 1) — "..self.item_name)
							Plan.UnlockResource(self, self.builder)
							self.builder = nil
							-- Keep plan alive (PlanExists) — pad finishes via owner worker
							return
						end
						if (iPadId ~= nil) then
							EngineerTactic.RegisterWorker(iPadId, self.builder)
						end
						self:ClaimOwnBuilding(oBuildingAI)
					end
					self:SafeDoFinish(self.builder, oBuildingAI)
					self:MarkBuilderEpochCommitment()
					return
				else
					if (self:IsEpochPlan()) then
						self:SafeDoFinish(self.builder, oBuildingAI)
						self:MarkBuilderEpochCommitment()
						return
					end
					-- Job finished (Dark Eldar tap-and-go)
					aitrace("BuildBuildingPlan: Job finished...")
					Plan.UnlockResource(self, self.builder)
					self.builder = nil
					Plan.SetComplete(self, true)
					return
				end
			else
				self.building = nil
				self.m_iClaimedBuildingId = nil
			end
		end
		
	elseif (oBuilding == nil) then

		-- Builder got stuck and wasn't able to finish building => Choose another builder
		local oNewBuilder = nil
		local iBuilderID = self.builder:GetID()
		for oSquad in military_manager:GetUnlockedSquads() do
		
			-- Get a valid engineer
			if (oSquad:IsValid() and oSquad:IsEngineer() and oSquad:CanBuild(self.item_id) == SquadAI.CANBUILD_Ok and oSquad:GetID() ~= iBuilderID) then
				if (not cpu_manager:IsEngineerReservedForEpoch(oSquad, self.item_id)) then
					oNewBuilder = oSquad
					break
				end
			end
		end
		
		-- Set new builder
		if (oNewBuilder ~= nil) then
			self.builder:DoMove(cpu_manager.start_pos)
			Plan.UnlockResource(self, self.builder)
			BuildPlan.SetBuilder(self, oNewBuilder)
			self.started_building = false
		end
	end
end

function BuildBuildingPlan:Retry()

	-- Work around for invalid build position with heavy network lag or time out
	-- Bigger gen / epoch: longer timeout (aborting frees engie for other builds = interrupt feel)
	local iTimeout = 120
	if (cpu_manager:IsBiggerGenerator(self.item_id)) then
		iTimeout = 200
	elseif (self:IsEpochPlan()) then
		iTimeout = 300
	end
	if (g_iGMT > self.m_iPlanStart + iTimeout) then

		if (self:IsConstructionStillPending()) then
			aitrace("BuildBuildingPlan: Time out but unfinished — keep "..self.item_name)
			self.m_iPlanStart = g_iGMT
			local oUnfinished = self:FindOwnUnfinishedBuilding()
			if (oUnfinished == nil) then
				oUnfinished = build_manager:FindUnfinishedBuilding(self.item_id)
			end
			if (oUnfinished ~= nil and self.builder ~= nil) then
				self:ClaimOwnBuilding(oUnfinished)
				self:SafeDoFinish(self.builder, oUnfinished)
				self:MarkBuilderEpochCommitment()
			end
			return
		end
		aitrace("BuildBuildingPlan: Time out! Abort building "..self.item_name)
		Plan.UnlockResource( self, self.builder )
		self.builder = nil
		Plan.SetComplete( self, true )
		return
	end

	-- Pad already exists (first DoBuild placed it, IsBuilding lag) — finish, do NOT place a 2nd
	local oPending = self:FindOwnUnfinishedBuilding()
	if (oPending == nil) then
		oPending = build_manager:FindUnfinishedBuilding(self.item_id)
	end
	if (oPending ~= nil and self.builder ~= nil and self.builder:IsValid()) then
		aitrace("BuildBuildingPlan: Retry → finish existing "..self.item_name)
		self:MarkConstructionStarted()
		self.building = oPending
		self:ClaimOwnBuilding(oPending)
		local vPad = oPending:GetPosition()
		self.copy_build_pos = Vector3f(vPad)
		self.bestPosition = Vector3f(vPad)
		if (self.build_pos == nil) then
			self.build_pos = Vector2f()
		end
		self.build_pos.x = vPad.x
		self.build_pos.y = vPad.z
		self:SafeDoFinish(self.builder, oPending)
		self:MarkBuilderEpochCommitment()
		Plan.SetState(self, "Building a "..self.item_name, BuildBuildingPlan.BuildingState)
		return
	end

	-- Check if we have a build position
	if (self.build_pos == nil) then
		self.build_pos = Vector2f()
		self.build_pos.x = cpu_manager.start_pos.x
		self.build_pos.y = cpu_manager.start_pos.z
	end
	
	-- Find a place to build it
	if (cpu_manager:IsBiggerGenerator(self.item_id)) then
		
		-- Try to build
		self.bestPosition = Vector3f(self.copy_build_pos)
		if (self.builder:CanBuild( self.item_id ) == SquadAI.CANBUILD_Ok) then
			self.builder:DoBuildBuilding( self.item_id, self.bestPosition )
		end			 		
	else
	
		-- Get closest enemy
		local oEnemy = cpu_manager:FindClosestEnemyPlayer()
		if (oEnemy == nil) then
			return
		end
		local vEnemyPos = oEnemy:GetStartingPosition()
		
		-- Arkhan 12.2005: Retry with deviation to fix build bug
		if (math.random(1, 2) == 1) then
			
			-- Get strategic point positions
			local aBuildPositions = {}
			for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
			
				-- Check owner
				if (oStrategicPoint:Owner() == cpu_manager.player_id) then
					table.insert(aBuildPositions, oStrategicPoint:GetPosition())
				end
			end
			local iBuildPosCount = table.getn(aBuildPositions)
			if (iBuildPosCount > 0) then
				
				-- Choose a random strat position
				local vBuildPos = aBuildPositions[math.random(1, iBuildPosCount)]
				self.build_pos.x = vBuildPos.x
				self.build_pos.y = vBuildPos.z
			end
		end
		local bias_pos = Vector2f()
		local bufer = math.random(1, 8)
		if bufer == 1 then
			bias_pos.x = self.build_pos.x + math.random(-10, -5)
			bias_pos.y = self.build_pos.y + math.random(0, 0)
		elseif bufer == 2 then
		bias_pos.x = self.build_pos.x + math.random(0, 0)
		bias_pos.y = self.build_pos.y + math.random(-10, -5)
		elseif bufer == 3 then
			bias_pos.x = self.build_pos.x + math.random(5, 10)
			bias_pos.y = self.build_pos.y + math.random(0, 0)
		elseif bufer == 4 then
			bias_pos.x = self.build_pos.x + math.random(0, 0)
			bias_pos.y = self.build_pos.y + math.random(5, 10)
		elseif bufer == 5 then
			bias_pos.x = self.build_pos.x + math.random(5, 10)
			bias_pos.y = self.build_pos.y + math.random(5, 10)
		elseif bufer == 6 then
			bias_pos.x = self.build_pos.x + math.random(-10, -5)
			bias_pos.y = self.build_pos.y + math.random(-10, -5)
		elseif bufer == 7 then
			bias_pos.x = self.build_pos.x + math.random(-10, -5)
			bias_pos.y = self.build_pos.y + math.random(5, 10)
		elseif bufer == 8 then
			bias_pos.x = self.build_pos.x + math.random(5, 10)
			bias_pos.y = self.build_pos.y + math.random(-10, -5)
		end												   
		self.bestPosition = Vector3f()
		local bSuccess = cpu_manager.terrain_analyzer:FindClosestFreePosition( self.item_id, bias_pos, vEnemyPos, self.bestPosition )
		if (bSuccess and self.builder:CanBuild(self.item_id) == SquadAI.CANBUILD_Ok) then
			self.builder:DoBuildBuilding( self.item_id, self.bestPosition )
		end
	end
end

function BuildBuildingPlan:ObtainNewBuilder()

    aitrace("BuildBuildingPlan: Obtain new builder for "..self.item_name)
    self.building = nil
    
    -- Necron/Ork: this plan's pad only (global FindUnfinished → 2 on 1 gen)
    if (EngineerTactic.ShouldDisableGeneralAssist()) then
		self.building = self:FindOwnUnfinishedBuilding()
	else
		self.building = build_manager:FindUnfinishedBuilding( self.item_id )
	end
    
    -- Both the builder and the building died -- just quit
    if (self.building == nil) then
    	aitrace("BuildBuildingPlan: Can't find building for new builder. Abort "..self.item_name)
        self:SetComplete( true )
        return
    end
	self:ClaimOwnBuilding(self.building)
    
    -- Reassign under fire OK; only skip true overrun (workers build under ranged)
    local build_pos = self.building:GetPosition()    
	if (self:IsBuildSiteOverrun(build_pos)) then
		return
	end

	-- Necron/Ork: never pile a 2nd worker on the same unfinished pad
	if (EngineerTactic.ShouldDisableGeneralAssist()) then
		local iPadId = EngineerTactic.GetPadTargetId(self.building)
		if (iPadId ~= nil and not EngineerTactic.CanAssignWorker(iPadId, "build", build_pos)) then
			local iOwnerId = EngineerTactic.FindPadWorkerSquadId(iPadId, build_pos)
			local oOwner = nil
			if (iOwnerId ~= nil) then
				oOwner = military_manager:GetSquadFromID(iOwnerId)
			end
			-- Ghost claim (capturer / POST LOCK / dead): purge and allow new builder
			if (oOwner == nil or not oOwner:IsValid() or
				EngineerTactic.IsSquadOffPadDuty(oOwner)) then
				if (oOwner ~= nil and oOwner:IsValid()) then
					EngineerTactic.UnregisterWorkerSquad(oOwner)
				else
					EngineerTactic.CleanupBufer()
				end
				aitrace("BuildBuildingPlan: Purge ghost pad claim — "..self.item_name)
				-- fall through to GetClosestEngineerForBuild
			elseif (oOwner:IsBuilding() ~= 0 or oOwner:IsBuildProgressing()) then
				-- Real pad worker finishing — wait
				aitrace("BuildBuildingPlan: Pad already has worker (Necron/Ork max 1) — "..self.item_name)
				return
			elseif (oOwner:IsLocked()) then
				-- Already locked — NEVER SetBuilder/LockResource (Plan.ai:146 assert)
				if (self.builder == nil or
					(type(self.builder.GetID) == "function" and
					 self.builder:GetID() == oOwner:GetID())) then
					self.builder = oOwner
					EngineerTactic.RegisterWorker(iPadId, oOwner)
					local oOwnTac = oOwner:GetTactic()
					if (oOwnTac ~= nil) then
						oOwnTac.m_vDestination = Vector3f(build_pos)
						oOwnTac.m_bBusy = true
						oOwnTac.m_Bufer = true
					end
					self:SafeDoFinish(oOwner, self.building)
					Plan.SetNeeds(self, "No needs", Plan.NeedsFulfilled)
					aitrace("BuildBuildingPlan: Keep locked pad worker (no re-Lock) — "..self.item_name)
				else
					aitrace("BuildBuildingPlan: Pad worker locked by other — wait "..self.item_name)
				end
				return
			else
				-- Unlocked idle claim: adopt same worker
				local oOwnTac = oOwner:GetTactic()
				BuildPlan.SetBuilder(self, oOwner)
				self:MarkBuilderEpochCommitment()
				EngineerTactic.RegisterWorker(iPadId, oOwner)
				if (oOwnTac ~= nil) then
					oOwnTac.m_vDestination = Vector3f(build_pos)
					oOwnTac.m_bBusy = true
				end
				self:SafeDoFinish(oOwner, self.building)
				Plan.SetNeeds(self, "No needs", Plan.NeedsFulfilled)
				aitrace("BuildBuildingPlan: Adopt pad worker (Necron/Ork max 1) — "..self.item_name)
				return
			end
		end
	end
    
    local engineer = cpu_manager:GetClosestEngineerForBuild(self.item_id, build_pos, true, false, build_pos)
    if (engineer == nil) then
    	engineer = cpu_manager:GetClosestEngineerForBuild(self.item_id, build_pos, true, true, build_pos)
    end
    if (engineer ~= nil and not engineer:IsLocked()) then
        BuildPlan.SetBuilder( self, engineer )
        self:MarkBuilderEpochCommitment()
		local iRegId = EngineerTactic.GetPadTargetId(self.building)
		if (iRegId ~= nil) then
			EngineerTactic.RegisterWorker(iRegId, engineer)
		end
		local oTactic = engineer:GetTactic()
		if (oTactic ~= nil) then
			oTactic.m_vDestination = Vector3f(build_pos)
			oTactic.m_bBusy = true
		end
        
        if (self:NeedsAssistantBuilder()) then
        	self:ObtainAssistantBuilder(self.building)
        end
    
        Plan.SetNeeds( self, "No needs", Plan.NeedsFulfilled )
        return
    end
end

function BuildBuildingPlan:FixState()

	if (self.building == nil or self.builder == nil) then
		return
	end
	
	self.started_building = false
	self:SafeDoFinish(self.builder, self.building)
	Plan.SetState( self, "Fixing a "..self.item_name, BuildBuildingPlan.BuildingState )
end

function BuildBuildingPlan:ShiftState()

	if (self.builder == nil) then
		return
	end
		
	if (not self.shifted) then
		aitrace("BuildBuildingPlan: Shift state move/release")
		local move_pos = Vector3f(self.bestPosition)
		move_pos.x = move_pos.x + deviate_pos(math.random(5,10))
		move_pos.z = move_pos.z + deviate_pos(math.random(5,10))
		cpu_manager:DoMove(self.builder, move_pos, false, "Slag builder shift")
		self.shift_move = g_iGMT
		self.shifted = true
	elseif (self.shifted and g_iGMT >= self.shift_move + 4) then
		aitrace("BuildBuildingPlan: Shift state retry")
		self.building = build_manager:FindUnfinishedBuilding( self.item_id )
		if ( self.building == nil ) then
			Plan.UnlockResource( self, self.builder )
			self.builder = nil	
			self:SetComplete( true )
		else
			Plan.SetState(self, "Try to fix building: "..self.item_name, BuildBuildingPlan.FixState)
			self.shift_move = g_iGMT
			self.shifted = false
		end
	end 
end


function BuildBuildingPlan:Update()

	AITrace.Log("Plan.Noise", "BuildBuildingPlan: Update building plan for "..self.item_name)
	
	-- Take into account if my builder dies
	if (self.builder ~= nil and not self.builder:IsValid()) then
	
		-- Reset builder
		Plan.UnlockResource( self, self.builder )
		self.builder = nil

		-- Set my state to try to fix the building
		if (self.started_building) then
			Plan.SetNeeds(self, "Asking for new builder", BuildBuildingPlan.ObtainNewBuilder)
			Plan.SetState(self, "Try to fix building: "..self.item_name, BuildBuildingPlan.FixState)
		else
			Plan.SetNeeds(self, "Asking for builder", BuildBuildingPlan.ObtainBuilder)
			Plan.SetState(self, "Wanting to build: "..self.item_name, BuildBuildingPlan.BuildBuilding)
		end
	end
	
	if (self.assistant_builder ~= nil and not self.assistant_builder:IsValid()) then
		Plan.UnlockResource(self, self.assistant_builder)
		self.assistant_builder = nil
	end
	
	self:MaintainAssistantBuilder()
	self:MaintainStationaryBuilderUnstick()

	-- Locked builder stuck at template site (не сбрасываем Front/Around HQ пока идёт марш)
	if (self.builder ~= nil and self.builder:IsValid() and self.builder:IsLocked() and not self.started_building) then
		local bUnreachable = false
		local bIdleStuck = false
		local bFarFromSite = false
		if (self.m_bKeepBuildPos) then
			bUnreachable = self:IsSiteUnreachableForBuilder(self.builder)
			bIdleStuck = (self.builder:IsIdle() and
				not self.builder:IsBuildProgressing() and self.builder:IsBuilding() == 0 and
				self:IsBuilderCloseToSite(self.builder, self.bestPosition))
		else
			bUnreachable = (self.bestPosition ~= nil and
				not self:CanBuilderUseSite(self.builder, self.bestPosition))
			bIdleStuck = (self.builder:IsIdle() and
				not self.builder:IsBuildProgressing() and self.builder:IsBuilding() == 0)
			if (self.bestPosition ~= nil) then
				bFarFromSite = (distance_sqr(self.builder:GetPosition(), self.bestPosition) > sqr(40) and
					self.builder:IsBuilding() == 0 and not self.builder:IsBuildProgressing())
			end
		end
		if (bUnreachable or bIdleStuck or bFarFromSite) then
			local iTimeout = BuildBuildingPlan.IDLE_LOCKED_ABORT_SEC
			if (bUnreachable) then
				iTimeout = BuildBuildingPlan.UNREACHABLE_RETRY_SEC
			end
			if (self.m_iUnreachableSince == nil) then
				self.m_iUnreachableSince = g_iGMT
			elseif (g_iGMT >= self.m_iUnreachableSince + iTimeout) then
				if (self:ApplyFallbackBuildPosition(self.builder:GetPosition())) then
					self.m_iUnreachableSince = nil
					self.m_iStuckSince = nil
					Plan.SetState(self, "Wanting to build: "..self.item_name, BuildBuildingPlan.BuildBuilding)
				else
					self:AbortAndReleaseBuilder("unreachable template site")
				end
				Plan.Update(self)
				return
			end
		else
			self.m_iUnreachableSince = nil
		end
	end
		
	-- retry or quit building if big generator is not progressing
	if (self.builder ~= nil and cpu_manager:IsBiggerGenerator(self.item_id) and 
		self.started_building and g_iGMT > self.m_iPlanStart + 10 and self.builder:IsBuilding() == self.item_id and 
		not self.builder:IsBuildProgressing()) then
		local oStuckTac = self.builder:GetTactic()
		local bMoving = (oStuckTac ~= nil and oStuckTac:IsMoving())
		if (not bMoving) then
			-- time to build a big gen (dcpro)
			local build_time = 160
			if (g_iGMT <= self.m_iPlanStart + build_time + 10) then
				aitrace("BuildBuildingPlan: Builder stuck, shift position")
				if (g_iGMT >= self.shift_move + 8) then 
					aitrace("BuildBuildingPlan: Builder stuck, set shift state")
					Plan.SetState(self, "Shifting builder for: "..self.item_name, BuildBuildingPlan.ShiftState)
				end
			elseif (self.building ~= nil) then
				self:SafeDoFinish(self.builder, self.building)
			else
				aitrace("BuildBuildingPlan: Builder stuck. Abort "..self.item_name, true)
				Plan.UnlockResource( self, self.builder )
				self.builder = nil
				self:SetComplete(true)		
			end
		end
	-- Check if builder is lazy (bigger/epoch: brief idle is normal; don't abort and hand engie away)
	elseif (self.builder ~= nil and self.builder:IsIdle() and self.started_building) then
		
		if (self.building == nil) then
			self.building = build_manager:FindUnfinishedBuilding(self.item_id)
		end
		self.building = EngineerTactic.ResolveLiveFinishTarget(self.building)
		if (self.building == nil) then
			self.m_iClaimedBuildingId = nil
		end
		-- Dark Eldar: idle + pad already kicked off (HP>0.2) → unlock, do NOT re-DoFinish
		if (cpu_manager:AutoConstructBuildings() and not self:IsEpochPlan() and self.building ~= nil) then
			if (self.building:GetHealthPercentage() > 0.2) then
				aitrace("BuildBuildingPlan: Job finished (auto-construct idle)...")
				Plan.UnlockResource(self, self.builder)
				self.builder = nil
				Plan.SetComplete(self, true)
				Plan.Update(self)
				return
			end
		end
		-- Idle dance/melee: yank back unless worker should abandon
		if (self.building ~= nil and self:IsBuildSiteOverrun(self.building:GetPosition())) then
			local oTactic = self.builder:GetTactic()
			if (oTactic ~= nil and oTactic.ShouldAbandonWork ~= nil and oTactic:ShouldAbandonWork()) then
				self:ReleaseBuilderFromOverrun("lazy under overrun")
			else
				aitrace("BuildBuildingPlan: Builder lazy, send him to work again")
				self:SafeDoFinish(self.builder, self.building)
				self:MarkBuilderEpochCommitment()
			end
		elseif (self.building ~= nil) then
			if (EngineerTactic.ShouldDisableGeneralAssist()) then
				local oTactic = self.builder:GetTactic()
				local iPadId = EngineerTactic.GetPadTargetId(self.building)
				if (oTactic ~= nil and iPadId ~= nil and
					not oTactic:CanJoinBuildTarget(iPadId, self.building:GetPosition(), "build")) then
					aitrace("BuildBuildingPlan: lazy skip foreign pad — "..self.item_name)
					Plan.UnlockResource(self, self.builder)
					self.builder = nil
					return
				end
				if (iPadId ~= nil) then
					EngineerTactic.RegisterWorker(iPadId, self.builder)
				end
			end
			aitrace("BuildBuildingPlan: Builder lazy, send him to work again")
			self:SafeDoFinish(self.builder, self.building)
			self:MarkBuilderEpochCommitment()
		elseif (cpu_manager:IsBiggerGenerator(self.item_id)) then
			-- Keep plan alive; re-issue build at slag instead of aborting
			if (self.bestPosition ~= nil and self.builder:CanBuildAt(self.item_id, self.bestPosition)) then
				self.builder:DoBuildBuilding(self.item_id, self.bestPosition)
			elseif (self.copy_build_pos ~= nil) then
				cpu_manager:DoMove(self.builder, self.copy_build_pos, false, "Resume bigger generator")
			end
		elseif (self:IsEpochPlan()) then
			aitrace("BuildBuildingPlan: Epoch idle — waiting for footprint "..self.item_name, true)
		else
			aitrace("BuildBuildingPlan: No building available. Abort "..self.item_name, true)
			Plan.UnlockResource( self, self.builder )
			self.builder = nil
			self:SetComplete(true)
		end
	elseif (self.builder ~= nil and self.started_building and self.builder:IsBroken() and
		not self.builder:IsBuildProgressing()) then
		if (self.building ~= nil and not self:IsBuildSiteOverrun(self.building:GetPosition())) then
			self:SafeDoFinish(self.builder, self.building)
		end
	end

	Plan.Update( self )
end

function BuildBuildingPlan:BuildBuildingFast()

	-- Check for builder
	if (self.builder == nil) then
		
		-- Shall we wait for a builder?
		if (self.wait_on_builder == nil) then	
			aitrace( "BuildBuildingPlan: No builder found. Abort "..self.item_name )
--			Plan.SetComplete( self, true )
		else
			aitrace( "BuildBuildingPlan: Search builder for "..self.item_name )	
		end
		return
	end

	if not (self.builder:IsBuilding() == 0) or self.builder:GetTactic():IsBufer() then
                return
        end

	-- Relocate only for buildings that use safe placement (not LP/turret/mine)
	if (cpu_manager:UsesEngineerSafePlacement(self.item_id) and
		cpu_manager.terrain_analyzer:HasThreat(self.bestPosition, 35)) then
	
		-- Try to find a save build position
		if (not self:SetSaveBuildPosition(self.builder)) then
			if (not self:ApplyFallbackBuildPosition(self.builder:GetPosition())) then
				aitrace("BuildBuildingPlan: Cannot build under threat : "..self.item_name)
				return
			end
		end
	end

	if (not self.m_bKeepBuildPos and not self:EnsureReachableBuildSite(self.builder)) then
		return
	end

	-- No assertion for bigger generators !!!
	if (cpu_manager:IsBiggerGenerator(self.item_id)) then
		if (not self.builder:CanBuildAt(self.item_id, self.bestPosition) or self.builder:CanBuild(self.item_id) ~= SquadAI.CANBUILD_Ok) then
			return
		end
	end
	
	-- Check if building can be built
	if (not self.builder:CanBuildAt(self.item_id, self.bestPosition)) then
		aitrace("BuildBuildingPlan: Can't build building for unknown reasons. Try to get another build position..", true)
		if (self.m_bKeepBuildPos and not self:IsBuilderCloseToSite(self.builder, self.bestPosition)) then
			cpu_manager:DoMove(self.builder, self.bestPosition, false, "Template approach "..self.item_name)
			return
		end
		if (self:ApplyFallbackBuildPosition(self.builder:GetPosition())) then
			if (self.builder:CanBuildAt(self.item_id, self.bestPosition)) then
				self.builder:DoBuildBuilding(self.item_id, self.bestPosition)
				Plan.SetState( self, "Building a "..self.item_name, BuildBuildingPlan.BuildingState )
			else
				self.m_iPlacementFailCount = self.m_iPlacementFailCount + 1
				if (self.m_iPlacementFailCount >= 8) then
					self:AbortAndReleaseBuilder("no valid site after fallback")
				end
			end
			return
		end
		self.build_pos = nil
		self:InitBestBuildingPosition()
		return
	end
	
	-- Try to build
	self.builder:DoBuildBuilding(self.item_id, self.bestPosition)

	-- Change state
	Plan.SetState( self, "Building a "..self.item_name, BuildBuildingPlan.BuildingState )
	return
end