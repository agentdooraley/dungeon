class 'InfantryTactic' (Tactic)

-- Target ability table
InfantryTactic.TargetAbilities = {}

function InfantryTactic:__init( squad_ai ) super( squad_ai )

	-- Generate all the ability id's
	self:AddTargetAbilities()
	for iLoop1 in InfantryTactic.TargetAbilities do
	
		-- Check ability ID
		if (InfantryTactic.TargetAbilities[iLoop1][1] == nil) then
			local ability_id = cpu_manager.stats:GetAbilityID( InfantryTactic.TargetAbilities[iLoop1][2] )
			dbAssert( ability_id ~= nil )
			InfantryTactic.TargetAbilities[iLoop1][1] = ability_id
		end		
	end
	
	Tactic.AssignStateFunction( self, Tactic.States.Hold, self.BeginHoldState )
	Tactic.AssignStateFunction( self, Tactic.States.Retreat, self.BeginRetreatState )
	Tactic.AssignStateFunction( self, Tactic.States.Attack, self.BeginAttackState )
	
	-- Init list of commanders
	self.commander = {}
	self:AddCommanders()
	self.m_bCommander = false
	local sSquadName = squad_ai:GetSquadName()
	for iLoop1 in self.commander do
	
		-- Check if we are a commander
		if (self.commander[iLoop1][1] == sSquadName) then
			self.m_bCommander = true
			break
		end
	end

	self.morale_threshold = 300

    --Life Time
    self.time_life = 0

	self.strat_ai = nil
	
	-- Cover flag
	self.m_bTakeCover = true
	
	self:SetName("Infantry Tactic")
	self.m_eType = Tactic.Types.Infantry
		
	self.m_iCoverDelay = 0
	
	self.m_bBunkerSquad = false
	
	self.m_iTransportable = 0
	
	-- Arkhan 06.2006: Set commander attach/detach health percentage
	self.m_fCommanderAttachHealth = 0.4
	
	-- Check resource(req+pow) cost
	self.iReqCost = 0
	self.iPowCost = 0
	local oStats = self.squad_ai:GetStats()
	if (oStats ~= nil) then
		self.iReqCost = oStats:GetCost(ResourceAmount.RT_Requisition)
		self.iPowCost = oStats:GetCost(ResourceAmount.RT_Power)
	end
	self.iResCost = self.iReqCost + self.iPowCost

	-- Check power cost
	self.m_bPowerCost = false
	local oStats2 = self.squad_ai:GetStats()
	if (oStats2 ~= nil and oStats2:GetCost(ResourceAmount.RT_Power) > 0) then
		self.m_bPowerCost = true
	end
	
	-- Init wait for threat flag
	self.bWaitForThreat = false
end

function InfantryTactic:IsCommanderAttacker()

	-- Check if we are attacking
	if (self.squad_ai:IsLocked()) then
	
		-- Retreat if almost dead and not part of a large army
		if (self.squad_ai:GetHealthPercentage() < 0.6 and cpu_manager:GetArmyStrength() < 2000) then
			return false
		end
	else
		-- Don't join attacks if severly hurt
		if (self.squad_ai:GetHealthPercentage() < 0.4 or (cpu_manager:GetTierLevel() > 1 and self.squad_ai:GetHealthPercentage() < 0.6)) then
			return false
		end
	end
	return true
end

function InfantryTactic:IsCommanderDefender()
	
	-- Check HQ threat
	if (cpu_manager:GetCriticalThreat() > 0) then
		return true
	end
	return self:IsCommanderAttacker()
end

-- Arkhan 01.2006: Abstract method
function InfantryTactic:AddTargetAbilities()

end

-- Arkhan 01.2006: Abstract method
function InfantryTactic:AddCommanders()

end

function InfantryTactic:IsTransportable()
	return self.m_iTransportable
end



function InfantryTactic:CanTakeCoverAt( vSearchPos, iCheckRange )
	if (vSearchPos == nil) then
		return false
	end
	if (iCheckRange == nil) then
		iCheckRange = 25
	end
	local iEnemyStrength, iAlliedStrength = cpu_manager:GetArmyStrengthAtPos(vSearchPos, iCheckRange, true)
	if (iEnemyStrength == 0) then
		return true
	end
	if (iAlliedStrength >= 3 * iEnemyStrength) then
		return true
	end
	return false
end



function InfantryTactic:TryTakeCover( vSearchPos, iSearchRange )
	if (not self.m_bTakeCover or vSearchPos == nil) then
		return false
	end
	if (iSearchRange == nil) then
		iSearchRange = 35
	end
	local iCheckRange = 25
	if (not self:CanTakeCoverAt(vSearchPos, iCheckRange)) then
		self.m_iCoverDelay = g_iGMT + 8
		return false
	end
	local vSquadPos = self.squad_ai:GetPosition()
	if (not self:IsDisengageRouteClear(vSquadPos, vSearchPos, 20)) then
		self.m_iCoverDelay = g_iGMT + 5
		return false
	end
	if (self.squad_ai:DoMoveToClosestCover(vSearchPos, iSearchRange)) then
		return true
	end
	return false
end

function InfantryTactic:HarrasingAttack()
    if CpuManager.AISettings.bHarassing then
		local vMyPos = self.squad_ai:GetPosition()
		local vPosThreat, iAlliedStrength = cpu_manager:GetArmyStrengthAtPos(vMyPos, 60 , true)
		local aCapturers = cpu_manager:GetAvailableCapturers()
        if ((g_iGMT < DefendChokePointPlan.HarassingTime*60 and g_iGMT > 30 and self.time_life > 1) 
			or (self.time_life > 1 and self.time_life < 60 and g_iGMT < 300 and g_iGMT > 30)) 
			and not self.squad_ai:IsEngineer() and self.squad_ai:IsIdle() and cpu_manager:GetUnitStrength(self.squad_ai)>180 and iAlliedStrength > vPosThreat*1.5 then
	-- Find closest enemy
			self.vHarassingTargetAttack = nil
			local oEnemy = cpu_manager:FindClosestEnemyPlayer()
			if (oEnemy == nil) then
				self.vHarassingTargetAttack = nil
				return
			end

			-- Check if old target is still valid
			if (self.vHarassingTargetAttack ~= nil) then
						
				-- Check for buildings
				if (cpu_manager.cpu_player:FindFirstBaseEnemy(self.vHarassingTargetAttack, 35, 1) == nil) then
					return
				end

				-- Check for strats to disown
				local oStrategicPoint = resource_manager:FindFirstStrategicPoint(self.vHarassingTargetAttack, 40)
				if (oStrategicPoint ~= nil) then
				
					-- Check owner
					local iOwnerID = oStrategicPoint:Owner()
					if (iOwnerID ~= 0 and not cpu_manager:IsFriendly(iOwnerID)) then
						return
					end
				end
			end

			-- Check for closest enemy building and closest enemy engineer on building
			local iMaxAttackDistance = 250
			local oEnemyBuilding = cpu_manager.cpu_player:FindFirstBaseEnemy(cpu_manager.cpu_player:GetStartingPosition(), iMaxAttackDistance, 1)
			if (oEnemyBuilding ~= nil) then
				local oUnit = cpu_manager.cpu_player:FindFirstInfantryEnemy(oEnemyBuilding:GetPosition(), 35, 1)
					  if (oUnit ~= nil and oUnit:IsEngineer()) then
						self.vHarassingTarget = Vector3f(oUnit:GetPosition())
					  elseif (oUnit ~= nil) then
						self.vHarassingTarget = Vector3f(oUnit:GetPosition())
					  else
						self.vHarassingTarget = Vector3f(oEnemyBuilding:GetPosition())
						iMaxAttackDistance = cpu_manager:GetShortestPathingDistance(cpu_manager.cpu_player:GetStartingPosition(), self.vHarassingTarget, true)
					  end
			end
				
			-- Check for strats to disown
			local oStrategicPoint = resource_manager:FindFirstStrategicPoint(cpu_manager.cpu_player:GetStartingPosition(), iMaxAttackDistance)
			if (oStrategicPoint ~= nil) then
			
				-- Check owner
				local iOwnerID = oStrategicPoint:Owner()
				if (iOwnerID ~= 0 and not cpu_manager:IsFriendly(iOwnerID)) then
					  local oUnit = cpu_manager.cpu_player:FindFirstInfantryEnemy(oStrategicPoint:GetPosition(), 35, 1)
					  if (oUnit ~= nil and oUnit:IsEngineer()) then
						self.vHarassingTarget = Vector3f(oUnit:GetPosition())
					  elseif (oUnit ~= nil) then
						self.vHarassingTarget = Vector3f(oUnit:GetPosition())
					  else
						self.vHarassingTarget = Vector3f(oStrategicPoint:GetPosition())
					  end
				end
			end

			if self.vHarassingTargetAttack ~= nil then
				self.vHarassingTargetAttack = self.vHarassingTargetAttack
				cpu_manager:DoMove(self.squad_ai, self.vHarassingTargetAttack, true, "AttackState")
			else 
				self.vHarassingTargetAttack = oEnemy:GetStartingPosition()
				Tactic.SetState(self, Tactic.States.Attack)
				cpu_manager:DoMove(self.squad_ai, self.vHarassingTargetAttack, true, "AttackState")
			end

        end
    end
end

function InfantryTactic:BeginHoldState()
	
	-- Check if we're desperatly capturing
	if (self:UrgentCapturing()) then
		return
	end

	if (self:IsCapturePlanMove()) then
		if (self.squad_ai:IsCapturing()) then
			return
		end

		local vSquadPos = self.m_vCurrentPosition
		local iDistance = distance_sqr(self:GetTarget(), vSquadPos)
		if (iDistance > sqr(25)) then
			if (g_iGMT >= self.m_iMoveDelay + 8) then
				cpu_manager:DoMove(self.squad_ai, self:GetTarget(), false, "CapturePlanMove")
				self.m_iMoveDelay = g_iGMT
			end
		end

		Tactic.SetSubState( self, self.HoldState, "Holding" )
		return
	end

	if (self:IsCaptureGuardMove() and not self:IsCaptureGuardAttack()) then
		if (self.squad_ai:IsCapturing()) then
			return
		end

		local vSquadPos = self.m_vCurrentPosition
		local iDistance = distance_sqr(self:GetTarget(), vSquadPos)
		if (iDistance > sqr(25)) then
			if (g_iGMT >= self.m_iMoveDelay + 6) then
				cpu_manager:DoMove(self.squad_ai, self:GetTarget(), false, "CaptureGuardEscort")
				self.m_iMoveDelay = g_iGMT
			end
		elseif (iDistance < sqr(20) and not self.squad_ai:IsAttacking() and not self.squad_ai:IsInStateAttackMove()) then
			self.squad_ai:DoStop()
			self.m_iMoveDelay = g_iGMT
		end

		Tactic.SetSubState( self, self.HoldState, "Holding" )
		return
	end
	
	-- Check if our capturing was interrupted
	if (self.squad_ai:IsCapturing()) then
		
		if (self.squad_ai:WasRecentlyHurt()) then
			cpu_manager:DoMove(self.squad_ai, self.squad_ai:GetPosition(), true, "Interrupt capturing!")
		end
		return
	end
	
	-- Check if we're busy
	if (self:IsInSubState() or (self:IsAffectedByMorale() and self.squad_ai:IsBroken())) then
		return
	end

	-- Check if we're doing a gather move at the moment
	if (self:CheckGatherMove()) then
		return
	end

	-- Jump into planned target fight, or assist a distant fight if AFK
	if (self:JumpAttack() or self:TryJumpAssistFight()) then
		self.m_iMoveDelay = 0
		return
	end
	
	-- Try to disown flags
	if (self:TryDisownFlags()) then
		self.m_iMoveDelay = g_iGMT
		Tactic.SetSubState( self, self.HoldState, "Holding" )
		return
	end
	
	-- Check move delay
	local vSquadPos = self.m_vCurrentPosition
	local iDistance = distance_sqr(self:GetTarget(), vSquadPos)
	if (g_iGMT < self.m_iMoveDelay + 5 and self:IsMoving() and (iDistance > sqr(60) or self.squad_ai:IsInStateAttackMove())) then
		Tactic.SetSubState( self, self.HoldState, "Holding" )
		return
	end
	
	-- Check for deepstrike buildings
	if (self:EnterDeepStrikeBuilding()) then
		self.m_iMoveDelay = g_iGMT
		Tactic.SetSubState( self, self.HoldState, "Holding" )
		return
	end
		
	-- Check for cover and bunkers (near plan target OR under pressure — bunker is local)
	local bBunkerPressure = (self.squad_ai:WasRecentlyHurt() or self.squad_ai:IsUnderAttack() or
		self.squad_ai:GetHealthPercentage() < 0.55)
	if ((iDistance < sqr(35) or bBunkerPressure) and self.squad_ai:IsRanged() and g_iGMT > self.m_iCoverDelay) then
        local vPosThreat, iAlliedStrength = cpu_manager:GetArmyStrengthAtPos(vSquadPos, 40, true)			
		-- Check if squad is able to occupy bunkers
		if (self.m_bBunkerSquad) then
			
			-- Try to occupy a close bunker	
			if (cpu_manager:OccupyBunker(self.squad_ai, 20)) then
				self.m_iMoveDelay = g_iGMT
				self.m_iCoverDelay = g_iGMT
				Tactic.SetSubState( self, self.HoldState, "Holding" )
				return
			end
		end
		
		-- Check if we should try to take cover
		if (self.m_bTakeCover and not self.squad_ai:HasSetupTime() and self.squad_ai:WasRecentlyHurt()) and vPosThreat<iAlliedStrength and not self.squad_ai:IsInCombat() and not self.squad_ai:IsUnderAttack() then
		
			-- Try to take cover
			if (self:TryTakeCover(self.squad_ai:GetPosition(), 35)) then
				self.m_iMoveDelay = g_iGMT
				self.m_iCoverDelay = g_iGMT
				Tactic.SetSubState( self, self.HoldState, "Holding" )
				return
			end
		end
	end
	
	if (self.squad_ai:IsRanged() and self:TryCombatDisengage()) then
		self.m_iMoveDelay = g_iGMT
		Tactic.SetSubState(self, self.HoldState, "Holding")
		return
	end

	if (self.squad_ai:IsRanged() and self:MaintainInfantryRangedRange()) then
		Tactic.SetSubState(self, self.HoldState, "Holding")
		return
	end

	local iCloseDist = 25
	local iFarDist = 60
	if (self.squad_ai:IsRanged()) then
		iCloseDist = math.floor(self:GetRangedCombatRange() * 0.85)
		iFarDist = self:GetRangedCombatRange() + 15
	end

	-- Check distance
	if (iDistance > sqr(iCloseDist) and not self.squad_ai:IsInCombat() and 
        self.squad_ai:GetHealthPercentage() > 0.5 and self.squad_ai:GetNumTroopers() > self.squad_ai:GetMaxTroopers() / 3) and self.squad_ai:GetNumTroopers() > 1 then
	
		-- Check for a close transporter
		local oTransporterTactic = cpu_manager:GetTransporterInRange(vSquadPos, self.m_iTransportable)
		if (oTransporterTactic ~= nil) then
		
			-- Try to enter transporter
			oTransporterTactic:LoadSquad(self.squad_ai, self:GetUnitStrength(), self:GetTarget())
			self.m_iMoveDelay = g_iGMT
			Tactic.SetSubState( self, self.HoldState, "Holding" )
			return
		end
		cpu_manager:DoMove(self.squad_ai, self:GetTarget(), false, "HoldState")
	
	elseif (iDistance > sqr(iFarDist)) then
	
		-- If we get near the target area, then make an attack move
		cpu_manager:DoMove(self.squad_ai, self:GetTarget(), true, "HoldState")

	elseif (not self.squad_ai:IsAttacking() and not self.squad_ai:IsInStateAttackMove()) then
	
		-- Check targets for melee squads
		if (not self.squad_ai:IsRanged()) then
			
			-- Get closest enemy unit
			local oUnit = self:GetClosestUnitForMelee(50)
			if (oUnit ~= nil and ((not oUnit:IsInfiltrating() or oUnit:IsAttacking()) or oUnit:IsEngineer())) then --or self.squad_ai:IsDetector()
				cpu_manager:DoMove(self.squad_ai, oUnit:GetPosition(), true, "HoldState")
				self.m_iMoveDelay = g_iGMT + 3
			else
			
				-- Get closest enemy building
				local oBuilding = self:GetClosestBuildingForMelee(50)
				if (oBuilding ~= nil) then
				
					-- Don't move too close to building
					if (distance_sqr(oBuilding:GetPosition(), vSquadPos) > sqr(15)) then
						cpu_manager:DoMove(self.squad_ai, oBuilding:GetPosition(), true, "HoldState")
						self.m_iMoveDelay = g_iGMT + 3
					end
					
				elseif (iDistance > sqr(25) or self.squad_ai:WasRecentlyHurt()) then
				
					-- Move to target if we're hurt or not close enough
					cpu_manager:DoMove(self.squad_ai, self:GetTarget(), true, "HoldState")
					self.m_iMoveDelay = g_iGMT
				else
					self.squad_ai:DoStop()
					self.m_iMoveDelay = g_iGMT
				end
			end
		else
				
			-- Check for close and near distance
			if (self:MaintainInfantryRangedRange()) then
				Tactic.SetSubState(self, self.HoldState, "Holding")
				return
			end
			if (iDistance < sqr(iCloseDist) and not self.squad_ai:WasRecentlyHurt() and not cpu_manager.terrain_analyzer:HasThreat(self:GetTarget(), 35)) then
			
				-- Try to take cover in close distance
			 	if (self.squad_ai:IsIdle() and g_iGMT > self.m_iCoverDelay and self.m_bTakeCover) then
								
					-- Try to take cover
					if (self:TryTakeCover(self:GetTarget(), 35)) then
						self.m_iMoveDelay = g_iGMT
						self.m_iCoverDelay = g_iGMT
					end
				else
					self.squad_ai:DoStop()
					self.m_iMoveDelay = g_iGMT
				end
				Tactic.SetSubState( self, self.HoldState, "Holding" )
				return
			end
			if (iDistance > sqr(iFarDist)) then
				cpu_manager:DoMove(self.squad_ai, self:GetTarget(), true, "HoldState")
				self.m_iMoveDelay = g_iGMT
			end
		end
	end

	-- Set holding sub-state
	Tactic.SetSubState( self, self.HoldState, "Holding" )
end

-- OccupyBunker used to live only in BeginHold/Attack — after anti-stutter those rarely re-run in combat
function InfantryTactic:TryEnterNearbyBunker()
	if (not self.m_bBunkerSquad or self.squad_ai == nil or not self.squad_ai:IsValid()) then
		return false
	end
	if (self.squad_ai:IsCapturing()) then
		return false
	end
	if (g_iGMT <= self.m_iCoverDelay) then
		return false
	end

	local fHP = self.squad_ai:GetHealthPercentage()
	local bHurt = (self.squad_ai:WasRecentlyHurt() or self.squad_ai:IsUnderAttack() or fHP < 0.55)
	if (not bHurt) then
		local vPos = self.m_vCurrentPosition
		if (vPos == nil) then
			vPos = self.squad_ai:GetPosition()
		end
		local iEnemy, iAllied = cpu_manager:GetArmyStrengthAtPos(vPos, 35, true)
		if (iEnemy <= 0 or iEnemy < iAllied * 1.2) then
			return false
		end
	end

	if (not cpu_manager:OccupyBunker(self.squad_ai, 20)) then
		return false
	end
	self.m_iMoveDelay = g_iGMT
	self.m_iCoverDelay = g_iGMT + 2
	return true
end

function InfantryTactic:HoldState()

	if (self:IsCapturePlanMove() or self:IsCaptureGuardMove()) then
		return
	end

	-- Try to jump into combat / assist distant fights
	if (not self.squad_ai:IsCapturing() and (self:JumpAttack() or self:TryJumpAssistFight())) then
		self.m_iMoveDelay = 0
		return
	end
	
	-- Try to disown flags
	if (self:TryDisownFlags()) then
		self.m_iMoveDelay = g_iGMT
		return
	end

	-- Bunker refuge while engaged (BeginHold no longer restarts mid-fight)
	if (self:TryEnterNearbyBunker()) then
		return
	end
	
	-- If idle, restart — but not while shooting/in combat (re-BeginHold DoMove = walk-stop stutter)
	if (not self:IsInEmergencySubState() and not self:NeedsRangedDisengage()) then
		if (self.squad_ai:IsAttacking() or self.squad_ai:IsInCombat()) then
			return
		end
		if (self.squad_ai:IsIdle() or not self:IsMoving() or (self.squad_ai:WasRecentlyHurt() and not self.squad_ai:IsRanged())) then
			Tactic.SetState( self, self:GetState() )
		end
	end
end

function InfantryTactic:BeginRetreatState()
	if (self:IsOverwhelmSpamMode() and not self.squad_ai:IsLocked()) then
		return
	end
	local vSquadPos = self.m_vCurrentPosition
	local vPosThreat, iAlliedStrength = cpu_manager:GetArmyStrengthAtPos(vSquadPos, 40, true)
	-- Check if we're desperatly capturing
	if (self:UrgentCapturing()) then
		return
	end
	
	-- Check if our capturing was interrupted
	if (self.squad_ai:IsCapturing()) then
		
		if (self.squad_ai:WasRecentlyHurt()) or (self.squad_ai:IsUnderAttack() and iAlliedStrength < 0.9*vPosThreat)  then
			cpu_manager:DoMove(self.squad_ai, self.squad_ai:GetPosition(), true, "Interrupt capturing!")
		end
		return
	end
	
	-- Check if we're busy
	if (self:IsInSubState()) then
		return
	end

	-- Melee winning/equal fight: don't micro-retreat / jump-flee
	if (self:ShouldStayInFight()) then
		return
	end

	-- Try to jump if under attack
	if (self.squad_ai:IsUnderAttack()) then
		
		-- Move to disengage
		if (self:MoveToDisengage()) then
			self.m_iMoveDelay = g_iGMT
			return
		end
	end
	
	-- Check move delay
	if (g_iGMT < self.m_iMoveDelay + 5 and self:IsMoving()) then
		Tactic.SetSubState(self, self.HoldState, "Holding")
		return
	end
	
	-- Check for deepstrike buildings
	if (self:EnterDeepStrikeBuilding()) then
		self.m_iMoveDelay = g_iGMT
		Tactic.SetSubState( self, self.HoldState, "Holding" )
		return
	end
	
	-- Check for cover and bunkers
	local vSquadPos = self.m_vCurrentPosition
	local iDistance = distance_sqr(self:GetTarget(), vSquadPos)
	if (self.squad_ai:IsRanged() and g_iGMT > self.m_iCoverDelay) then
        			
		-- Check if squad is able to occupy bunkers
		if (self.m_bBunkerSquad) then
			
			-- Try to occupy a close bunker	
			if (cpu_manager:OccupyBunker(self.squad_ai, 20)) then
				self.m_iMoveDelay = g_iGMT
				self.m_iCoverDelay = g_iGMT
				Tactic.SetSubState( self, self.HoldState, "Holding" )
				return
			end
		end
		
		-- Check if we should try to take cover
		if (self.m_bTakeCover and iDistance < sqr(35) and self.squad_ai:WasRecentlyHurt()) and vPosThreat<iAlliedStrength then
		
			-- Try to take cover
			if (self:TryTakeCover(self.squad_ai:GetPosition(), 35)) and not self.squad_ai:IsInCombat() and not self.squad_ai:IsUnderAttack() then
				self.m_iMoveDelay = g_iGMT
				self.m_iCoverDelay = g_iGMT
				Tactic.SetSubState( self, self.HoldState, "Holding" )
				return
			end
		end
	end
	
	-- Check distance
	if (iDistance > sqr(25) and 
        self.squad_ai:GetHealthPercentage() > 0.5 and self.squad_ai:GetNumTroopers() > self.squad_ai:GetMaxTroopers() / 3 and self.squad_ai:GetNumTroopers() > 1) then
	
		-- Check for a close transporter
		local oTransporterTactic = cpu_manager:GetTransporterInRange(vSquadPos, self.m_iTransportable)
		if (oTransporterTactic ~= nil) then
		
			-- Try to enter transporter
			oTransporterTactic:LoadSquad(self.squad_ai, self:GetUnitStrength(), self:GetTarget())
			self.m_iMoveDelay = g_iGMT
			Tactic.SetSubState( self, self.HoldState, "Holding" )
			return
		end
		cpu_manager:DoMove(self.squad_ai, self:GetTarget(), false, "RetreatState Infantry")
	
	elseif (iDistance > sqr(40) or not self:IsDefender()) then
	
		-- If we are broken, or too far away from the retreat position, then make a basic move
		cpu_manager:DoMove(self.squad_ai, self:GetTarget(), false, "RetreatState Infantry")
	
	elseif (iDistance > sqr(25) or self.squad_ai:WasRecentlyHurt()) then
	
		-- If we are in range of the retreat position, then make an attack move
		cpu_manager:DoMove(self.squad_ai, self:GetTarget(), true, "RetreatState Infantry")
	else
		self.squad_ai:DoStop()
	end
	self.m_iMoveDelay = g_iGMT

	-- Set holding sub-state
	Tactic.SetSubState(self, self.HoldState, "Holding")
end

function InfantryTactic:BeginAttackState()
	local vSquadPos = self.m_vCurrentPosition

	if (self:IsCapturePlanMove()) then
		return
	end

	if (self:IsCaptureGuardMove()) then
		if (self.squad_ai:IsCapturing()) then
			return
		end
		local vSquadPos = self.m_vCurrentPosition
		local iDistance = distance_sqr(self:GetTarget(), vSquadPos)
		if (iDistance > sqr(20) and g_iGMT >= self.m_iMoveDelay + 6) then
			cpu_manager:DoMove(self.squad_ai, self:GetTarget(), self:IsCaptureGuardAttack(), "CaptureGuardAttack")
			self.m_iMoveDelay = g_iGMT
		end
		Tactic.SetSubState(self, self.HoldState, "Holding")
		return
	end

	-- Check if we're desperatly capturing
	if (self:UrgentCapturing()) then
		return
	end
	
	-- Check if our capturing was interrupted
	if (self.squad_ai:IsCapturing()) then
		
		local iMaxCapturingSquadCost = cpu_manager:GetArmyStrength() / 5
	

		if (not self:IsCapturePlanMove() and (self.squad_ai:WasRecentlyHurt() or self:GetUnitStrength() > iMaxCapturingSquadCost)) then
			cpu_manager:DoMove(self.squad_ai, self.squad_ai:GetPosition(), true, "Interrupt capturing!")
		end
		return
	end
	
	-- Check if we're busy
	if (self:IsInSubState() or (self:IsAffectedByMorale() and self.squad_ai:IsBroken())) then
		return
	end

	-- Check if we're doing a gather move at the moment
	if (self:CheckGatherMove()) then
		return
	end

	-- Try to jump into attack target / assist if sitting out
	if (self:JumpAttack() or self:TryJumpAssistFight()) then
		self.m_iMoveDelay = 0
		return
	end
	
	-- Try to disown flags
	if (self:TryDisownFlags()) then
		self.m_iMoveDelay = g_iGMT
		Tactic.SetSubState( self, self.AttackingState, "Attacking" )
		return
	end
	
	-- Check move delay
	if (g_iGMT < self.m_iMoveDelay + 5 and self:IsMoving()) then
		Tactic.SetSubState( self, self.AttackingState, "Attacking" )
		return
	end
	
	-- Check for deepstrike buildings
	if (self:EnterDeepStrikeBuilding()) then
		self.m_iMoveDelay = g_iGMT
		Tactic.SetSubState( self, self.AttackingState, "Attacking" )
		return
	end
	
	-- Check for cover and bunkers
	
	local iDistance = distance_sqr(self:GetTarget(), vSquadPos)
	if (self.squad_ai:IsRanged() and g_iGMT > self.m_iCoverDelay) then
               local vPosThreat, iAlliedStrength = cpu_manager:GetArmyStrengthAtPos(vSquadPos, 30, true)			
		-- Check if squad is able to occupy bunkers
		if (self.m_bBunkerSquad) then
			
			-- Try to occupy a close bunker	
			if (cpu_manager:OccupyBunker(self.squad_ai, 20)) then
				self.m_iMoveDelay = g_iGMT
				self.m_iCoverDelay = g_iGMT
				Tactic.SetSubState( self, self.AttackingState, "Attacking" )
				return
			end
		end
		
		-- Check if we should try to take cover
		if (self.m_bTakeCover and not self.squad_ai:HasSetupTime() and self.squad_ai:WasRecentlyHurt()) and vPosThreat<iAlliedStrength then
		
			-- Try to take cover
			if (self:TryTakeCover(self.squad_ai:GetPosition(), 35)) then
				self.m_iMoveDelay = g_iGMT
				self.m_iCoverDelay = g_iGMT
				Tactic.SetSubState( self, self.AttackingState, "Attacking" )
				return
			end
		end
	end

	if (self.squad_ai:IsRanged() and self:TryCombatDisengage()) then
		self.m_iMoveDelay = g_iGMT
		Tactic.SetSubState(self, self.AttackingState, "Attacking")
		return
	end

	if (self.squad_ai:IsRanged() and self:MaintainInfantryRangedRange()) then
		Tactic.SetSubState(self, self.AttackingState, "Attacking")
		return
	end

	local iCloseDist = 25
	local iFarDist = 60
	if (self.squad_ai:IsRanged()) then
		iCloseDist = math.floor(self:GetRangedCombatRange() * 0.85)
		iFarDist = self:GetRangedCombatRange() + 15
	end

		-- Check distance
		if (iDistance > sqr(iCloseDist) and not self.squad_ai:IsInCombat() and 
            self.squad_ai:GetHealthPercentage() > 0.5 and self.squad_ai:GetNumTroopers() > self.squad_ai:GetMaxTroopers() / 3) and self.squad_ai:GetNumTroopers() > 1 then
		
			-- Check for a close transporter
			local oTransporterTactic = cpu_manager:GetTransporterInRange(vSquadPos, self.m_iTransportable)
			if (oTransporterTactic ~= nil) then
			
				-- Try to enter transporter
				oTransporterTactic:LoadSquad(self.squad_ai, self:GetUnitStrength(), self:GetTarget())
				self.m_iMoveDelay = g_iGMT
				Tactic.SetSubState(self, self.HoldState, "Attacking")
				return
			end
			cpu_manager:DoMove(self.squad_ai, self:GetTarget(), true, "AttackState")
		end
	
	-- Only make an attack move if not in combat
	if (not self.squad_ai:IsAttacking() and not self.squad_ai:IsInStateAttackMove()) then
	
		-- Check distance
		if (iDistance > sqr(iCloseDist) and not self.squad_ai:IsInCombat() and not self.squad_ai:WasRecentlyHurt() and
			self.squad_ai:GetHealthPercentage() > 0.6 and self.squad_ai:GetNumTroopers() > self.squad_ai:GetMaxTroopers() / 2) and self.squad_ai:GetNumTroopers() > 1 then
		
			-- Check for a close transporter
			local oTransporterTactic = cpu_manager:GetTransporterInRange(vSquadPos, self.m_iTransportable)
			if (oTransporterTactic ~= nil) then
			
				-- Try to enter transporter
				oTransporterTactic:LoadSquad(self.squad_ai, self:GetUnitStrength(), self:GetTarget())
				self.m_iMoveDelay = g_iGMT
				Tactic.SetSubState(self, self.HoldState, "Attacking")
				return
			end
			cpu_manager:DoMove(self.squad_ai, self:GetTarget(), true, "AttackState")
		
		elseif (iDistance > sqr(iFarDist)) then
		
			-- If we are too far away from the target, then make a simple attack move
			cpu_manager:DoMove(self.squad_ai, self:GetTarget(), true, "AttackState")
		else

			-- Check targets for melee squads
			if (not self.squad_ai:IsRanged()) then
			
				-- Get closest enemy unit
				local oUnit = self:GetClosestUnitForMelee(50)
				if (oUnit ~= nil and ((not oUnit:IsInfiltrating() or oUnit:IsAttacking()) or oUnit:IsEngineer())) then --self.squad_ai:IsDetector()
					cpu_manager:DoMove(self.squad_ai, oUnit:GetPosition(), true, "AttackState")
					self.m_iMoveDelay = g_iGMT + 3
				else
				
					-- Get closest enemy building
					local oBuilding = self:GetClosestBuildingForMelee(50)
					if (oBuilding ~= nil) then
					
						-- Don't move too close to building
						if (distance_sqr(oBuilding:GetPosition(), vSquadPos) > sqr(15)) then
							cpu_manager:DoMove(self.squad_ai, oBuilding:GetPosition(), true, "AttackState")
							self.m_iMoveDelay = g_iGMT + 3
						end
						
					elseif (iDistance > sqr(25) or self.squad_ai:WasRecentlyHurt()) then
					
						-- Move to target if we're hurt or not close enough
						cpu_manager:DoMove(self.squad_ai, self:GetTarget(), true, "AttackState")
						self.m_iMoveDelay = g_iGMT
					else
						self.squad_ai:DoStop()
						self.m_iMoveDelay = g_iGMT
					end
				end
			else
				
				-- If we are close to the target area, then hold fire at weapon range
				if (self:MaintainInfantryRangedRange()) then
					Tactic.SetSubState(self, self.HoldState, "Attacking")
					return
				end
				if (iDistance < sqr(iCloseDist) and not self.squad_ai:WasRecentlyHurt() and
					not cpu_manager.terrain_analyzer:HasThreat(self:GetTarget(), 35)) then
					self.squad_ai:DoStop()
					self.m_iMoveDelay = g_iGMT
					Tactic.SetSubState(self, self.HoldState, "Attacking")
					return
				end
				if (iDistance > sqr(iFarDist)) then
					cpu_manager:DoMove(self.squad_ai, self:GetTarget(), true, "AttackState")
					self.m_iMoveDelay = g_iGMT
				end
			end
		end
	end

	-- Set attacking sub-state
	Tactic.SetSubState( self, self.AttackingState, "Attacking" )
end

function InfantryTactic:AttackingState()
	
	-- Try to jump into attack target / assist if sitting out
	if (not self.squad_ai:IsCapturing() and (self:JumpAttack() or self:TryJumpAssistFight())) then
		self.m_iMoveDelay = 0
		return
	end
	
	-- Try to disown flags
	if (self:TryDisownFlags()) then
		self.m_iMoveDelay = g_iGMT
		return
	end

	if (self:TryEnterNearbyBunker()) then
		return
	end

	-- If idle or was hurt, restart — not while already engaged (avoids DoMove spam)
	if (not self:IsInEmergencySubState() and not self:NeedsRangedDisengage()) then
		if (self.squad_ai:IsAttacking() or self.squad_ai:IsInCombat()) then
			return
		end
		if (self.squad_ai:IsIdle() or not self:IsMoving() or (self.squad_ai:WasRecentlyHurt() and not self.squad_ai:IsRanged())) then
			Tactic.SetState( self, self:GetState() )
		end
	end
end

function InfantryTactic:Upgrade()

	-- Check if we are reinforcing
	if (self.squad_ai:IsReinforcing() or not self.squad_ai:HasUpgradableTrooper()) then
		return
	end

	-- If I am broken, don't upgrade!
	if (self:IsAffectedByMorale() and self.squad_ai:IsBroken()) then
		return
	end	
	
	-- Only upgrade in healthy state
	if (self.squad_ai:GetNumTroopers() < self.squad_ai:GetMaxTroopers() * 0.4 or self.squad_ai:GetHealthPercentage() < 0.5) then
		return
	end
	
	-- Set upgrade direction
	local eUpgradeType = UnitStatsAI.UC_VehicleMed
	if (math.random(1, 2) == 2) then

		-- Figure out my enemy's favourite class
		local oEnemy = cpu_manager:FindClosestEnemyPlayer()
		if (oEnemy ~= nil) then
			eUpgradeType = oEnemy:GetMajorityClassType()
		end
	end

	-- Try to upgrade
	self.squad_ai:DoBestUpgrade(eUpgradeType)
end


function InfantryTactic:Reinforce()

	-- Check if we are reinforcing
	if (self.squad_ai:IsReinforcing()) then
		return
	end
	--[[
	-- If I am broken, don't upgrade!
	if (self:IsAffectedByMorale() and self.squad_ai:IsBroken()) then
		return
	end
	]]
	-- Don't reinforce squads in critical condition
	if (self.squad_ai:GetNumTroopers() <= self.squad_ai:GetMaxTroopers() / 4 and self.squad_ai:IsUnderAttack()) then
		return
	end

	-- Always try to get the leader first
	if (self.squad_ai:CanReinforce(true, 0)) then
		self.squad_ai:DoReinforce(true, 0)
		return
	end

	-- Don't reinforce if we have no free resources
	local iRequisition = resource_manager:GetResourceAmount():Get(ResourceAmount.RT_Requisition)
	local iPower = resource_manager:GetResourceAmount():Get( ResourceAmount.RT_Power ) 
	if (self.bWaitForThreat or ((iRequisition < 400 or self.m_bPowerCost and iPower<100) and not Tactic.Options.can_reinforce)) then
		return
	end

	if iRequisition < 150 or self.m_bPowerCost and iPower<100 then
           return
        end

	-- Always try to reinforce, as long as I have money
	if (self.squad_ai:CanReinforce( false, 0 )) then
		self.squad_ai:DoReinforce( false, 0 )
	end
end

function InfantryTactic:BrokenMorale()

	if (cpu_manager.m_bOverwhelmActive) then
		self.stateID = Tactic.StateID.NoState
		self.m_eSubStateID = Tactic.StateID.NoState
		Tactic.SetState(self, self:GetState())
		return
	end

	local vPos = self.squad_ai:GetPosition()

	if (not self.squad_ai:IsBroken()) then
		if (self.squad_ai:GetMoralePercentage() > 0.7) then
			self.m_eSubStateID = Tactic.StateID.NoState
			self.stateID = Tactic.StateID.NoState
			self.last_time = nil
			Tactic.SetState(self, self:GetState())
		end
		return
	end

	self.safe_point = self:GetHomeRetreatPos()
	local bUnderFire = (self.squad_ai:IsUnderAttack() or self.squad_ai:WasRecentlyHurt() or
		cpu_manager.terrain_analyzer:HasThreat(vPos, 40) or
		cpu_manager.cpu_player:FindFirstEnemy(vPos, 40, 1) ~= nil)

	if (bUnderFire) then
		if (not self:MoveToDisengage()) then
			local vDeep = cpu_manager.start_pos
			if (distance_sqr(vPos, vDeep) > sqr(20)) then
				cpu_manager:DoMove(self.squad_ai, vDeep, false, "BrokenMorale HQ")
			else
				self.squad_ai:DoMoveToClosestSafePoint(self.safe_point, self.tolerance)
			end
		end
	elseif (distance_sqr(vPos, self.safe_point) > sqr(25)) then
		cpu_manager:DoMove(self.squad_ai, self.safe_point, false, "BrokenMorale home")
	else
		self.squad_ai:DoStop()
	end

	if (self.last_time ~= nil and self.squad_ai:WasAttackedSince(self.last_time)) then
		self.tolerance = self.tolerance + 10
	end
	self.last_time = g_iGMT
	self.m_eSubStateID = self.stateID
end

function InfantryTactic:AvoidDeath()

	if (cpu_manager.m_bOverwhelmActive and not self.squad_ai:IsEngineer()) then
		if (self.stateID == Tactic.StateID.AvoidDeath) then
			self.m_eSubStateID = Tactic.StateID.NoState
			self.stateID = Tactic.StateID.NoState
			Tactic.SetState(self, self:GetState())
		end
		return
	end

	if (self.stateID == Tactic.StateID.AvoidDeath and not self:CheckForDeath(true)) then 
	  	  
		self.m_eSubStateID = Tactic.StateID.NoState
		self.stateID = Tactic.StateID.NoState
		
		-- Go back in the fray - reset my state
		Tactic.SetState( self, self:GetState() )
		self.state_function( self )
	end
end

function InfantryTactic:DoDance()

	if (self.stateID == Tactic.StateID.DoDance and not self:CheckForDance()) then
	  	  
		-- Go back in the fray - reset my state
		if (self.m_eSubStateID == self.stateID) then
			self.m_eSubStateID = Tactic.StateID.NoState
		end
		self.stateID = Tactic.StateID.NoState
		Tactic.SetState( self, self:GetState() )
		self.state_function( self )
	end
end

function InfantryTactic:DoAbilities()

	-- Check if we can possess
	if (self.squad_ai:CanPossess()) then
	
		-- Check if we are in combat
		if (self.squad_ai:IsInCombat() or cpu_manager.terrain_analyzer:HasThreat(self.squad_ai:GetPosition(), 35)) then
			self.squad_ai:DoPossess()
		end
	end
		  
	if (self.squad_ai:IsInCombat()) then
	
		-- Do the targetted abilities
		for i in InfantryTactic.TargetAbilities do
		
			local ability_id = InfantryTactic.TargetAbilities[i][1]
			local filter = InfantryTactic.TargetAbilities[i][3]
			local count =  InfantryTactic.TargetAbilities[i][4]	
			
			-- Fix multiple attack bug by forcing 1 secs minimum delay
			local now = g_iGMT
			if (now > InfantryTactic.TargetAbilities[i][5] + 1 and
				Ability.DoAbilityTarget( self.squad_ai, ability_id, filter, count )) then
				InfantryTactic.TargetAbilities[i][5] = g_iGMT
			end
		end
	end
end

-- Melee stay-in-fight: cached, uses army strength tables (no full squad scan per gate).
function InfantryTactic:ShouldStayInFight()
	if (self.squad_ai == nil or not self.squad_ai:IsValid()) then
		return false
	end
	if (self.squad_ai:IsRanged() or self.squad_ai:IsEngineer()) then
		return false
	end
	-- Commanders must still peel to attach / AvoidDeath
	if (self:IsCommander()) then
		return false
	end
	if (cpu_manager.m_bOverwhelmActive) then
		return true
	end
	if (not (self.squad_ai:IsInCombat() or self.squad_ai:IsUnderAttack() or self.squad_ai:WasRecentlyHurt())) then
		return false
	end

	-- Cache ~1s — many gates/tick; strength cell-cache already smooths jumps
	if (self.m_iStayInFightCacheTime ~= nil and g_iGMT < self.m_iStayInFightCacheTime) then
		return self.m_bStayInFightCached
	end

	local vPos = self.m_vCurrentPosition
	if (vPos == nil) then
		vPos = self.squad_ai:GetPosition()
	end
	local iEnemyStr, iAlliedStr = cpu_manager:GetArmyStrengthAtPos(vPos, 40, true)
	local bStay = (iEnemyStr > 0 and iAlliedStr >= iEnemyStr)

	self.m_bStayInFightCached = bStay
	self.m_iStayInFightCacheTime = g_iGMT + 1.0
	return bStay
end

-- Idle jump/teleport melee: join a fight within jump range instead of AFK at base.
function InfantryTactic:TryJumpAssistFight()
	if (self.squad_ai:IsRanged() or not self.squad_ai:CanJump()) then
		return false
	end
	if (self:IsCommander()) then
		return false
	end
	if (self.squad_ai:IsCapturing() or self.squad_ai:IsEngineer()) then
		return false
	end
	if (self:IsInEmergencySubState() or self:IsInSubState()) then
		return false
	end
	if (self:IsCapturePlanMove() or self:IsCaptureGuardMove()) then
		return false
	end
	if (g_iGMT < self.last_jump + 15) then
		return false
	end
	if (self.squad_ai:IsInCombat() or self.squad_ai:IsUnderAttack()) then
		return false
	end
	if (self.m_iCommanderAttachTargetId ~= nil) then
		return false
	end

	local vMyPos = self.squad_ai:GetPosition()
	if (self.squad_ai:IsLocked()) then
		local vPlanTarget = self:GetTarget()
		if (vPlanTarget ~= nil and distance_sqr(vMyPos, vPlanTarget) > sqr(50)) then
			return false
		end
	end

	local iJumpDist = self.squad_ai:GetJumpDistance()
	if (iJumpDist == nil or iJumpDist < 30) then
		return false
	end

	-- Throttle after cheap early-outs (don't burn slot when already in combat)
	if (g_iGMT < self.m_iLastJumpAssistCheck + 2.5) then
		return false
	end
	-- Stagger jumpers across ticks when many units (same quality, spread CPU)
	local iSid = self.squad_ai:GetID()
	if (iSid ~= nil and math.mod(iSid + math.floor(g_iGMT), 2) ~= 0) then
		return false
	end
	self.m_iLastJumpAssistCheck = g_iGMT

	local iMyStrength = self:GetUnitStrength()
	local iMinRangeSqr = sqr(40)
	local iMaxRangeSqr = sqr(iJumpDist)
	local oVictim = nil
	local iBest = 0
	local iChecked = 0
	local aJumpTargets = cpu_manager:GetJumpTargets()
	for iLoop1 in aJumpTargets do
		local vPos = aJumpTargets[iLoop1][2]
		local iDist = distance_sqr(vMyPos, vPos)
		if (iDist > iMinRangeSqr and iDist < iMaxRangeSqr) then
			iChecked = iChecked + 1
			if (iChecked > 4) then
				break
			end
			local iEnemyPower, iAllyPower = cpu_manager:GetArmyStrengthAtPos(vPos, 35, true)
			local iStr = aJumpTargets[iLoop1][3]
			if (iAllyPower > 0 and iEnemyPower > 0 and iEnemyPower <= (iAllyPower + iMyStrength) and iStr > iBest) then
				iBest = iStr
				oVictim = aJumpTargets[iLoop1][1]
			end
		end
	end

	if (oVictim ~= nil) then
		local vEnemyPos = oVictim:GetPosition()
		if (self.squad_ai:CanJumpToPosition(vEnemyPos)) then
			self.squad_ai:DoJump(vEnemyPos)
			self.target = Vector3f(vEnemyPos)
			self.last_jump = g_iGMT
			self.m_iLastGatherMove = self.last_jump - 10
			return true
		end
	end

	-- Fallback: one threat blob (not all)
	local iThreatChecked = 0
	for iLoop1 in cpu_manager.m_aThreatPositions do
		local vPos = cpu_manager.m_aThreatPositions[iLoop1]
		local iDist = distance_sqr(vMyPos, vPos)
		if (iDist > iMinRangeSqr and iDist < iMaxRangeSqr) then
			iThreatChecked = iThreatChecked + 1
			if (iThreatChecked > 3) then
				break
			end
			local iEnemyPower, iAllyPower = cpu_manager:GetArmyStrengthAtPos(vPos, 35, true)
			if (iAllyPower > 0 and iEnemyPower > 0 and iEnemyPower <= (iAllyPower + iMyStrength)) then
				if (self.squad_ai:CanJumpToPosition(vPos)) then
					self.squad_ai:DoJump(vPos)
					self.target = Vector3f(vPos)
					self.last_jump = g_iGMT
					self.m_iLastGatherMove = self.last_jump - 10
					return true
				end
			end
		end
	end
	return false
end

function InfantryTactic:MoveToDisengage(bDanceflag)

	if (cpu_manager.m_bOverwhelmActive and not self.squad_ai:IsEngineer()) then
		return false
	end
	if (bDanceflag ~= true and self:ShouldStayInFight()) then
		return false
	end
	
	-- Check if squad is able to occupy bunkers
	if (self.m_bBunkerSquad) then
		
		-- Try to occupy a close bunker	
		if (cpu_manager:OccupyBunker(self.squad_ai, 20)) then
			self.m_iMoveDelay = g_iGMT
			self.m_iCoverDelay = g_iGMT
			return true
		end
	end
	local iRangeTemp = 60
	if (bDanceflag == nil) then
		bDanceflag = false
		iRangeTemp = 20
	end

	-- Check for a close transporter
	local vSquadPos = self.m_vCurrentPosition
	local oTransporterTactic = cpu_manager:GetTransporterInRange(vSquadPos, self.m_iTransportable, iRangeTemp)
	if (oTransporterTactic ~= nil) and self.squad_ai:IsUnderAttack() then
		oTransporterTactic:LoadSquadDisengage(self.squad_ai, self:GetUnitStrength(), bDanceflag)
		self.m_iMoveDelay = g_iGMT - 4
		return true
	end

	self.m_bDanceDisengage = (bDanceflag == true)
	local bResult = Tactic.MoveToDisengage(self)
	self.m_bDanceDisengage = false
	return bResult
end

--avoid being beaten by close combat troops
function InfantryTactic:CheckForDance()
  
	if (cpu_manager.m_bOverwhelmActive and not self.squad_ai:IsEngineer()) then
		return false
	end
	if (self:ShouldStayInFight()) then
		return false
	end

	local bRanged = self.squad_ai:IsRanged()
	local bEnemyCommander = false

	-- Squads stationary and in combat can try to dance
	local bCheckDance = (self.squad_ai:IsUnderAttack() and not self.squad_ai:IsBroken() 
				and not self.squad_ai:IsInStateMove())
        
	-- Don't dance if we are in state of disengage
	if (self.stateID ~= Tactic.StateID.DoDance and not bCheckDance) then
		self.m_iDancing = 0
		return false
	end

	-- Don't dance if we are melee and have commander attached
	if (not bRanged and self:CommanderAttached()) then
		self.m_iDancing = 0
		return false
	end

	-- Get squad position
	local vSquadPos = self.m_vCurrentPosition

	-- Set scan range
	local iScanRange = 15     
	if (self:IsCommander() or not bRanged) then
		iScanRange = 20
	elseif (self.squad_ai:CanJump()) then
		iScanRange = 5
	end

	-- Check for a close unit
	local oEnemyUnit = cpu_manager.cpu_player:FindFirstEnemy(vSquadPos, iScanRange, 1)
	if (oEnemyUnit == nil) then
		self.m_iDancing = 0
		return false
	end
	
	-- Don't dance if enemy is ranged or there's a special case
	if (oEnemyUnit:IsRanged() or not self:CheckDance(oEnemyUnit)) then
		self.m_iDancing = 0
		return false
	end
	
	-- Get enemy unit stats
	local oStats = oEnemyUnit:GetStats()
	if (oStats == nil) then
		self.m_iDancing = 0
		return false
	end
	
	-- Check enemy unit type
	local eClass = oStats:GetClass()
	if (eClass == UnitStatsAI.UC_VehicleLow or eClass == UnitStatsAI.UC_VehicleMed or
		eClass == UnitStatsAI.UC_VehicleHigh or eClass == UnitStatsAI.UC_Commander) then
		
		-- Don't dance vehicles and commanders which are almost dead
		if (oEnemyUnit:GetHealthPercentage() < 0.2) then
			self.m_iDancing = 0
			return false
		elseif (eClass == UnitStatsAI.UC_Commander) then
			bEnemyCommander = true
		end
	else
		
		-- Don't dance infantry if we are a commander health>30% or more than 3 times stronger
		if ((self:IsCommander() and self.squad_ai:GetHealthPercentage() > 0.3) or self:GetUnitStrength() > 3 * cpu_manager:GetUnitStrength(oEnemyUnit)) then
			self.m_iDancing = 0
			return false
		end
	end

	-- Don't dance if we are melee and are not fighting a commander or after 5 minutes
	if (not bRanged and (not bEnemyCommander or g_iGMT > 5 * 60)) and self.squad_ai:GetHealthPercentage() > 0.4 then
		self.m_iDancing = 0
		return false
	end
	
	-- In standard dancing mode, there's a 50% chance that dancing fails
	if (self.m_iDancing == 0 and CpuManager.AISettings.iDancing == 1 and math.random(1, 2) == 2) then
		self.m_iDancing = g_iGMT
		return false
	end

	-- Move to a safe destination
	if (not self:MoveToDisengage(true)) then
		self.squad_ai:DoMoveToClosestSafePoint(self.safe_point, self.tolerance_default)
	end
	
	-- Set state
	local state_func, state_name = self:GetSubState()
	if (state_func ~= self.DoDance) then
		Tactic.SetSubState( self, self.DoDance, "DoDance" )
		self.squad_ai:DoSetStance( SquadAI.STANCE_StandGround )
		self.stateID = Tactic.StateID.DoDance
	end

	-- Set dancing state
	self.m_eSubStateID = self.stateID
	return true
end

function InfantryTactic:CheckDance(oSquad)
	return true
end

-- Avoid being killed in firefight against superior enemy
function InfantryTactic:CheckForDeath(bCheck)

	if (cpu_manager.m_bOverwhelmActive) then
		return false
	end
	-- Winning melee fight: allow dying rather than jump-flee / peel
	if (self:ShouldStayInFight()) then
		return false
	end

	local fHealth = self.squad_ai:GetHealthPercentage()
	local vSquadPos = self.m_vCurrentPosition
    local iMaxRange = cpu_manager:GetMaxRange(self.squad_ai:GetSquadName())
    local vPosThreat, iAlliedStrength = cpu_manager:GetArmyStrengthAtPos(vSquadPos, iMaxRange + 35 , true)

	-- Commanders / ranged only — jump melee used to Always AvoidDeath then jump out after leaping in
	local bValidSquad = (self:IsCommander() or self.squad_ai:IsRanged())
	local bCheckAvoidDeath = (bValidSquad and self.squad_ai:IsUnderAttack() and not self.squad_ai:IsCapturing() and
				not self.squad_ai:IsBroken() and distance_sqr(vSquadPos, cpu_manager.start_pos) > sqr(50))
	
	-- Check if we are already retreating
	if (self.stateID == Tactic.StateID.AvoidDeath) then
		-- Ranged units don't retreat too far
		if (self.squad_ai:IsRanged()) then
			local oEnemyUnit = cpu_manager.cpu_player:FindFirstEnemy(vSquadPos, iMaxRange+5, 1)
			if (oEnemyUnit == nil) then
				self.m_iDancing = 0
				return false
			end
		end
	elseif (not bCheckAvoidDeath) and (vPosThreat<iAlliedStrength*2) or vPosThreat==0 then
		self.m_iDancing = 0
		return false
	end

	-- Set health threshold for active builders, commanders and rest
	local fHealthThresh = 0.0
	local bIsBuilding = (self.squad_ai:IsEngineer() and self.squad_ai:IsBuilding() ~= 0)
	if (bIsBuilding) then
		fHealthThresh = 0.2
	elseif (self:IsCommander() or self.squad_ai:GetMaxTroopers() == 1) then
        if iAlliedStrength==0 then
           iAlliedStrength=1
        end
		if (bCheck) then
			fHealthThresh = 0.4*(vPosThreat/iAlliedStrength)
		else
			fHealthThresh = 0.3*(vPosThreat/iAlliedStrength)
		end
	else 
		local iSquadSize = self.squad_ai:GetNumTroopers()
		local iSquadMax = self.squad_ai:GetMaxTroopers()
		fHealthThresh = math.max(0.4*(vPosThreat/iAlliedStrength)*(iSquadSize/ iSquadMax + 0.1),(1.0 - (iSquadSize / iSquadMax))*(vPosThreat/iAlliedStrength))
		--(1.0 - (iSquadSize/ iSquadMax))*(vPosThreat/iAlliedStrength)
		
	end

	-- Check health threshold
	if (fHealth > fHealthThresh) then
		self.m_iDancing = 0
		return false
	end
	      
	-- Move to a safe destination
	if (not self:MoveToDisengage()) then
		self.squad_ai:DoMoveToClosestSafePoint(self.safe_point, self.tolerance_default)
	end
		
	-- Set state
	local state_func, state_name = self:GetSubState()
	if (state_func ~= self.AvoidDeath) then
		Tactic.SetSubState(self, self.AvoidDeath, "AvoidDeath")
		self.squad_ai:DoSetStance(SquadAI.STANCE_StandGround)
		self.stateID = Tactic.StateID.AvoidDeath
	end
	
	-- Set avoid death state
	self.m_eSubStateID = self.stateID
	
	aitrace("	Retreat "..tostring(bCheck).." "..tostring(fHealthThresh).." "..tostring(fHealth))
	return true
end

function InfantryTactic:CheckForBroken()
   
	-- Check if we are broken
	if (not self.squad_ai:IsBroken() or self:UrgentCapturing()) then
		return
	end
   
	-- If my morale is broken and I'm not already running away, run away
	local state_func, state_name = self:GetSubState()
	if (state_func ~= self.BrokenMorale and self:IsAffectedByMorale()) then
		 
		 self.safe_point = self:GetHomeRetreatPos()
		 if not self:MoveToDisengage() then
			self.tolerance = self.tolerance_default
			cpu_manager:DoMove(self.squad_ai, self.safe_point, false, "Broken retreat")
		 end
		 
		 Tactic.SetSubState( self, self.BrokenMorale, "Broken Morale" )
		 
		 self.stateID = Tactic.StateID.IsBroken
		 self.m_eSubStateID = self.stateID
	end
end

function InfantryTactic:SyncSubState()

	-- Check if we are in substate
	local bInSubstate = self:IsInSubState()
	if (self.stateID == Tactic.StateID.NoState and not bInSubstate) then
		return
	end

	-- Since other function may override the substate we have to sync state flags
	local state_func, state_name = self:GetSubState() 
	if (self.stateID == Tactic.StateID.IsBroken and state_func ~= self.BrokenMorale) or
	   (self.stateID == Tactic.StateID.DoDance and state_func ~= self.DoDance) or
	   (self.stateID == Tactic.StateID.AvoidDeath and state_func ~= self.AvoidDeath) or
	   (self.stateID == Tactic.StateID.AvoidStealth and state_func ~= self.AvoidStealthTroops) then
		   
		self.stateID = Tactic.StateID.NoState
		self.m_eSubStateID = Tactic.StateID.NoState
	end
	
	-- Sync InSubState with state flag
	if (bInSubstate and self.stateID == Tactic.StateID.NoState) or
	   (not bInSubstate and self.stateID ~= Tactic.StateID.NoState) then
	
		if (bInSubstate) then
			self.m_eSubStateID = Tactic.StateID.NoState
		else
			self.stateID = Tactic.StateID.NoState
		end
	end
end

function InfantryTactic:Update()

	if (cpu_manager.m_bOverwhelmActive and not self.squad_ai:IsEngineer()) then
		if (self.stateID == Tactic.StateID.IsBroken or self.stateID == Tactic.StateID.AvoidDeath) then
			self.stateID = Tactic.StateID.NoState
			self.m_eSubStateID = Tactic.StateID.NoState
		end
		local state_func = self:GetSubState()
		if (state_func == self.BrokenMorale or state_func == self.AvoidDeath) then
			Tactic.SetState(self, self:GetState())
			self.stateID = Tactic.StateID.NoState
			self.m_eSubStateID = Tactic.StateID.NoState
		end
	end

	if (self:IsAffectedByMorale() and self.squad_ai:IsBroken() and not self:UrgentCapturing()) then
		if (self.squad_ai:CanJump()) then
			self.tolerance_default = self.squad_ai:GetJumpDistance()
		else
			self.tolerance_default = 100
		end

		local state_func = self:GetSubState()
		if (state_func ~= self.BrokenMorale) then
			self.safe_point = self:GetHomeRetreatPos()
			Tactic.SetSubState(self, self.BrokenMorale, "Broken Morale")
			self.stateID = Tactic.StateID.IsBroken
			self.m_eSubStateID = self.stateID
		end

		if (not Tactic.Update(self)) then
			return false
		end
		self:Reinforce()
		return true
	end

	-- State machine
	if not Tactic.Update( self ) then
		return false
	end
	
	-- Set default tolerance
	if self.squad_ai:CanJump() then
		self.tolerance_default = self.squad_ai:GetJumpDistance()
	else
		self.tolerance_default = 100
	end

        self.time_life = self.time_life + 1


	-- Wait-for-threat: refresh ~1s (harass flag; not every infantry every tick)
	if (g_iGMT < DefendChokePointPlan.HarassingTime * 60) then
		if (g_iGMT >= self.m_iLastWaitThreatCheck + 1.0) then
			self.m_iLastWaitThreatCheck = g_iGMT
			local vSquadPos = self.m_vCurrentPosition
			local iRangeSqr = sqr(70)
			local bThreatNear = false
			for iLoop1 in cpu_manager.m_aEnemyUnits do
				if (distance_sqr(vSquadPos, cpu_manager.m_aEnemyUnits[iLoop1][1]) < iRangeSqr) then
					bThreatNear = true
					break
				end
			end
			if (not bThreatNear) then
				for iLoop1 in cpu_manager.m_aEnemyTurrets do
					if (distance_sqr(vSquadPos, cpu_manager.m_aEnemyTurrets[iLoop1][1]) < iRangeSqr) then
						bThreatNear = true
						break
					end
				end
			end
			self.bWaitForThreat = (not bThreatNear)
		end
	else
		self.bWaitForThreat = false
	end
	
	-- Update commander attach/detach health
	self.m_fCommanderAttachHealth = 0.5

	-- Upgrade weapons
	self:Upgrade()
	
	-- Reinforce squads
	self:Reinforce()
	
	self:SyncSubState()
	
	self:CheckForBroken()
	
	-- If not already in substate
	if (self.stateID == Tactic.StateID.NoState) then
	   
		local bAllowEmergencyChecks = (not cpu_manager.m_bOverwhelmActive or self.squad_ai:IsEngineer())
		-- Check dance mode
		if (bAllowEmergencyChecks and CpuManager.AISettings.iDancing == 2) then
		 	self:CheckForDeath(false)
			if (self.stateID == Tactic.StateID.NoState) then
				self:CheckForDance()
				if (self.stateID == Tactic.StateID.NoState) then
					self:CheckForStealthTroops()
				end
			end
		elseif (bAllowEmergencyChecks and CpuManager.AISettings.iDancing == 1 and g_iGMT > self.m_iDancing + 10) then
			self:CheckForDeath(false)
			if (self.stateID == Tactic.StateID.NoState) then
				self:CheckForDance()
				if (self.stateID == Tactic.StateID.NoState) then
					self:CheckForStealthTroops()
				end
			end
		end
	end
	
	if (cpu_manager.assassinate and self.stateID == Tactic.StateID.NoState and not cpu_manager.m_bOverwhelmActive) then
	
		for i in self.commander do
		
			if self.squad_ai:HasSquadAttached( self.commander[i][1] ) and self.commander[i][2] then
				
				--if I'm nearly dead, run away
				if self.squad_ai:GetAttachedHealthPercentage() < 0.7 then
				   self.squad_ai:DoMoveToClosestSafePoint( self.safe_point, self.tolerance )
				end
				return
			end
		end
	end
	
	if (self.squad_ai:IsAttached()) then
		self:CheckForDetach()
	end

	if (self:IsCapturePlanMove() and not self.squad_ai:IsLocked() and not self.squad_ai:IsCapturing()) then
		self:SetCapturePlanMove(false)
	end

	if (not self:IsCapturePlanMove() and not self:IsCaptureGuardMove()) then
		self:FocusEnemy()
	end

--        if not self:FocusEnemy() then
--	-- Special moves
--	self:CloseOnEnemy()
--	end

	-- Do abilities
	self:InitAbilities()
	self:DoAbilities()

	-- Check stance
	self:UpdateStance()
--[[       if self.squad_ai:IsIdle() and not self.squad_ai:IsCapturing() then
        self:HarrasingAttack()
       end]]
	-- Return success
	return true
end


function InfantryTactic:CheckForDetach()

	-- Set detach health
	local fDetachHealth = self.m_fCommanderAttachHealth + 0.4

	-- Detach healthy commanders
	if (self:CommanderAttached()) then
		
		-- Detach only from capturing or ranged squads
		if (self.squad_ai:IsCapturing()) then--or (self.squad_ai:GetAttachedHealthPercentage() > fDetachHealth and self.squad_ai:IsRanged())) then
			self.squad_ai:DoDetachSquad()
			--self.squad_ai:DoSetDefaultMeleeStance()
		end
	end
	
	-- Detach commander from broken/capturing
--[[	if --((self.squad_ai:IsBroken() or self.squad_ai:IsCapturing()) and
		--(self.squad_ai:IsInCombat() or self.squad_ai:WasRecentlyHurt())) then 
		
		self.squad_ai:DoDetachSquad()
		self.squad_ai:DoSetDefaultMeleeStance()
	end]]
end

--runs away when morale is broken  by default
function InfantryTactic:IsAffectedByMorale()
	if (cpu_manager.m_bOverwhelmActive) then
		return false
	end
	if (self:ShouldStayInFight()) then
		return false
	end
	return true
end

function InfantryTactic:ShouldRetreatToBase()
	if (self:ShouldStayInFight()) then
		return false
	end
	return Tactic.ShouldRetreatToBase(self)
end

function InfantryTactic:ShouldRetreatAllTheWayHome()
	if (self:ShouldStayInFight()) then
		return false
	end
	return Tactic.ShouldRetreatAllTheWayHome(self)
end

function InfantryTactic:IsCommander()
    return self.m_bCommander   
end

function InfantryTactic:CommanderAttached()

   if self.squad_ai:IsAttached() then

	   for i in self.commander do

	      if self.squad_ai:HasSquadAttached( self.commander[i][1] ) then
			   return true
		   end
	   end   
   end
   return false
end
