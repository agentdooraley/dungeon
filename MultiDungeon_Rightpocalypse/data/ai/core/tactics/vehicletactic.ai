				end
			end

		end
	end
]]
end

function VehicleTactic:BeginHoldState()

	-- Check if we're desperatly capturing
	if (self:UrgentCapturing()) then
		return
	end

	if (self:IsCaptureGuardMove() and not self:IsCaptureGuardAttack()) then
		if (self.squad_ai:IsCapturing()) then
			return
		end
		local vSquadPos = self.squad_ai:GetPosition()
		local iDistance = distance_sqr(self:GetTarget(), vSquadPos)
		if (iDistance > sqr(30) and g_iGMT >= self.m_iMoveDelay + 6) then
			cpu_manager:DoMove(self.squad_ai, self:GetTarget(), false, "CaptureGuardEscort")
			self.m_iMoveDelay = g_iGMT
		elseif (iDistance <= sqr(30)) then
			self.squad_ai:DoStop()
			self.m_iMoveDelay = g_iGMT
		end
		Tactic.SetSubState(self, self.HoldState, "Holding")
		return
	end
	
	-- Check if our capturing was interrupted
	if (self.squad_ai:IsCapturing()) then
		
		if (self.squad_ai:WasRecentlyHurt()) then
			cpu_manager:DoMove(self.squad_ai, self.squad_ai:GetPosition(), true, "Interrupt capturing!")
		end
		return
	end

	-- Check if we're busy
	if (self:IsInSubState()) then
		return
	end

	if (self.m_iArtilleryMinRange ~= nil and self.m_iArtilleryMinRange > 0) then
		if (self:MaintainArtilleryRange(self.m_iArtilleryMinRange)) then
			self.m_iMoveDelay = g_iGMT
			Tactic.SetSubState(self, self.HoldState, "Holding")
			return
		end
	end
	
	-- Check if we're doing a gather move at the moment
	if (self:CheckGatherMove()) then
		return
	end

	-- Try to jump
	if (self:JumpAttack()) then
		self.m_iMoveDelay = 0
		self.hurt_level = math.max(self.squad_ai:GetHealthPercentage() / 2, 0.3)
		return
	end
	
	-- Try to disown flags
	if (self:TryDisownFlags()) then
		self.m_iMoveDelay = g_iGMT
		Tactic.SetSubState( self, self.HoldState, "Holding" )
		return
	end
	
	-- Check move delay
	local vSquadPos = self.squad_ai:GetPosition()
        if (self.m_vTargetTransport.x~=0 or self.m_vTargetTransport.z~=0) and self.m_iUsedTransportSlots>0 and self.squad_ai:CanUnload() then
           self.squad_ai:DoMove(self.m_vTargetTransport)
           self:SetTarget(self.m_vTargetTransport, Tactic.Variant.Vector)
           self.m_iMoveDelay = self.m_iMoveDelay + 5
           self.m_vTargetTransport = Vector3f(0,0,0)
           return
        end
	local iDistance = distance_sqr(self:GetTarget(), vSquadPos)	
	if (g_iGMT < self.m_iMoveDelay + 5 and self:IsMoving() and (iDistance > sqr(30) or self.squad_ai:IsInStateAttackMove())) then
		Tactic.SetSubState( self, self.HoldState, "Holding" )
		return
	end
	
	-- Check for deepstrike buildings
	if (self:EnterDeepStrikeBuilding()) then
		self.m_iMoveDelay = g_iGMT
		Tactic.SetSubState( self, self.HoldState, "Holding" )
		return
	end
	-- Try to unload troops
        if self.m_fDisengage and self.m_iUsedTransportSlots>0 and self.squad_ai:CanUnload() then
           if not self:MoveToDisengage() then
              self.squad_ai:DoMoveToClosestSafePoint( self.safe_point, self.tolerance )
              self:SetTarget(self.safe_point,Tactic.Variant.Vector)
           end
        if distance_sqr(self:GetTarget(), vSquadPos) < sqr(25) then
           self.m_fDisengage=false
        else
           self.squad_ai:DoMove(self:GetTarget())
        end
           return
	elseif (self:UnloadTroops(iDistance)) then
		self.m_iMoveDelay = g_iGMT - 1
		Tactic.SetSubState(self, self.HoldState, "Holding")
		return
	end
		
	-- Check distance
	if (iDistance > sqr(60)) then
	
		-- If we get near the target area, then make an attack move if we're not in combat or attacking
		cpu_manager:DoMove(self.squad_ai, self:GetTarget(), true, "HoldState")

	elseif (not self.squad_ai:IsAttacking() and not self.squad_ai:IsInStateAttackMove()) then
	
		-- Check targets for melee squads
		if (not self.squad_ai:IsRanged()) then
			
			-- Get closest enemy unit
			local oUnit = self:GetClosestUnitForMelee(50)
			if (oUnit ~= nil and (not oUnit:IsInfiltrating() or oUnit:IsAttacking() or self.squad_ai:IsDetector())) then
				cpu_manager:DoMove(self.squad_ai, oUnit:GetPosition(), true, "HoldState")
				self.m_iMoveDelay = g_iGMT + 5
			else
			
				-- Get closest enemy building
				local oBuilding = self:GetClosestBuildingForMelee(50)
				if (oBuilding ~= nil) then
				
					-- Don't move too close to building
					if (distance_sqr(oBuilding:GetPosition(), vSquadPos) > sqr(15)) then
						cpu_manager:DoMove(self.squad_ai, oBuilding:GetPosition(), true, "HoldState")
						self.m_iMoveDelay = g_iGMT + 5
					end
					
				elseif (iDistance > sqr(25) or self.squad_ai:WasRecentlyHurt()) then
				
					-- Move to target if we're hurt or not close enough
					cpu_manager:DoMove(self.squad_ai, self:GetTarget(), true, "HoldState")
					self.m_iMoveDelay = g_iGMT
				else
					self.squad_ai:DoStop()
					self.m_iMoveDelay = g_iGMT
				end
			end
		else
		
			-- If we are close to the target area, then make an attack move
			if (iDistance < sqr(25) and not self.squad_ai:WasRecentlyHurt() and
				not cpu_manager.terrain_analyzer:HasThreat(self:GetTarget(), 35)) then
				self.squad_ai:DoStop()
				self.m_iMoveDelay = g_iGMT
				Tactic.SetSubState(self, self.HoldState, "Holding")
				return
			end
			cpu_manager:DoMove(self.squad_ai, self:GetTarget(), true, "HoldState")
			self.m_iMoveDelay = g_iGMT
		end
	end

	-- Set holding sub-state
	Tactic.SetSubState(self, self.HoldState, "Holding")
end

function VehicleTactic:HoldState()

	if (self:IsCaptureGuardMove()) then
		return
	end

	-- Try to jump
	if (not self.squad_ai:IsCapturing() and self:JumpAttack()) then
		self.m_iMoveDelay = 0
		self.hurt_level = math.max(self.squad_ai:GetHealthPercentage() / 2, 0.3)
		return
	end
	
	-- Try to disown flags
	if (self:TryDisownFlags()) then
		self.m_iMoveDelay = g_iGMT
		return
	end
	
	-- If idle, restart — not while shooting/in combat (re-Begin → DoMove stutter)
	if (self.squad_ai:IsAttacking() or self.squad_ai:IsInCombat()) then
		return
	end
	if (self.squad_ai:IsIdle() or not self:IsMoving() or self.squad_ai:WasRecentlyHurt()) then
		Tactic.SetState(self, self:GetState())
	end
end

function VehicleTactic:BeginRetreatState()

	if (self:IsOverwhelmSpamMode() and not self.squad_ai:IsLocked()) then
		return
	end

	-- Check if we're desperatly capturing
	if (self:UrgentCapturing()) then
		return
	end
	
	-- Check if our capturing was interrupted
	if (self.squad_ai:IsCapturing()) then
		
		if (self.squad_ai:WasRecentlyHurt()) then
			cpu_manager:DoMove(self.squad_ai, self.squad_ai:GetPosition(), true, "Interrupt capturing!")
		end
		return
	end

	-- Check if we're busy
	if (self:IsInSubState()) then
		return
	end
	
	-- Try to jump if under attack
	if (self.squad_ai:IsUnderAttack()) then
		
		-- Move to disengage
		if (self:MoveToDisengage()) then
			self.m_iMoveDelay = g_iGMT
			return
		end
	end
	
	-- Check move delay
	if (g_iGMT < self.m_iMoveDelay + 5 and (self:IsMoving() or self.m_bNeedRepair)) then
		Tactic.SetSubState( self, VehicleTactic.HoldState, "Holding" )
		return
	end
	
	-- Check for deepstrike buildings
	if (self:EnterDeepStrikeBuilding()) then
		self.m_iMoveDelay = g_iGMT
		Tactic.SetSubState( self, self.HoldState, "Holding" )
		return
	end
        if (self.m_vTargetTransport.x~=0 or self.m_vTargetTransport.z~=0) and self.m_iUsedTransportSlots>0 and self.squad_ai:CanUnload() then
           self.squad_ai:DoMove(self.m_vTargetTransport)
           self:SetTarget(self.m_vTargetTransport, Tactic.Variant.Vector)
           self.m_iMoveDelay = self.m_iMoveDelay + 5
           self.m_vTargetTransport = Vector3f(0,0,0)
           return
        end
	-- Try to unload troops
		local vSquadPos = self.squad_ai:GetPosition()
		local iDistance = distance_sqr(self:GetTarget(), vSquadPos)
	-- Try to unload troops
        if self.m_fDisengage and self.m_iUsedTransportSlots>0 and self.squad_ai:CanUnload() then
           if not self:MoveToDisengage() then
              self.squad_ai:DoMoveToClosestSafePoint( self.safe_point, self.tolerance )
              self:SetTarget(self.safe_point,Tactic.Variant.Vector)
           end
        if distance_sqr(self:GetTarget(), vSquadPos) < sqr(35) then
           self.m_fDisengage=false
        else
           self.squad_ai:DoMove(self:GetTarget())
        end
        return
	elseif (self:UnloadTroops(iDistance)) then
		self.m_iMoveDelay = g_iGMT - 1
		Tactic.SetSubState(self, self.HoldState, "Holding")
		return
	end
	
	-- Check for damaged vehicles close to start point
	if (self.m_bNeedRepair and iDistance < sqr(50) and not self.squad_ai:WasRecentlyHurt() and
		distance_sqr(self:GetTarget(), cpu_manager.start_pos) < 1) then
		
		if ((self.squad_ai:IsInStateAttackMove() or self.squad_ai:IsInStateMove()) and not self:IsMoving()) then
			self.squad_ai:DoStop()
			self.m_iMoveDelay = g_iGMT + 15	
		end
		Tactic.SetSubState( self, VehicleTactic.HoldState, "Holding" )
		return
	end
	
	-- Try to jump
	if (self:JumpAttack()) then
		self.m_iMoveDelay = 0
		self.hurt_level = math.max(self.squad_ai:GetHealthPercentage() / 2, 0.3)
		return
	end
	
	-- Check distance
	if (iDistance > sqr(50) or not self:IsDefender()) then
	
		-- If we are too far away from the retreat position, then make a basic move
		cpu_manager:DoMove(self.squad_ai, self:GetTarget(), false, "RetreatState Vehicle")
		
	elseif (iDistance > sqr(25) or self.squad_ai:WasRecentlyHurt()) then
	
		-- If we are in range of the retreat position, then make an attack move
		cpu_manager:DoMove(self.squad_ai, self:GetTarget(), true, "RetreatState Vehicle")
	else
		self.squad_ai:DoStop()
	end
	self.m_iMoveDelay = g_iGMT

	-- Set holding sub-state
	Tactic.SetSubState( self, VehicleTactic.HoldState, "Holding" )
end

function VehicleTactic:BeginAttackState()
	
	-- Check if we're desperatly capturing
	if (self:UrgentCapturing()) then
		return
	end

	if (self:IsCaptureGuardMove()) then
		if (self.squad_ai:IsCapturing()) then
			return
		end
		local vSquadPos = self.squad_ai:GetPosition()
		local iDistance = distance_sqr(self:GetTarget(), vSquadPos)
		if (iDistance > sqr(25) and g_iGMT >= self.m_iMoveDelay + 6) then
			cpu_manager:DoMove(self.squad_ai, self:GetTarget(), self:IsCaptureGuardAttack(), "CaptureGuardAttack")
			self.m_iMoveDelay = g_iGMT
		end
		Tactic.SetSubState(self, self.HoldState, "Holding")
		return
	end
	
	-- Check if our capturing was interrupted
	if (self.squad_ai:IsCapturing()) then
		
		local iMaxCapturingSquadCost = cpu_manager:GetArmyStrength() / 5
		if (self.squad_ai:WasRecentlyHurt() or self:GetUnitStrength() > iMaxCapturingSquadCost) then
			cpu_manager:DoMove(self.squad_ai, self.squad_ai:GetPosition(), true, "Interrupt capturing!")
		end
		return
	end

	-- Check if we're busy
	if (self:IsInSubState()) then
		return
	end

	if (self.m_iArtilleryMinRange ~= nil and self.m_iArtilleryMinRange > 0) then
		if (self:MaintainArtilleryRange(self.m_iArtilleryMinRange)) then
			self.m_iMoveDelay = g_iGMT
			Tactic.SetSubState(self, self.AttackingState, "Attacking")
			return
		end
	end

	
	-- Check if we're doing a gather move at the moment
	if (self:CheckGatherMove()) then
		return
	end

	-- Try to jump
	if (self:JumpAttack()) then
		self.m_iMoveDelay = 0
		self.hurt_level = math.max(self.squad_ai:GetHealthPercentage() / 2, 0.3)
		return
	end
	
	-- Try to disown flags
	if (self:TryDisownFlags()) then
		self.m_iMoveDelay = g_iGMT
		Tactic.SetSubState( self, self.AttackingState, "Attacking" )
		return
	end
	
	-- Check move delay
	if (g_iGMT < self.m_iMoveDelay + 5 and self:IsMoving()) then
		Tactic.SetSubState( self, self.AttackingState, "Attacking" )
		return
	end
	
	-- Check for deepstrike buildings
	if (self:EnterDeepStrikeBuilding()) then
		self.m_iMoveDelay = g_iGMT
		Tactic.SetSubState(self, self.AttackingState, "Attacking")
		return
	end
        if (self.m_vTargetTransport.x~=0 or self.m_vTargetTransport.z~=0) and self.m_iUsedTransportSlots>0 and self.squad_ai:CanUnload() then
           self.squad_ai:DoMove(self.m_vTargetTransport)
           self:SetTarget(self.m_vTargetTransport, Tactic.Variant.Vector)
           self.m_iMoveDelay = self.m_iMoveDelay + 5
           self.m_vTargetTransport = Vector3f(0,0,0)
           return
        end
	-- Try to unload troops
	local vSquadPos = self.squad_ai:GetPosition()
	local iDistance = distance_sqr(self:GetTarget(), vSquadPos)
	-- Try to unload troops
    if self.m_fDisengage and self.m_iUsedTransportSlots>0 and self.squad_ai:CanUnload() then
       if not self:MoveToDisengage() then
          self.squad_ai:DoMoveToClosestSafePoint( self.safe_point, self.tolerance )
          self:SetTarget(self.safe_point,Tactic.Variant.Vector)
       end
    if distance_sqr(self:GetTarget(), vSquadPos) < sqr(35) then
       self.m_fDisengage=false
    else
       self.squad_ai:DoMove(self:GetTarget())
    end
    return
	elseif (self:UnloadTroops(iDistance)) then
		self.m_iMoveDelay = g_iGMT - 1
		Tactic.SetSubState(self, self.AttackingState, "Attacking")
		return
	end
	
	-- Only make an attack move if not in combat
	if (not self.squad_ai:IsAttacking() and not self.squad_ai:IsInStateAttackMove()) then
	
		-- Check distance
		if (iDistance > sqr(60)) then
		
			-- If we are too far away from the target, then make a simple attack move
			cpu_manager:DoMove(self.squad_ai, self:GetTarget(), true, "AttackState")
		else

			-- Check targets for melee squads
			if (not self.squad_ai:IsRanged()) then
			
				-- Get closest enemy unit
				local oUnit = self:GetClosestUnitForMelee(50)
				if (oUnit ~= nil and (not oUnit:IsInfiltrating() or oUnit:IsAttacking() or self.squad_ai:IsDetector())) then
					cpu_manager:DoMove(self.squad_ai, oUnit:GetPosition(), true, "AttackState")
					self.m_iMoveDelay = g_iGMT + 5
				else
				
					-- Get closest enemy building
					local oBuilding = self:GetClosestBuildingForMelee(50)
					if (oBuilding ~= nil) then
					
						-- Don't move too close to building
						if (distance_sqr(oBuilding:GetPosition(), vSquadPos) > sqr(15)) then
							cpu_manager:DoMove(self.squad_ai, oBuilding:GetPosition(), true, "AttackState")
							self.m_iMoveDelay = g_iGMT + 5
						end
						
					elseif (iDistance > sqr(25) or self.squad_ai:WasRecentlyHurt()) then
					
						-- Move to target if we're hurt or not close enough
						cpu_manager:DoMove(self.squad_ai, self:GetTarget(), true, "AttackState")
						self.m_iMoveDelay = g_iGMT
					else
						self.squad_ai:DoStop()
						self.m_iMoveDelay = g_iGMT + 5
					end
				end
			else
		
				-- If we are close to the target area, then make an attack move
				if (iDistance < sqr(25) and not self.squad_ai:WasRecentlyHurt() and
					not cpu_manager.terrain_analyzer:HasThreat(self:GetTarget(), 35)) then
					self.squad_ai:DoStop()
					self.m_iMoveDelay = g_iGMT
					Tactic.SetSubState(self, self.HoldState, "Attacking")
					return
				end
				cpu_manager:DoMove(self.squad_ai, self:GetTarget(), true, "AttackState")
				self.m_iMoveDelay = g_iGMT
			end
		end
	end

	-- Set attacking sub-state
	Tactic.SetSubState(self, self.AttackingState, "Attacking")
end

function VehicleTactic:AttackingState()

	-- Try to jump
	if (not self.squad_ai:IsCapturing() and self:JumpAttack()) then
		self.m_iMoveDelay = 0
		self.hurt_level = math.max(self.squad_ai:GetHealthPercentage() / 2, 0.3)
		return
	end
	
	-- Try to disown flags
	if (self:TryDisownFlags()) then
		self.m_iMoveDelay = g_iGMT
		return
	end

	-- If idle, restart — not while already engaged
	if (self.squad_ai:IsAttacking() or self.squad_ai:IsInCombat()) then
		return
	end
	if (self.squad_ai:IsIdle() or not self:IsMoving() or self.squad_ai:WasRecentlyHurt()) then
		Tactic.SetState( self, self:GetState() )
	end
end

function VehicleTactic:DoAbilities()
   
end

--jump capable vehicles will retreat once if hurt badly
function VehicleTactic:Retreat()

	if (self:IsOverwhelmSpamMode()) then
		return
	end

   --retreat from battle if badly hurt and while not already moving 
    if self.squad_ai:IsRanged() and self.squad_ai:CanJump() and 
		self.squad_ai:GetHealthPercentage() < self.hurt_level and
		self.squad_ai:WasRecentlyHurt() and not self.squad_ai:IsInStateMove() then 
		local engi = function( esquad_ai )
			return esquad_ai:IsEngineer() and distance(self.squad_ai:GetPosition(),esquad_ai:GetPosition())<20
		end
		if not cpu_manager:FindFirstFriendly(engi) then
			if not self:MoveToDisengage() then
				self.squad_ai:DoMoveToClosestSafePoint( self.safe_point, self.tolerance )
			end
		end
		  -- retreat twice
		self.hurt_level = 0.3	
    end
end

function VehicleTactic:FindArtilleryRetreatPoint( vSquadPos )

	local vBestTurret = nil
	local iBestTurretDist = 999999999
	local vHQ = nil
	local iHQDist = 999999999

	for oBuilding in cpu_manager.player_stats:GetBases() do
		if (oBuilding:IsValid() and oBuilding:IsConstructionDone()) then
			local vBuildPos = oBuilding:GetPosition()
			local iDistSqr = distance_sqr(vSquadPos, vBuildPos)
			if (cpu_manager:IsHQ(oBuilding:GetBlueprintID())) then
				if (iDistSqr < iHQDist) then
					iHQDist = iDistSqr
					vHQ = vBuildPos
				end
			elseif (oBuilding:HasGuns()) then
				if (iDistSqr < iBestTurretDist) then
					iBestTurretDist = iDistSqr
					vBestTurret = vBuildPos
				end
			end
		end
	end

	if (vBestTurret ~= nil) then
		return Vector3f(vBestTurret)
	end
	if (vHQ ~= nil) then
		return Vector3f(vHQ)
	end
	return Vector3f(cpu_manager.start_pos)
end

function VehicleTactic:IsNearArtilleryAnchor( vSquadPos, iRadius )

	if (iRadius == nil) then
		iRadius = 20
	end
	local iRadiusSqr = iRadius * iRadius

	for oBuilding in cpu_manager.player_stats:GetBases() do
		if (oBuilding:IsValid() and oBuilding:IsConstructionDone()) then
			if (cpu_manager:IsHQ(oBuilding:GetBlueprintID()) or oBuilding:HasGuns()) then
				if (distance_sqr(vSquadPos, oBuilding:GetPosition()) <= iRadiusSqr) then
					return true
				end
			end
		end
	end
	return false
end

function VehicleTactic:HasArtilleryThreat( vPos, iRange )

	if (cpu_manager.terrain_analyzer:HasThreat(vPos, iRange)) then
		return true
	end
	if (Ability.Filters.CloseEnemy(vPos, iRange, 1) ~= nil) then
		return true
	end
	if (Ability.Filters.CloseCommanderEnemy(vPos, iRange, 1) ~= nil) then
		return true
	end
	if (Ability.Filters.CloseVehicleEnemy(vPos, iRange, 1) ~= nil) then
		return true
	end
	if (Ability.Filters.CloseInfantryEnemy(vPos, iRange, 1) ~= nil) then
		return true
	end
	if (Ability.Filters.CloseInfiltratedEnemy(vPos, iRange, 1) ~= nil) then
		return true
	end
	return false
end

function VehicleTactic:GetClosestArtilleryThreat( vPos, iScanRange )

	local oClosest = nil
	local fClosestDist = 999999999

	local function ConsiderUnit( oUnit )

		if (oUnit ~= nil and oUnit:IsValid()) then
			local fDist = distance(vPos, oUnit:GetPosition())
			if (fDist <= iScanRange and fDist < fClosestDist) then
				fClosestDist = fDist
				oClosest = oUnit
			end
		end
	end

	ConsiderUnit(cpu_manager.cpu_player:FindFirstEnemy(vPos, iScanRange, 1))
	ConsiderUnit(cpu_manager.cpu_player:FindFirstBaseEnemy(vPos, iScanRange, 1))
	ConsiderUnit(Ability.Filters.CloseEnemy(vPos, iScanRange, 1))
	ConsiderUnit(Ability.Filters.CloseCommanderEnemy(vPos, iScanRange, 1))
	ConsiderUnit(Ability.Filters.CloseVehicleEnemy(vPos, iScanRange, 1))
	ConsiderUnit(Ability.Filters.CloseInfantryEnemy(vPos, iScanRange, 1))
	ConsiderUnit(Ability.Filters.CloseInfiltratedEnemy(vPos, iScanRange, 1))

	if (oClosest ~= nil) then
		return oClosest, fClosestDist
	end

	if (self:HasArtilleryThreat(vPos, iScanRange)) then
		local oFallback = cpu_manager.cpu_player:FindFirstEnemy(vPos, iScanRange + 40, 1)
		if (oFallback ~= nil) then
			return oFallback, distance(vPos, oFallback:GetPosition())
		end
		return nil, 0
	end

	return nil, nil
end

function VehicleTactic:ArtilleryHoldFire( vPos )

	if (g_iGMT < self.m_iLastArtilleryHold + 4) then
		return true
	end
	if (self.m_bArtilleryHoldAttackMove ~= false) then
		cpu_manager:DoMove(self.squad_ai, Vector3f(vPos), true, "ArtilleryHold")
	else
		if (self.squad_ai:IsInStateAttackMove() or self.squad_ai:IsInStateMove()) then
			cpu_manager:DoMove(self.squad_ai, Vector3f(vPos), false, "ArtilleryHold")
		end
		self.squad_ai:DoSetStance(SquadAI.STANCE_StandGround)
	end
	self.m_iLastArtilleryHold = g_iGMT
	return true
end

function VehicleTactic:MaintainArtilleryRange( iMinRange )

	if (self:IsOverwhelmSpamMode()) then
		return false
	end

	if (iMinRange == nil) then
		iMinRange = self.m_iArtilleryMinRange
	end
	if (iMinRange == nil) then
		iMinRange = 60
	end

	local iMaxRange = self.m_iArtilleryMaxRange
	if (iMaxRange == nil or iMaxRange <= iMinRange) then
		iMaxRange = iMinRange + 30
	end

	local vPos = self.squad_ai:GetPosition()
	local iScanRange = iMaxRange + 30
	if (iScanRange < iMinRange + 50) then
		iScanRange = iMinRange + 50
	end
	local bThreatNear = self:HasArtilleryThreat(vPos, iMinRange)
	local oEnemy, fEnemyDist = self:GetClosestArtilleryThreat(vPos, iScanRange)
	local bNearAnchor = self:IsNearArtilleryAnchor(vPos, 20)

	if (oEnemy == nil and not bThreatNear) then
		return false
	end

	if (oEnemy == nil and bThreatNear) then
		fEnemyDist = 0
	end

	if (fEnemyDist > iMaxRange) then
		return false
	end

	if (bNearAnchor or (fEnemyDist >= iMinRange and fEnemyDist <= iMaxRange)) then
		self:ArtilleryHoldFire(vPos)
		return true
	end

	if (g_iGMT < self.m_iLastArtilleryMove + 5) then
		if (self.squad_ai:IsInStateMove()) then
			return true
		end
	end

	local vRetreatAnchor = self:FindArtilleryRetreatPoint(vPos)
	self.safe_point = Vector3f(vRetreatAnchor)

	local vMove = Vector3f(vRetreatAnchor)
	if (oEnemy ~= nil) then
		local vEnemyPos = oEnemy:GetPosition()
		local fBackDist = iMinRange - fEnemyDist + 20
		if (fBackDist < 30) then
			fBackDist = 30
		end
		if (fBackDist > 55) then
			fBackDist = 55
		end

		local fAwayX = vPos.x - vEnemyPos.x
		local fAwayZ = vPos.z - vEnemyPos.z
		local fAwayLen = math.sqrt(fAwayX * fAwayX + fAwayZ * fAwayZ)
		if (fAwayLen > 1) then
			vMove = Vector3f(vPos)
			vMove.x = vPos.x + (fAwayX / fAwayLen) * fBackDist
			vMove.z = vPos.z + (fAwayZ / fAwayLen) * fBackDist
		end
	end

	if (self:IsDisengageRouteClear(vPos, vMove, 24)) then
		cpu_manager:DoMove(self.squad_ai, vMove, false, "ArtilleryRange")
		self.m_iLastArtilleryMove = g_iGMT
		return true
	end

	if (self:IsDisengageRouteClear(vPos, vRetreatAnchor, 24)) then
		cpu_manager:DoMove(self.squad_ai, vRetreatAnchor, false, "ArtilleryRetreat")
		self.m_iLastArtilleryMove = g_iGMT
		return true
	end

	if (self:MoveToDisengage()) then
		self.m_iLastArtilleryMove = g_iGMT
		return true
	end

	return false
end

function VehicleTactic:MoveToDisengage()
	if (self:IsOverwhelmSpamMode()) then
		return false
	end
	if (self.m_iArtilleryMinRange ~= nil and self.m_iArtilleryMinRange > 0) then
		if (self:IsNearArtilleryAnchor(self.squad_ai:GetPosition(), 20)) then
			return false
		end
		self.safe_point = self:FindArtilleryRetreatPoint(self.squad_ai:GetPosition())
	end
	return Tactic.MoveToDisengage(self)
end


function VehicleTactic:DoDance()

	if (self.stateID == Tactic.StateID.DoDance and not self:CheckForDance()) then
	
		-- Go back in the fray - reset my state
		if (self.m_eSubStateID == self.stateID) then
			self.m_eSubStateID = Tactic.StateID.NoState
		end
		self.stateID = Tactic.StateID.NoState
		Tactic.SetState( self, self:GetState() )
		self.tolerance = self.tolerance_default
	end
end

-- Short kite when chipped — never HQ gather/abandon (Looted/Bomma/Leman + daemon/relic ranged)
function VehicleTactic:TryFireSupportSoftPeel()

	local bFireSupport = self:IsBaseFireSupportUnit()
	local bRelicRanged = (self:IsDaemonRelicUnit() and self.squad_ai:IsRanged())
	if (not bFireSupport and not bRelicRanged) then
		return false
	end
	if (self:IsOverwhelmSpamMode()) then
		return false
	end
	if (self.squad_ai:IsCapturing()) then
		return false
	end
	if (not self.squad_ai:IsUnderAttack() and not self.squad_ai:WasRecentlyHurt()) then
		return false
	end
	local fHP = self.squad_ai:GetHealthPercentage()
	-- Fire support: mid-chip only; daemon/relic: short dance on any chip while fighting
	if (bFireSupport and (fHP >= 0.9)) then
		return false
	end
	if (bRelicRanged and fHP >= 0.95) then
		return false
	end
	if (self.m_iLastDisengage ~= nil and g_iGMT < self.m_iLastDisengage + 4) then
		return false
	end
	self.tolerance = 23
	self.squad_ai:DoMoveToClosestSafePoint( self.safe_point, self.tolerance )
	self.m_iLastDisengage = g_iGMT
	return true
end

function VehicleTactic:CheckForDance()

	if (self:IsOverwhelmSpamMode()) then
		return false
	end
	-- Homeside / base threat: hold, don't dance into the base AFK
	if (self:ShouldHoldDefenseLine() or self:IsBaseFireSupportUnit()) then
		return false
	end

   if (self.can_dance and self.squad_ai:IsUnderAttack() and not self.squad_ai:IsBroken()) then

	  local squad_pos = self.squad_ai:GetPosition()
	  enemy_squad = Ability.Filters.CloseEnemy( squad_pos, 7, 1 )
	  if enemy_squad ~= nil and not enemy_squad:IsBroken() then

		 local stance = enemy_squad:GetMeleeStance()
		 if stance == SquadAI.MSTANCE_Assault then
 
	        -- In standard dancing mode, there's a 50% chance that dancing fails
	        if (self.m_iDancing == 0 and CpuManager.AISettings.iDancing == 1 and math.random(1, 2) == 2) then
	           self.m_iDancing = g_iGMT
	           return false
	        end
  
			local first_call = self.stateID == Tactic.StateID.NoState

			--no valid destination
			if not self:MoveToDisengage() then
			   
			   if not first_call then
				  self.tolerance = self.tolerance + 10
			   else
				  self.tolerance = self.tolerance_default
			   end
			   
			   self.squad_ai:DoMoveToClosestSafePoint( self.safe_point, self.tolerance )
			end
			
			--we start to dance
			if self:GetSubState() ~= self.DoDance then
			   			   
			   Tactic.SetSubState( self, self.DoDance, "DoDance" )
			   self.squad_ai:DoSetStance( SquadAI.STANCE_StandGround )
		 
			   self.stateID = Tactic.StateID.DoDance	 	
			end
					
			self.m_eSubStateID = self.stateID
			return true
		 end		 
	  end
   end

   -- No dancing
   self.m_iDancing = 0
   return false
end

function VehicleTactic:SyncSubState()

	-- Check if we are in sub state
	local in_state = self:IsInSubState()
	if (self.stateID == Tactic.StateID.NoState and not in_state) then
		return
	end

	-- Since other function may override the substate we have to sync state flags
	local state_func, state_name = self:GetSubState() 
	if (self.stateID == Tactic.StateID.IsBroken and state_func ~= self.BrokenMorale) or
	   (self.stateID == Tactic.StateID.DoDance and state_func ~= self.DoDance) or
	   (self.stateID == Tactic.StateID.AvoidDeath and state_func ~= self.AvoidDeath) or
	   (self.stateID == Tactic.StateID.AvoidStealth and state_func ~= self.AvoidStealthTroops) then
		   
		self.stateID = Tactic.StateID.NoState
		self.m_eSubStateID = Tactic.StateID.NoState
	end
	
	-- Sync InSubState with state flag
	if (in_state and self.stateID == Tactic.StateID.NoState) or
	   (not in_state and self.stateID ~= Tactic.StateID.NoState) then
	
		if (in_state) then
			self.m_eSubStateID = Tactic.StateID.NoState
		else
			self.stateID = Tactic.StateID.NoState
		end
	end
end

function VehicleTactic:Upgrade()

	if (g_iGMT < (self.m_iLastUpgradeCheck or 0) + 2) then
		return
	end
	self.m_iLastUpgradeCheck = g_iGMT

	-- Check situation
	if (self.squad_ai:HasUpgradableTrooper() and self.squad_ai:GetHealthPercentage() > 0.5) then
	
		-- Set upgrade direction
		local eUpgradeType = UnitStatsAI.UC_VehicleMed
		if (math.random(1, 2) == 2) then

			-- Figure out my enemy's favourite class
			local oEnemy = cpu_manager:FindClosestEnemyPlayer()
			if (oEnemy ~= nil) then
				eUpgradeType = oEnemy:GetMajorityClassType()
			end
		end

		-- Try to upgrade
		self.squad_ai:DoBestUpgrade(eUpgradeType)
	end
end

function VehicleTactic:Reinforce()

	if (g_iGMT < (self.m_iLastReinforceCheck or 0) + 2) then
		return
	end
	self.m_iLastReinforceCheck = g_iGMT

	-- Don't reinforce if we can't reinforce or need repair
	if (self.squad_ai:GetMaxTroopers() == 1 or self.m_bNeedRepair) then
		return	
	end

	-- Don't reinforce if we have no free resources
	if (not Tactic.Options.can_reinforce) then
		return	
	end

	-- Don't reinforce if there's only one squad member left which is severly damaged
	if (self.squad_ai:GetNumTroopers() == 1 and self.squad_ai:GetHealthPercentage() < 0.5) then
		return
	end
	
	-- Always try to reinforce, as long as I have money
	if (not self.squad_ai:IsReinforcing()) then
			
		if (self.squad_ai:CanReinforce( true, 0 )) then
			self.squad_ai:DoReinforce( true, 0 )
		elseif (self.squad_ai:CanReinforce( false, 0 )) then
			self.squad_ai:DoReinforce( false, 0 )
		end
	end
end

function VehicleTactic:CanCaptureGuard()

	if (not Tactic.CanCaptureGuard(self)) then
		return false
	end
	if (CapturePlan:NeedsHomeSideSecurePhase()) then
		return true
	end
	if (CpuManager.AISettings.bHarassing and g_iGMT < DefendChokePointPlan.HarassingTime * 60 and g_iGMT > 30 and
		self.squad_ai:IsIdle() and cpu_manager:GetUnitStrength(self.squad_ai) > 180 and not self:IsDefender()) then
		return false
	end
	return true
end

function VehicleTactic:Update()

	-- State machine
	if (not Tactic.Update(self)) then
		return false
	end

	-- Sentinel / Reaver / Wraith: after decap leave the flag (do not AFK-block capture)
	if (self:ManageCanOnlyDecapCapture()) then
		return true
	end

	self:SyncTransportCargo()

	-- Loaded transport stuck in Idle never reaches BeginAttackState (m_vTargetTransport unused there)
	if (self.m_iTransportVehicle > 0 and self.squad_ai:CanUnload() and self:GetState() == Tactic.States.Idle) then
		Tactic.SetState(self, Tactic.States.Attack)
	end

	-- Try to unload troops
      if (g_iGMT > self.m_iMoveDelay + 5) and (self.squad_ai:CanUnload() and not self.m_fDisengage) or self.m_fDisengageDance then
	   local iDistance = sqr(1)
        if self.m_fDisengageDance then
           self.m_fDisengageDance = false
        else
	   local vSquadPos = self.squad_ai:GetPosition()
	   iDistance = distance_sqr(self:GetTarget(), vSquadPos)	
        end

	if (self:UnloadTroops(iDistance)) then
		self.m_iMoveDelay = g_iGMT
		return
	end
      end
--[[
	-- Check if vehicle can be repaired
	if (self.squad_ai:CanBeRepaired() and self.squad_ai:GetHealthPercentage() < 0.4 and
		self.squad_ai:GetNumTroopers() == 1 and	not self.squad_ai:IsReinforcing()) then

		-- Check if we can retreat
		if (self.squad_ai:IsRanged() or not self.squad_ai:IsUnderAttack()) then
			self.m_bNeedRepair = true
		end
	end
	
	-- Check if vehicle needs repair
	if (self.m_bNeedRepair) then

		-- Check if vehicle is repaired
--		aitrace("Current repair target = "..tostring(self:GetTarget().x)..", "..tostring(self:GetTarget().z))
		if (self.squad_ai:GetHealthPercentage() > 0.97) then
	        self.m_bNeedRepair = false
	        self.hurt_level = 0.6
	    end
	end
	
        self.time_life = self.time_life + 1
]]
	if (self.squad_ai:CanJump()) then
		self.tolerance_default = self.squad_ai:GetJumpDistance()
	else
		self.tolerance_default = 100
	end
	
	self:Upgrade()
	
	self:Reinforce()
	
	self:SyncSubState()
	
	if (self.m_iArtilleryMinRange ~= nil and self.m_iArtilleryMinRange > 0) then
		if (self:MaintainArtilleryRange(self.m_iArtilleryMinRange)) then
			self:InitAbilities()
			self:DoAbilities()
			return true
		end
	end
	
	-- Check if ranged vehicle under attack wants to retreat a short distance
	self:Retreat()
	
	if (self.stateID == Tactic.StateID.NoState) then
	
		local bAllowEmergencyChecks = not self:IsOverwhelmSpamMode()
		-- Check dance mode
		if (bAllowEmergencyChecks and CpuManager.AISettings.iDancing == 2) then
			self:CheckForDance()
			if (self.stateID == Tactic.StateID.NoState) then
				self:CheckForStealthTroops()
			end
		elseif (bAllowEmergencyChecks and CpuManager.AISettings.iDancing == 1 and g_iGMT > self.m_iDancing + 10) then
			self:CheckForDance()
			if (self.stateID == Tactic.StateID.NoState) then
				self:CheckForStealthTroops()
			end
		end
	end
	if (not self:IsCaptureGuardMove()) then
		self:FocusEnemy()
	end

	-- Special moves
--        if not self:FocusEnemy() then
--	self:CloseOnEnemy()
--        end
	
	-- Do abilities
	self:InitAbilities()
	self:DoAbilities()
	
	-- Don't update stance if in special substate !
	if (self.stateID == Tactic.StateID.NoState) then
		self:UpdateStance()
	end

    self:HarrasingAttack()


	return true
end