					end
				end
			end

			-- Solo harass only if path AND destination are safe (no walking through armies)
			if (vHarassingTarget ~= nil and self:CanSafelyAdvanceTo(vHarassingTarget, 50)) then
				local vMyPos = self.squad_ai:GetPosition()
				local iNearEnemy, iNearAllied = cpu_manager:GetArmyStrengthAtPos(vMyPos, 55, true)
