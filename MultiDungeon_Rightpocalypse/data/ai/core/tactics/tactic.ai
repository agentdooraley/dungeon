function Tactic:CanDeepStrike()

	-- Check if we are able to enter a deepstrike building
	if (self.m_iDeepStrikeBlueprintID < 0) then
		return false
	end
	return true
end

function Tactic:SetDeepStrikeBuilding(oBuilding)

	-- Check building
	if (oBuilding:GetBlueprintID() ~= self.m_iDeepStrikeBlueprintID or not oBuilding:IsConstructionDone()) then
		return
	end
	
	-- Check if we already have a valid deep strike building
	if (self.m_iDeepStrikeBuildingID >= 0) then

		-- Get current deepstrike building
		local oDeepStrikeBuilding = military_manager:GetBaseFromID(self.m_iDeepStrikeBuildingID)
		if (oDeepStrikeBuilding ~= nil and oDeepStrikeBuilding:IsValid()) then
		
			-- Check if new building is closer
			local vSquadPos = self.squad_ai:GetPosition()
			local iNewDistance = distance_sqr(oBuilding:GetPosition(), vSquadPos)
			local iOldDistance = distance_sqr(oDeepStrikeBuilding:GetPosition(), vSquadPos)
			if (iNewDistance >= iOldDistance) then
				return
			end
		end
	end
	self.m_iDeepStrikeBuildingID = oBuilding:GetEntity():GetID()
end

function Tactic:EnterDeepStrikeBuilding()

	-- Check if we have a deepstrike building
	if (self.m_iDeepStrikeBuildingID < 0) then
		return false
	end
	
	-- Get deepstrike building
	local oDeepStrikeBuilding = military_manager:GetBaseFromID(self.m_iDeepStrikeBuildingID)
	if (oDeepStrikeBuilding == nil or not oDeepStrikeBuilding:IsValid()) then
		self.m_iDeepStrikeBuildingID = -1
		return false
	end

	-- Check if we are ready to enter a deepstrike building
	if (self.squad_ai:GetHealthPercentage() < 0.8 or self.squad_ai:IsCapturing() or
		(self.squad_ai:GetMaxTroopers() == 1) or
		self.squad_ai:IsInCombat() or self.squad_ai:GetNumTroopers() < self.squad_ai:GetMaxTroopers()) then
		return false
	end

	-- Check if the deepstrike building is much closer than the target pos, or we are waiting for action
	local vSquadPos = self.squad_ai:GetPosition()
	local iDistanceToTarget = distance_sqr(vSquadPos, self.target)
	local iDistanceToBuilding = distance_sqr(vSquadPos, oDeepStrikeBuilding:GetPosition())
	local bCloserThanHalfRange = (iDistanceToTarget < 2 * iDistanceToBuilding)
	local bLocked = self.squad_ai:IsLocked()
	if ((bLocked and (iDistanceToTarget < sqr(70) or bCloserThanHalfRange)) or
		(not bLocked and iDistanceToBuilding > sqr(70) and bCloserThanHalfRange) or
		cpu_manager.terrain_analyzer:HasThreat(vSquadPos, 70)) then
		return false
	end
	
	-- Okay, try to enter deepstrike building
	aitrace("Tactic: Enter deepstrike building...")
	self.squad_ai:DoDefault(oDeepStrikeBuilding:GetEntity())
	return true
end

function Tactic:Update()
	
	local continue = true 
	if (self:GetState() == Tactic.States.Disabled) then
		continue = false
	end

	if (continue and self:IsComplete()) then
		continue = false
	end
	
	if (not cpu_manager.components[ CpuPlayer.CT_Tactics ]) then
		continue = false	
	end

	if (continue) then
		
		AITrace.Log("Tactic.Noise", "Tactic: Update "..tostring(self.squad_ai:GetSquadName()).."...")
		
		-- Update position
		self.m_vLastPosition = self.m_vCurrentPosition
		self.m_vCurrentPosition = self.squad_ai:GetPosition()
		
		-- Update unit strength
		self.m_iUnitStrength = cpu_manager:GetUnitStrength(self.squad_ai)
		
		self.state_function( self )
	end
	return continue
end



function Tactic:IsWorkerSquad( oSquad )
	if (oSquad == nil or not oSquad:IsValid() or not oSquad:IsEngineer()) then
		return false
	end
	if (oSquad:IsBuildProgressing() or oSquad:IsBuilding() ~= 0) then
		return true
	end
	if (oSquad:CanRepair() and not oSquad:IsIdle()) then
		return true
	end
	return false
end



function Tactic:IsBuildingUnderWork( oBuilding )
	if (oBuilding == nil or not oBuilding:IsValid()) then
		return false
	end
	if (not oBuilding:IsConstructionDone()) then
		return true
	end
	if (oBuilding:CanBeRepaired() and oBuilding:GetHealthPercentage() < 0.99) then
		return true
	end
	return false
end



function Tactic:FindWorkerNearPos( vPos, iRange )
	if (vPos == nil or cpu_manager.m_aEnemyUnits == nil) then
		return nil
	end
	if (iRange == nil) then
		iRange = 5
	end
	local iRangeSqr = sqr(iRange)
	local oBest = nil
	local iBestDist = nil
	for iLoop1 in cpu_manager.m_aEnemyUnits do
		local oSquad = cpu_manager.m_aEnemyUnits[iLoop1][3]
		if (oSquad ~= nil and oSquad:IsValid() and oSquad:IsEngineer()) then
			local iDist = distance_sqr(vPos, cpu_manager.m_aEnemyUnits[iLoop1][1])
			if (iDist <= iRangeSqr) then
				if (iBestDist == nil or iDist < iBestDist) then
					iBestDist = iDist
					oBest = oSquad
				end
			end
		end
	end
	return oBest
end



function Tactic:FindWorkerAtBuilding( oBuilding )
	if (oBuilding == nil or not oBuilding:IsValid()) then
		return nil
	end
	return self:FindWorkerNearPos(oBuilding:GetPosition(), 5)
end



function Tactic:DoFocusSquad( oSquad )
	if (oSquad == nil or not oSquad:IsValid()) then
		return false
	end
	if (self.squad_ai == nil or not self.squad_ai:IsValid()) then
		return false
	end
	local iID = oSquad:GetID()
	-- Same target: no new order (DoDefault every 2.5s = stutter / walk-stop)
	if (self.m_iFocusTargetID ~= nil and self.m_iFocusTargetID == iID) then
		return true
	end
	-- Re-check before GetEntities — dying target = pure virtual
	if (not oSquad:IsValid()) then
		self.m_iFocusTargetID = nil
		return false
	end
	local oEnemyUnitEnt = oSquad:GetEntities()
	if (oEnemyUnitEnt == nil) then
		self.m_iFocusTargetID = nil
		return false
	end
	local unitbuf = nil
	for unit in oEnemyUnitEnt do
		if (unit ~= nil) then
			unitbuf = unit
			break
		end
	end
	if (unitbuf == nil) then
		self.m_iFocusTargetID = nil
		return false
	end
	if (self.squad_ai == nil or not self.squad_ai:IsValid() or not oSquad:IsValid()) then
		self.m_iFocusTargetID = nil
		return false
	end
	-- Never SetTarget here: it overwrites plan target → Hold/Attack DoMove to enemy → dance
	self.m_iFocusTargetID = iID
	self.squad_ai:DoDefault(unitbuf)
	return true
end



function Tactic:IsAffectedByMorale()
	return false
end

function Tactic:IsOverwhelmSpamMode()
	if (not cpu_manager.m_bOverwhelmActive) then
		return false
	end
	if (self.squad_ai == nil or not self.squad_ai:IsValid()) then
		return false
	end
	return true
end

function Tactic:IsInEmergencySubState()
	if (self:IsOverwhelmSpamMode()) then
		return false
	end
	if (self.squad_ai ~= nil and self.squad_ai:IsValid() and self.squad_ai:IsBroken() and self:IsAffectedByMorale()) then
		return true
	end
	if (self.stateID == Tactic.StateID.IsBroken) then
		return true
	end
	if (self.stateID == Tactic.StateID.AvoidDeath) then
		return true
	end
	if (self.stateID == Tactic.StateID.DoDance) then
		return true
	end
	if (self.stateID == Tactic.StateID.AvoidStealth) then
		return true
	end
	return false
end

-- Vehicles + daemon/relic "tanks" (Squiggoth, Avatar…): hold line, not soft peel
function Tactic:IsDefenseTankUnit()
	if (self:IsDaemonRelicUnit()) then
		return true
	end
	return (self.m_eType == Tactic.Types.Vehicle)
end

-- Looted Tank / Fighta-Bomma / Leman Russ: long-range base guns
function Tactic:IsBaseFireSupportUnit()
	if (self.squad_ai == nil or not self.squad_ai:IsValid()) then
		return false
	end
	return BaseTactic:IsBaseFireSupportSquadName( self.squad_ai:GetSquadName() )
end

-- Squiggoth / Land Raider / fire support: never park in AttackPlan gather
function Tactic:IsNoGatherCombatUnit()

	if (self:IsBaseFireSupportUnit()) then
		return true
	end
	if (self:IsDaemonRelicUnit()) then
		return true
	end
	return false
end


-- Homeside / base contested: tanks stay and fight (no deep HQ AFK)
function Tactic:ShouldHoldDefenseLine()
	if (not self:IsDefenseTankUnit()) then
		return false
	end
	if (self.squad_ai == nil or not self.squad_ai:IsValid()) then
		return false
	end
	-- Fire support + daemon/relic: always hold / fight (no HQ AFK, no 30% peel)
	if (self:IsBaseFireSupportUnit()) then
		return true
	end
	if (self:IsDaemonRelicUnit()) then
		return true
	end
	if (self.m_eType == Tactic.Types.Vehicle and self.squad_ai:GetHealthPercentage() < 0.3) then
		return false
	end
	if (cpu_manager:GetCriticalThreat() > 0 or cpu_manager:HQThreat()) then
		return true
	end
	return cpu_manager:IsHomeSidePosition(self.squad_ai:GetPosition())
end

function Tactic:ShouldRetreatToBase()
	if (self.squad_ai == nil or not self.squad_ai:IsValid()) then
		return false
	end
	if (self:IsOverwhelmSpamMode()) then
		return false
	end
	-- Daemon/relic: never abandon the line (short ranged dance only)
	if (self:IsDaemonRelicUnit()) then
		return false
	end
	-- Looted / Bomma / Leman: never abandon the line for "outgunned" retreat
	if (self:IsBaseFireSupportUnit() and self.squad_ai:GetHealthPercentage() >= 0.3) then
		return false
	end
	-- Broken / AvoidDeath / Dance — план не перебивает; мягкий peel сюда не входит
	if (self:IsInEmergencySubState()) then
		return true
	end
	if (self.squad_ai:IsBroken()) then
		return true
	end
	if (self:IsAffectedByMorale() and self.squad_ai:GetMoralePercentage() < 0.25) then
		return true
	end
	local fHP = self.squad_ai:GetHealthPercentage()
	-- Commanders (Haemonculus etc.): high UnitStrength hides being alone → yo-yo Attack↔Retreat
	if (self:IsCommander() and fHP < 0.55 and
		(self.squad_ai:IsUnderAttack() or self.squad_ai:WasRecentlyHurt())) then
		return true
	end
	-- Только серьёзный урон / явный перевес врага — не чип-дамаг
	if (fHP < 0.3 and (self.squad_ai:IsUnderAttack() or self.squad_ai:WasRecentlyHurt())) then
		return true
	end
	-- Vehicles on homeside/base: outgunned ≠ run to HQ AFK — hold the line
	if (self:ShouldHoldDefenseLine()) then
		return false
	end
	if (self.squad_ai:IsUnderAttack() or self.squad_ai:WasRecentlyHurt()) then
		local vPos = self.squad_ai:GetPosition()
		local iEnemy, iAllied = cpu_manager:GetArmyStrengthAtPos(vPos, 40, true)
		local iMy = self:GetUnitStrength()
		if (iEnemy > 0) then
			if (iAllied < cpu_manager:GetRetreatRatio() * iEnemy) then
				return true
			end
			if (iAllied == 0 and iEnemy > iMy and fHP < 0.55) then
				return true
			end
			-- Solo-ish commander: allied ≈ self, still outgunned
			if (self:IsCommander() and iAllied <= iMy * 1.15 and
				iAllied < iEnemy and fHP < 0.65) then
				return true
			end
		end
	end
	return false
end

-- Дальний уход на базу/точку — только broken / мораль / крит. HP (не чип-дамаг)
function Tactic:ShouldRetreatAllTheWayHome()
	if (self.squad_ai == nil or not self.squad_ai:IsValid()) then
		return false
	end
	if (self:IsOverwhelmSpamMode()) then
		return false
	end
	if (self:IsDaemonRelicUnit()) then
		return false
	end
	if (self:IsBaseFireSupportUnit() and self.squad_ai:GetHealthPercentage() >= 0.3) then
		return false
	end
	if (self.squad_ai:IsBroken()) then
		return true
	end
	if (self:IsAffectedByMorale() and self.squad_ai:GetMoralePercentage() < 0.25) then
		return true
	end
	if (self.squad_ai:GetHealthPercentage() < 0.25 and (self.squad_ai:WasRecentlyHurt() or self.squad_ai:IsUnderAttack())) then
		return true
	end
	return false
end

function Tactic:IsSoftDisengageUnit()
	if (self.squad_ai == nil or not self.squad_ai:IsValid()) then
		return false
	end
	-- Daemon/relic infantry-as-tank: not soft peel (Predator soaks)
	if (self:IsDaemonRelicUnit()) then
		return false
	end
	if (self.squad_ai:IsRanged()) then
		return true
	end
	return (self.m_eType == Tactic.Types.Vehicle)
end

-- Melee still pressing (for DoDance — don't park on own LP)
function Tactic:IsMeleePressing( iRange )
	if (iRange == nil) then
		iRange = 22
	end
	if (self.squad_ai == nil or not self.squad_ai:IsValid()) then
		return false
	end
	local oEnemy = cpu_manager.cpu_player:FindFirstEnemy(self.squad_ai:GetPosition(), iRange, 1)
	if (oEnemy == nil or oEnemy:IsRanged()) then
		return false
	end
	return true
end

function Tactic:PickDanceEscapeStep( squad_pos, fStep )
	if (fStep == nil) then
		fStep = 40
	end
	local vAway = self:FindAwayFromEnemiesPosition(squad_pos, 45, fStep)
	if (vAway ~= nil and distance_sqr(vAway, squad_pos) >= sqr(12)) then
		return vAway
	end
	return self:FindBestEscapeDirection(squad_pos, fStep)
end

-- Мягкий peel: хватит — не underattack и нет мили в 20м (полный HP может терпеть)
function Tactic:ShouldCancelSoftDisengage()
	if (self.m_bDanceDisengage) then
		return false
	end
	if (self.squad_ai:IsBroken()) then
		return false
	end
	if (not self:IsSoftDisengageUnit()) then
		return false
	end
	if (self.squad_ai:IsUnderAttack()) then
		return false
	end

	local fHP = self.squad_ai:GetHealthPercentage()
	local vPos = self.squad_ai:GetPosition()
	local oEnemy = cpu_manager.cpu_player:FindFirstEnemy(vPos, 20, 1)

	if (fHP >= 0.9) then
		-- Полный HP: стоп, если нет ближника рядом (рейндж-огонь можно впитывать)
		if (oEnemy == nil or oEnemy:IsRanged()) then
			return true
		end
		return false
	end

	-- Не полный HP: стоп только когда давление реально спало
	if (oEnemy == nil and not self.squad_ai:WasRecentlyHurt()) then
		return true
	end
	return false
end

-- Короткий шаг от врага / к дому (не через всю карту к точке)
function Tactic:FindLocalDisengagePoint(squad_pos, iMaxStep)
	if (Tactic.TEST_RetreatToClosestBase) then
		return self:GetHomeRetreatPos()
	end
	if (iMaxStep == nil) then
		iMaxStep = 35
	end
	local vAway = self:FindAwayFromEnemiesPosition(squad_pos, 45, iMaxStep)
	if (vAway ~= nil) then
		return vAway
	end
	local vLocal = self:FindDisengagePosition(squad_pos, 12, iMaxStep, 25)
	if (vLocal ~= nil) then
		return vLocal
	end
	-- Небольшой nudge к HQ, без полного марша
	local vHome = cpu_manager.start_pos
	local fDx = vHome.x - squad_pos.x
	local fDz = vHome.z - squad_pos.z
	local fLen = math.sqrt(fDx * fDx + fDz * fDz)
	if (fLen < 1) then
		return nil
	end
	local vNudge = Vector3f(squad_pos)
	vNudge.x = squad_pos.x + (fDx / fLen) * iMaxStep
	vNudge.z = squad_pos.z + (fDz / fLen) * iMaxStep
	if (cpu_manager:IsPosOnMap(vNudge)) then
		return vNudge
	end
	return nil
end

function Tactic:GetHomeRetreatPos()
	local vPos = self.squad_ai:GetPosition()
	local vBase = cpu_manager:FindClosestFriendlyBaseOrStrategicPoint(vPos, cpu_manager.start_pos, true, false, true)
	if (vBase ~= nil) then
		return Vector3f(vBase)
	end
	return Vector3f(cpu_manager.start_pos)
end

function Tactic:GetRangedCombatRange()
	local iMax = cpu_manager:GetMaxRange(self.squad_ai:GetSquadName())
	if (iMax == nil or iMax < 20) then
		return 30
	end
	return iMax
end

function Tactic:GetRangedMinDistance()
	return math.max(16, math.floor(self:GetRangedCombatRange() * 0.45))
end

function Tactic:MaintainInfantryRangedRange()
	if (self:IsOverwhelmSpamMode()) then
		return false
	end
	if (not self.squad_ai:IsRanged() or self.squad_ai:IsBroken()) then
		return false
	end
	if (self:ShouldRetreatToBase() or self:NeedsRangedDisengage()) then
		return false
	end
	if (self.squad_ai:IsUnderAttack() and self.squad_ai:WasRecentlyHurt()) then
		return false
	end
	local iMaxRange = self:GetRangedCombatRange()
	local iMinRange = self:GetRangedMinDistance()
	local vPos = self.squad_ai:GetPosition()
	local oEnemy = cpu_manager.cpu_player:FindFirstEnemy(vPos, iMaxRange + 15, 1)
	if (oEnemy == nil) then
		return false
	end
	local iEnemyDist = distance(vPos, oEnemy:GetPosition())
	if (iEnemyDist > iMaxRange + 5) then
		return false
	end
	if (iEnemyDist < iMinRange) then
		if (self:MoveToDisengage()) then
			self.m_iMoveDelay = g_iGMT
			return true
		end
	end
	-- In a fight: only hold stance. DoStop here cancels DoDefault/attack-move → walk-stop stutter
	if (self.squad_ai:IsInCombat() or self.squad_ai:IsAttacking()) then
		if (self.squad_ai:GetStance() ~= SquadAI.STANCE_StandGround) then
			self.squad_ai:DoSetStance(SquadAI.STANCE_StandGround)
		end
		return true
	end
	if (self.squad_ai:IsInStateAttackMove() or self:IsMoving()) then
		self.squad_ai:DoStop()
		self.m_iMoveDelay = g_iGMT
	end
	if (self.squad_ai:GetStance() ~= SquadAI.STANCE_StandGround) then
		self.squad_ai:DoSetStance(SquadAI.STANCE_StandGround)
	end
	return true
end

function Tactic:CanSafelyAdvanceTo(vPos, iRange)
	if (vPos == nil) then
		return true
	end
	if (iRange == nil) then
		iRange = 50
	end
	local vMyPos = nil
	if (self.squad_ai ~= nil and self.squad_ai:IsValid()) then
		vMyPos = self.squad_ai:GetPosition()
	end
	-- Destination-only check let squads walk past an army to an empty building
	if (vMyPos ~= nil) then
		if (cpu_manager:HasThreatOnPath(vMyPos, vPos, iRange)) then
			return false
		end
		local aFrac = { 0.33, 0.5, 0.67 }
		for iSample = 1, 3 do
			local fT = aFrac[iSample]
			local vSample = Vector3f(vMyPos)
			vSample.x = vMyPos.x + (vPos.x - vMyPos.x) * fT
			vSample.z = vMyPos.z + (vPos.z - vMyPos.z) * fT
			local iPathEnemy, iPathAllied = cpu_manager:GetArmyStrengthAtPos(vSample, iRange, true)
			if (iPathEnemy > 0) then
				local iAvailable = iPathAllied + self:GetUnitStrength()
				if (iAvailable < cpu_manager:GetAttackRatio() * iPathEnemy) then
					return false
				end
			end
		end
	end
	local iEnemy, iAlliedTotal, iMyAtPos = cpu_manager:GetArmyStrengthAtPos(vPos, iRange, true)
	if (iEnemy <= 0) then
		return true
	end
	local iAvailable = iAlliedTotal - iMyAtPos + self:GetUnitStrength()
	return iAvailable >= cpu_manager:GetAttackRatio() * iEnemy
end

-- Focus buckets: 1=infantry(+MonsterMed), 2=vehicle/air, 3=building, 4=MonsterHigh
function Tactic:GetFocusBucketFromClass( eClass )
	if (eClass == UnitStatsAI.UC_BuildingLow or eClass == UnitStatsAI.UC_BuildingMed or
		eClass == UnitStatsAI.UC_BuildingHigh) then
		return 3
	end
	if (eClass == UnitStatsAI.UC_MonsterHigh) then
		return 4
	end
	if (eClass == UnitStatsAI.UC_VehicleLow or eClass == UnitStatsAI.UC_VehicleMed or
		eClass == UnitStatsAI.UC_VehicleHigh or eClass == UnitStatsAI.UC_AirLow or
		eClass == UnitStatsAI.UC_AirMed or eClass == UnitStatsAI.UC_AirHigh) then
		return 2
	end
	-- Infantry, commander, MonsterMed (small/med demons) — no UC_MonsterLow in engine
	return 1
end

function Tactic:GetPreferredFocusBucket()
	if (self.m_iPreferredFocusBucket ~= nil and g_iGMT < self.m_iNextFocusBucketCheck) then
		return self.m_iPreferredFocusBucket
	end
	self.m_iNextFocusBucketCheck = g_iGMT + 15

	local stats = self.squad_ai:GetStats()
	if (stats == nil) then
		self.m_iPreferredFocusBucket = 1
		return 1
	end

	local aSum = { 0, 0, 0, 0 }
	local aCnt = { 0, 0, 0, 0 }
	for class = 0, UnitStatsAI.UC_Count - 1 do
		local iBucket = self:GetFocusBucketFromClass(class)
		aSum[iBucket] = aSum[iBucket] + stats:GetEffectivenessRating(class)
		aCnt[iBucket] = aCnt[iBucket] + 1
	end

	local iBest = 1
	local fBest = -1
	for iBucket = 1, 4 do
		local fAvg = 0
		if (aCnt[iBucket] > 0) then
			fAvg = aSum[iBucket] / aCnt[iBucket]
		end
		if (fAvg > fBest) then
			fBest = fAvg
			iBest = iBucket
		end
	end

	self.m_iPreferredFocusBucket = iBest
	return iBest
end

function Tactic:FocusEnemy()
	-- ~2.5s. Squads only for now (buildings later).
	if (self:IsOverwhelmSpamMode()) then
		return false
	end
	if (self.squad_ai == nil or not self.squad_ai:IsValid()) then
		return false
	end
	if (self.squad_ai:IsCapturing() or self.squad_ai:IsEngineer()) then
		return false
	end
	-- Only while actually in a fight (not chip / UnderAttack on the march)
	if (not self.squad_ai:IsInCombat()) then
		self.m_iFocusTargetID = nil
		return false
	end
	if (g_iGMT < self.m_iLastFocusEnemy + 2.5) then
		return false
	end

	local vPos = self.squad_ai:GetPosition()
	if (vPos == nil) then
		return false
	end
	local iMaxRange = cpu_manager:GetMaxRange(self.squad_ai:GetSquadName()) + 5
	local iRangeSqr = sqr(iMaxRange)

	-- Sticky: keep current focus, no new DoDefault / no plan-target rewrite
	if (self.m_iFocusTargetID ~= nil and cpu_manager.m_aEnemyUnits ~= nil) then
		for iLoop1 in cpu_manager.m_aEnemyUnits do
			local aEntry = cpu_manager.m_aEnemyUnits[iLoop1]
			local oSticky = aEntry[3]
			if (oSticky ~= nil and oSticky:IsValid() and oSticky:GetID() == self.m_iFocusTargetID) then
				if (distance_sqr(vPos, aEntry[1]) <= iRangeSqr) then
					self.m_iLastFocusEnemy = g_iGMT
					return true
				end
				break
			end
		end
		self.m_iFocusTargetID = nil
	end

	self.m_iLastFocusEnemy = g_iGMT
	local iPref = self:GetPreferredFocusBucket()

	-- Workers repairing/building first (infantry soft targets)
	local oWorker = self:FindWorkerNearPos(vPos, iMaxRange)
	if (oWorker ~= nil) then
		return self:DoFocusSquad(oWorker)
	end

	-- Already shooting: don't re-order (DoDefault mid-fight causes walk-stop)
	if (self.squad_ai:IsAttacking()) then
		return false
	end

	local oEnemy = nil
	if (iPref == 1) then
		oEnemy = cpu_manager.cpu_player:FindFirstInfantryEnemy(vPos, iMaxRange, 1)
	end
	if (oEnemy == nil) then
		oEnemy = cpu_manager.cpu_player:FindFirstEnemy(vPos, iMaxRange, 1)
	end
	if (oEnemy == nil or not oEnemy:IsValid() or oEnemy:IsInfiltrating()) then
		return false
	end
	return self:DoFocusSquad(oEnemy)
end
--Larkin edit (Apr14, 2008)
function Tactic:IsMoving()
    local bMoveState = (self.squad_ai:IsInStateMove() or self.squad_ai:IsCapturing())
    local bAttackMoveState = (self.squad_ai:IsInStateAttackMove() and distance_sqr(self.m_vLastPosition, self.m_vCurrentPosition) > sqr(4))
    return (bMoveState or bAttackMoveState)
end

--? @shortdesc stay in the same state, but use a new state function (a substate)
--? @args function state_function
--? @result void
function Tactic:SetSubState( state_function, sub_state_name )

	dbAssert( state_function ~= nil )
	
	self.prev_sub_state = self.state_function
	self.prev_sub_state_name = self.sub_state_name
	
	self.state_function = state_function
	self.sub_state_name = sub_state_name

end

function Tactic:GetSubState()
	return self.state_function, self.sub_state_name
end

function Tactic:GetPrevSubState()
	
	return self.prev_sub_state, self.prev_sub_state_name
	
end

--? @shortdesc change the current state of the tactic and enter the starting state function 
--? @extdesc will use IdleState if no appropriate beginning state function exists \n
--? available states: \n
--? Tactic.States.Idle \n
--? Tactic.States.Attack \n
--? Tactic.States.Hold \n
--? @args Tactic.State state
--? @result void
function Tactic:SetState( state )

	dbAssert( state ~= nil )
		
	-- We are in substate, therefore only replace previous state with new one 
	if self.stateID ~= Tactic.StateID.NoState then
	
		--if you don't have a function for this, use idle state
		if( self.state_function_map[ state ] == nil ) then
			self.prev_sub_state = Tactic.IdleState
		else
			self.prev_sub_state = self.state_function_map[ state ]
		end
		self.prev_sub_state_name = state
		self.m_iMoveDelay = 0
		return
	end
		
	self.state = state
	
	--if you don't have a function for this, use idle state
	if( self.state_function_map[ state ] == nil ) then
		self.state_function = Tactic.IdleState
	else
		self.state_function = self.state_function_map[ state ]
	end
	
	--reset
	self.sub_state_name = "Initialized"
	self.prev_sub_state_name = "Initialized"
	self.prev_sub_state = nil
	self.m_iMoveDelay = 0
end

--? @shortdesc assign the starting function to use when this tactic enters a state
--? @args 
--? @result Tactic.State state
function Tactic:GetState()
	return self.state
end

--? @shortdesc assign the starting function to use when this tactic enters a state
--? @args Tactic.State state, function state_func
--? @result void
function Tactic:AssignStateFunction( state, state_func )
	
	dbAssert( state_func ~= nil )
	self.state_function_map[ state ] = state_func
	
end

--? @shortdesc state used when the tactic is not locked
--? @args 
--? @result void
function Tactic:IdleState()

end

--? @shortdesc state used when a designer locks a resource
--? @args 
--? @result void
function Tactic:StartDisabledState()

	if self.squad_ai ~= nil and self.squad_ai:IsValid() then
		self.squad_ai:DoStop()
	end
	self:SetSubState( Tactic.DisabledState )
end

--? @shortdesc state used when the tactic should not do anything
--? @args 
--? @result void
function Tactic:DisabledState()
	
end

--? @shortdesc set a target for the tactic. This target is a variant, so it may be of different types depending on the current state
--? @extdesc available variants: \n
--? Tactic.Variant.Vector \n
--? Tactic.Variant.SquadAI \n
--? @args Variant target
--? @result void
function Tactic:SetTarget( target, variant_type )

	if (g_iGMT < self.last_jump + 15 and self.target ~= nil and not self.squad_ai:IsRanged()) then
		return
	end
	self.variant_type = variant_type
	self.target = Vector3f(target)
	-- self.m_iMoveDelay = 0
end

function Tactic:UpdateStance()

	-- Check if I have setup time
	if self.squad_ai:HasSetupTime() and self.squad_ai:IsRanged() then
		if self.squad_ai:GetStance() ~= SquadAI.STANCE_StandGround then
			self.squad_ai:DoSetStance( SquadAI.STANCE_StandGround )
		end
	elseif self.squad_ai:GetStance() ~= SquadAI.STANCE_Hold then
		self.squad_ai:DoSetStance( SquadAI.STANCE_Hold )
	end
end

-- Soft capturer pack: cheapest infantry — prefer safe caps, no weapon upgrades
function Tactic:IsDedicatedCapturer()

	if (self.squad_ai == nil or not self.squad_ai:IsValid()) then
		return false
	end
	if (cpu_manager == nil) then
		return false
	end
	cpu_manager:EnsureDedicatedCapturer()
	return cpu_manager:IsDedicatedCapturerId(self.squad_ai:GetID())
end

-- Solo harass run (early window + assigned harass target)
function Tactic:IsActivelyHarassing()

	if (self.vHarassingTargetAttack == nil) then
		return false
	end
	if (DefendChokePointPlan == nil or DefendChokePointPlan.HarassingTime == nil) then
		return false
	end
	return (g_iGMT < DefendChokePointPlan.HarassingTime * 60)
end

-- Soft/harass fighting with the blob (not solo)
function Tactic:IsFightingAlongsideArmy()

	if (self.squad_ai == nil or not self.squad_ai:IsValid()) then
		return false
	end
	local vPos = self.squad_ai:GetPosition()
	local iEnemy, iAllied = cpu_manager:GetArmyStrengthAtPos(vPos, 70, true)
	local iSelf = cpu_manager:GetUnitStrength(self.squad_ai)
	if (iSelf == nil or iSelf < 1) then
		iSelf = 1
	end
	return (iAllied >= iSelf * 2.5)
end

-- Soft on cap duty: never upgrade. Soft/harass alone: never. With main army: allow.
function Tactic:ShouldBlockSoftOrHarassUpgrade()

	if (self:IsSoftCapturerOnCaptureDuty()) then
		return true
	end
	if (self:IsDedicatedCapturer() or self:IsActivelyHarassing()) then
		return (not self:IsFightingAlongsideArmy())
	end
	return false
end

-- Soft / dedicated capturer / solo harass / self-cap expand role
function Tactic:IsSoftOrHarassExpandRole()

	if (self:IsSoftCapturerOnCaptureDuty() or self:IsDedicatedCapturer() or
		self:IsActivelyHarassing() or self:IsCapturePlanMove() or self:IsSoftSelfCap()) then
		return true
	end
	return false
end

-- Cheap troopers under fire / broken: reinforce(false) even mid-cap / no morale
-- (DoReinforce may cancel capture — better than losing the squad)
function Tactic:TrySoftHarassCombatTrooperTopUp()

	if (self.squad_ai == nil or not self.squad_ai:IsValid() or self.squad_ai:IsReinforcing()) then
		return false
	end
	if (not self:IsSoftOrHarassExpandRole()) then
		return false
	end
	local bPressure = (self.squad_ai:IsUnderAttack() or self.squad_ai:IsInCombat() or
		self.squad_ai:WasRecentlyHurt() or
		(self:IsAffectedByMorale() and self.squad_ai:IsBroken()))
	if (not bPressure) then
		return false
	end
	if (self.squad_ai:CanReinforce(false, 0)) then
		self.squad_ai:DoReinforce(false, 0)
		return true
	end
	return false
end

-- Orks: keep race-tactic Reinforce (critical_num etc.) — skip shared trooper-first.
function Tactic.IsOrkPlayer()

	if (cpu_manager == nil or cpu_manager.player_stats == nil) then
		return false
	end
	return (cpu_manager.player_stats:GetPlayerRaceName() == "ork_race")
end

-- Troopers first, then leader. Orks excluded (return false — use race tactics / legacy).
function Tactic.DoReinforcePreferTroopers(oSquad)

	if (oSquad == nil or not oSquad:IsValid() or oSquad:IsReinforcing()) then
		return false
	end
	if (Tactic.IsOrkPlayer()) then
		return false
	end
	if (oSquad:CanReinforce(false, 0)) then
		oSquad:DoReinforce(false, 0)
		return true
	end
	if (oSquad:CanReinforce(true, 0)) then
		oSquad:DoReinforce(true, 0)
		return true
	end
	return false
end

function Tactic:TryDoReinforce()

	if (Tactic.IsOrkPlayer()) then
		-- Legacy shared top-up only; Slugga/Shoota/etc. own Update-path Reinforce
		if (self.squad_ai == nil or not self.squad_ai:IsValid() or self.squad_ai:IsReinforcing()) then
			return false
		end
		if (self.squad_ai:CanReinforce(true, 0)) then
			self.squad_ai:DoReinforce(true, 0)
			return true
		end
		if (self.squad_ai:CanReinforce(false, 0)) then
			self.squad_ai:DoReinforce(false, 0)
			return true
		end
		return false
	end
	return Tactic.DoReinforcePreferTroopers(self.squad_ai)
end

-- Soft busy capping (plan or self-cap). Idle soft → help army (no AFK reserve deadlock).
function Tactic:IsSoftCapturerOnCaptureDuty()

	if (not self:IsDedicatedCapturer()) then
		return false
	end
	if (self:IsCapturePlanMove()) then
		return true
	end
	if (self.squad_ai:IsCapturing()) then
		return true
	end
	if (self.m_bSoftSelfCap == true) then
		return true
	end
	return false
end

function Tactic:SetSoftSelfCap( bValue )
	self.m_bSoftSelfCap = (bValue == true)
end

function Tactic:IsSoftSelfCap()
	return (self.m_bSoftSelfCap == true)
end

-- Default troopers can attack; idle soft help when no safe caps
function Tactic:IsAttacker()

	if (self:IsSoftCapturerOnCaptureDuty()) then
		return false
	end
	return true
end

function Tactic:SetCapturePlanMove( bValue )
	self.m_bCapturePlanMove = bValue
end

function Tactic:IsCapturePlanMove()
	return (self.m_bCapturePlanMove == true)
end

function Tactic:SetCaptureGuardMove( bValue, bAttack )
	self.m_bCaptureGuardMove = bValue
	if (bValue) then
		self.m_bCaptureGuardAttack = (bAttack == true)
	else
		self.m_bCaptureGuardAttack = false
	end
end

function Tactic:IsCaptureGuardMove()
	return (self.m_bCaptureGuardMove == true)
end

function Tactic:IsCaptureGuardAttack()
	return (self.m_bCaptureGuardAttack == true)
end

function Tactic:CanCaptureGuard()

	if (self.squad_ai == nil or not self.squad_ai:IsValid()) then
		return false
	end
	if (self.squad_ai:IsEngineer()) then
		return false
	end
	-- Dedicated capturer stays free for CapturePlan (not escort)
	if (self:IsDedicatedCapturer()) then
		return false
	end
	-- Capturer duty / lock outranks stale escort flag
	if (self:IsCapturePlanMove() or self.squad_ai:IsLocked()) then
		return false
	end
	if (self:IsCaptureGuardMove()) then
		return true
	end
	if (self:IsInEmergencySubState() or self:ShouldRetreatToBase()) then
		return false
	end
	if (self.squad_ai:IsCapturing()) then
		return false
	end
	return true
end

function Tactic:IsDefender()

	if (self:IsSoftCapturerOnCaptureDuty()) then
		return false
	end
	-- Soft pack: expand empty points instead of AFK in Defend at HQ
	-- (still defend when base is under real pressure)
	if (self:IsDedicatedCapturer() and CapturePlan ~= nil and
		CapturePlan.HasSafeEmptyCaptureTarget ~= nil and CapturePlan:HasSafeEmptyCaptureTarget() and
		self.squad_ai ~= nil and self.squad_ai:IsValid() and
		not self.squad_ai:IsUnderAttack() and not self.squad_ai:WasRecentlyHurt() and
		self.squad_ai:GetHealthPercentage() >= 0.5 and
		cpu_manager:GetCriticalThreat() <= 0 and not cpu_manager:HQThreat()) then
		return false
	end
	return true
end

-- Race/tactic gate for DefendChokePointPlan army harass push (not the leader)
function Tactic:CanJoinArmyHarass()

	return true
end

-- Default: only InfantryTactic sets m_bCommander / overrides this
function Tactic:IsCommander()
	return false
end

-- Solo attach heroes (commissar/priest…): Defend/Response must not issue Attack/Hold
-- Combat commanders (Force Commander, Librarian…) stay false — they fight unattached
function Tactic:IsSoloAttachCommander()
	return false
end

function Tactic:IsCommanderAttacker()

	-- Check if we are attacking
	if (self.squad_ai:IsLocked()) then
	
		-- Retreat if almost dead and not part of a large army
		if (self.squad_ai:GetHealthPercentage() < 0.3) then
			return false
		end
	else
		-- Don't join attacks if severly hurt
		if (self.squad_ai:GetHealthPercentage() < 0.2) then
			return false
		end
	end
	return true
end

function Tactic:IsCommanderDefender()
	
	-- Check HQ threat
	if (cpu_manager:GetCriticalThreat() > 0) then
		return true
	end
	return self:IsCommanderAttacker()
end

function Tactic:TryAttachSquad(melee, match_stance, radius, min_strength, health, oUserFilter)

   local attach_to = nil
   local bInfiltrator = self.squad_ai:IsInfiltrating()

   -- AvoidDeath / retreat: don't walk back to hosts at the fight (Attack↔attach yo-yo)
   if (self:IsInEmergencySubState() or self:ShouldRetreatToBase()) then
      return nil
   end

   if not self.squad_ai:IsBroken() and (health == nil or self.squad_ai:GetHealthPercentage() < health) then

      -- minimum strength default
      if min_strength == nil then
         min_strength = 160 + (cpu_manager:GetTierLevel() - 1) * 40
      end

      -- ??????? range-?????? + ????? ?????????????????, ???? ????
      local range_filter = function(squad_ai)
         local oTactic = squad_ai:GetTactic()
         local ok = squad_ai:IsRanged() and not squad_ai:IsBroken() and not squad_ai:IsCapturing() and
                    (oTactic:GetUnitStrength() >= min_strength) and self.squad_ai:CanAttachTo(squad_ai) and
                    not oTactic:IsInSubState() and (not squad_ai:IsInfiltrating() or bInfiltrator) and oTactic:IsAttacker()
         if not ok then return false end
         if type(oUserFilter) == "function" then
            return oUserFilter(squad_ai)
         end
         return true
      end

      -- ??????? melee-?????? + ????? ?????????????????, ???? ????
      local melee_filter = function(squad_ai)
         local oTactic = squad_ai:GetTactic()
         local ok = (not squad_ai:IsRanged()) and not squad_ai:IsBroken() and not squad_ai:IsCapturing() and
                    (oTactic:GetUnitStrength() >= min_strength) and self.squad_ai:CanAttachTo(squad_ai) and
                    not oTactic:IsInSubState() and (not squad_ai:IsInfiltrating() or bInfiltrator) and oTactic:IsAttacker()
         if not ok then return false end
         if type(oUserFilter) == "function" then
            return oUserFilter(squad_ai)
         end
         return true
      end

      -- attach logic (??????????? ??????, ?? attach_to ???????? ??????)
      if not melee then
         attach_to = cpu_manager:GetClosestSquad(self.squad_ai:GetPosition(), radius, range_filter)
         if attach_to == nil and not match_stance then
            attach_to = cpu_manager:GetClosestSquad(self.squad_ai:GetPosition(), radius, melee_filter)
         end

         if attach_to ~= nil then
            self:DoMoveAttach(attach_to)
            if match_stance then
               attach_to:DoSetMeleeStance(SquadAI.MSTANCE_Ranged)
            end
         end

      else
         attach_to = cpu_manager:GetClosestSquad(self.squad_ai:GetPosition(), radius, melee_filter)
         if attach_to == nil and not match_stance then
            attach_to = cpu_manager:GetClosestSquad(self.squad_ai:GetPosition(), radius, range_filter)
         end

         if attach_to ~= nil then
            self:DoMoveAttach(attach_to)
            if match_stance then
               attach_to:DoSetMeleeStance(SquadAI.MSTANCE_Assault)
            end
         end
      end
   end

   return attach_to
end


function Tactic:TryAttachSquadMelee()

   --if I'm in combat
   local bInfiltrator = self.squad_ai:IsInfiltrating()
   if not self.squad_ai:IsBroken() and self.squad_ai:IsInCombat() then
	  
	  if self.squad_ai:GetHealthPercentage() < 0.3 then
		 
		 local attachable_filter = function( squad_ai )
		 	local oTactic = squad_ai:GetTactic()
		    return not squad_ai:IsBroken() and not squad_ai:IsCapturing() and self.squad_ai:CanAttachTo(squad_ai) and
				   not oTactic:IsInSubState() and (not squad_ai:IsInfiltrating() or bInfiltrator) and oTactic:IsAttacker()
		 end
		 
		 --find close by squads
		 local attach_to = cpu_manager:GetClosestSquad( self.squad_ai:GetPosition(), 10, attachable_filter )
		 if attach_to ~= nil then
			self.squad_ai:DoAttachSquad( attach_to )
			attach_to:DoSetMeleeStance( SquadAI.MSTANCE_Assault )
		 end
		 
	  else
		 
		 local melee_filter = function( squad_ai )
		 	local oTactic = squad_ai:GetTactic()
	        return not squad_ai:IsRanged() and not squad_ai:IsBroken() and not squad_ai:IsCapturing() and
	        	   self.squad_ai:CanAttachTo(squad_ai) and not oTactic:IsInSubState() and
	        	   (not squad_ai:IsInfiltrating() or bInfiltrator) and oTactic:IsAttacker()
		 end
		 
		 local attach_to = cpu_manager:GetClosestSquad( self.squad_ai:GetPosition(), 10, melee_filter )
		 if attach_to ~= nil then 			
			self.squad_ai:DoAttachSquad( attach_to )
			attach_to:DoSetMeleeStance( SquadAI.MSTANCE_Assault )
		 end
	  end	  
   end
end

function Tactic:ClearCommanderAttachPursuit()

	self.m_iCommanderAttachTargetId = nil
	self.m_bCommanderAttachInterrupted = false
	self.m_vCommanderAttachLastHostPos = nil
	self.m_vCommanderAttachWaypoint = nil
end

function Tactic:IsCommanderAttachHostBanned(iHostId)

	if (iHostId == nil or self.m_mCommanderAttachBanUntil == nil) then
		return false
	end
	local fUntil = self.m_mCommanderAttachBanUntil[iHostId]
	if (fUntil == nil) then
		return false
	end
	if (g_iGMT >= fUntil) then
		self.m_mCommanderAttachBanUntil[iHostId] = nil
		return false
	end
	return true
end

function Tactic:BanCommanderAttachHost(iHostId, fSeconds)

	if (iHostId == nil) then
		return
	end
	if (self.m_mCommanderAttachBanUntil == nil) then
		self.m_mCommanderAttachBanUntil = {}
	end
	if (fSeconds == nil) then
		fSeconds = 10
	end
	self.m_mCommanderAttachBanUntil[iHostId] = g_iGMT + fSeconds
end

-- Threat on corridor only (host endpoint may be fighting — that is OK)
function Tactic:IsCommanderAttachPathSafe(vFrom, vTo, iLane)

	if (vFrom == nil or vTo == nil) then
		return true
	end
	if (iLane == nil) then
		iLane = 26
	end
	local fDist = distance(vFrom, vTo)
	if (fDist < 30) then
		return true
	end

	local iSteps = math.floor(fDist / 15) + 1
	if (iSteps > 8) then
		iSteps = 8
	end
	for iStep = 1, iSteps - 1 do
		local fT = iStep / iSteps
		if (fT > 0.12 and fT < 0.88) then
			local vSample = Vector3f(vFrom)
			vSample.x = vFrom.x + (vTo.x - vFrom.x) * fT
			vSample.z = vFrom.z + (vTo.z - vFrom.z) * fT
			if (cpu_manager.terrain_analyzer:HasThreat(vSample, iLane)) then
				return false
			end
			if (self:PointNearEnemyBuilding(vSample, nil, nil, iLane)) then
				return false
			end
		end
	end

	if (cpu_manager.m_aEnemyUnits ~= nil) then
		for iLoop1 in cpu_manager.m_aEnemyUnits do
			local vEnemyPos = cpu_manager.m_aEnemyUnits[iLoop1][1]
			if (distance_sqr(vEnemyPos, vTo) > sqr(40) and
				self:PointNearSegment(vEnemyPos, vFrom, vTo, iLane)) then
				return false
			end
		end
	end
	return true
end

-- Lateral detour around a dirty corridor toward host
function Tactic:FindCommanderAttachDetour(vFrom, vHost)

	if (vFrom == nil or vHost == nil) then
		return nil
	end
	local fDx = vHost.x - vFrom.x
	local fDz = vHost.z - vFrom.z
	local fLen = math.sqrt(fDx * fDx + fDz * fDz)
	if (fLen < 35) then
		return nil
	end
	local fOx = -fDz / fLen
	local fOz = fDx / fLen
	local aOffsets = { 45, -45, 70, -70, 95, -95 }
	local aFracs = { 0.45, 0.6, 0.35 }

	for iFrac in aFracs do
		local fT = aFracs[iFrac]
		local vMid = Vector3f(vFrom)
		vMid.x = vFrom.x + fDx * fT
		vMid.z = vFrom.z + fDz * fT
		for iOff in aOffsets do
			local fOff = aOffsets[iOff]
			local vWp = Vector3f(vMid)
			vWp.x = vMid.x + fOx * fOff
			vWp.z = vMid.z + fOz * fOff
			if (cpu_manager:IsPosOnMap(vWp) and
				not cpu_manager.terrain_analyzer:HasThreat(vWp, 22) and
				self:IsCommanderAttachPathSafe(vFrom, vWp, 24) and
				self:IsCommanderAttachPathSafe(vWp, vHost, 24)) then
				return vWp
			end
		end
	end
	return nil
end

-- Prefer safe path, then closer. Skips temporarily banned hosts.
function Tactic:FindClosestAttachHost(oUserFilter, iMaxRadius)

	local vPos = self.squad_ai:GetPosition()
	local iMaxSqr = sqr(iMaxRadius or 2000)
	local oBestSafe = nil
	local iBestSafeDist = nil
	local oBestAny = nil
	local iBestAnyDist = nil

	for oSquad in military_manager:GetSquads() do
		local bOk = true
		if (type(oUserFilter) == "function") then
			bOk = oUserFilter(oSquad)
		end
		if (bOk and not self:IsCommanderAttachHostBanned(oSquad:GetID())) then
			local vHostPos = oSquad:GetPosition()
			local iDist = distance_sqr(vPos, vHostPos)
			if (iDist <= iMaxSqr) then
				if (oBestAny == nil or iDist < iBestAnyDist) then
					oBestAny = oSquad
					iBestAnyDist = iDist
				end
				if (self:IsCommanderAttachPathSafe(vPos, vHostPos, 26)) then
					if (oBestSafe == nil or iDist < iBestSafeDist) then
						oBestSafe = oSquad
						iBestSafeDist = iDist
					end
				end
			end
		end
	end
	if (oBestSafe ~= nil) then
		return oBestSafe
	end
	return oBestAny
end

-- true = идём к хосту / отходим от контакта; caller не должен звать InfantryTactic.Update
function Tactic:PursueCommanderAttach(oTarget, sMoveMsg, fAttachRange)

	if (oTarget == nil or not oTarget:IsValid()) then
		self:ClearCommanderAttachPursuit()
		return false
	end

	if (self.squad_ai:IsAttached()) then
		self:ClearCommanderAttachPursuit()
		return false
	end

	if (fAttachRange == nil) then
		fAttachRange = 20
	end
	if (sMoveMsg == nil) then
		sMoveMsg = "CommanderAttach"
	end

	local iHostId = oTarget:GetID()
	if (self:IsCommanderAttachHostBanned(iHostId)) then
		self:ClearCommanderAttachPursuit()
		return false
	end

	-- Contact on the way: peel, ban this host briefly, let caller pick another
	local bContact = (self.squad_ai:IsUnderAttack() or self.squad_ai:WasRecentlyHurt())
	if (bContact) then
		self:BanCommanderAttachHost(iHostId, 12)
		self:ClearCommanderAttachPursuit()
		self.m_iCommanderAttachBailUntil = g_iGMT + 4
		self:MoveToDisengage()
		self:InitAbilities()
		self:DoAbilities()
		return true
	end

	-- Short peel window after contact before re-commit
	if (self.m_iCommanderAttachBailUntil ~= nil and g_iGMT < self.m_iCommanderAttachBailUntil) then
		local vPos = self.squad_ai:GetPosition()
		if (cpu_manager.terrain_analyzer:HasThreat(vPos, 28)) then
			self:MoveToDisengage()
			self:InitAbilities()
			self:DoAbilities()
			return true
		end
		self.m_iCommanderAttachBailUntil = 0
	end

	self.m_iCommanderAttachTargetId = iHostId
	local vMyPos = self.squad_ai:GetPosition()
	local vHostPos = oTarget:GetPosition()
	local iDistSqr = distance_sqr(vMyPos, vHostPos)

	if (iDistSqr <= sqr(fAttachRange)) then
		self.squad_ai:DoAttachSquad(oTarget)
		self:ClearCommanderAttachPursuit()
		return false
	end

	if (self.m_bCommanderAttachInterrupted) then
		self.m_bCommanderAttachInterrupted = false
	end

	local vMoveTo = vHostPos
	local bPathSafe = self:IsCommanderAttachPathSafe(vMyPos, vHostPos, 26)
	if (not bPathSafe) then
		local vWp = self.m_vCommanderAttachWaypoint
		if (vWp ~= nil) then
			if (distance_sqr(vMyPos, vWp) < sqr(18) or
				not self:IsCommanderAttachPathSafe(vMyPos, vWp, 24)) then
				self.m_vCommanderAttachWaypoint = nil
				vWp = nil
			end
		end
		if (vWp == nil) then
			vWp = self:FindCommanderAttachDetour(vMyPos, vHostPos)
			self.m_vCommanderAttachWaypoint = vWp
		end
		if (vWp ~= nil) then
			vMoveTo = vWp
		else
			-- No detour: try another host next tick
			self:BanCommanderAttachHost(iHostId, 8)
			self:ClearCommanderAttachPursuit()
			return false
		end
	else
		self.m_vCommanderAttachWaypoint = nil
	end

	local bResendMove = true
	if (self:IsMoving() and self.m_vCommanderAttachLastHostPos ~= nil) then
		if (distance_sqr(self.m_vCommanderAttachLastHostPos, vMoveTo) < sqr(15)) then
			bResendMove = false
		end
	end

	if (bResendMove and g_iGMT >= self.m_iMoveDelay + 3) then
		cpu_manager:DoMove(self.squad_ai, vMoveTo, false, sMoveMsg)
		self.m_iMoveDelay = g_iGMT
		self.m_vCommanderAttachLastHostPos = Vector3f(vMoveTo)
	end

	self:InitAbilities()
	self:DoAbilities()
	return true
end

--used for lower difficulty settings: some special units (such as bloodthirster) 
--should always be in the attacking force if created
function Tactic:IsDaemonRelicUnit()

	if (self.squad_ai == nil or not self.squad_ai:IsValid()) then
		return false
	end
	return BaseTactic:IsDaemonRelicSquadName( self.squad_ai:GetSquadName() )
end

-- Legacy: peel-at-30% removed — daemon/relic fight to the end (short ranged dance only)
Tactic.DaemonRelicCriticalHP = 0.3

function Tactic:IsDaemonRelicCriticallyDamaged()

	return false
end

function Tactic:AlwaysAttack()
	return false
end

-- Arkhan 11.2005: Try to jump into combat
function Tactic:JumpAttack()

	-- Overwhelm: skip jump-assist scans (GetArmyStrength / jump-target loops)
	if (self:IsOverwhelmSpamMode()) then
		return false
	end

	-- Don't jump if I can't jump
	if (not self.squad_ai:CanJump()) then
		return false
	end

	-- Scan cadence (same as JumpAssist) — last_jump still gates actual jumps
	if (g_iGMT < (self.m_iLastJumpAttackCheck or 0) + 2.5) then
		return false
	end
	self.m_iLastJumpAttackCheck = g_iGMT
	
	-- No double jump within 15 secs
	if (g_iGMT < self.last_jump + 15) then
		return false
	end

	-- No jump if we are in substate
	if (self:IsInSubState()) then
		return false
	end

	-- Check if the squad is ranged
	if (self.squad_ai:IsRanged()) then
		return self:JumpAttackRanged()
	end
	return self:JumpAttackMelee()
end

-- Arkhan 11.2005: Reworked to get a more cooperative attack behaviour
-- Try jumping into battle and engage the ranged guys
function Tactic:JumpAttackRanged()

	-- Allow jumps only to reach a target position
	if (self.target == nil) then
		return false
	end
	
	-- Init long and short jumps
	local iLongJumpDistance = self.squad_ai:GetJumpDistance()
	local iShortJumpDistance = 50
	local iTargetRange = 35

	-- Get positions
	local vMyPos = self.squad_ai:GetPosition()
	local vTargetPosition = self.target
	local bUnderAttack = self.squad_ai:IsUnderAttack()
	
	-- Check for threats
	if (not bUnderAttack and not cpu_manager:CloseEnemyUnits(vMyPos, iTargetRange)) then
		return false
	end
	
	-- Check my situation
	local iMyStrength = self:GetUnitStrength()
	local iEnemyPower, iMyPower = cpu_manager:GetArmyStrengthAtPos(vMyPos, iTargetRange, true)
	
	-- Don't jump if there's no threat at the target and we are not under attack
	if (iEnemyPower <= 0 and not bUnderAttack) then
		return false
	end
	
	-- Don't jump attack, if the enemy is much stronger in the target area
	local iTargetEnemyPower, iTargetAllyPower = cpu_manager:GetArmyStrengthAtPos(vTargetPosition, iTargetRange, true)
	if (distance_sqr(vTargetPosition, vMyPos) < sqr(iShortJumpDistance)) then
	
		-- In case of short jumps, use the local allied power for comparison and don't jump in combat
		if (2 * iTargetEnemyPower > 3 * math.max(iTargetAllyPower, iMyPower) or self.squad_ai:IsInCombat()) then
			return false
		end
	else
	
		-- In case of long jumps, use only unit strength for comparison and jump even out of combat
		if (2 * iTargetEnemyPower > 3 * (iTargetAllyPower + iMyStrength)) then
			return false
		end
	end
	
	-- Try to jump in target range (5 tries)
	local iMinRange = sqr(iShortJumpDistance)
	local iMaxRange = sqr(iLongJumpDistance)
	for iLoop1 = 1, 5 do
	
		-- Create a jump position
		local vJumpPosition = vTargetPosition
		vJumpPosition.x = vJumpPosition.x + math.random(-15, 15)
		vJumpPosition.z = vJumpPosition.z + math.random(-15, 15)
			
		-- Check if target position is in range
		local iDistance = distance_sqr(vJumpPosition, vMyPos)
		if (iDistance <= iMaxRange and iDistance > iMinRange) then
			
			-- Check if unit is able to jump to position
			if (self.squad_ai:CanJumpToPosition(vJumpPosition) and cpu_manager.terrain_analyzer:GetPathingDistance(vMyPos, vJumpPosition) >= 0) then
			
				-- Check for close enemies
				if (not cpu_manager.terrain_analyzer:HasThreat(vJumpPosition, 20)) then
								
					-- Jump to position
					self.squad_ai:DoJump(vJumpPosition)
					self.last_jump = g_iGMT
					self.m_iLastGatherMove = self.last_jump - 10
					return true
				end
			end
		end
	end
	return false
end

-- Arkhan 11.2005: Reworked to get a more cooperative attack behaviour
-- Try jumping into battle and engage the ranged guys
function Tactic:JumpAttackMelee()

	-- Need a target anchor (assist AFK fights is InfantryTactic:TryJumpAssistFight)
	if (self.target == nil) then
		return false
	end

	local vMyPos = self.squad_ai:GetPosition()
	if (vMyPos == nil) then
		return false
	end

	local iLongJumpDistance = self.squad_ai:GetJumpDistance()
	if (iLongJumpDistance == nil or iLongJumpDistance < 25) then
		return false
	end
	-- In-game jump ranges top out ~70; don't search farther
	if (iLongJumpDistance > 70) then
		iLongJumpDistance = 70
	end

	-- Cheap gates before GetArmyStrength / jump-target loops
	if (not cpu_manager:CloseEnemyUnits(vMyPos, iLongJumpDistance)) then
		return false
	end
	if (cpu_manager.cpu_player:FindFirstEnemy(vMyPos, iLongJumpDistance, 1) == nil) then
		return false
	end

	-- Check situation
	local iMyStrength = self:GetUnitStrength()
	local iTargetRange = 35
	local iShortJumpDistance = 50
	local iDistanceToTarget = distance_sqr(vMyPos, self.target)
	local iEnemyPower, iMyPower = cpu_manager:GetArmyStrengthAtPos(vMyPos, iTargetRange, true)
	local iTargetEnemyPower, iTargetAllyPower = cpu_manager:GetArmyStrengthAtPos(self.target, iTargetRange, true)
	
	-- Init long and short jump distances
	local iMinRange = sqr(iShortJumpDistance)
	local iMaxRange = sqr(iLongJumpDistance)
	if (iDistanceToTarget < sqr(iShortJumpDistance)) then
	
		-- Check short jumps
		if (not self.squad_ai:IsInCombat() or self:IsMoving()) then
			return false
		end
		-- Don't leap deeper into a losing local fight (then jump-flee)
		-- iMyPower already includes this squad at current pos
		if (iEnemyPower > iMyPower) then
			return false
		end
		iMinRange = sqr(25)
		iMaxRange = sqr(iShortJumpDistance)
	else
	
		-- Long jumps: only if equal/stronger at landing (was 2x — leap into bad fights then flee)
		if (iTargetEnemyPower > (iTargetAllyPower + iMyStrength)) then
			return false
		end
	end
	
	-- Check for close units
	local oVictim = nil
	local iMinStrength = 0
	-- Already verified an enemy exists within jump range above
	local aJumpTargets = cpu_manager:GetJumpTargets()
		
	-- Check all enemy units
	for iLoop1 in aJumpTargets do
					
		-- Check distance and unit strength
		local iDistance = distance_sqr(vMyPos, aJumpTargets[iLoop1][2])
		if (iDistance > iMinRange and iDistance < iMaxRange and aJumpTargets[iLoop1][3] > iMinStrength) then

			-- Check distance to target position
			if (distance_sqr(self.target, aJumpTargets[iLoop1][2]) < sqr(iTargetRange)) then

				-- Re-check landing zone: don't pick a blob we'd immediately flee from
				local iLandEnemy, iLandAlly = cpu_manager:GetArmyStrengthAtPos(aJumpTargets[iLoop1][2], iTargetRange, true)
				if (iLandEnemy <= (iLandAlly + iMyStrength)) then
					iMinStrength = aJumpTargets[iLoop1][3]
					oVictim = aJumpTargets[iLoop1][1]
				end
			end
		end
	end
	
	-- Check strategic points with long jumps
	if (oVictim == nil and iMaxRange > sqr(iShortJumpDistance)) then
	
		-- Get closest strategic point in range of the target position
		local oStrategicPoint = resource_manager:FindFirstStrategicPoint(self.target, 35)
		if (oStrategicPoint ~= nil and not cpu_manager:IsFriendly(oStrategicPoint:Owner())) then
		
			-- Don't jump attack if strat is outside jump range
			local vStratPos = oStrategicPoint:GetPosition()
			local iDistance = distance_sqr(vMyPos, vStratPos)
			if (iDistance < iMaxRange and iDistance > iMinRange) then
				
				-- Don't jump attack, if the enemy is stronger in this area
				local iStratEnemyPower, iStratAllyPower = cpu_manager:GetArmyStrengthAtPos(vStratPos, iTargetRange, true)
				if (iStratEnemyPower <= iStratAllyPower + iMyStrength) then
					oVictim = oStrategicPoint:GetEntity()
				end
			end
		end
	end
	
	-- Leave, if no victim was found
	if (oVictim == nil) then
		return false
	end
	
	-- Get enemy position
	local vEnemyPos = oVictim:GetPosition()
		
	-- Now make the jump attack
	if (self:CanJumpAttached()) then
	  
		-- Try to grab some nearby melee dudes to help unit
		local attach_to = self:TryAttachSquad(true, true, 10, 200, nil)
		if (attach_to ~= nil and attach_to:CanJumpToPosition(vEnemyPos)) then
			attach_to:DoJump(vEnemyPos)
		else
			self.squad_ai:DoJump(vEnemyPos)
		end
	else
		self.squad_ai:DoJump(vEnemyPos)
	end
	
	self.target = Vector3f(vEnemyPos)
	self.last_jump = g_iGMT
	self.m_iLastGatherMove = self.last_jump - 10
	return true
end

-- Arkhan 03.2006: Virtual method used by commander which are able to jump with an attached squad
function Tactic:CanJumpAttached()
	return false
end

-- Unstable in SS because of buggy CanJumpToPosition() function!!! Don't use!
function Tactic:CompassMove( fMaxDistance )

	-- Init directions
	local fDiaDistance = fMaxDistance / math.sqrt(2)
	local aMoveDirections =
	{
		{ fMaxDistance, 0, nil, nil },
		{ fDiaDistance, fDiaDistance, nil, nil },
		{ 0, fMaxDistance, nil, nil },
		{ -fDiaDistance, fDiaDistance, nil, nil },
		{ -fMaxDistance, 0, nil, nil },
		{ -fDiaDistance, -fDiaDistance, nil, nil },
		{ 0, -fMaxDistance, nil, nil },
		{ fDiaDistance, -fDiaDistance, nil, nil }
	}
	
	-- Calculate positions and distances
	local vSquadPos = self.squad_ai:GetPosition()
	for iLoop1 in aMoveDirections do
	
		-- Create move position
		local vMovePos = Vector3f(vSquadPos)
		vMovePos.x = vMovePos.x + aMoveDirections[iLoop1][1]
		vMovePos.z = vMovePos.z + aMoveDirections[iLoop1][2]
		aMoveDirections[iLoop1][3] = Vector3f(vMovePos)
		
		-- Calculate distance to home base
		aMoveDirections[iLoop1][4] = distance_sqr(vMovePos, cpu_manager.start_pos)
	end
	
	-- Move positions in home direction first
	oLessThan = function(vDir1, vDir2) return vDir1[4] < vDir2[4] end
	table.sort(aMoveDirections, oLessThan)
	
	-- Check move positions
	for iLoop1 = 1, table.getn(aMoveDirections) do
	
		-- Check if we can jump to move position
		local vMovePos = aMoveDirections[iLoop1][3]
		if (cpu_manager:IsPosOnMap(vMovePos) and
			self.squad_ai:CanJumpToPosition(vMovePos) and
			cpu_manager.terrain_analyzer:GetPathingDistance(vSquadPos, vMovePos) >= 0) then
		
			-- Check for threat
			if (not cpu_manager.terrain_analyzer:HasThreat(vMovePos, 35)) then
				return vMovePos
			end
		end
	end
	
	-- No valid move position found
	return nil
end

function Tactic:PointNearSegment( vPoint, vFrom, vTo, iRadius )

	local vAirline = Vector3f()
	vAirline.x = vTo.x - vFrom.x
	vAirline.z = vTo.z - vFrom.z
	local iAirlineDistance = math.sqrt(vAirline.x * vAirline.x + vAirline.z * vAirline.z)
	if (iAirlineDistance < 1) then
		return distance_sqr(vPoint, vFrom) < sqr(iRadius)
	end

	local vAirlineDir = Vector3f()
	vAirlineDir.x = vAirline.x / iAirlineDistance
	vAirlineDir.z = vAirline.z / iAirlineDistance
	local vAirlineOrth = Vector3f()
	vAirlineOrth.x = -vAirlineDir.z
	vAirlineOrth.z = vAirlineDir.x

	local vDir1 = Vector3f()
	vDir1.x = vPoint.x - vFrom.x
	vDir1.z = vPoint.z - vFrom.z
	local iSide = vDir1.x * vAirlineOrth.x + vDir1.z * vAirlineOrth.z
	if (iSide >= iRadius or iSide <= -iRadius) then
		return false
	end

	local iAlong = vDir1.x * vAirlineDir.x + vDir1.z * vAirlineDir.z
	if (iAlong < 0) then
		return distance_sqr(vPoint, vFrom) < sqr(iRadius)
	end
	if (iAlong > iAirlineDistance) then
		return distance_sqr(vPoint, vTo) < sqr(iRadius)
	end
	return true
end

function Tactic:RefreshDisengageBuildingCache()

	if (g_iGMT > Tactic.DisengageCache.enemy_buildings_time) then
		Tactic.DisengageCache.enemy_buildings_time = g_iGMT + 8
		local aEnemyBuildings = {}
		for oPlayer in cpu_manager.stats:GetPlayerStats() do
			if (cpu_manager.player_stats:IsEnemy(oPlayer) and not oPlayer:IsPlayerDead()) then
				for oBuilding in oPlayer:GetBases() do
					if (oBuilding:IsValid()) then
						table.insert(aEnemyBuildings, Vector3f(oBuilding:GetPosition()))
					end
				end
			end
		end
		Tactic.DisengageCache.enemy_buildings = aEnemyBuildings
	end

	if (g_iGMT > Tactic.DisengageCache.own_buildings_time) then
		Tactic.DisengageCache.own_buildings_time = g_iGMT + 8
		local aOwnBuildings = {}
		for oBuilding in cpu_manager.player_stats:GetBases() do
			if (oBuilding:IsValid()) then
				table.insert(aOwnBuildings, Vector3f(oBuilding:GetPosition()))
			end
		end
		Tactic.DisengageCache.own_buildings = aOwnBuildings
	end
end

function Tactic:PointNearEnemyBuilding( vPoint, vFrom, vTo, iRadius )

	if (iRadius == nil) then
		iRadius = 22
	end
	self:RefreshDisengageBuildingCache()
	for iLoop1 in Tactic.DisengageCache.enemy_buildings do
		local vBuildingPos = Tactic.DisengageCache.enemy_buildings[iLoop1]
		if (vTo == nil) then
			if (distance_sqr(vPoint, vBuildingPos) < sqr(iRadius + 8)) then
				return true
			end
		elseif (self:PointNearSegment(vBuildingPos, vFrom, vTo, iRadius + 8)) then
			return true
		end
	end
	return false
end

function Tactic:TakeDisengageHeavyBudget()

	if (self.squad_ai:IsBroken()) then
		return true
	end
	if (g_iGMT > Tactic.DisengageCache.heavy_budget_time) then
		Tactic.DisengageCache.heavy_budget_time = g_iGMT
		Tactic.DisengageCache.heavy_budget = 4
	end
	if (Tactic.DisengageCache.heavy_budget > 0) then
		Tactic.DisengageCache.heavy_budget = Tactic.DisengageCache.heavy_budget - 1
		return true
	end
	return false
end

-- Surrounded / no clean corridor: least-bad of 8 dirs.
-- Safety first; among equally safe dirs prefer homeward. Never returns current pos.
function Tactic:FindBestEscapeDirection( squad_pos, fStep )

	if (Tactic.TEST_RetreatToClosestBase) then
		return self:GetHomeRetreatPos()
	end

	if (fStep == nil) then
		fStep = 35
	end

	local bDesperate = (self.stateID == Tactic.StateID.AvoidDeath or
		(self.squad_ai:GetHealthPercentage() ~= nil and self.squad_ai:GetHealthPercentage() < 0.5))
	if (bDesperate and fStep < 55) then
		fStep = 55
	end

	local vHome = self:GetHomeRetreatPos()
	local vNearestEnemy = nil
	local oEnemy = cpu_manager.cpu_player:FindFirstEnemy(squad_pos, 55, 1)
	if (oEnemy ~= nil) then
		vNearestEnemy = oEnemy:GetPosition()
	end

	local fDia = fStep / math.sqrt(2)
	local aDirs = {
		{ fStep, 0 },
		{ fDia, fDia },
		{ 0, fStep },
		{ -fDia, fDia },
		{ -fStep, 0 },
		{ -fDia, -fDia },
		{ 0, -fStep },
		{ fDia, -fDia },
	}

	local aCandidates = {}
	local iBestSafety = nil
	for iLoop1 in aDirs do
		local vCandidate = Vector3f(squad_pos)
		vCandidate.x = vCandidate.x + aDirs[iLoop1][1]
		vCandidate.z = vCandidate.z + aDirs[iLoop1][2]
		if (cpu_manager:IsPosOnMap(vCandidate) and
			not self:PointNearEnemyBuilding(vCandidate, nil, nil, 14)) then

			-- Primary: safety (higher = safer)
			local iSafety = 0
			local bHot = cpu_manager.terrain_analyzer:HasThreat(vCandidate, 18)
			if (bHot) then
				iSafety = iSafety - 100
			end
			local iBlocked = self:CountThreatBlockedDirections(vCandidate, 25, 18)
			iSafety = iSafety + (8 - iBlocked) * 10
			-- Mild bonus: farther from nearest enemy (tie-break within safety)
			if (vNearestEnemy ~= nil) then
				iSafety = iSafety + math.min(5, math.floor(distance(vCandidate, vNearestEnemy) / 15))
			end

			local iHomeDist = distance_sqr(vCandidate, vHome)
			table.insert(aCandidates, { vCandidate, iSafety, iHomeDist, bHot })
			if (iBestSafety == nil or iSafety > iBestSafety) then
				iBestSafety = iSafety
			end
		end
	end

	if (table.getn(aCandidates) <= 0) then
		return Vector3f(vHome)
	end

	-- Keep only top safety band (±5 ≈ same threat tier)
	local aSafe = {}
	for iLoop1 in aCandidates do
		if (aCandidates[iLoop1][2] >= iBestSafety - 5) then
			table.insert(aSafe, aCandidates[iLoop1])
		end
	end

	-- Among equally safe: closest to home
	table.sort(aSafe, function(oA, oB)
		if (oA[2] ~= oB[2]) then
			return oA[2] > oB[2]
		end
		return oA[3] < oB[3]
	end)

	return Vector3f(aSafe[1][1])
end

function Tactic:FindCheapDisengagePoint( squad_pos )

	if (Tactic.TEST_RetreatToClosestBase) then
		return self:GetHomeRetreatPos()
	end

	if (self:ShouldRetreatAllTheWayHome()) then
		return self:GetHomeRetreatPos()
	end

	-- Раньше брали ближайшее своё здание/точку — на пустых картах это другой конец карты
	local vLocal = self:FindLocalDisengagePoint(squad_pos, 35)
	if (vLocal ~= nil and distance_sqr(vLocal, squad_pos) > sqr(10)) then
		return vLocal
	end

	-- Здание только если реально рядом
	self:RefreshDisengageBuildingCache()
	local vBest = nil
	local iBestDist = sqr(50)
	for iLoop1 in Tactic.DisengageCache.own_buildings do
		local iDistSqr = distance_sqr(squad_pos, Tactic.DisengageCache.own_buildings[iLoop1])
		if (iDistSqr < iBestDist and iDistSqr > sqr(10)) then
			iBestDist = iDistSqr
			vBest = Tactic.DisengageCache.own_buildings[iLoop1]
		end
	end
	if (vBest ~= nil) then
		return Vector3f(vBest)
	end

	vLocal = self:FindLocalDisengagePoint(squad_pos, 25)
	if (vLocal ~= nil and distance_sqr(vLocal, squad_pos) > sqr(10)) then
		return vLocal
	end
	-- Surrounded: leave along least-bad axis (never "retreat to self").
	return self:FindBestEscapeDirection(squad_pos, 38)
end

function Tactic:NeedsRangedDisengage()

	if (self:IsOverwhelmSpamMode()) then
		return false
	end
	-- Squiggoth / Avatar / Living Saint… — no infantry chip peel (Command Squad keeps own CheckForDeath)
	if (self:IsDaemonRelicUnit()) then
		return false
	end
	-- Vehicles holding homeside/base: soak, don't soft-peel to HQ
	if (self:ShouldHoldDefenseLine()) then
		return false
	end
	if (not self.squad_ai:IsRanged() or not self.squad_ai:IsUnderAttack()) then
		return false
	end
	if (self:ShouldRetreatAllTheWayHome()) then
		return true
	end
	-- Already peeling for life: keep moving (else StandGround in fire)
	if (self.stateID == Tactic.StateID.AvoidDeath) then
		return true
	end

	local fHP = self.squad_ai:GetHealthPercentage()
	local vPos = self.squad_ai:GetPosition()
	local iScanRange = 18
	if (self.squad_ai:IsRanged()) then
		iScanRange = self:GetRangedMinDistance()
	end
	local oEnemy = cpu_manager.cpu_player:FindFirstEnemy(vPos, iScanRange, 1)

	-- Полный HP: только от ближника в лицо (рейндж-огонь впитываем)
	if (fHP >= 0.9) then
		return (oEnemy ~= nil and not oEnemy:IsRanged())
	end

	-- Половина+: ближник рядом, или недавно били и враг близко
	if (fHP >= 0.5) then
		if (oEnemy ~= nil and not oEnemy:IsRanged()) then
			return true
		end
		if (oEnemy ~= nil and self.squad_ai:WasRecentlyHurt()) then
			return true
		end
		local iEnemy, iAllied = cpu_manager:GetArmyStrengthAtPos(vPos, 40, true)
		if (iEnemy > 0 and iAllied < cpu_manager:GetRetreatRatio() * iEnemy) then
			return true
		end
		return false
	end

	-- Низкий HP + under attack: всегда peel (враг может быть дальше MinDistance)
	return true
end

function Tactic:TryCombatDisengage()
	if (self:IsOverwhelmSpamMode()) then
		return false
	end
	if (not self.squad_ai:IsRanged()) then
		return false
	end
	if (not self.squad_ai:IsUnderAttack() and not self.squad_ai:WasRecentlyHurt()) then
		return false
	end
	if (not self:NeedsRangedDisengage() and not self:ShouldRetreatToBase()) then
		return false
	end
	return self:MoveToDisengage()
end

function Tactic:IsDisengageRouteClear( vFrom, vTo, iLaneRadius )

	if (iLaneRadius == nil) then
		iLaneRadius = 22
	end

	self:RefreshDisengageBuildingCache()

	local fDist = distance(vFrom, vTo)
	if (fDist < 5) then
		return not cpu_manager.terrain_analyzer:HasThreat(vTo, iLaneRadius)
	end

	local iSteps = math.floor(fDist / 10) + 1
	if (iSteps > 6) then
		iSteps = 6
	end

	for iStep = 0, iSteps do
		local fT = iStep / iSteps
		local vSample = Vector3f(vFrom)
		vSample.x = vFrom.x + (vTo.x - vFrom.x) * fT
		vSample.z = vFrom.z + (vTo.z - vFrom.z) * fT
		if (cpu_manager.terrain_analyzer:HasThreat(vSample, iLaneRadius)) then
			return false
		end
		if (self:PointNearEnemyBuilding(vSample, nil, nil, iLaneRadius)) then
			return false
		end
	end

	local fPad = iLaneRadius + 8
	local fMinX = math.min(vFrom.x, vTo.x) - fPad
	local fMaxX = math.max(vFrom.x, vTo.x) + fPad
	local fMinZ = math.min(vFrom.z, vTo.z) - fPad
	local fMaxZ = math.max(vFrom.z, vTo.z) + fPad

	for iLoop1 in Tactic.DisengageCache.enemy_buildings do
		local vBuildingPos = Tactic.DisengageCache.enemy_buildings[iLoop1]
		if (vBuildingPos.x >= fMinX and vBuildingPos.x <= fMaxX and
			vBuildingPos.z >= fMinZ and vBuildingPos.z <= fMaxZ) then
			if (self:PointNearSegment(vBuildingPos, vFrom, vTo, iLaneRadius + 8)) then
				return false
			end
		end
	end

	if (cpu_manager.m_aEnemyUnits ~= nil) then
		for iLoop1 in cpu_manager.m_aEnemyUnits do
			if (self:PointNearSegment(cpu_manager.m_aEnemyUnits[iLoop1][1], vFrom, vTo, iLaneRadius)) then
				return false
			end
		end
	else
		for oPlayer in cpu_manager.stats:GetPlayerStats() do
			if (cpu_manager.player_stats:IsEnemy(oPlayer) and not oPlayer:IsPlayerDead()) then
				for oSquad in oPlayer:GetSquads() do
					if (oSquad:IsValid() and cpu_manager:GetUnitStrength(oSquad) > 0) then
						if (self:PointNearSegment(oSquad:GetPosition(), vFrom, vTo, iLaneRadius)) then
							return false
						end
					end
				end
			end
		end
	end

	return true
end

function Tactic:FindClosestAllyDisengagePoint( squad_pos, mind, maxd )

	local iMinSqr = mind * mind
	local iMaxSqr = maxd * maxd
	local aNear = {}

	local function ConsiderPos(vAllyPos)
		local iDistSqr = distance_sqr(vAllyPos, squad_pos)
		if (iDistSqr > iMinSqr and iDistSqr < iMaxSqr) then
			table.insert(aNear, { Vector3f(vAllyPos), iDistSqr })
		end
	end

	-- Cached unit tables instead of full GetPlayerStats/GetSquads
	for iLoop1 in cpu_manager.m_aMyUnits do
		ConsiderPos(cpu_manager.m_aMyUnits[iLoop1][1])
	end
	for iLoop1 in cpu_manager.m_aAlliedUnits do
		ConsiderPos(cpu_manager.m_aAlliedUnits[iLoop1][1])
	end

	if (table.getn(aNear) == 0) then
		return nil
	end
	table.sort(aNear, function(a, b) return a[2] < b[2] end)

	local iLimit = table.getn(aNear)
	if (iLimit > 5) then
		iLimit = 5
	end
	for iLoop1 = 1, iLimit do
		local vAllyPos = aNear[iLoop1][1]
		if (not cpu_manager.terrain_analyzer:HasThreat(vAllyPos, 35) and
			self:IsDisengageRouteClear(squad_pos, vAllyPos, 22)) then
			return vAllyPos
		end
	end
	return nil
end

function Tactic:CountThreatBlockedDirections( vPos, fStep, iRadius )

	if (iRadius == nil) then
		iRadius = 20
	end
	if (fStep == nil) then
		fStep = 25
	end

	local fDia = fStep / math.sqrt(2)
	local aDirs = {
		{ fStep, 0 },
		{ fDia, fDia },
		{ 0, fStep },
		{ -fDia, fDia },
		{ -fStep, 0 },
		{ -fDia, -fDia },
		{ 0, -fStep },
		{ fDia, -fDia },
	}

	local iBlocked = 0
	for iLoop1 in aDirs do
		local vTest = Vector3f(vPos)
		vTest.x = vTest.x + aDirs[iLoop1][1]
		vTest.z = vTest.z + aDirs[iLoop1][2]
		if (not cpu_manager:IsPosOnMap(vTest) or
			cpu_manager.terrain_analyzer:HasThreat(vTest, iRadius) or
			self:PointNearEnemyBuilding(vTest, nil, nil, iRadius)) then
			iBlocked = iBlocked + 1
		end
	end
	return iBlocked
end

function Tactic:FindFriendlyBuildingDisengagePoint( squad_pos, mind, maxd, bRequireClearRoute )

	self:RefreshDisengageBuildingCache()

	local aNear = {}
	local iMinSqr = 0
	if (mind ~= nil) then
		iMinSqr = mind * mind
	end

	local function AddNearBuilding( vBuildPos, bOwn )

		local iDistSqr = distance_sqr(vBuildPos, squad_pos)
		if (iDistSqr >= iMinSqr) then
			table.insert(aNear, { Vector3f(vBuildPos), iDistSqr, bOwn })
		end
	end

	for iLoop1 in Tactic.DisengageCache.own_buildings do
		AddNearBuilding(Tactic.DisengageCache.own_buildings[iLoop1], true)
	end

	if (table.getn(aNear) < 2) then
		for oPlayer in cpu_manager.stats:GetPlayerStats() do
			if (not cpu_manager.player_stats:IsEnemy(oPlayer) and not oPlayer:IsPlayerDead() and
				oPlayer:GetPlayerID() ~= cpu_manager.player_id) then
				for oBuilding in oPlayer:GetBases() do
					if (oBuilding:IsValid()) then
						AddNearBuilding(oBuilding:GetPosition(), false)
					end
				end
			end
		end
	end

	if (table.getn(aNear) == 0) then
		return nil
	end

	table.sort(aNear, function(oItem1, oItem2) return oItem1[2] < oItem2[2] end)

	local aCandidates = {}
	local iLimit = table.getn(aNear)
	if (iLimit > 4) then
		iLimit = 4
	end

	for iLoop1 = 1, iLimit do
		local vBuildPos = aNear[iLoop1][1]
		local bOwn = aNear[iLoop1][3]
		local bClear = self:IsDisengageRouteClear(squad_pos, vBuildPos, 24)
		if (not bRequireClearRoute or bClear) then
			local iScore = 100000000 - aNear[iLoop1][2]
			if (bOwn) then
				iScore = iScore + 40000000
			end
			if (bClear) then
				iScore = iScore + 50000000
			end
			iScore = iScore - distance_sqr(vBuildPos, cpu_manager.start_pos) / 4
			table.insert(aCandidates, { Vector3f(vBuildPos), iScore })
		end
	end

	if (table.getn(aCandidates) == 0) then
		return nil
	end
	table.sort(aCandidates, function(oItem1, oItem2) return oItem1[2] > oItem2[2] end)
	return Vector3f(aCandidates[1][1])
end

function Tactic:FindDisengagePosition( squad_pos, mind, maxd, safe_radius )

	local fStep = maxd
	if (not cpu_manager.terrain_analyzer:HasThreat(squad_pos, safe_radius)) then
		fStep = mind
	end

	local vHome = cpu_manager.start_pos
	local vNearestEnemy = nil
	local oEnemy = cpu_manager.cpu_player:FindFirstEnemy(squad_pos, safe_radius + 25, 1)
	if (oEnemy ~= nil) then
		vNearestEnemy = oEnemy:GetPosition()
	end

	local fDia = fStep / math.sqrt(2)
	local aDirs = {
		{ fStep, 0 },
		{ fDia, fDia },
		{ 0, fStep },
		{ -fDia, fDia },
		{ -fStep, 0 },
		{ -fDia, -fDia },
		{ 0, -fStep },
		{ fDia, -fDia },
	}

	local aCandidates = {}
	for iLoop1 in aDirs do
		local vCandidate = Vector3f(squad_pos)
		vCandidate.x = vCandidate.x + aDirs[iLoop1][1]
		vCandidate.z = vCandidate.z + aDirs[iLoop1][2]
		if (cpu_manager:IsPosOnMap(vCandidate) and
			not cpu_manager.terrain_analyzer:HasThreat(vCandidate, 20) and
			not self:PointNearEnemyBuilding(vCandidate, nil, nil, 18) and
			self:IsDisengageRouteClear(squad_pos, vCandidate, 22)) then
			local iBlocked = self:CountThreatBlockedDirections(vCandidate, 25, 20)
			if (iBlocked < 7) then
				local iScore = distance_sqr(vCandidate, vHome)
				if (vNearestEnemy ~= nil) then
					local fAway = (vCandidate.x - squad_pos.x) * (squad_pos.x - vNearestEnemy.x) +
					              (vCandidate.z - squad_pos.z) * (squad_pos.z - vNearestEnemy.z)
					iScore = iScore + fAway * 4
				end
				iScore = iScore + (8 - iBlocked) * 3000000
				table.insert(aCandidates, { vCandidate, iScore })
			end
		end
	end

	if (table.getn(aCandidates) > 0) then
		table.sort(aCandidates, function(oItem1, oItem2) return oItem1[2] > oItem2[2] end)
		return Vector3f(aCandidates[1][1])
	end
	-- Surrounded: no clean corridor — still leave along least-bad axis.
	return self:FindBestEscapeDirection(squad_pos, fStep)
end

function Tactic:FindAwayFromEnemiesPosition( squad_pos, iRange, maxd )

	-- Near enemy base: pure "away from enemies" often points deeper into their side
	-- when the foe is between us and home. Use the same homeward 8-dir pick as broken.
	if (not cpu_manager:IsHomeSidePosition(squad_pos)) then
		return self:FindBestEscapeDirection(squad_pos, maxd)
	end

	local fSumDx = 0
	local fSumDz = 0
	local iCount = 0
	local iRangeSqr = sqr(iRange)
	-- Cached enemy unit table (no full player/squad walk)
	for iLoop1 in cpu_manager.m_aEnemyUnits do
		local vEnemyPos = cpu_manager.m_aEnemyUnits[iLoop1][1]
		if (distance_sqr(squad_pos, vEnemyPos) < iRangeSqr) then
			fSumDx = fSumDx + (squad_pos.x - vEnemyPos.x)
			fSumDz = fSumDz + (squad_pos.z - vEnemyPos.z)
			iCount = iCount + 1
		end
	end
	if (iCount == 0) then
		return nil
	end

	local fLen = math.sqrt(fSumDx * fSumDx + fSumDz * fSumDz)
	if (fLen < 1) then
		-- Enemies cancel out (surrounded): escape toward home, not farther out.
		return self:FindBestEscapeDirection(squad_pos, maxd)
	end

	local vCandidate = Vector3f(squad_pos)
	vCandidate.x = squad_pos.x + (fSumDx / fLen) * maxd
	vCandidate.z = squad_pos.z + (fSumDz / fLen) * maxd
	if (cpu_manager:IsPosOnMap(vCandidate) and
		not self:PointNearEnemyBuilding(vCandidate, nil, nil, 18)) then
		-- Skip CountThreatBlockedDirections on soft peel (8 HasThreat calls) — dance/broken keep full check
		if (self.m_bDanceDisengage or self.squad_ai:IsBroken()) then
			if (self:CountThreatBlockedDirections(vCandidate, 25, 20) >= 7) then
				return self:FindBestEscapeDirection(squad_pos, maxd)
			end
		end
		return vCandidate
	end
	return self:FindBestEscapeDirection(squad_pos, maxd)
end

function Tactic:MoveToDisengage()

	if (self:IsOverwhelmSpamMode()) then
		return false
	end
	-- Daemon/relic: no deep peel (short ranged dance uses DoMoveToClosestSafePoint)
	if (self:IsDaemonRelicUnit()) then
		return false
	end

	local squad_pos = self.squad_ai:GetPosition()
	local bBroken = self.squad_ai:IsBroken()
	local bDance = (self.m_bDanceDisengage == true)
	local bRetreatHome = self:ShouldRetreatAllTheWayHome()

	-- Мягкий peel (рейндж/техника): стоп когда не underattack и давление спало
	if (not bBroken and not bRetreatHome and not bDance and self:ShouldCancelSoftDisengage()) then
		if (self.squad_ai:IsInStateMove()) then
			self.squad_ai:DoStop()
		end
		if (self.squad_ai:IsRanged()) then
			self.squad_ai:DoSetStance(SquadAI.STANCE_StandGround)
		end
		self.m_iLastDisengage = g_iGMT
		return false
	end

	-- Дальний уход: только broken / мораль / крит. HP
	if (bRetreatHome) then
		local vHome = self:GetHomeRetreatPos()
		local bAtHome = (distance_sqr(squad_pos, vHome) < sqr(25))
		local bLocalThreat = (self.squad_ai:IsUnderAttack() or self.squad_ai:WasRecentlyHurt() or
			cpu_manager.terrain_analyzer:HasThreat(squad_pos, 35))
		if (bAtHome and not (bBroken and bLocalThreat)) then
			self.squad_ai:DoStop()
			self.m_iLastDisengage = g_iGMT
			return true
		end
		-- Home path through fire → break out to open space first (not suicide run to HQ)
		local bHomePathHot = (not bAtHome and
			(cpu_manager:HasThreatOnPath(squad_pos, vHome, 28) or
			 cpu_manager.terrain_analyzer:HasThreat(vHome, 40)))
		if (bHomePathHot and bLocalThreat) then
			local vEscape = self:FindBestEscapeDirection(squad_pos, 60)
			if (vEscape ~= nil and distance_sqr(squad_pos, vEscape) >= sqr(15)) then
				if (g_iGMT >= self.m_iLastDisengage + 2 or not self.squad_ai:IsInStateMove() or
					self.safe_point == nil or distance_sqr(self.safe_point, vEscape) > sqr(25)) then
					cpu_manager:DoMove(self.squad_ai, vEscape, false, "Retreat breakout", false)
					self.safe_point = Vector3f(vEscape)
					self.m_iLastDisengage = g_iGMT
				end
				return true
			end
		end
		if (self.safe_point == nil or distance_sqr(self.safe_point, vHome) > sqr(20)) then
			self.safe_point = Vector3f(vHome)
		end
		if (g_iGMT >= self.m_iLastDisengage + 3 or not self.squad_ai:IsInStateMove()) then
			if (bBroken and bLocalThreat and bAtHome) then
				cpu_manager:DoMove(self.squad_ai, cpu_manager.start_pos, false, "Broken retreat HQ")
			else
				cpu_manager:DoMove(self.squad_ai, vHome, false, "Retreat home")
			end
			self.m_iLastDisengage = g_iGMT
		end
		return true
	end

	-- AvoidDeath / low HP: always allow peel (don't freeze under fire waiting NeedsRanged)
	local bAvoidDeath = (self.stateID == Tactic.StateID.AvoidDeath)
	local fHP = self.squad_ai:GetHealthPercentage()
	local bLowHP = (fHP ~= nil and fHP < 0.5)
	if (self.squad_ai:IsRanged() and self.squad_ai:IsUnderAttack() and not bBroken and
		not bAvoidDeath and not bLowHP and not self:NeedsRangedDisengage()) then
		return false
	end

	-- Dance/melee emergency: прежние более длинные прыжки/шаги
	local maxd = 35
	local mind = 12
	local safe_radius = 25
	local jump_ok = false
	if (bDance or bBroken or bAvoidDeath or bLowHP) then
		maxd = 100
		mind = 25
		safe_radius = 35
	end
	if (bBroken) then
		maxd = 140
		safe_radius = 50
		mind = 0
	end

	if (g_iGMT < self.m_iLastDisengage + 8) then
		if (self:ShouldCancelSoftDisengage()) then
			if (self.squad_ai:IsInStateMove()) then
				self.squad_ai:DoStop()
			end
			return false
		end
		-- DoDance at/near own point while melee presses → keep stepping away (don't sticky-hold LP)
		if (bDance and self.safe_point ~= nil and
			distance_sqr(squad_pos, self.safe_point) < sqr(22) and
			(self.squad_ai:IsUnderAttack() or self:IsMeleePressing(28))) then
			local vEscape = self:PickDanceEscapeStep(squad_pos, 40)
			if (vEscape ~= nil and distance_sqr(squad_pos, vEscape) >= sqr(12)) then
				cpu_manager:DoMove(self.squad_ai, vEscape, false, "Dance escape", false)
				self.safe_point = Vector3f(vEscape)
				self.m_iLastDisengage = g_iGMT
				return true
			end
		end
		if (self.squad_ai:IsInStateMove() and self.safe_point ~= nil) then
			-- Soft peel: не тащить дальше 50м от текущего места к старой далёкой цели
			if (not bDance and not bBroken and self:IsSoftDisengageUnit()) then
				if (distance_sqr(squad_pos, self.safe_point) > sqr(50)) then
					local vLocal = self:FindLocalDisengagePoint(squad_pos, maxd)
					if (vLocal ~= nil) then
						cpu_manager:DoMove(self.squad_ai, vLocal, false, "Disengage", false)
						self.safe_point = Vector3f(vLocal)
						self.m_iLastDisengage = g_iGMT
					end
				end
			end
			return true
		end
		if (self.safe_point ~= nil and distance_sqr(squad_pos, self.safe_point) < sqr(20)) then
			-- Still under fire / melee at "safe" point → re-pick escape (don't StandGround in place).
			if (bDance and (self.squad_ai:IsUnderAttack() or self:IsMeleePressing(28))) then
				local vEscape = self:PickDanceEscapeStep(squad_pos, 40)
				if (vEscape ~= nil and distance_sqr(squad_pos, vEscape) >= sqr(12)) then
					cpu_manager:DoMove(self.squad_ai, vEscape, false, "Dance escape", false)
					self.safe_point = Vector3f(vEscape)
					self.m_iLastDisengage = g_iGMT
					return true
				end
				self.m_iLastDisengage = 0
				self.safe_point = nil
			elseif (self.squad_ai:IsUnderAttack() or self.squad_ai:WasRecentlyHurt()) then
				self.m_iLastDisengage = 0
				self.safe_point = nil
			else
				if (self.squad_ai:IsRanged() and not bBroken) then
					self.squad_ai:DoSetStance(SquadAI.STANCE_StandGround)
				end
				return true
			end
		end
	end

	-- Лёгкий путь: короткий local peel (без зданий на другом конце карты)
	-- AvoidDeath / low HP: skip — need longer breakout steps into open space
	if (not bBroken and not bDance and not bAvoidDeath and not bLowHP and
		not self:TakeDisengageHeavyBudget()) then
		if (self.safe_point ~= nil and self.squad_ai:IsInStateMove() and
			distance_sqr(squad_pos, self.safe_point) > sqr(12) and
			distance_sqr(squad_pos, self.safe_point) < sqr(50)) then
			return true
		end
		local vCheap = self:FindCheapDisengagePoint(squad_pos)
		-- Destination too close = still in the pocket → force least-bad escape step.
		if (vCheap == nil or distance_sqr(squad_pos, vCheap) < sqr(10)) then
			vCheap = self:FindBestEscapeDirection(squad_pos, 38)
		end
		if (vCheap ~= nil and distance_sqr(squad_pos, vCheap) >= sqr(10)) then
			cpu_manager:DoMove(self.squad_ai, vCheap, false, "Disengage", false)
			self.safe_point = Vector3f(vCheap)
			self.m_iLastDisengage = g_iGMT
			return true
		end
		return false
	end

	if (self.squad_ai:CanJump() and g_iGMT > self.last_jump + 10) then
		jump_ok = true
		if (bDance or bBroken) then
			maxd = self.squad_ai:GetJumpDistance()
		end
	end

	if (not cpu_manager.terrain_analyzer:HasThreat(squad_pos, safe_radius)) then
		if (not bBroken) then
			mind = 10
		end
		jump_ok = false
	end

	if (self.squad_ai:GetNumTroopers() > 3) then
		if (self.squad_ai:GetHealthPercentage() > 0.5 or not self.squad_ai:WasRecentlyHurt() or not self.squad_ai:IsUnderAttack()) then
			jump_ok = false
		end
	end

	local move_pos = nil
	local bRetreatToBuilding = false
	local bBreakout = false

	-- Soft peel: сначала короткий шаг от врага
	if (not bBroken and not bDance) then
		move_pos = self:FindLocalDisengagePoint(squad_pos, maxd)
	end

	-- Здание только в пределах maxd (dance/broken — шире)
	local iBuildMax = maxd
	if (bDance or bBroken) then
		iBuildMax = maxd + 80
	end
	if (move_pos == nil) then
		move_pos = self:FindFriendlyBuildingDisengagePoint(squad_pos, mind, iBuildMax, true)
		if (move_pos ~= nil) then
			if (distance_sqr(squad_pos, move_pos) <= sqr(iBuildMax)) then
				if (bDance and distance_sqr(squad_pos, move_pos) < sqr(18) and
					(self.squad_ai:IsUnderAttack() or self:IsMeleePressing(28))) then
					move_pos = nil
				else
					bRetreatToBuilding = true
				end
			else
				move_pos = nil
			end
		end
	end
	if (move_pos == nil and (bDance or bBroken)) then
		move_pos = self:FindFriendlyBuildingDisengagePoint(squad_pos, 5, iBuildMax, false)
		if (move_pos ~= nil) then
			if (bDance and distance_sqr(squad_pos, move_pos) < sqr(18) and
				(self.squad_ai:IsUnderAttack() or self:IsMeleePressing(28))) then
				move_pos = nil
			else
				bRetreatToBuilding = true
			end
		end
	end

	-- Дальняя союзная точка — ТОЛЬКО broken/dance, не обычный chip peel
	if (move_pos == nil and (bBroken or bDance)) then
		move_pos = cpu_manager:FindClosestFriendlyBaseOrStrategicPoint(squad_pos, cpu_manager.start_pos, false, false, true)
		if (move_pos ~= nil) then
			-- Dance: already at that flag/building + melee still on us → don't re-target same point
			if (bDance and distance_sqr(squad_pos, move_pos) < sqr(18) and
				(self.squad_ai:IsUnderAttack() or self:IsMeleePressing(28))) then
				move_pos = nil
			else
				bRetreatToBuilding = true
			end
		end
	end

	if (move_pos == nil and jump_ok and self.squad_ai:WasRecentlyHurt()) then
		move_pos = self:FindClosestAllyDisengagePoint(squad_pos, mind, maxd)
	end

	if (move_pos == nil) then
		move_pos = self:FindDisengagePosition(squad_pos, mind, maxd, safe_radius)
	end

	if (move_pos == nil) then
		move_pos = self:FindLocalDisengagePoint(squad_pos, maxd)
	end

	-- Dance under melee: step away if still no useful destination
	if (move_pos == nil and bDance and (self.squad_ai:IsUnderAttack() or self:IsMeleePressing(28))) then
		move_pos = self:PickDanceEscapeStep(squad_pos, 40)
	end

	-- Финальный fallback на HQ только для broken
	if (move_pos == nil and bBroken) then
		move_pos = Vector3f(cpu_manager.start_pos)
	end

	if (move_pos ~= nil and cpu_manager.terrain_analyzer:HasThreat(squad_pos, safe_radius) and
		not bRetreatToBuilding and not self:IsDisengageRouteClear(squad_pos, move_pos, 20)) then
		local vAway = self:FindAwayFromEnemiesPosition(squad_pos, safe_radius + 15, maxd)
		if (vAway ~= nil) then
			move_pos = vAway
			if (not self:IsDisengageRouteClear(squad_pos, vAway, 22)) then
				bBreakout = true
			end
		end
	end

	if (move_pos ~= nil and not bBreakout and not bRetreatToBuilding and
		not self:IsDisengageRouteClear(squad_pos, move_pos, 20)) then
		if (bDance or bBroken) then
			move_pos = self:FindFriendlyBuildingDisengagePoint(squad_pos, 5, iBuildMax, false)
			if (move_pos ~= nil) then
				if (bDance and distance_sqr(squad_pos, move_pos) < sqr(18) and
					(self.squad_ai:IsUnderAttack() or self:IsMeleePressing(28))) then
					move_pos = self:PickDanceEscapeStep(squad_pos, 40)
					bRetreatToBuilding = false
				else
					bRetreatToBuilding = true
				end
			else
				move_pos = nil
			end
		else
			move_pos = self:FindLocalDisengagePoint(squad_pos, maxd)
		end
	end

	if (move_pos ~= nil) then
		if (distance_sqr(squad_pos, move_pos) < sqr(10)) then
			-- Dance under melee: never StandGround on the arrival tile — step further away
			if (bDance and (self.squad_ai:IsUnderAttack() or self:IsMeleePressing(28))) then
				local vEscape = self:PickDanceEscapeStep(squad_pos, 40)
				if (vEscape ~= nil and distance_sqr(squad_pos, vEscape) >= sqr(12)) then
					cpu_manager:DoMove(self.squad_ai, vEscape, false, "Dance escape", false)
					self.safe_point = Vector3f(vEscape)
					self.m_iLastDisengage = g_iGMT
					return true
				end
			elseif (self.squad_ai:IsRanged() and not bBroken) then
				self.squad_ai:DoSetStance(SquadAI.STANCE_StandGround)
			end
			self.safe_point = Vector3f(move_pos)
			self.m_iLastDisengage = g_iGMT
			return true
		end
		local safe_point = Vector3f(move_pos)
		if (jump_ok and self.squad_ai:CanJumpToPosition(safe_point) and distance_sqr(squad_pos, safe_point) > sqr(mind)) then
			self.squad_ai:DoJump(safe_point)
			self.last_jump = g_iGMT
		else
			cpu_manager:DoMove(self.squad_ai, move_pos, false, "Disengage", false)
		end
		self.safe_point = Vector3f(move_pos)
		self.m_iLastDisengage = g_iGMT
		return true
	end

	if (jump_ok and self.safe_point ~= nil and g_iGMT > self.m_iLastDisengage + 3) then
		self.squad_ai:DoMoveToClosestSafePoint(self.safe_point, maxd)
		if (self.squad_ai:CanJumpToPosition(self.safe_point) and distance_sqr(squad_pos, self.safe_point) > sqr(mind)) then
			self.squad_ai:DoJump(self.safe_point)
			self.last_jump = g_iGMT
			self.m_iLastDisengage = g_iGMT
		end
		return true
	end
	return false
end

function Tactic:EmergencyRetreat()
	if (self:IsOverwhelmSpamMode()) then
		return
	end
	if (self:IsDaemonRelicUnit()) then
		return
	end
	--self.squad_ai:GetNumTroopers() == 1 
	-- Check if we can jump
	
	if (not self.squad_ai:CanJump()) then
		return
	end
	if self.squad_ai:GetNumTroopers() > 1 then
		if self.squad_ai:GetHealthPercentage() > 0.5 or not self.squad_ai:WasRecentlyHurt() then
			return
		end
	end
	-- Check health
	local vSquadPos = self.squad_ai:GetPosition()
	if (self.squad_ai:GetHealthPercentage() > 0.3) then
		
		-- Check threat
		if (cpu_manager.terrain_analyzer:HasThreat(vSquadPos, 50)) then
		
			-- Check situation
			local iEnemyStrength, iAlliedStrength = cpu_manager:GetArmyStrengthAtPos(vSquadPos, 50)
			if (iEnemyStrength < iAlliedStrength) then
				return
			end
		else
			return
		end
		
	elseif (not cpu_manager.terrain_analyzer:HasThreat(vSquadPos, 35)) then
		return
	end
	
	-- Try to teleport to save position
	self:MoveToDisengage()
end

function Tactic:DoMoveAttach( attach_to )

   --[[local attach_pos = attach_to:GetPosition()
   local squad_pos = self.squad_ai:GetPosition()
   
   dbAssert( attach_pos ~= nil )
   dbAssert( squad_pos ~= nil )
   
   if distance_sqr( squad_pos, attach_pos ) > 100 then
      cpu_manager:DoMove( self.squad_ai, attach_pos, false, "Attach" )
      self.squad_ai:DoMove( attach_pos )
   end]]
   
   self.squad_ai:DoAttachSquad( attach_to )
end

--try to close on enemy if we fight CC, receive damage but there is no enenmy
--squad nearby. This is most likely if we attack a building and enemy squad is
--shooting us.
function Tactic:CloseOnEnemy()

	-- Check move delay
	if (g_iGMT < self.m_iMoveDelay + 5) then
		return
	end

	if (self.squad_ai:IsBroken() or not self.squad_ai:WasRecentlyHurt() or
		self.squad_ai:IsCapturing() or self:IsInSubState()) then
		return
	end

	if (not self.squad_ai:IsInCombat() and not self.squad_ai:IsUnderAttack()) then
		return
	end

	if (self:IsMoving() and not self.squad_ai:IsUnderAttack()) then
		return
	end

	if (not self.squad_ai:IsInStateAttackMove() and not self.squad_ai:IsUnderAttack()) then
		return
	end

	-- Get squad position
	local vSquadPos = self.squad_ai:GetPosition()

	-- Check for nearby enemy squads
	local oEnemyUnit = cpu_manager.cpu_player:FindFirstEnemy(vSquadPos, 15, 1)
	if (oEnemyUnit == nil or not oEnemyUnit:IsEngineer()) then
		return
	end

	local oEnemyBuilding = cpu_manager.cpu_player:FindFirstBaseEnemy(vSquadPos, 15, 1)
	if (oEnemyBuilding == nil or not self:IsBuildingUnderWork(oEnemyBuilding)) then
		return
	end

	local oWorker = self:FindWorkerAtBuilding(oEnemyBuilding)
	if (oWorker == nil or oWorker:GetID() ~= oEnemyUnit:GetID()) then
		return
	end

	local vEnemyPos = oEnemyUnit:GetPosition()
	if (distance_sqr(vSquadPos, vEnemyPos) < sqr(8)) then
		return
	end
	
	-- Squad is most likely fighting a building
	cpu_manager:DoMove(self.squad_ai, vEnemyPos, false, "Close on enemy")
	
	-- Set move delay
	if (self.squad_ai:IsRanged()) then
		self.m_iMoveDelay = g_iGMT
	else
		self.m_iMoveDelay = g_iGMT + 5
	end
end

-- Arkhan 01.2006: Virtual method to avoid the worker bug
function Tactic:ValidMove( vDestination )
	self.squad_ai:DoMove( vDestination )
end

-- Arkhan 01.2006: Method to figure out if the squad should continue capturing even in critical situations
function Tactic:UrgentCapturing()

	-- Urgent T&H (<2 min): die on victory SP — 1 model / low HP / broken OK
	if (CapturePlan:IsTakeAndHoldUrgent()) then
		local vUrgentPos = self.squad_ai:GetPosition()
		if (self.squad_ai:IsCapturing() or self:IsCapturePlanMove()) then
			local oUrgentFlag = resource_manager:FindFirstStrategicPoint(vUrgentPos, 45)
			if (oUrgentFlag == nil) then
				local iBest = sqr(55)
				for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
					local iDist = distance_sqr(vUrgentPos, oStrategicPoint:GetPosition())
					if (iDist < iBest) then
						iBest = iDist
						oUrgentFlag = oStrategicPoint
					end
				end
			end
			if (oUrgentFlag ~= nil and CapturePlan:IsVictoryStrategicPoint(oUrgentFlag)) then
				return true
			end
		end
	end

	-- Check if squad is capturing
	if (not self.squad_ai:IsCapturing()) then
		return false
	end
	
	-- Get closest strategic point
	local vSquadPos = self.squad_ai:GetPosition()
	local oTargetPoint = resource_manager:FindFirstStrategicPoint(vSquadPos, 30)
	if (oTargetPoint == nil) then
	
		-- Clean check
		local iTargetDistance = sqr(50)
		for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
		
			-- Check distance
			local iDistance = distance_sqr(vSquadPos, oStrategicPoint:GetPosition())
			
			-- Take this strategic point if it is closer than the previous points
			if (iDistance < iTargetDistance) then
				iTargetDistance = iDistance
				oTargetPoint = oStrategicPoint
			end
		end
		if (oTargetPoint == nil) then
			return false
		end
	end

	-- T&H urgent victory flag: pin even if broken / 1 model (die for the win)
	if (CapturePlan:IsVictoryStrategicPoint(oTargetPoint) and CapturePlan:IsTakeAndHoldUrgent()) then
		return true
	end

	local fProgress = oTargetPoint:GetCaptureProgress()

	-- Early finish tiers (≥0.85)
	if (CapturePlan:ShouldFinishCaptureDespiteThreat(fProgress, self.squad_ai)) then
		return true
	end

	-- Broken: only pin when BrokenCaptureAllowed (overwhelm / T&H / empty homeside / …)
	if (self.squad_ai:IsBroken()) then
		return CapturePlan:BrokenCaptureAllowed(self.squad_ai, oTargetPoint, fProgress)
	end

	-- Last model: do not die for normal crit / enemy homeside — peel and live
	if (self.squad_ai:GetNumTroopers() <= 1) then
		if (cpu_manager.terrain_analyzer:HasThreat(vSquadPos, 20)) then
			return false
		end
	end

	-- Safe / empty: finish the cap
	if (not cpu_manager.terrain_analyzer:HasThreat(vSquadPos, 20)) then
		return true
	end
	if (CapturePlan:IsEmptyOfEnemyArmy(oTargetPoint)) then
		return true
	end

	-- Contested (incl. crit / enemy homeside): only if we outmatch locally
	local iEnemyStrength, iAlliedStrength = cpu_manager:GetArmyStrengthAtPos(vSquadPos, 30, true)
	if (iEnemyStrength == nil) then
		iEnemyStrength = 0
	end
	if (iAlliedStrength == nil) then
		iAlliedStrength = 0
	end
	if (iAlliedStrength > iEnemyStrength) then
		return true
	end
	return false
end

-- Arkhan 01.2006: Returns the position of a near unit which is closer to the target than me
function Tactic:GetCloseSquadPosition()

	-- Get a good target position to keep army together
	local vMyPosition = self.squad_ai:GetPosition()
	local vTargetPosition = self.target
	local iClosestRangeToTarget = distance_sqr(self.target, vMyPosition)
	for oSquad in military_manager:GetSquads() do
	
		-- Check if squad is valid
		if (oSquad:IsValid()) then
		
			-- Calculate distance to me and to target
			local vPosition = oSquad:GetPosition()
			local iDistanceToMe = distance_sqr(vPosition, vMyPosition)
			if (iDistanceToMe > sqr(35)) then
				
				local iDistanceToTarget = distance_sqr(vPosition, self.target)
				if (iDistanceToTarget < sqr(35) and iDistanceToTarget < iClosestRangeToTarget) then
					iClosestRangeToTarget = iDistanceToTarget
					vTargetPosition = vPosition
				end
			end
		end
	end
	return vTargetPosition
end

-- Arkhan 02.2006: Gets the closest enemy unit for melee
function Tactic:GetClosestUnitForMelee(iRange)

	-- Quick check
	if (not cpu_manager:CloseEnemyUnits(self.target, iRange)) then
		return nil
	end

	local oBuilding = cpu_manager.cpu_player:FindFirstBaseEnemy(self.target, iRange, 1)
	if (oBuilding ~= nil and self:IsBuildingUnderWork(oBuilding)) then
		local oWorker = self:FindWorkerAtBuilding(oBuilding)
		if (oWorker ~= nil) then
			return oWorker
		end
	end

    -- Get closest infantry enemy unit to target position
    local oEnemyUnit = cpu_manager.cpu_player:FindFirstEnemy(self.target, iRange, 1)
    if (oEnemyUnit ~= nil and not oEnemyUnit:IsRanged() and oEnemyUnit:GetMaxTroopers() == 1) then
    	oEnemyUnit = cpu_manager.cpu_player:FindFirstInfantryEnemy(self.target, iRange, 1)
    end
	return oEnemyUnit
end




-- Arkhan 02.2006: Gets the closest enemy turret for melee
function Tactic:GetClosestBuildingForMelee(iRange)

	-- Quick check
	if (not cpu_manager:CloseEnemyBuildings(self.target, iRange)) then
		return nil
	end

	-- Check for closest listening post to target position
	local oStrategicPoint = resource_manager:FindFirstStrategicPoint(self.target, iRange)
	if (oStrategicPoint ~= nil and oStrategicPoint:HasListeningPost() and not cpu_manager:IsFriendly(oStrategicPoint:Owner())) then
		return oStrategicPoint:GetEntity()
	end
	
	-- Check for closest building to target position
	local oBuilding = cpu_manager.cpu_player:FindFirstBaseEnemy(self.target, iRange, 1)
	if (oBuilding ~= nil) then
		if (self:IsBuildingUnderWork(oBuilding)) then
			if (self:FindWorkerAtBuilding(oBuilding) ~= nil) then
				return nil
			end
		end
		return oBuilding:GetEntity()
	end
	return nil
end

-- Arkhan 05.2006: Makes a gather move
function Tactic:GatherMove(vPos)

	aitrace("Tactic: Gather move...")

	-- Set time of last gather move
	self.m_iLastGatherMove = g_iGMT

	-- Make a simple move to the gather position
	self.target = Vector3f(vPos)
	cpu_manager:DoMove(self.squad_ai, self.target, false, "GatherState")
end

-- Arkhan 05.2006: Check if the unit is gathering
function Tactic:CheckGatherMove()

	-- Check if we're doing a gather move at the moment
	if (g_iGMT > self.m_iLastGatherMove + 15 or self.squad_ai:IsIdle()) then
		return false
	end
	
	-- Stop gather move if we've allied support in close range
	local vSquadPosition = self.squad_ai:GetPosition()
	local iCloseRange = sqr(35)
	local IsInRange = function(oAlliedSquad)
		
		-- Check if allied squad is current squad
		if (iSquadID == oAlliedSquad:GetID()) then
			return false
		end
		
		-- Check distance from allied squad to current squad
		if (distance_sqr(oAlliedSquad:GetPosition(), vSquadPosition) < iCloseRange) then
			return true
		end
	end
	if (cpu_manager:FindFirstFriendly(IsInRange) ~= nil) then
		return false
	end
	return true
end

function Tactic:TryDisownFlags()
	
	-- Sentinel / Reaver / Wraith: never hunt flags — only if already next to one
	if (self:CanOnlyDecap()) then
		return self:TryNearbyOnlyCapture()
	end

	-- Check if we are able to capture
	if (not self.squad_ai:CanCapture() or self.squad_ai:IsCapturing() or g_iGMT < self.m_iNextDisownCheck or g_iGMT<60) then
		return false
	end
	
	-- Check unit strength
	local iUnitStrength = self:GetUnitStrength()
	local bExpendable = false
	if (iUnitStrength < 300 or (g_iGMT > DefendChokePointPlan.HarassingTime * 60 and iUnitStrength < cpu_manager:GetArmyStrength() / 5)) then
		bExpendable = true
	end
	
	-- Check if we can allow the squad to capture a flag
	local vSquadPos = self.squad_ai:GetPosition()

	if (not bExpendable and distance_sqr(vSquadPos, self:GetTarget()) > sqr(50)) then
		return false
	end
	self.m_iNextDisownCheck = g_iGMT + 1/2
	
	-- Search a flag for capturing
	local oStrategicPoint = resource_manager:SearchForFlagToDisown(self.squad_ai, 50)
	if (oStrategicPoint ~= nil) then
        if oStrategicPoint:IsLocked() then
           return false
        end
		if (cpu_manager:IsAllyCaptureAtPoint(oStrategicPoint, 40)) then
			return false
		end
		-- Secure homeside first: no opportunistic decap / crit / enemy-side grabs
		if (CapturePlan:NeedsHomeSideSecurePhase() and
			not CapturePlan:CanCaptureDuringHomeSideSecure(oStrategicPoint)) then
			return false
		end
		-- Empty victory nearby: only if path/local safe and not broken
		if (oStrategicPoint:IsStrategicObjective() and not oStrategicPoint:IsRelic() and
			CapturePlan.CanSafelyTakeEmptyVictory ~= nil and
			not CapturePlan:CanSafelyTakeEmptyVictory(self.squad_ai, oStrategicPoint)) then
			return false
		end
		-- Check owner
		local iOwner = oStrategicPoint:Owner()
		-- Ally already capping: do not steal. Neutral leftover progress after CanOnlyDecap is OK.
		if (cpu_manager:IsFriendly(iOwner) and iOwner ~= 0) then
			if (not self.squad_ai:IsCapturing() and oStrategicPoint:GetCaptureProgress() > 0) then
				return false
			end
		end
		-- Homeside relic during secure: allow early (same set as CapturePlan secure targets)
		local bSecureHomeRelic = (CapturePlan:NeedsHomeSideSecurePhase() and
			CapturePlan:IsHomeSideRelic(oStrategicPoint))
		if (iOwner == 0 and (oStrategicPoint:IsStrategicObjective() and not bExpendable)) or
			(g_iGMT <150 and (oStrategicPoint:IsStrategicObjective() or oStrategicPoint:IsRelic()) and
			 not bSecureHomeRelic) then
			return false
		end
	
		-- Check if strat can be captured
		if (not oStrategicPoint:HasListeningPost() and not cpu_manager:IsFriendly(iOwner)) then
			-- Check threat
			local vStratPos = oStrategicPoint:GetPosition()
			local vEnemyStrength, iAlliedStrength = cpu_manager:GetArmyStrengthAtPos(vStratPos, 35, true)
			if (vEnemyStrength*2>iAlliedStrength) then
				return false
			elseif (vEnemyStrength*2<iAlliedStrength or vEnemyStrength==0) then
				-- Broken: same gate as CapturePlan (no crit / enemy-side / contested homeside grab)
				local fProgress = 0
				if (oStrategicPoint.GetCaptureProgress ~= nil) then
					fProgress = oStrategicPoint:GetCaptureProgress()
				end
				if (CapturePlan.ShouldRefuseBrokenCapture ~= nil and
					CapturePlan:ShouldRefuseBrokenCapture(self.squad_ai, oStrategicPoint, fProgress)) then
					return false
				end
				-- Capture first; enemy-side top-up after (DoReinforce before DoDefault = jitter)
				self.squad_ai:DoDefault(oStrategicPoint:GetEntity())
				local iDistMy = cpu_manager:GetShortestPathingDistance(cpu_manager.start_pos, vStratPos, false)
				local oEnemy = cpu_manager:FindClosestEnemyPlayer(false)
				local bEnemySide = false
				if (oEnemy ~= nil) then
					local iDistEnemy = cpu_manager:GetShortestPathingDistance(oEnemy:GetStartingPosition(), vStratPos, false)
					bEnemySide = (iDistMy >= iDistEnemy)
				end
				local iRequisition = resource_manager:GetResourceAmount():Get(ResourceAmount.RT_Requisition)
				if (bEnemySide and iRequisition > 200 and g_iGMT < DefendChokePointPlan.HarassingTime * 60 and
					self.squad_ai:GetNumTroopers() < self.squad_ai:GetMaxTroopers() and
					not self.squad_ai:IsReinforcing()) then
					self:TryDoReinforce()
				end
				return true
            end
		end
	end
	return false
end

function Tactic:AvoidStealthTroops()

	if (self.stateID == Tactic.StateID.AvoidStealth and not self:CheckForStealthTroops()) then 
	  	  
		if (self.m_eSubStateID == self.stateID) then
			self.m_eSubStateID = Tactic.StateID.NoState
		end
		self.stateID = Tactic.StateID.NoState
		
		-- Go back in the fray - reset my state
		Tactic.SetState( self, self:GetState() )
	end
end

-- Avoid stealth troops if we can't detect
function Tactic:CheckForStealthTroops()

	if (self:IsOverwhelmSpamMode()) then
		return false
	end

	-- Ranged squads stationary, hurt and away from home base
	local vSquadPos = self.squad_ai:GetPosition()
	local bCheckAvoidStealth = (self.squad_ai:IsRanged() and self.squad_ai:WasRecentlyHurt() and
								not self.squad_ai:IsDetector() and not self.squad_ai:IsCapturing() and
								not self.squad_ai:IsInStateMove() and not self.squad_ai:IsBroken() and
								not self.squad_ai:IsAttacking())
						 
	-- Don't leave if we are in state of disengage
	if (self.stateID ~= Tactic.StateID.AvoidStealth and not bCheckAvoidStealth) then
		self.m_iDancing = 0
		return false
	end

	-- Already peeling from stealth: keep checking every think
	-- Else: arty/HWT (setup / artillery range) 1s; others 2s
	if (self.stateID ~= Tactic.StateID.AvoidStealth) then
		local iInterval = 2
		if ((self.m_iArtilleryMinRange ~= nil and self.m_iArtilleryMinRange > 0) or
			self.squad_ai:HasSetupTime()) then
			iInterval = 1
		end
		if (g_iGMT < (self.m_iLastStealthCheck or 0) + iInterval) then
			return false
		end
		self.m_iLastStealthCheck = g_iGMT
	end
	
	-- Check for stealth troops
	if (cpu_manager.cpu_player:FindFirstInfiltratedEnemy(vSquadPos, 35, 1) == nil) then
		return false
	end
	      
	-- Check for a safe destination
	if (not self:MoveToDisengage()) then
	
		-- Check if we dance for the first time
		if (self.stateID ~= Tactic.StateID.NoState) then
			self.tolerance = self.tolerance + 10    
		else
			self.tolerance = self.tolerance_default
		end
		self.squad_ai:DoMoveToClosestSafePoint(self.safe_point, self.tolerance)
	end
		
	-- Set state
	local state_func, state_name = self:GetSubState()
	if (state_func ~= self.AvoidStealthTroops) then
		Tactic.SetSubState( self, self.AvoidStealthTroops, "AvoidStealth" )
		self.squad_ai:DoSetStance( SquadAI.STANCE_StandGround )
		self.stateID = Tactic.StateID.AvoidStealth
	end
	
	-- Set avoid stealth state
	self.m_eSubStateID = self.stateID
	return true
end

