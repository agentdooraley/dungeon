class 'Tactic'

Tactic.States = 
{
	Disabled = "Disabled",
	Idle = "Idle",
	Attack = "Attack",
	Hold = "Hold",
	Retreat = "Retreat",
	Invalid = "Invalid"
}

Tactic.Options = 
{
	can_reinforce = false,
}

--amount of resources tactics have to leave unused
Tactic.ResourceFloor =
{
	requisition = 0,
   power = 0
}

Tactic.Variant =
{
	Vector = 0,
	SquadAI = 1,
	BaseAI = 2,
	Invalid = 3
}

Tactic.StateID =
{
    NoState = 0,
    IsBroken = 1,
    DoDance = 2,
    CloseOn = 3,
    AvoidDeath = 4,
    AvoidStealth = 5
}

Tactic.Types =
{
	Undefined = 0,
	Infantry = 1,
	Vehicle = 2
}

Tactic.GlobalDefenseState = "Hold"
Tactic.GlobalDefenseTime = 0

Tactic.DisengageCache = {
	enemy_buildings_time = 0,
	enemy_buildings = {},
	own_buildings_time = 0,
	own_buildings = {},
	heavy_budget_time = 0,
	heavy_budget = 0,
}
-- TEST was: peel → GetHomeRetreatPos (too far even without attack). Keep false.
Tactic.TEST_RetreatToClosestBase = false

--? @shortdesc ctor
--? @args SquadAI squad_ai
--? @result void
function Tactic:__init( squad_ai )

	dbAssert( squad_ai ~= nil )
	
	self.squad_ai = squad_ai
	self.status = "Initialized"
	self.prev_sub_state = nil
	
	self.state = nil
	self.state_function = nil
	self.state_function_map = {}

	self.tactic_name = nil
	self.m_eType = Tactic.Types.Undefined
	
	self.state_function_map[ Tactic.States.Idle ] = Tactic.IdleState
	self.state_function_map[ Tactic.States.Disabled ] = Tactic.StartDisabledState
	
	self.sub_state_name = "No Sub State"
	self.stateID = Tactic.StateID.NoState
	self.m_eSubStateID = Tactic.StateID.NoState
	
	self:SetState( Tactic.States.Idle )

	self.last_jump = 0
	self.m_iLastDisengage = 0

	self.safe_point = Vector3f()
	
	self.tolerance_default = 100
	self.tolerance = self.tolerance_default
	self.target = Vector3f(cpu_manager.start_pos)
	
	self.m_iMoveDelay = 0
	self.m_iLastGatherMove = 0
	self.m_iDancing = 0
	self.m_vCurrentPosition = squad_ai:GetPosition()
	self.m_vLastPosition = squad_ai:GetPosition()
	self.m_iUnitStrength = cpu_manager:GetUnitStrength(self.squad_ai)
	
	self.m_iNextDisownCheck = 0
	self.m_iNextDecapVacate = 0
	
	self.m_iDeepStrikeBlueprintID = -1
	self.m_iDeepStrikeBuildingID = -1
	
	self.m_iLastJumpTargetUpdate = 0
	
	self.m_bCapturePlanMove = false
	self.m_bCaptureGuardMove = false
	self.m_bCaptureGuardAttack = false
	
	self.m_iCommanderAttachTargetId = nil
	self.m_bCommanderAttachInterrupted = false
	self.m_vCommanderAttachLastHostPos = nil
	self.m_vCommanderAttachWaypoint = nil
	self.m_iCommanderAttachBailUntil = 0
	self.m_mCommanderAttachBanUntil = {}
	self.m_bDanceDisengage = false
	self.m_iStayInFightCacheTime = -1
	self.m_bStayInFightCached = false
	self.m_iLastJumpAssistCheck = 0
	self.m_iLastJumpAttackCheck = 0
	self.m_iLastUpgradeCheck = 0
	self.m_iLastReinforceCheck = 0
	self.m_iLastDetachCheck = 0
	self.m_iLastHarassCheck = 0
	self.m_iLastStealthCheck = 0
	self.m_iLastFocusEnemy = 0
	self.m_iFocusTargetID = nil
	self.m_iPreferredFocusBucket = 1
	self.m_iNextFocusBucketCheck = 0
	self.m_iLastWaitThreatCheck = 0
	
	-- Init abilities
	self:InitAbilities()
end

-- Virtual method to initialize ability ID's
function Tactic:InitAbilities()
	
end

--sets a general rule that all Engineers/Builders cannot capture
--copy the function below to your engineer/builder's tactic file then set to true to allow capturing for that unit
function Tactic:IsEngineerWhoCanCapture()
   return false
end

function Tactic:IsInSubState()
	return (self.m_eSubStateID ~= Tactic.StateID.NoState)
end

function Tactic:GetType()
	return self.m_eType
end

function Tactic:CanOnlyDecap()
	return false
end

-- Nearby SP for CanOnlyDecap vacate / stuck checks
function Tactic:FindNearbyStrategicPoint(iRange)

	local vPos = self.squad_ai:GetPosition()
	local iRangeSqr = sqr(iRange or 22)
	local oBest = nil
	local iBest = nil
	for oStrategicPoint in resource_manager:GetStrategicPointAIs() do
		local iDist = distance_sqr(oStrategicPoint:GetPosition(), vPos)
		if (iDist < iRangeSqr and (iBest == nil or iDist < iBest)) then
			iBest = iDist
			oBest = oStrategicPoint
		end
	end
	return oBest
end

-- CanOnlyDecap (Sentinel / Reaver / …): only decap enemy flags when already nearby.
-- Never finish / start capture on neutral; never join CapturePlan / AttackPlan lists.
function Tactic:TryNearbyOnlyCapture()

	if (not self:CanOnlyDecap()) then
		return false
	end
	if (not self.squad_ai:CanCapture() or self.squad_ai:IsCapturing()) then
		return false
	end
	if (g_iGMT < (self.m_iNextDisownCheck or 0)) then
		return false
	end
	self.m_iNextDisownCheck = g_iGMT + 1

	local oFlag = self:FindNearbyStrategicPoint(18)
	if (oFlag == nil or oFlag:IsLocked() or oFlag:HasListeningPost()) then
		return false
	end
	local iOwner = oFlag:Owner()
	-- Neutral / friendly: never take the point (decap only vs enemy)
	if (iOwner == 0 or cpu_manager:IsFriendly(iOwner)) then
		return false
	end
	if (cpu_manager:IsAllyCaptureAtPoint(oFlag, 25)) then
		return false
	end
	local vStratPos = oFlag:GetPosition()
	local vEnemyStrength, iAlliedStrength = cpu_manager:GetArmyStrengthAtPos(vStratPos, 30, true)
	if (vEnemyStrength ~= nil and vEnemyStrength > 0 and iAlliedStrength ~= nil and
		vEnemyStrength * 2 > iAlliedStrength) then
		return false
	end
	-- Broken: same gate as CapturePlan (overwhelm / T&H / ≥0.85 / empty homeside only)
	local fProgress = 0
	if (oFlag.GetCaptureProgress ~= nil) then
		fProgress = oFlag:GetCaptureProgress()
	end
	if (CapturePlan.ShouldRefuseBrokenCapture ~= nil and
		CapturePlan:ShouldRefuseBrokenCapture(self.squad_ai, oFlag, fProgress)) then
		return false
	end
	self.squad_ai:DoDefault(oFlag:GetEntity())
	return true
end

-- Leave the flag so real capturers are not blocked (legacy CanOnlyDecap vacate)
function Tactic:VacateAfterDecap(oFlag)

	local vFlagPos = self.squad_ai:GetPosition()
	if (oFlag ~= nil) then
		vFlagPos = oFlag:GetPosition()
	end
	if (self.squad_ai:IsCapturing()) then
		self.squad_ai:DoStop()
	end
	local vDir = cpu_manager:GetDirectionToEnemy(vFlagPos)
	local vAway = Vector3f(vFlagPos.x + 25, vFlagPos.y, vFlagPos.z)
	if (vDir ~= nil) then
		vAway.x = vFlagPos.x + vDir.x * 25
		vAway.y = vFlagPos.y + vDir.y * 25
		vAway.z = vFlagPos.z + vDir.z * 25
	end
	cpu_manager:DoMove(self.squad_ai, vAway, false, "AttackState")
	self.m_iNextDisownCheck = g_iGMT + 4
	self.m_iNextDecapVacate = g_iGMT + 2
	return true
end

-- CanOnlyDecap: after enemy decap → leave; never sit on neutral finishing the take
function Tactic:ManageCanOnlyDecapCapture()

	if (not self:CanOnlyDecap()) then
		return false
	end
	if (self.m_iNextDecapVacate ~= nil and g_iGMT < self.m_iNextDecapVacate) then
		return false
	end

	local oFlag = self:FindNearbyStrategicPoint(22)
	if (self.squad_ai:IsCapturing()) then
		if (oFlag == nil) then
			return false
		end
		local iOwner = oFlag:Owner()
		-- Decap done (neutral) or ours — leave so infantry can take it
		if (iOwner == 0 or cpu_manager:IsFriendly(iOwner)) then
			return self:VacateAfterDecap(oFlag)
		end
		return false
	end

	-- Idle on neutralized point: vacate (do not start full capture)
	if (oFlag ~= nil and self.squad_ai:IsIdle() and oFlag:Owner() == 0 and
		distance_sqr(self.squad_ai:GetPosition(), oFlag:GetPosition()) < sqr(18)) then
		return self:VacateAfterDecap(oFlag)
	end

	-- Else: only start decap on nearby enemy-owned flags
	return self:TryNearbyOnlyCapture()
end

function Tactic:IsSupportDetector()
	return false
end

